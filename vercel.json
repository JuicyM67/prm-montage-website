    },
    {
      "source": "/koksmontering-vvs/kok-i-upplands-vasby",
      "destination": "/koksmontering-upplands-vasby",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/page/:n*",
      "destination": "/tjanster",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs",
      "destination": "/tjanster",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/:path*",
      "destination": "/tjanster",
      "permanent": true
    },
    {
      "source": "/vvs-snickeri-inredning/page/:n*",
      "destination": "/tjanster",
      "permanent": true
    },
    {
      "source": "/vvs-snickeri-inredning",
      "destination": "/tjanster",
      "permanent": true
    },
    {
      "source": "/vvs-snickeri-inredning/:path*",
      "destination": "/tjanster",
      "permanent": true
    },
    {
      "source": "/offert",
      "destination": "/kontakt",
      "permanent": true
    },
    {
      "source": "/kontakta-oss",
      "destination": "/kontakt",
      "permanent": true
    },
    {
      "source": "/tjanster/:path+",
      "destination": "/tjanster",
      "permanent": true
    },
    {
      "source": "/produkt/installera-eluttag-till-tvattmaskin-diskmaskin",
      "destination": "/eluttag-tvattmaskin-diskmaskin",
      "permanent": true
    },
    {
      "source": "/produkt/installera-eluttag-i-badrum",
      "destination": "/eluttag-badrum",
      "permanent": true
    },
    {
      "source": "/produkt/montera-duschhorn",
      "destination": "/montera-duschvagg",
      "permanent": true
    },
    {
      "source": "/produkt/byta-blandare",
      "destination": "/byta-blandare",
      "permanent": true
    },
    {
      "source": "/produkt/installera-diskmaskin",
      "destination": "/installera-diskmaskin",
      "permanent": true
    },
    {
      "source": "/produkt/byta-toalettstol",
      "destination": "/byta-toalettstol",
      "permanent": true
    },
    {
      "source": "/produkt/installera-tvattmaskin",
      "destination": "/installera-tvattmaskin",
      "permanent": true
    },
    {
      "source": "/produkt/laga-lackande-blandare",
      "destination": "/laga-lackande-blandare",
      "permanent": true
    },
    {
      "source": "/produkt/byta-handfat-kommod",
      "destination": "/byta-handfat-kommod",
      "permanent": true
    },
    {
      "source": "/produkt/montera-tv-pa-vagg",
      "destination": "/montera-tv-pa-vagg",
      "permanent": true
    },
    {
      "source": "/produkt",
      "destination": "/tjanster",
      "permanent": true
    },
    {
      "source": "/produkt/:path*",
      "destination": "/tjanster",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?path=:path*"
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-cache"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
