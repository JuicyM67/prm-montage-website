      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/vvs-i-upplands-vasby",
      "destination": "/rormokare-upplands-vasby",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/rormokare-jour-i-upplands-vasby",
      "destination": "/rormokare-upplands-vasby",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/jour-rormokare-i-upplands-vasby",
      "destination": "/rormokare-upplands-vasby",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/akut-rormokare-i-upplands-vasby",
      "destination": "/rormokare-upplands-vasby",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/pris-jour-rormokare-i-upplands-vasby",
      "destination": "/rormokare-upplands-vasby",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/pris-akut-rormokare-i-upplands-vasby",
      "destination": "/rormokare-upplands-vasby",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/vattenlacka-akut-i-upplands-vasby",
      "destination": "/rormokare-upplands-vasby",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/vattenlacka-i-upplands-vasby",
      "destination": "/rormokare-upplands-vasby",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/akut-vattenlacka-i-upplands-vasby",
      "destination": "/rormokare-upplands-vasby",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/snickeri-i-upplands-vasby",
      "destination": "/snickeri-upplands-vasby",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/interior-inredning-i-upplands-vasby",
      "destination": "/snickeri-upplands-vasby",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/inredning-i-upplands-vasby",
      "destination": "/snickeri-upplands-vasby",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/montera-ikea-kok-i-upplands-vasby",
      "destination": "/ikea-koksmontering-upplands-vasby",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/ikea-kok-i-upplands-vasby",
      "destination": "/ikea-koksmontering-upplands-vasby",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/koksmontering-i-upplands-vasby",
      "destination": "/koksmontering-upplands-vasby",
