{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.prmmontage.se"
        }
      ],
      "destination": "https://prmmontage.se/:path*",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs-i-stockholm",
      "destination": "/koksrenovering-stockholm",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs-i-upplands-vasby",
      "destination": "/rormokare-upplands-vasby",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs-i-:rest*",
      "destination": "/tjanster",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/rormokare-i-stockholm",
      "destination": "/rormokare-stockholm",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/rormokare-jour-i-stockholm",
      "destination": "/akut-rormokare-stockholm",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/jour-rormokare-i-stockholm",
      "destination": "/akut-rormokare-stockholm",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/akut-rormokare-i-stockholm",
      "destination": "/akut-rormokare-stockholm",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/pris-jour-rormokare-i-stockholm",
      "destination": "/akut-rormokare-stockholm",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/pris-akut-rormokare-i-stockholm",
      "destination": "/akut-rormokare-stockholm",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/vattenlacka-akut-i-stockholm",
      "destination": "/vattenlacka-stockholm",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/vattenlacka-i-stockholm",
      "destination": "/vattenlacka-stockholm",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/akut-vattenlacka-i-stockholm",
      "destination": "/vattenlacka-stockholm",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/snickeri-i-stockholm",
      "destination": "/snickeri-stockholm",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/interior-inredning-i-stockholm",
      "destination": "/snickeri-stockholm",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/inredning-i-stockholm",
      "destination": "/snickeri-stockholm",
      "permanent": true
    },
    {
      "source": "/koksmontering-vvs/montera-ikea-kok-i-stockholm",
