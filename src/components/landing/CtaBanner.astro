---
// Slutlig CTA som rundat kort i sidans bredd (SaaS-stil).
interface Props { heading?: string; text?: string }
const { heading = 'Redo när du är det', text = 'Beskriv jobbet så återkommer vi med ett fast pris. Kostnadsfritt och utan förpliktelser.' } = Astro.props;
---
<section class="cv-ctawrap">
  <div class="cv-container">
    <div class="cv-ctabanner">
      <div class="cv-ctastars" role="button" title="Se alla omdömen" aria-label="5 av 5 stjärnor, 100+ omdömen på Google"><span class="stars" aria-hidden="true"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span><span class="txt">(100+ omdömen) på Google</span></div>
      <h2 set:html={heading} />
      <p>{text}</p>
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--light hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--outline-light"><i class="fas fa-phone"></i> 08-520 279 77</a>
      </div>
    </div>
  </div>
</section>
