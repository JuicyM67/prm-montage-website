---
// Bento-rutnät med bildkort, små UI-komponenter och ett jourkort. Bilder: Unsplash (se credits längst ned).
// Hela kortet är klickbart via "stretched link" på rubriken; extra länkar (chips) ligger ovanpå.
const quick = [
  ['Byta blandare', '/byta-blandare'], ['Byta lås', '/byta-las-cylinder'], ['Montera TV', '/montera-tv-pa-vagg'],
  ['Möbelmontering', '/mobelmontering-stockholm'], ['Hyllor & tavlor', '/montera-hyllor-tavlor-gardinstanger'], ['Dörr & dörrstängare', '/montera-dorr-dorrstangare'],
];
---
<div class="cv-tiles">
  <!-- Småjobb -->
  <article class="cv-tile t-hero">
    <img class="cv-tile__img" src="assets/img/unsplash/tile-smajobb.webp" width="1400" height="934" loading="lazy" alt="">
    <div class="cv-tile__shade"></div>
    <div class="cv-joblist" aria-hidden="true">
      <strong>Din jobblista</strong>
      <ul>
        <li><i class="fas fa-check"></i>Byta blandare</li>
        <li><i class="fas fa-check"></i>Hänga upp TV</li>
        <li><i class="fas fa-check"></i>Byta lås</li>
      </ul>
      <span>Ett besök. Ett pris.</span>
    </div>
    <div class="cv-tile__body">
      <span class="cv-tile__eyebrow">Snabba småjobb</span>
      <h3><a class="cv-tile__link" href="/handyman-stockholm">Samla alla småjobb till ett besök</a></h3>
      <p>Montering, lås, blandare och småfix. Vi tar dem på samma gång.</p>
      <div class="cv-glass-tags">{quick.map(([l, h]) => <a href={h}>{l}</a>)}</div>
    </div>
    <span class="cv-tile__go" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
  </article>

  <!-- VVS -->
  <article class="cv-tile t-vvs">
    <img class="cv-tile__img" src="assets/img/unsplash/tile-vvs.webp" width="1400" height="1018" loading="lazy" alt="">
    <div class="cv-tile__shade"></div>
    <div class="cv-tile__body">
      <span class="cv-tile__eyebrow">VVS</span>
      <h3><a class="cv-tile__link" href="/rormokare-stockholm">Droppar kranen? Vi fixar det.</a></h3>
      <p>Blandare, toalett, diskmaskin och läckor.</p>
    </div>
    <span class="cv-tile__go" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
  </article>

  <!-- Köksmontering -->
  <article class="cv-tile t-ikea">
    <img class="cv-tile__img" src="assets/img/unsplash/tile-ikea.webp" width="1400" height="934" loading="lazy" alt="">
    <div class="cv-tile__shade"></div>
    <div class="cv-tile__body">
      <span class="cv-tile__eyebrow">Köksmontering</span>
      <h3><a class="cv-tile__link" href="/ikea-koksmontering-stockholm">Ditt IKEA-kök, monterat rätt</a></h3>
      <div class="cv-steps-mini" aria-hidden="true">
        <span><i class="fas fa-check"></i>Stommar</span><span><i class="fas fa-check"></i>Luckor</span><span><i class="fas fa-check"></i>Bänkskiva</span>
      </div>
    </div>
    <span class="cv-tile__go" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
  </article>

  <!-- Köksrenovering -->
  <article class="cv-tile t-kok">
    <img class="cv-tile__img" src="assets/img/unsplash/tile-kok.webp" width="1400" height="936" loading="lazy" alt="">
    <div class="cv-tile__shade"></div>
    <div class="cv-tile__body">
      <span class="cv-tile__eyebrow">Köksrenovering</span>
      <h3><a class="cv-tile__link" href="/koksrenovering-stockholm">Nytt kök, ett projekt</a></h3>
      <p>Snickeri, VVS och el samordnat.</p>
    </div>
    <span class="cv-tile__go" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
  </article>

  <!-- Eluttag och lampor -->
  <article class="cv-tile t-lamp">
    <img class="cv-tile__img" src="assets/img/unsplash/tile-lampor.webp" width="1400" height="934" loading="lazy" alt="">
    <div class="cv-tile__shade cv-tile__shade--light"></div>
    <div class="cv-tile__body">
      <span class="cv-tile__eyebrow">Eluttag &amp; lampor</span>
      <h3><a class="cv-tile__link" href="/byta-eluttag-stromstallare">Sätt upp lampan. Byt uttaget.</a></h3>
      <p>Strömbrytare, dimmer och belysning.</p>
    </div>
    <span class="cv-tile__go" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
  </article>

  <!-- Jour -->
  <article class="cv-tile t-jour">
    <div class="cv-tile__body">
      <span class="cv-live"><span class="ping"></span>Jour dygnet runt</span>
      <h3><a class="cv-tile__link" href="/jour">Akut läckage eller elfel?</a></h3>
      <p>Vi rycker ut när det inte kan vänta.</p>
      <a class="cv-callbtn" href="tel:+46852027977"><i class="fas fa-phone"></i> 08-520 279 77</a>
    </div>
  </article>
</div>
<p class="cv-credit">Bilder: Unsplash. Benjamin Lehman, Sasikan Ulevik, Bluewater Sweden, André François McKenzie, Pierre Châtel-Innocenti.</p>
