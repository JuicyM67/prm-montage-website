---
// Bento-rutnät över tjänsterna. Stora kortet samlar småjobben som snabblänkar.
const quick = [
  ['Byta blandare', '/byta-blandare'], ['Byta lås', '/byta-las-cylinder'], ['Montera TV', '/montera-tv-pa-vagg'],
  ['Möbelmontering', '/mobelmontering-stockholm'], ['Hyllor & tavlor', '/montera-hyllor-tavlor-gardinstanger'],
  ['Varmvattenberedare', '/byta-varmvattenberedare'], ['Dörr & dörrstängare', '/montera-dorr-dorrstangare'], ['Eluttag & lampor', '/byta-eluttag-stromstallare'],
];
---
<div class="cv-bento">
  <div class="cv-bcard b-lg b-accent">
    <div class="cv-card__icon"><i class="fas fa-screwdriver-wrench"></i></div>
    <h3><a href="/handyman-stockholm">Snabba småjobb</a></h3>
    <p>Montering, lås, blandare och småfix — ofta klart vid ett besök. Samla flera jobb så tar vi dem på samma gång.</p>
    <div class="cv-tags">{quick.map(([l, h]) => <a href={h}>{l}</a>)}</div>
    <a class="cv-card__more" href="/handyman-stockholm">Se alla småjobb <i class="fas fa-arrow-right"></i></a>
  </div>
  <a class="cv-bcard b-md" href="/rormokare-stockholm"><div class="cv-card__icon"><i class="fas fa-shower"></i></div><h3>VVS &amp; rörmokare</h3><p>Toalett, diskmaskin, läckor och andra VVS-jobb.</p><span class="cv-card__more">Läs mer <i class="fas fa-arrow-right"></i></span></a>
  <a class="cv-bcard b-md" href="/ikea-koksmontering-stockholm"><div class="cv-card__icon"><i class="fas fa-toolbox"></i></div><h3>Köksmontering &amp; IKEA</h3><p>Vi monterar ditt kök enligt tillverkarens anvisningar.</p><span class="cv-card__more">Läs mer <i class="fas fa-arrow-right"></i></span></a>
  <a class="cv-bcard b-md" href="/koksrenovering-stockholm"><div class="cv-card__icon"><i class="fas fa-utensils"></i></div><h3>Köksrenovering</h3><p>Snickeri, VVS och el i samma projekt.</p><span class="cv-card__more">Läs mer <i class="fas fa-arrow-right"></i></span></a>
  <a class="cv-bcard b-md" href="/elektriker-stockholm"><div class="cv-card__icon"><i class="fas fa-bolt"></i></div><h3>Elektriker</h3><p>Eluttag, belysning och elinstallationer.</p><span class="cv-card__more">Läs mer <i class="fas fa-arrow-right"></i></span></a>
  <a class="cv-bcard b-md b-urgent" href="/jour"><div class="cv-card__icon"><i class="fas fa-triangle-exclamation"></i></div><h3>Jour — akut hjälp</h3><p>Vattenläcka eller elfel? Vi rycker ut dygnet runt.</p><span class="cv-card__more">Ring eller läs mer <i class="fas fa-arrow-right"></i></span></a>
</div>
