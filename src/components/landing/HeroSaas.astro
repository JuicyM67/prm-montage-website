---
// Hero i SaaS-stil: centrerad. Pill, rubrik, ingress, två CTA:er och en visuell yta (slot) under.
interface Props { pill: string; title: string; accent?: string; lead: string }
const { pill, title, accent, lead } = Astro.props;
---
<section class="cv-hero cv-hero--saas cv-hero--center">
  <div class="cv-container">
    <div class="cv-hero__copy">
      <span class="cv-pill"><span class="dot"></span>{pill}</span>
      <h1>{title} {accent && <span class="cv-grad">{accent}</span>}</h1>
      <p class="cv-hero__lead">{lead}</p>
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--ghost"><i class="fas fa-phone"></i> Ring 08-520 279 77</a>
      </div>
      <ul class="cv-hero__note"><li><i class="fas fa-check"></i>Fast pris</li><li><i class="fas fa-check"></i>Egna hantverkare</li><li><i class="fas fa-check"></i>Garanti</li></ul>
    </div>
    <slot />
  </div>
</section>
