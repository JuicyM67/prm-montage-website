---
// Allt Google/sociala nätverk läser ur <head> som är unikt per sida.
// Fält som utelämnas får samma värde som motsvarande huvudfält (og:title = title osv).
export interface Props {
  title: string;
  description: string;
  canonical: string;
  ogUrl?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  jsonLd: Record<string, unknown>;
}
const p = Astro.props;
const ogTitle = p.ogTitle ?? p.title;
const ogDescription = p.ogDescription ?? p.description;
const ogImage = p.ogImage;
---
<link rel="canonical" href={p.canonical}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="PRM Montage">
<meta property="og:locale" content="sv_SE">
<meta property="og:url" content={p.ogUrl ?? p.canonical}>
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:image" content={ogImage}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={p.twitterTitle ?? ogTitle}>
<meta name="twitter:description" content={p.twitterDescription ?? ogDescription}>
<meta name="twitter:image" content={p.twitterImage ?? ogImage}>
<script type="application/ld+json" set:html={JSON.stringify(p.jsonLd)} />
