---
// Delad sidmall för småjobbs- och tjänst × område-sidor. Markupen följer de handskrivna tjänstesidorna
// (t.ex. byta-blandare.astro) och JSON-LD (BreadcrumbList, Service, FAQPage) byggs ur samma data som
// sidan visar, så att innehåll och strukturerad data inte kan glida isär.
import BaseLayout from '../layouts/BaseLayout.astro';
import { organization } from '../data/organization';

export interface Faq { q: string; a: string }
export interface Section { h: string; paras?: string[]; list?: string[] }
export interface Crumb { name: string; href?: string }
export interface Highlight { icon: string; title: string; text: string }
export interface Props {
  slug: string;
  title: string;
  description: string;
  ogDescription?: string;
  ogImage?: string;
  heroImage: string;
  heroAlt: string;
  h1: string;
  lead?: string;
  crumbs: Crumb[];
  eyebrow?: string;
  h2: string;
  intro: string[];
  highlights?: Highlight[];
  sections?: Section[];
  checklistTitle?: string;
  checklist?: string[];
  faqTitle?: string;
  faqs: Faq[];
  serviceType: string;
  serviceName: string;
  areaServed?: string;
  defaultService: string;
  ctaHeading: string;
  relatedTitle?: string;
  related?: { href: string; label: string }[];
}
const p = Astro.props;
const url = `https://prmmontage.se/${p.slug}`;
const stripTags = (s: string) => s.replace(/<[^>]+>/g, '');
const ogImage = p.ogImage ?? `https://prmmontage.se/${p.heroImage}`;
const crumbItems = [
  { name: 'Hem', href: '/' },
  { name: 'Tjänster', href: '/tjanster' },
  ...p.crumbs,
];
const seo = {
  title: p.title,
  description: p.description,
  canonical: url,
  ogDescription: p.ogDescription ?? p.description,
  ogImage,
  jsonLd: {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          ...crumbItems.map((c, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: c.name,
            ...(c.href ? { item: `https://prmmontage.se${c.href === '/' ? '/' : c.href}` } : {}),
          })),
          { '@type': 'ListItem', position: crumbItems.length + 1, name: p.h1.replace(/&amp;/g, '&') },
        ],
      },
      {
        '@type': 'Service',
        serviceType: p.serviceType,
        name: p.serviceName,
        description: p.ogDescription ?? p.description,
        provider: organization,
        areaServed: p.areaServed ?? 'Stockholm',
        url,
      },
      {
        '@type': 'FAQPage',
        mainEntity: p.faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: stripTags(f.a) },
        })),
      },
    ],
  },
};
const pStyle = 'color:var(--nt-gray);line-height:1.85;font-size:1.02rem;';
const related = p.related ?? [];
---
<BaseLayout seo={seo} activeNav="tjanster" defaultService={p.defaultService}>
  <div class="tp-breadcrumb-area tp-breadcrumb-spacing nt-dark-band pt-180 pb-90" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container">
      <div class="row"><div class="col-xl-8 col-lg-9">
        <div class="tp-breadcrumb-content">
          <h1 class="tp-breadcrumb-title fw-600 fs-60 fs-xs-40 ls-m-3 tp-text-common-white lh-1 mb-20" set:html={p.h1} />
          {p.lead && <p style="color:rgba(255,255,255,.78);font-size:1.02rem;max-width:620px;margin-bottom:18px;" set:html={p.lead} />}
          <div class="tp-breadcrumb-dvdr"><ul>
            <li><a href="/">Hem</a></li><li class="dvdr">/</li>
            <li><a href="/tjanster">Tjänster</a></li><li class="dvdr">/</li>
            {p.crumbs.map((c) => <><li><a href={c.href}>{c.name}</a></li><li class="dvdr">/</li></>)}
            <li set:html={p.h1} />
          </ul></div>
        </div>
      </div></div>
    </div>
  </div>

  <div class="tp-service-details-thumb pt-80" style="background:var(--nt-white);">
    <div class="container">
      <div class="nt-media wow img-custom-anim-top" data-wow-duration="1.5s" data-wow-delay="0.2s" style="height:360px;">
        <img src={p.heroImage} width="1400" height="560" alt={p.heroAlt} style="width:100%;height:100%;object-fit:cover;">
      </div>
    </div>
  </div>

  <div class="tp-service-details-area pt-70 pb-120" style="background:var(--nt-white);">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8">
          <span class="nt-eyebrow">{p.eyebrow ?? 'Tjänst'}</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36" set:html={p.h2} />
          {p.intro.map((t) => <p class="mb-25" style={pStyle} set:html={t} />)}

          {p.highlights && p.highlights.length > 0 && (
            <div class="row g-4 mt-10 mb-45">
              {p.highlights.map((h, i) => (
                <div class="col-md-6">
                  <div class="nt-highlight h-100" style={`background:var(--nt-gray-light);border-left-color:${i % 2 === 0 ? 'var(--nt-orange)' : 'var(--nt-navy)'};`}>
                    <h5><i class={`fas ${h.icon}`} style="color:#1FA968;margin-right:8px;"></i>{h.title}</h5>
                    <p>{h.text}</p>
                  </div>
                </div>
              ))}
            </div>
          )}

          {p.checklist && p.checklist.length > 0 && (
            <>
              <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">{p.checklistTitle ?? 'Vad som ingår'}</h4>
              <ul class="nt-check mb-45">
                {p.checklist.map((li) => <li><i class="fas fa-check-circle"></i><span set:html={li} /></li>)}
              </ul>
            </>
          )}

          {(p.sections ?? []).map((s) => (
            <>
              <h3 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;" set:html={s.h} />
              {(s.paras ?? []).map((t) => <p class="mb-25" style={pStyle} set:html={t} />)}
              {s.list && s.list.length > 0 && (
                <ul class="nt-check mb-45">
                  {s.list.map((li) => <li><i class="fas fa-check-circle"></i><span set:html={li} /></li>)}
                </ul>
              )}
            </>
          ))}

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">{p.faqTitle ?? 'Vanliga frågor'}</h4>
          <div class="accordion nt-accordion mb-45" id="faqSj">
            {p.faqs.map((f, i) => (
              <div class="accordion-item">
                <h2 class="accordion-header"><button class={`accordion-button${i === 0 ? '' : ' collapsed'}`} type="button" data-bs-toggle="collapse" data-bs-target={`#faqSj${i + 1}`} set:html={f.q} /></h2>
                <div id={`faqSj${i + 1}`} class={`accordion-collapse collapse${i === 0 ? ' show' : ''}`} data-bs-parent="#faqSj"><div class="accordion-body" set:html={f.a} /></div>
              </div>
            ))}
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="nt-side-card nt-side-card--navy" style="background:var(--nt-navy);">
            <h4 style="color:#fff;font-weight:700;margin-bottom:24px;">Kontakta oss direkt</h4>
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-phone" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">Ring oss</p><a href="tel:+46852027977" style="color:#fff;font-weight:700;font-size:1.05rem;text-decoration:none;">08-520 279 77</a></div>
            </div>
            <div style="display:flex;align-items:center;gap:14px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-envelope" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">E-post</p><a href="mailto:info@pro-montage.se" style="color:#fff;font-weight:700;text-decoration:none;">info@pro-montage.se</a></div>
            </div>
          </div>
          <div class="nt-side-card">
            <h5>Varför PRM Montage?</h5>
            <ul class="nt-check" style="margin:0;"><li><i class="fas fa-check"></i><span>Fast pris, alltid</span></li><li><i class="fas fa-check"></i><span>F-skatt &amp; försäkrade</span></li><li><i class="fas fa-check"></i><span>Egna hantverkare</span></li><li><i class="fas fa-check"></i><span>Garanti på arbetet</span></li></ul>
          </div>
          {related.length > 0 && (
            <div class="nt-side-card">
              <h5>{p.relatedTitle ?? 'Fler småjobb'}</h5>
              <ul class="nt-side-nav">
                {related.map((r) => <li><a href={r.href}>{r.label} <i class="fas fa-arrow-right"></i></a></li>)}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>

  <div class="tp-cta-area nt-dark-band pt-120 pb-120" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container"><div class="row"><div class="col-xl-8 col-lg-10">
      <span class="nt-eyebrow nt-eyebrow-light">Redo att börja?</span>
      <h2 class="mb-15 fs-xl-40 fs-sm-36 tp-text-common-white" set:html={p.ctaHeading} />
      <p class="mb-40" style="color:rgba(255,255,255,0.78);font-size:1.05rem;max-width:620px;">Kontakta oss idag — fast pris, egna hantverkare, kostnadsfri offert.</p>
      <div class="d-flex flex-wrap align-items-center gap-4">
        <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500"><span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span></a>
        <a href="tel:+46852027977" class="d-inline-flex align-items-center gap-3" style="text-decoration:none;"><span style="width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;"><i class="fas fa-phone" style="color:#1FA968;"></i></span><span><span style="display:block;color:rgba(255,255,255,0.6);font-size:.8rem;">Ring oss direkt</span><span style="display:block;color:#fff;font-weight:700;font-size:1.15rem;">08-520 279 77</span></span></a>
      </div>
    </div></div></div>
  </div>
</BaseLayout>
