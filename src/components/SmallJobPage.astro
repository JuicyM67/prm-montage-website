---
// Delad sidmall för småjobbs- och tjänst × område-sidor. Markupen följer de handskrivna tjänstesidorna
// (t.ex. byta-blandare.astro) och JSON-LD (BreadcrumbList, Service, FAQPage) byggs ur samma data som
// sidan visar, så att innehåll och strukturerad data inte kan glida isär.
import BaseLayout from '../layouts/BaseLayout.astro';
import { organization } from '../data/organization';
import ProofBar from './ProofBar.astro';
import ReviewStrip from './ReviewStrip.astro';
import FinalCta from './FinalCta.astro';
import StickyOfferCard from './StickyOfferCard.astro';

import type { JobPageProps } from './small-job-types';

export interface Props extends JobPageProps {}
const p = Astro.props;
const url = `https://prmmontage.se/${p.slug}`;
const stripTags = (s: string) => s.replace(/<[^>]+>/g, '');
const ogImage = p.ogImage ?? `https://prmmontage.se/${p.heroImage}`;
const crumbItems = [
  { name: 'Hem', href: '/' },
  { name: 'Tjänster', href: '/tjanster' },
  ...p.crumbs,
];
const seo = {
  title: p.title,
  description: p.description,
  canonical: url,
  ogDescription: p.ogDescription ?? p.description,
  ogImage,
  jsonLd: {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          ...crumbItems.map((c, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: c.name,
            ...(c.href ? { item: `https://prmmontage.se${c.href === '/' ? '/' : c.href}` } : {}),
          })),
          { '@type': 'ListItem', position: crumbItems.length + 1, name: p.h1.replace(/&amp;/g, '&') },
        ],
      },
      {
        '@type': 'Service',
        serviceType: p.serviceType,
        name: p.serviceName,
        description: p.ogDescription ?? p.description,
        provider: organization,
        areaServed: p.areaServed ?? 'Stockholm',
        url,
      },
      {
        '@type': 'FAQPage',
        mainEntity: p.faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: stripTags(f.a) },
        })),
      },
    ],
  },
};
const related = p.related ?? [];
const reviewOffset = [...p.slug].reduce((a, c) => a + c.charCodeAt(0), 0) % 13;
---
<BaseLayout seo={seo} activeNav="tjanster" defaultService={p.defaultService}>
  <section class="cv-pagehero">
    <div class="cv-container">
      <ul class="cv-crumbs">
        <li><a href="/">Hem</a></li>
        <li><a href="/tjanster">Tjänster</a></li>
        {p.crumbs.map((c) => <li><a href={c.href}>{c.name}</a></li>)}
      </ul>
      <h1 set:html={p.h1} />
      {p.lead && <p class="cv-pagehero__lead" set:html={p.lead} />}
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--outline-light"><i class="fas fa-phone"></i> Ring 08-520 279 77</a>
      </div>
      <div class="cv-rating cv-rating--light"><span class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span><span>4,9 på Google · 100+ omdömen</span></div>
    </div>
  </section>

  <ProofBar />

  <section class="cv-section">
    <div class="cv-container cv-layout">
      <article class="cv-prose">
        <h2 set:html={p.h2} />
        {p.intro.map((t) => <p set:html={t} />)}

        <div class="cv-btn-row cv-midcta-row">
          <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        </div>

        {p.checklist && p.checklist.length > 0 && (
          <>
            <h3>{p.checklistTitle ?? 'Vad som ingår'}</h3>
            <ul class="cv-checks">
              {p.checklist.map((li) => <li><i class="fas fa-check-circle"></i><span set:html={li} /></li>)}
            </ul>
          </>
        )}

        {(p.sections ?? []).map((s) => (
          <>
            <h3 set:html={s.h} />
            {(s.paras ?? []).map((t) => <p set:html={t} />)}
            {s.list && s.list.length > 0 && (
              <ul class="cv-checks">
                {s.list.map((li) => <li><i class="fas fa-check-circle"></i><span set:html={li} /></li>)}
              </ul>
            )}
          </>
        ))}

        <h2 class="cv-block">{p.faqTitle ?? 'Vanliga frågor'}</h2>
        <div class="accordion nt-accordion" id="faqSj">
          {p.faqs.map((f, i) => (
            <div class="accordion-item">
              <h3 class="accordion-header"><button class={`accordion-button${i === 0 ? '' : ' collapsed'}`} type="button" data-bs-toggle="collapse" data-bs-target={`#faqSj${i + 1}`} set:html={f.q} /></h3>
              <div id={`faqSj${i + 1}`} class={`accordion-collapse collapse${i === 0 ? ' show' : ''}`} data-bs-parent="#faqSj"><div class="accordion-body" set:html={f.a} /></div>
            </div>
          ))}
        </div>
      </article>

      <aside>
        <StickyOfferCard related={p.related} relatedTitle={p.relatedTitle ?? 'Fler småjobb'} />
      </aside>
    </div>
  </section>

  <section class="cv-section cv-section--tint">
    <div class="cv-container">
      <h2 class="cv-h2">Det säger våra kunder</h2>
      <ReviewStrip count={3} offset={reviewOffset} job />
    </div>
  </section>

  <FinalCta heading={p.ctaHeading} />
</BaseLayout>
