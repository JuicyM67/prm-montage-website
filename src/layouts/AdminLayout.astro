---
import '../styles/fonts.css';
import '../admin/admin.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="sv">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title} – PRM Montage admin</title>
  <!-- Adminytan ska aldrig indexeras (även X-Robots-Tag sätts i vercel.json). -->
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" type="image/png" href="/assets/img/logo/favicon-192.png">
  <link rel="shortcut icon" href="/assets/img/logo/favicon.ico">
  <link rel="preload" href="/assets/fonts/dm-sans-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body class="adm-body">
  <slot />
</body>
</html>
