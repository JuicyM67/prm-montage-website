---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import SectionHeader from '../components/landing/SectionHeader.astro';
import ReviewStrip from '../components/ReviewStrip.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyOfferCard from '../components/StickyOfferCard.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "Köksrenovering & köksmontering Södermalm | PRM Montage",
  "description": "Köksrenovering och köksmontering på Södermalm till fast pris. Vi monterar kök i lägenhet — stomme, luckor, bänkskiva — anpassat efter äldre fastigheter. Kostnadsfri offert.",
  "canonical": "https://prmmontage.se/koksmontering-sodermalm",
  "ogDescription": "Köksmontering på Södermalm till fast pris — professionell montering av kök, oavsett varumärke.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/hero-kok.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Köksmontering Södermalm"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Köksmontering",
        "name": "Köksmontering Södermalm",
        "description": "Montering av kök du redan köpt — stomme, luckor, bänkskiva och infästning, till fast pris på Södermalm.",
        "provider": organization,
        "areaServed": "Södermalm",
        "url": "https://prmmontage.se/koksmontering-sodermalm"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Går det att montera kök i lägenhet utan hiss på Södermalm?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. Vi planerar för trapphus och smala passager redan när leveransen bokas, så att kökets delar kommer upp utan att störa grannarna i onödan."
            }
          },
          {
            "@type": "Question",
            "name": "Hur hanterar ni sneda väggar i gamla hus?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Vi mäter vid offerten och riktar upp stommarna efter golv och väggar, så att luckor och bänkskiva ändå sluter jämnt."
            }
          },
          {
            "@type": "Question",
            "name": "Räcker montering, eller behövs renovering?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Är köket redan köpt och rören och elen kan stå kvar räcker montering. Annars handlar det om renovering."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} defaultService="Köksrenovering">
  <!-- =============== BREADCRUMB =============== -->
    <section class="cv-pagehero">
    <div class="cv-container">
      <ul class="cv-crumbs"><li><a href="/">Hem</a></li></ul>
      <h1>Köksrenovering &amp; köksmontering på Södermalm</h1>
      <p class="cv-pagehero__lead">Fast pris och professionell montering av kök i Södermalms lägenheter — oavsett varumärke.</p>
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--outline-light"><i class="fas fa-phone"></i> Ring 08-520 279 77</a>
      </div>
      <div class="cv-rating cv-rating--light"><span class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span><span>4,9 på Google · 100+ omdömen</span></div>
    </div>
  </section>

  <div class="cv-pageshot-wrap"><div class="cv-container cv-pageshot"><img src="assets/img/projekt/hero-kok.webp" width="1400" height="560" alt="Kök monterat av PRM Montage i Stockholm" fetchpriority="high"></div></div>

  <ProofBar />


    <section class="cv-section">
    <div class="cv-container cv-layout">
      <article class="cv-prose">
          <span class="nt-eyebrow">Södermalm</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Köksmontering anpassad efter äldre lägenheter</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Södermalms lägenheter finns nästan uteslutande i fastigheter från sekelskiftet och några decennier framåt, vilket gör köksmontering till ett lite annorlunda uppdrag jämfört med i en nyproducerad lägenhet. Väggar och golv är sällan helt raka, vilket vi tar hänsyn till redan vid mätning och offert för att köket ska bli rakt och funktionellt ändå.</p>
          <div class="cv-btn-row cv-midcta-row">
            <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
          </div>


          <div class="nt-highlight mb-45">
            <h5><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Rakt kök i ett snett hus</h5>
            <p>Vi mäter noga i äldre lägenheter, så att köket sitter rakt även när väggar och golv inte gör det.</p>
          </div>

          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Vi utgår från ett kök som redan är köpt. Behöver lägenheten nya vattenledningar eller nya eluttag, eller ska en vägg rivas, hör det till en köksrenovering. Många trapphus på Södermalm saknar hiss, och det planerar vi för redan när materialleveransen bokas.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad ingår i köksmonteringen?</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Stommar som riktas upp mot väggar och golv som lutar</span></li>
            <li><i class="fas fa-check-circle"></i><span>Luckor som justeras tills de sluter fint</span></li>
            <li><i class="fas fa-check-circle"></i><span>Bänkskiva som passas in mot en ojämn vägg</span></li>
            <li><i class="fas fa-check-circle"></i><span>Sockellister och passbitar där rummet kräver det</span></li>
            <li><i class="fas fa-check-circle"></i><span>Inkoppling av diskmaskin och blandare när du vill ha hjälp</span></li>
          </ul>

          <div class="mb-45">
            <img src="assets/img/projekt/kok-02.webp" width="900" height="675" loading="lazy" alt="Monterat kök i lägenhet på Södermalm" class="w-100" style="border-radius:12px;aspect-ratio:16/9;height:auto;object-fit:cover;">
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Så går det till</h4>
          <div class="row g-4 gy-5 mb-45">
            <div class="col-md-4">
              <div class="nt-step h-100">
                <span class="nt-step__num">01</span>
                <h4>Kostnadsfri offert</h4>
                <p>Mät upp köket och skicka planlösningen, så får du ett fast pris. Berätta gärna om trapphus och hiss.</p>
              </div>
            </div>
            <div class="col-md-4">
              <div class="nt-step h-100">
                <span class="nt-step__num">02</span>
                <h4>Montering bokas in</h4>
                <p>Vi planerar leveransen av kökets delar upp i huset och bokar en monteringstid som fungerar för grannarna.</p>
              </div>
            </div>
            <div class="col-md-4">
              <div class="nt-step h-100">
                <span class="nt-step__num">03</span>
                <h4>Färdigt kök</h4>
                <p>Köket sätts ihop, justeras mot sneda väggar och golv och gås igenom med dig innan vi åker.</p>
              </div>
            </div>
          </div>

          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Vill du i stället riva och bygga om köket, med nya rör och eluttag, läs under <a href="/koksrenovering-stockholm">Köksrenovering Stockholm</a>. Köket från IKEA? Se <a href="/ikea-koksmontering-sodermalm">IKEA-köksmontering på Södermalm</a>. ROT-avdraget förklaras på <a href="/rut-rot">en egen sida</a>.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om köksmontering på Södermalm</h4>
          <div class="accordion nt-accordion mb-45" id="faqKoksmSod">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqKoksmSod1">Går det att montera kök i lägenhet utan hiss på Södermalm?</button></h2>
              <div id="faqKoksmSod1" class="accordion-collapse collapse show" data-bs-parent="#faqKoksmSod"><div class="accordion-body">Ja. Vi planerar för trapphus och smala passager redan när leveransen bokas, så att kökets delar kommer upp utan att störa grannarna i onödan.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqKoksmSod2">Hur hanterar ni sneda väggar i gamla hus?</button></h2>
              <div id="faqKoksmSod2" class="accordion-collapse collapse" data-bs-parent="#faqKoksmSod"><div class="accordion-body">Vi mäter vid offerten och riktar upp stommarna efter golv och väggar, så att luckor och bänkskiva ändå sluter jämnt.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqKoksmSod3">Räcker montering, eller behövs renovering?</button></h2>
              <div id="faqKoksmSod3" class="accordion-collapse collapse" data-bs-parent="#faqKoksmSod"><div class="accordion-body">Är köket redan köpt och rören och elen kan stå kvar räcker montering. Annars handlar det om renovering.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </article>
      <aside>
        <StickyOfferCard related={[]} relatedTitle="Fler jobb" />
      </aside>
    </div>
  </section>

  <section class="cv-section cv-section--tint">
    <div class="cv-container">
      <SectionHeader pill="Omdömen" title="Det säger våra kunder" />
      <ReviewStrip count={3} offset={10} job />
    </div>
  </section>


    <FinalCta heading="Dags att förverkliga ditt drömkök?" />

</BaseLayout>
