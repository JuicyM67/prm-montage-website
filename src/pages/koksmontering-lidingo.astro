---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import SectionHeader from '../components/landing/SectionHeader.astro';
import ReviewStrip from '../components/ReviewStrip.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyOfferCard from '../components/StickyOfferCard.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "Köksrenovering & köksmontering Lidingö | PRM Montage",
  "description": "Köksrenovering och köksmontering i Lidingö till fast pris. Vi monterar kök i villor och lägenheter — stomme, luckor, bänkskiva. Kostnadsfri offert.",
  "canonical": "https://prmmontage.se/koksmontering-lidingo",
  "ogDescription": "Köksmontering i Lidingö till fast pris — professionell montering av kök, oavsett varumärke.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/hero-kok.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Köksmontering Lidingö"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Köksmontering",
        "name": "Köksmontering Lidingö",
        "description": "Montering av kök du redan köpt — stomme, luckor, bänkskiva och infästning, till fast pris i Lidingö.",
        "provider": organization,
        "areaServed": "Lidingö",
        "url": "https://prmmontage.se/koksmontering-lidingo"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Kommer ni till Lidingö för ett enskilt kök?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. Vi åker över bron från Solna och planerar besöket så att monteringen kan göras i en sammanhängande omgång."
            }
          },
          {
            "@type": "Question",
            "name": "Passar köksmontering i äldre villor på Lidingö?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. Många äldre hus har golv och väggar som inte är helt raka, och det tar vi hänsyn till redan vid mätningen så att köket ändå sitter rakt."
            }
          },
          {
            "@type": "Question",
            "name": "När behövs en köksrenovering i stället?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "När väggar ska rivas, vatten flyttas eller el dras om. Är köket redan köpt och ska bara upp räcker det med montering."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} defaultService="Köksrenovering">
  <!-- =============== BREADCRUMB =============== -->
    <section class="cv-pagehero">
    <div class="cv-container">
      <ul class="cv-crumbs"><li><a href="/">Hem</a></li></ul>
      <h1>Köksrenovering &amp; köksmontering i Lidingö</h1>
      <p class="cv-pagehero__lead">Fast pris och professionell montering av kök i Lidingös villor och lägenheter — oavsett varumärke.</p>
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--outline-light"><i class="fas fa-phone"></i> Ring 08-520 279 77</a>
      </div>
      <div class="cv-rating cv-rating--light"><span class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span><span>4,9 på Google · 100+ omdömen</span></div>
    </div>
  </section>

  <div class="cv-pageshot-wrap"><div class="cv-container cv-pageshot"><img src="assets/img/projekt/hero-kok.webp" width="1400" height="560" alt="Kök monterat av PRM Montage i Stockholm" fetchpriority="high"></div></div>

  <ProofBar />


    <section class="cv-section">
    <div class="cv-container cv-layout">
      <article class="cv-prose">
          <span class="nt-eyebrow">Lidingö</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Professionell köksmontering på Lidingö</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Lidingö, med områden som Bodal, Käppala och Larsberg, kännetecknas av välskötta villor och generellt höga krav på slutresultatet. Köken här köps ofta från etablerade kökssnickerier eller kedjor — och oavsett var köket kommer ifrån hjälper vi till med själva monteringen: stomme, luckor, bänkskiva och infästning, med den noggrannhet som förväntas.</p>
          <div class="cv-btn-row cv-midcta-row">
            <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
          </div>


          <div class="nt-highlight mb-45">
            <h3><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Prissättning utan överraskningar</h3>
            <p>Priset för monteringen är fast och bestäms innan vi sätter igång, även i äldre villor med ojämna golv.</p>
          </div>

          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Skillnaden mot en köksrenovering är att vi utgår från ett kök som redan finns. Behövs rivning, nya vattenledningar eller nya eluttag är det renovering. I många av Lidingös äldre villor görs monteringen när kök och golv byts samtidigt, utan att resten av huset berörs.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad ingår i köksmonteringen?</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Köksstommar som monteras rakt trots ojämna underlag</span></li>
            <li><i class="fas fa-check-circle"></i><span>Luckor och lådfronter med jämna mellanrum</span></li>
            <li><i class="fas fa-check-circle"></i><span>Anpassning och montering av bänkskiva</span></li>
            <li><i class="fas fa-check-circle"></i><span>Avslutande lister och sockel</span></li>
            <li><i class="fas fa-check-circle"></i><span>Inkoppling av disk- och spisutrustning vid behov</span></li>
          </ul>

          <div class="mb-45">
            <img src="assets/img/projekt/kok-03.webp" width="900" height="675" loading="lazy" alt="Monterat kök i villa på Lidingö" class="w-100" style="border-radius:12px;aspect-ratio:16/9;height:auto;object-fit:cover;">
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Så går det till</h4>
          <div class="row g-4 gy-5 mb-45">
            <div class="col-md-4">
              <div class="nt-step h-100">
                <span class="nt-step__num">01</span>
                <h4>Kostnadsfri offert</h4>
                <p>Skicka planlösning, mått och leverantör, så får du ett fast pris på monteringen.</p>
              </div>
            </div>
            <div class="col-md-4">
              <div class="nt-step h-100">
                <span class="nt-step__num">02</span>
                <h4>Montering bokas in</h4>
                <p>Vi bokar in monteringen. Från vårt kontor i Solna kommer vi över bron, och vi planerar tiden så att besöken blir få.</p>
              </div>
            </div>
            <div class="col-md-4">
              <div class="nt-step h-100">
                <span class="nt-step__num">03</span>
                <h4>Färdigt kök</h4>
                <p>Vi monterar, justerar och visar hur allt fungerar innan vi lämnar köket åt dig.</p>
              </div>
            </div>
          </div>

          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Ska köket göras om från grunden, med rivning och nya ledningar, hittar du mer under <a href="/koksrenovering-stockholm">Köksrenovering Stockholm</a>. IKEA-kök monterar vi enligt sidan <a href="/ikea-koksmontering-lidingo">IKEA-köksmontering på Lidingö</a>. Läs gärna även om <a href="/rut-rot">ROT-avdraget</a>.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om köksmontering i Lidingö</h4>
          <div class="accordion nt-accordion mb-45" id="faqKoksmLid">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqKoksmLid1">Kommer ni till Lidingö för ett enskilt kök?</button></h2>
              <div id="faqKoksmLid1" class="accordion-collapse collapse show" data-bs-parent="#faqKoksmLid"><div class="accordion-body">Ja. Vi åker över bron från Solna och planerar besöket så att monteringen kan göras i en sammanhängande omgång.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqKoksmLid2">Passar köksmontering i äldre villor på Lidingö?</button></h2>
              <div id="faqKoksmLid2" class="accordion-collapse collapse" data-bs-parent="#faqKoksmLid"><div class="accordion-body">Ja. Många äldre hus har golv och väggar som inte är helt raka, och det tar vi hänsyn till redan vid mätningen så att köket ändå sitter rakt.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqKoksmLid3">När behövs en köksrenovering i stället?</button></h2>
              <div id="faqKoksmLid3" class="accordion-collapse collapse" data-bs-parent="#faqKoksmLid"><div class="accordion-body">När väggar ska rivas, vatten flyttas eller el dras om. Är köket redan köpt och ska bara upp räcker det med montering.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </article>
      <aside>
        <StickyOfferCard related={[]} relatedTitle="Fler jobb" />
      </aside>
    </div>
  </section>

  <section class="cv-section cv-section--tint">
    <div class="cv-container">
      <SectionHeader pill="Omdömen" title="Det säger våra kunder" />
      <ReviewStrip count={3} offset={9} job />
    </div>
  </section>


    <FinalCta heading="Dags att förverkliga ditt drömkök?" />

</BaseLayout>
