---
import BaseLayout from '../layouts/BaseLayout.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "Hantverkare i Solna — Bygg, VVS & El | PRM Montage",
  "description": "Hantverkare i Solna – PRM Montage har kontor på Industrivägen 19 och hjälper dig med kök, badrum, bygg, VVS och el till fast pris. Kostnadsfri offert.",
  "canonical": "https://prmmontage.se/solna",
  "ogDescription": "PRM Montage har kontor i Solna och hjälper dig med kök, badrum, bygg, VVS och el till fast pris.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/hero-kok.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Hantverkare i Solna"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Köksrenovering",
        "name": "Köksrenovering i Solna",
        "description": "Köksrenovering för bostadsrätter och villor i Solna, till fast pris.",
        "provider": organization,
        "areaServed": "Solna",
        "url": "https://prmmontage.se/koksrenovering-stockholm"
      },
      {
        "@type": "Service",
        "serviceType": "VVS och badrumsrenovering",
        "name": "VVS & Badrum i Solna",
        "description": "Badrumsrenovering och VVS-installationer i Solna, ofta i bostadsrätter.",
        "provider": organization,
        "areaServed": "Solna",
        "url": "https://prmmontage.se/vvs-badrum"
      },
      {
        "@type": "Service",
        "serviceType": "Elinstallation",
        "name": "Elektriker i Solna",
        "description": "Behörig elinstallation i lägenheter och villor i Solna.",
        "provider": organization,
        "areaServed": "Solna",
        "url": "https://prmmontage.se/elektriker-stockholm"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Hur begär jag en offert i Solna?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Enklast är att ringa oss på 08-520 279 77 eller fylla i formuläret på sidan. Berätta kort vad du vill ha hjälp med så återkommer vi med en kostnadsfri offert och ett fast pris innan arbetet påbörjas."
            }
          },
          {
            "@type": "Question",
            "name": "Ger renoveringen rätt till ROT-avdrag?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Arbetskostnaden vid de flesta renoveringar ger normalt rätt till ROT-avdrag, medan material och produkter inte gör det. Vi hjälper dig räkna på avdraget i offerten."
            }
          },
          {
            "@type": "Question",
            "name": "Hur snabbt kan ni komma ut till Solna?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Eftersom vårt kontor ligger på Industrivägen 19 i Solna har vi normalt kort startsträcka till uppdrag i kommunen. Vid akuta ärenden erbjuder vi jour dygnet runt på samma telefonnummer."
            }
          },
          {
            "@type": "Question",
            "name": "Behöver jag godkännande från bostadsrättsföreningen för renoveringen?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ofta ja, särskilt vid ingrepp i VVS, el eller bärande konstruktion. Kontrollera alltid med din förening vad som gäller innan arbetet påbörjas. Vi hjälper gärna till med underlag och ritningar som kan behövas i en sådan ansökan."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="omraden">
  <!-- =============== BREADCRUMB =============== -->
  <div class="tp-breadcrumb-area tp-breadcrumb-spacing nt-dark-band pt-180 pb-90" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container">
      <div class="row"><div class="col-xl-8 col-lg-9">
        <div class="tp-breadcrumb-content">
          <h1 class="tp-breadcrumb-title fw-600 fs-60 fs-xs-40 ls-m-3 tp-text-common-white lh-1 mb-20">Hantverkare i Solna</h1>
          <p style="color:rgba(255,255,255,.78);font-size:1.02rem;max-width:620px;margin-bottom:18px;">Bygg, renovering, VVS och el — med fast pris och kort startsträcka från vårt kontor i Solna.</p>
          <div class="tp-breadcrumb-dvdr"><ul><li><a href="/">Hem</a></li><li class="dvdr">/</li><li>Hantverkare i Solna</li></ul></div>
        </div>
      </div></div>
    </div>
  </div>

  <div class="tp-service-details-area pt-100 pb-120" style="background:var(--nt-white);">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8">
          <span class="nt-eyebrow">Solna</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Hantverkare med kontor mitt i Solna</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">PRM Montage AB har sitt kontor på Industrivägen 19, mitt i Solna — vilket gör oss till en verkligt lokal hantverkare snarare än ett företag som bara skriver att man "arbetar i området". Kort startsträcka och god lokalkännedom är en självklar fördel när du ska boka in en hantverkare: vi känner till husen, föreningarna och de vanligaste frågorna som dyker upp i just den här delen av Stockholm.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Solna har de senaste decennierna växt kraftigt, med stora nyproduktionsområden som Arenastaden, Hagalund och Råsunda. Det innebär att många av våra uppdrag i kommunen handlar om bostadsrätter i relativt nya fastigheter — renoveringar av kök och badrum, uppdatering av ytskikt, eller anpassningar efter att man flyttat in. VVS- och elarbeten i en bostadsrätt kräver ofta någon form av anmälan till eller godkännande från föreningen, särskilt vid ingrepp i stammar eller bärande väggar. Det här är något vi är vana vid att hantera tillsammans med våra kunder — vi hjälper gärna till med den praktiska och dokumentationsmässiga sidan så att renoveringen kan genomföras i linje med vad din förening kräver.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Oavsett om det handlar om en mindre badrumsrenovering i en lägenhet i Hagalund eller en större köksombyggnad i Arenastaden utgår vi alltid från samma arbetssätt: fast pris innan vi sätter igång, egna hantverkare inom bygg, VVS och el, och en tydlig kommunikation genom hela projektet.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;margin-top:10px;">Våra tjänster i Solna</h4>
          <div class="row g-4 mb-50">
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-utensils"></i></div>
                <h4><a href="/koksrenovering-stockholm">Köksrenovering Stockholm</a></h4>
                <p>Nytt kök i din bostadsrätt eller villa i Solna — vi hanterar snickeri, VVS och el i samma projekt.</p>
                <a class="nt-icon-card__link" href="/koksrenovering-stockholm">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-screwdriver-wrench"></i></div>
                <h4><a href="/koksmontering-solna">Köksmontering Solna</a></h4>
                <p>Har du redan ett kök på väg till din nya lägenhet i Solna? Vi monterar det snabbt och till fast pris.</p>
                <a class="nt-icon-card__link" href="/koksmontering-solna">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-toolbox"></i></div>
                <h4><a href="/ikea-koksmontering-solna">IKEA-köksmontering Solna</a></h4>
                <p>IKEA:s METOD-kök är vanligt vid inflytt i nyproduktion i Solna — vi monterar enligt IKEA:s anvisningar.</p>
                <a class="nt-icon-card__link" href="/ikea-koksmontering-solna">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-hammer"></i></div>
                <h4><a href="/bygg-renovering">Bygg &amp; renovering</a></h4>
                <p>Ombyggnationer och renoveringar anpassade efter nyare fastigheters förutsättningar.</p>
                <a class="nt-icon-card__link" href="/bygg-renovering">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-shower"></i></div>
                <h4><a href="/vvs-badrum">VVS &amp; Badrum</a></h4>
                <p>Badrumsrenovering med behörig VVS-installation — vi hjälper till med underlag till bostadsrättsföreningen vid behov.</p>
                <a class="nt-icon-card__link" href="/vvs-badrum">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-bolt"></i></div>
                <h4><a href="/elektriker-stockholm">Elektriker Stockholm</a></h4>
                <p>Elinstallationer och uppdatering av elcentraler, även i nyare fastigheter i Arenastaden och Hagalund.</p>
                <a class="nt-icon-card__link" href="/elektriker-stockholm">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-sun"></i></div>
                <h4><a href="/altanbygge-i-stockholm">Altanbygge i Stockholm</a></h4>
                <p>Altan eller uteplats till villa eller radhus i Solna, från ritning till färdig konstruktion.</p>
                <a class="nt-icon-card__link" href="/altanbygge-i-stockholm">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-triangle-exclamation"></i></div>
                <h4><a href="/jour">Jour — akut hjälp</a></h4>
                <p>Akut läckage eller elfel i din lägenhet eller villa i Solna? Vi rycker ut med kort startsträcka från kontoret.</p>
                <a class="nt-icon-card__link" href="/jour">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Varför anlita PRM Montage i Solna?</h4>
          <ul class="nt-check mb-50">
            <li><i class="fas fa-check-circle"></i><span>Fast pris innan vi sätter igång — inga överraskningar på fakturan.</span></li>
            <li><i class="fas fa-check-circle"></i><span>F-skatt och fullt försäkrade under varje uppdrag.</span></li>
            <li><i class="fas fa-check-circle"></i><span>Egna hantverkare inom bygg, VVS och el — inga underentreprenörer.</span></li>
            <li><i class="fas fa-check-circle"></i><span>Kort startsträcka — vårt kontor ligger på Industrivägen 19 i Solna.</span></li>
            <li><i class="fas fa-check-circle"></i><span>Garanti på utfört arbete.</span></li>
          </ul>

          <div class="mb-50">
            <img src="assets/img/projekt/kok-04.webp" width="900" height="675" loading="lazy" alt="Exempel på köksrenovering" class="w-100" style="border-radius:12px;aspect-ratio:16/9;height:auto;object-fit:cover;">
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om hantverkare i Solna</h4>
          <div class="accordion nt-accordion mb-45" id="faqSolna">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqSolna1">Hur begär jag en offert i Solna?</button></h2>
              <div id="faqSolna1" class="accordion-collapse collapse show" data-bs-parent="#faqSolna"><div class="accordion-body">Enklast är att ringa oss på 08-520 279 77 eller fylla i formuläret på sidan. Berätta kort vad du vill ha hjälp med så återkommer vi med en kostnadsfri offert och ett fast pris innan arbetet påbörjas.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqSolna2">Ger renoveringen rätt till ROT-avdrag?</button></h2>
              <div id="faqSolna2" class="accordion-collapse collapse" data-bs-parent="#faqSolna"><div class="accordion-body">Arbetskostnaden vid de flesta renoveringar ger normalt rätt till ROT-avdrag, medan material och produkter inte gör det. Vi hjälper dig räkna på avdraget i offerten. Läs mer på vår <a href="/rut-rot">sida om ROT-avdrag</a>.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqSolna3">Hur snabbt kan ni komma ut till Solna?</button></h2>
              <div id="faqSolna3" class="accordion-collapse collapse" data-bs-parent="#faqSolna"><div class="accordion-body">Eftersom vårt kontor ligger på Industrivägen 19 i Solna har vi normalt kort startsträcka till uppdrag i kommunen. Vid akuta ärenden erbjuder vi <a href="/jour">jour dygnet runt</a> på samma telefonnummer.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqSolna4">Behöver jag godkännande från bostadsrättsföreningen för renoveringen?</button></h2>
              <div id="faqSolna4" class="accordion-collapse collapse" data-bs-parent="#faqSolna"><div class="accordion-body">Ofta ja, särskilt vid ingrepp i VVS, el eller bärande konstruktion. Kontrollera alltid med din förening vad som gäller innan arbetet påbörjas. Vi hjälper gärna till med underlag och ritningar som kan behövas i en sådan ansökan.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="nt-side-card nt-side-card--navy" style="background:var(--nt-navy);">
            <h4 style="color:#fff;font-weight:700;margin-bottom:24px;">Kontakta oss direkt</h4>
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-phone" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">Ring oss</p><a href="tel:+46852027977" style="color:#fff;font-weight:700;font-size:1.05rem;text-decoration:none;">08-520 279 77</a></div>
            </div>
            <div style="display:flex;align-items:center;gap:14px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-envelope" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">E-post</p><a href="mailto:info@pro-montage.se" style="color:#fff;font-weight:700;text-decoration:none;">info@pro-montage.se</a></div>
            </div>
          </div>
          <div class="nt-side-card">
            <h5>Våra tjänster</h5>
            <ul class="nt-side-nav">
              <li><a href="/koksrenovering-stockholm">Köksrenovering Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/bygg-renovering">Bygg &amp; renovering <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/vvs-badrum">VVS &amp; Badrum <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/elektriker-stockholm">Elektriker Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/altanbygge-i-stockholm">Altanbygge i Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/jour">Jour — akut hjälp <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
          <div class="nt-side-card">
            <h5>Fler områden</h5>
            <ul class="nt-side-nav">
              <li><a href="/sundbyberg">Sundbyberg <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/upplands-vasby">Upplands Väsby <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/danderyd">Danderyd <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/bromma">Bromma <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/tacby">Täby <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/uppsala">Uppsala <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/lidingo">Lidingö <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/sodermalm">Södermalm <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="tp-cta-area nt-dark-band pt-120 pb-120" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container"><div class="row"><div class="col-xl-8 col-lg-10">
      <span class="nt-eyebrow nt-eyebrow-light">Redo att börja?</span>
      <h2 class="mb-15 fs-xl-40 fs-sm-36 tp-text-common-white">Hantverkare i Solna redo att hjälpa dig</h2>
      <p class="mb-40" style="color:rgba(255,255,255,0.78);font-size:1.05rem;max-width:620px;">Kontakta oss idag — fast pris, egna hantverkare, kostnadsfri offert.</p>
      <div class="d-flex flex-wrap align-items-center gap-4">
        <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500"><span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span></a>
        <a href="tel:+46852027977" class="d-inline-flex align-items-center gap-3" style="text-decoration:none;"><span style="width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;"><i class="fas fa-phone" style="color:#1FA968;"></i></span><span><span style="display:block;color:rgba(255,255,255,0.6);font-size:.8rem;">Ring oss direkt</span><span style="display:block;color:#fff;font-weight:700;font-size:1.05rem;">08-520 279 77</span></span></a>
      </div>
    </div></div></div>
  </div>
</BaseLayout>
