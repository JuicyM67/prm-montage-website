---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import SectionHeader from '../components/landing/SectionHeader.astro';
import ReviewStrip from '../components/ReviewStrip.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyOfferCard from '../components/StickyOfferCard.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "IKEA-köksmontering Södermalm — Fast pris | PRM Montage",
  "description": "IKEA-köksmontering på Södermalm till fast pris. Vi monterar ditt METOD-kök i lägenhet — enligt IKEA:s egna anvisningar. Kostnadsfri offert.",
  "canonical": "https://prmmontage.se/ikea-koksmontering-sodermalm",
  "ogDescription": "IKEA-köksmontering på Södermalm till fast pris — montering av METOD-kök enligt IKEA:s anvisningar.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/hero-kok.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "IKEA-köksmontering Södermalm"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "IKEA-köksmontering",
        "name": "IKEA-köksmontering Södermalm",
        "description": "Montering av IKEA:s METOD-köksystem på Södermalm — stommar, luckor, MAXIMERA-lådor och bänkskiva, till fast pris.",
        "provider": organization,
        "areaServed": "Södermalm",
        "url": "https://prmmontage.se/ikea-koksmontering-sodermalm"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Vad kostar IKEA-köksmontering på Södermalm?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Vi ger ett fast pris när vi sett köksritningen. Det styrs av antalet skåp, bänkskivans form och hur svårt det är att få upp delarna i trapphuset."
            }
          },
          {
            "@type": "Question",
            "name": "Är ni certifierade av IKEA?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "IKEA-certifiering har vi inte. Vi har däremot monterat METOD i många äldre lägenheter och följer tillverkarens instruktioner."
            }
          },
          {
            "@type": "Question",
            "name": "Går det att montera i lägenhet utan hiss?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. Vi planerar för trapphuset i förväg så att köksdelarna kommer upp utan att störa grannarna i onödan."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} defaultService="Köksrenovering">
  <!-- =============== BREADCRUMB =============== -->
    <section class="cv-pagehero">
    <div class="cv-container">
      <ul class="cv-crumbs"><li><a href="/">Hem</a></li></ul>
      <h1>IKEA-köksmontering på Södermalm</h1>
      <p class="cv-pagehero__lead">Montering av ditt IKEA METOD-kök — fast pris, Södermalm.</p>
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--outline-light"><i class="fas fa-phone"></i> Ring 08-520 279 77</a>
      </div>
      <div class="cv-rating cv-rating--light"><span class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span><span>4,9 på Google · 100+ omdömen</span></div>
    </div>
  </section>

  <div class="cv-pageshot-wrap"><div class="cv-container cv-pageshot"><img src="assets/img/projekt/hero-kok.webp" width="1400" height="560" alt="Kök monterat av PRM Montage i Stockholm" fetchpriority="high"></div></div>

  <ProofBar />


    <section class="cv-section">
    <div class="cv-container cv-layout">
      <article class="cv-prose">
          <span class="nt-eyebrow">Södermalm</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">IKEA-köksmontering i Södermalms lägenheter</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">IKEA:s METOD-system är ett av de vanligaste valen i Södermalms lägenheter, där kök ofta är kompakta och en effektiv planlösning gör stor skillnad i vardagen. Vi monterar METOD-kök i allt från enrumslägenheter i SoFo till större våningar kring Mariatorget och Nytorget.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">I hus från sekelskiftet är väggar och golv sällan raka, och det märks när ett METOD-kök ska hänga i våg. Därför mäter vi noga och justerar mot rummet, så att luckor och bänkskiva ändå sluter jämnt. Vi är inte en officiell IKEA-partner, men våra hantverkare har monterat många METOD-kök i äldre lägenheter och följer IKEA:s egna anvisningar för stommar, luckor, MAXIMERA-lådor, bänkskiva och sockellister.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Många fastigheter på Södermalm saknar hiss eller har smala trapphus, vilket vi planerar för redan när vi bokar in materialleveransen — så att köksdelarna kommer upp utan problem och utan att störa grannarna i onödan.</p>
          <div class="cv-btn-row cv-midcta-row">
            <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
          </div>


          <div class="row g-4 mt-10 mb-45">
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-orange);">
                <h3><i class="fas fa-file-invoice-dollar" style="color:#009828;margin-right:8px;"></i>Fast pris</h3>
                <p>Du vet vad monteringen kostar innan vi bokar tid, hur stor lägenheten än är.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-navy);">
                <h3><i class="fas fa-building" style="color:#009828;margin-right:8px;"></i>Planerat för trapphuset</h3>
                <p>Vi tar hänsyn till smala trapphus och avsaknad av hiss redan när leveransen planeras.</p>
              </div>
            </div>
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad ingår i IKEA-köksmonteringen på Södermalm?</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Köksstommar uppsatta efter IKEA:s ritning</span></li>
            <li><i class="fas fa-check-circle"></i><span>Luckor som justeras efter sneda väggar</span></li>
            <li><i class="fas fa-check-circle"></i><span>MAXIMERA-lådor med innerlådor</span></li>
            <li><i class="fas fa-check-circle"></i><span>Bänkskiva som passas in mot en ojämn vägg</span></li>
            <li><i class="fas fa-check-circle"></i><span>Sockel och avslutningslister</span></li>
            <li><i class="fas fa-check-circle"></i><span>Infästning i äldre väggar och slutkontroll</span></li>
          </ul>

          <div class="mb-45">
            <img src="assets/img/projekt/kok-05.webp" width="900" height="675" loading="lazy" alt="Monterat IKEA-kök i lägenhet på Södermalm" class="w-100" style="border-radius:12px;aspect-ratio:16/9;height:auto;object-fit:cover;">
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Så går det till</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span><strong>1. Skicka planen</strong> — köksritningen från IKEA och en kort beskrivning av trapphuset.</span></li>
            <li><i class="fas fa-check-circle"></i><span><strong>2. Offert</strong> — vi ger dig ett fast pris för monteringen.</span></li>
            <li><i class="fas fa-check-circle"></i><span><strong>3. Leverans och montering</strong> — vi samordnar när köksdelarna bärs upp och när vi monterar.</span></li>
          </ul>

          <p class="mb-45" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Köpte du köket någon annanstans? Läs om <a href="/koksmontering-sodermalm">köksmontering på Södermalm</a>. För hela ombyggnader, se <a href="/koksrenovering-stockholm">Köksrenovering Stockholm</a>. Om <a href="/rut-rot">ROT-avdraget</a> finns en egen sida.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om IKEA-köksmontering på Södermalm</h4>
          <div class="accordion nt-accordion mb-45" id="faqIkeaSod">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqIkeaSod1">Vad kostar IKEA-köksmontering på Södermalm?</button></h2>
              <div id="faqIkeaSod1" class="accordion-collapse collapse show" data-bs-parent="#faqIkeaSod"><div class="accordion-body">Vi ger ett fast pris när vi sett köksritningen. Det styrs av antalet skåp, bänkskivans form och hur svårt det är att få upp delarna i trapphuset.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqIkeaSod2">Är ni certifierade av IKEA?</button></h2>
              <div id="faqIkeaSod2" class="accordion-collapse collapse" data-bs-parent="#faqIkeaSod"><div class="accordion-body">IKEA-certifiering har vi inte. Vi har däremot monterat METOD i många äldre lägenheter och följer tillverkarens instruktioner.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqIkeaSod3">Går det att montera i lägenhet utan hiss?</button></h2>
              <div id="faqIkeaSod3" class="accordion-collapse collapse" data-bs-parent="#faqIkeaSod"><div class="accordion-body">Ja. Vi planerar för trapphuset i förväg så att köksdelarna kommer upp utan att störa grannarna i onödan.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </article>
      <aside>
        <StickyOfferCard related={[]} relatedTitle="Fler jobb" />
      </aside>
    </div>
  </section>

  <section class="cv-section cv-section--tint">
    <div class="cv-container">
      <SectionHeader pill="Omdömen" title="Det säger våra kunder" />
      <ReviewStrip count={3} offset={10} job />
    </div>
  </section>


    <FinalCta heading="IKEA-köksmontering på Södermalm redo att bokas in" />

</BaseLayout>
