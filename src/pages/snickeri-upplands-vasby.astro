---
import BaseLayout from '../layouts/BaseLayout.astro';

const seo = {
  "title": "Snickeri Upplands Väsby — Fast pris | PRM Montage",
  "description": "Snickeri i Upplands Väsby till fast pris. Platsbyggd förvaring, garderober, lister, innerdörrar och altaner av egna snickare. Kostnadsfri offert.",
  "canonical": "https://prmmontage.se/snickeri-upplands-vasby",
  "ogDescription": "Snickeri och inredningssnickeri i Upplands Väsby till fast pris — platsbyggd förvaring, lister, dörrar och altaner.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/hero-bygg.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Hantverkare i Upplands Väsby",
            "item": "https://prmmontage.se/upplands-vasby"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Snickeri Upplands Väsby"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Snickeri",
        "name": "Snickeri i Upplands Väsby",
        "description": "Snickeri och inredningssnickeri i Upplands Väsby — platsbyggda garderober, hyllor, lister, innerdörrar och altaner, till fast pris.",
        "provider": {
          "@type": "HomeAndConstructionBusiness",
          "@id": "https://prmmontage.se/#organization",
          "name": "PRM Montage",
          "legalName": "PRM MONTAGE AB",
          "url": "https://prmmontage.se/",
          "telephone": "+46852027977",
          "email": "info@pro-montage.se",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Industrivägen 19",
            "postalCode": "171 48",
            "addressLocality": "Solna",
            "addressCountry": "SE"
          },
          "priceRange": "$$"
        },
        "areaServed": "Upplands Väsby",
        "url": "https://prmmontage.se/snickeri-upplands-vasby"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Vad kostar platsbyggd inredning?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Det beror på omfattning, material och hur mycket anpassning utrymmet kräver. Ett garderobsparti längs en rak vägg går snabbare än en inbyggnad under snedtak. Vi mäter upp på plats och lämnar ett fast pris innan vi börjar."
            }
          },
          {
            "@type": "Question",
            "name": "Bygger ni efter min ritning eller tar ni fram förslaget?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Båda fungerar. Har du en ritning från arkitekt eller inredare bygger vi efter den. Har du bara en idé kommer vi ut, mäter upp och föreslår utförande, material och mått innan vi lämnar offert."
            }
          },
          {
            "@type": "Question",
            "name": "Kan ni ta el och VVS i samma snickeriprojekt?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. Vi har egna behöriga elektriker och VVS-montörer, så belysning i garderobspartiet eller vatten till den platsbyggda tvättstugan löser vi i samma projekt — utan att du behöver boka in fler firmor."
            }
          },
          {
            "@type": "Question",
            "name": "Ger snickeriarbete rätt till ROT-avdrag?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Arbetskostnaden för snickeri som utförs i bostaden ger normalt rätt till ROT-avdrag, medan material inte gör det. Inredning som byggs färdigt i verkstad och bara ställs på plats räknas inte alltid som ROT-berättigat — vi reder ut vad som gäller i offerten."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="tjanster" defaultService="VVS & Badrum">
  <!-- =============== BREADCRUMB =============== -->
  <div class="tp-breadcrumb-area tp-breadcrumb-spacing nt-dark-band pt-180 pb-90" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container">
      <div class="row"><div class="col-xl-8 col-lg-9">
        <div class="tp-breadcrumb-content">
          <h1 class="tp-breadcrumb-title fw-600 fs-60 fs-xs-40 ls-m-3 tp-text-common-white lh-1 mb-20">Snickeri i Upplands Väsby</h1>
          <p style="color:rgba(255,255,255,.78);font-size:1.02rem;max-width:620px;margin-bottom:18px;">Platsbyggd förvaring, lister, innerdörrar och altaner — utfört av egna snickare till fast pris.</p>
          <div class="tp-breadcrumb-dvdr"><ul><li><a href="/">Hem</a></li><li class="dvdr">/</li><li><a href="/upplands-vasby">Upplands Väsby</a></li><li class="dvdr">/</li><li>Snickeri Upplands Väsby</li></ul></div>
        </div>
      </div></div>
    </div>
  </div>

  <div class="tp-service-details-thumb pt-80" style="background:var(--nt-white);">
    <div class="container">
      <div class="nt-media wow img-custom-anim-top" data-wow-duration="1.5s" data-wow-delay="0.2s" style="height:360px;">
        <img src="assets/img/projekt/hero-bygg.webp" width="1400" height="560" alt="Snickeriarbete utfört av PRM Montage i Upplands Väsby" style="width:100%;height:100%;object-fit:cover;">
      </div>
    </div>
  </div>

  <div class="tp-service-details-area pt-70 pb-120" style="background:var(--nt-white);">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8">
          <span class="nt-eyebrow">Upplands Väsby</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Snickeri och inredningssnickeri i Upplands Väsby</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">PRM Montage utför snickeri och inredningssnickeri i hela Upplands Väsby — platsbyggd förvaring, garderober, hyllor, lister och foder, innerdörrar, panel och altaner. Vi har egna snickare och lämnar ett fast pris innan arbetet påbörjas.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">I kommunens villa- och radhusområden — Runby, Bollstanäs, Odenslunda, Vilunda — är det ofta förvaring som saknas: en hall som behöver en riktig garderobslösning, ett sovrum med snedtak som ingen färdig möbel passar i, eller en tvättstuga som skulle fungera betydligt bättre med en platsbyggd bänk. I lägenheterna kring Väsby centrum och Smedby handlar det oftare om att byta lister, foder och innerdörrar när resten av bostaden fräschas upp.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Vi mäter upp på plats, föreslår utförande och material, och bygger sedan in lösningen så att den ser ut att ha hört till huset från början.</p>
          <div class="row g-4 mt-10 mb-45">
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-orange);">
                <h5><i class="fas fa-ruler-combined" style="color:#1FA968;margin-right:8px;"></i>Måttbyggt på plats</h5>
                <p>Anpassat efter sneda väggar, snedtak och nischer — inte efter standardmått.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-navy);">
                <h5><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Fast pris på snickeriet</h5>
                <p>Tydlig prisbild på arbete och material innan vi sätter igång.</p>
              </div>
            </div>
          </div>
          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Snickerijobb vi tar oss an</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Platsbyggda garderober, klädkammare och hallförvaring</span></li>
            <li><i class="fas fa-check-circle"></i><span>Bokhyllor och inbyggd förvaring kring nischer och snedtak</span></li>
            <li><i class="fas fa-check-circle"></i><span>Inredningssnickeri i kök — hyllor, bänkskivor, luckor och passbitar</span></li>
            <li><i class="fas fa-check-circle"></i><span>Byte av innerdörrar, lister, foder och socklar</span></li>
            <li><i class="fas fa-check-circle"></i><span>Panel, bröstpanel och akustikpaneler</span></li>
            <li><i class="fas fa-check-circle"></i><span>Platsbyggd tvättstuga med bänk och förvaring</span></li>
            <li><i class="fas fa-check-circle"></i><span>Altan, trallgolv, räcken och utvändigt trä</span></li>
          </ul>
          <div class="mb-45">
            <img src="assets/img/projekt/bygg-04.webp" width="900" height="675" loading="lazy" alt="Snickeri och platsbyggd inredning utfört av PRM Montage" class="w-100" style="border-radius:12px;aspect-ratio:16/9;height:auto;object-fit:cover;">
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Snickeri som en del av något större</h4>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Ska planlösningen ändras, en vägg flyttas eller hela bostaden fräschas upp är <a href="/bygg-renovering">bygg &amp; renovering</a> rätt ingång. Gäller det köket tar vi det som <a href="/koksrenovering-stockholm">köksrenovering</a>, eller som ren <a href="/koksmontering-upplands-vasby">köksmontering</a> om köket redan är köpt. Ska en altan byggas hittar du mer under <a href="/altanbygge-i-stockholm">altanbygge</a>.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Se allt vi gör i kommunen på sidan <a href="/upplands-vasby">hantverkare i Upplands Väsby</a>.</p>
          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om snickeri i Upplands Väsby</h4>
<div class="accordion nt-accordion mb-45" id="faqSnickeriUV">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqSnickeriUV1">Vad kostar platsbyggd inredning?</button></h2>
              <div id="faqSnickeriUV1" class="accordion-collapse collapse show" data-bs-parent="#faqSnickeriUV"><div class="accordion-body">Det beror på omfattning, material och hur mycket anpassning utrymmet kräver. Ett garderobsparti längs en rak vägg går snabbare än en inbyggnad under snedtak. Vi mäter upp på plats och lämnar ett fast pris innan vi börjar.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqSnickeriUV2">Bygger ni efter min ritning eller tar ni fram förslaget?</button></h2>
              <div id="faqSnickeriUV2" class="accordion-collapse collapse" data-bs-parent="#faqSnickeriUV"><div class="accordion-body">Båda fungerar. Har du en ritning från arkitekt eller inredare bygger vi efter den. Har du bara en idé kommer vi ut, mäter upp och föreslår utförande, material och mått innan vi lämnar offert.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqSnickeriUV3">Kan ni ta el och VVS i samma snickeriprojekt?</button></h2>
              <div id="faqSnickeriUV3" class="accordion-collapse collapse" data-bs-parent="#faqSnickeriUV"><div class="accordion-body">Ja. Vi har egna behöriga <a href="/elektriker-stockholm">elektriker</a> och <a href="/rormokare-upplands-vasby">VVS-montörer</a>, så belysning i garderobspartiet eller vatten till den platsbyggda tvättstugan löser vi i samma projekt — utan att du behöver boka in fler firmor.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqSnickeriUV4">Ger snickeriarbete rätt till ROT-avdrag?</button></h2>
              <div id="faqSnickeriUV4" class="accordion-collapse collapse" data-bs-parent="#faqSnickeriUV"><div class="accordion-body">Arbetskostnaden för snickeri som utförs i bostaden ger normalt rätt till ROT-avdrag, medan material inte gör det. Inredning som byggs färdigt i verkstad och bara ställs på plats räknas inte alltid som ROT-berättigat — vi reder ut vad som gäller i offerten. Läs mer på vår <a href="/rut-rot">sida om ROT-avdrag</a>.</div></div>
            </div>
          </div>
          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="nt-side-card nt-side-card--navy" style="background:var(--nt-navy);">
            <h4 style="color:#fff;font-weight:700;margin-bottom:24px;">Kontakta oss direkt</h4>
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-phone" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">Ring oss</p><a href="tel:+46852027977" style="color:#fff;font-weight:700;font-size:1.05rem;text-decoration:none;">08-520 279 77</a></div>
            </div>
            <div style="display:flex;align-items:center;gap:14px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-envelope" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">E-post</p><a href="mailto:info@pro-montage.se" style="color:#fff;font-weight:700;text-decoration:none;">info@pro-montage.se</a></div>
            </div>
          </div>
          <div class="nt-side-card">
            <h5>Varför PRM Montage?</h5>
            <ul class="nt-check" style="margin:0;"><li><i class="fas fa-check"></i><span>Fast pris, alltid</span></li><li><i class="fas fa-check"></i><span>F-skatt &amp; försäkrade</span></li><li><i class="fas fa-check"></i><span>Egna hantverkare</span></li><li><i class="fas fa-check"></i><span>Garanti på arbetet</span></li></ul>
          </div>
          <div class="nt-side-card">
            <h5>I Upplands Väsby</h5>
            <ul class="nt-side-nav">
              <li><a href="/upplands-vasby">Hantverkare i Upplands Väsby <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/rormokare-upplands-vasby">Rörmokare Upplands Väsby <i class="fas fa-arrow-right"></i></a></li>
              <li class="is-active"><a href="/snickeri-upplands-vasby">Snickeri Upplands Väsby <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/koksmontering-upplands-vasby">Köksmontering Upplands Väsby <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/ikea-koksmontering-upplands-vasby">IKEA-köksmontering Upplands Väsby <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
          <div class="nt-side-card">
            <h5>Alla tjänster</h5>
            <ul class="nt-side-nav">
              <li><a href="/koksrenovering-stockholm">Köksrenovering Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li class="is-active"><a href="/bygg-renovering">Bygg &amp; renovering <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/vvs-badrum">VVS &amp; Badrum <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/elektriker-stockholm">Elektriker Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/altanbygge-i-stockholm">Altanbygge i Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/jour">Jour — akut hjälp <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
          <div class="nt-side-card">
            <h5>Relaterat</h5>
            <ul class="nt-side-nav">
              <li><a href="/snickeri-stockholm">Snickeri Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/bygg-renovering">Bygg &amp; renovering <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/altanbygge-i-stockholm">Altanbygge i Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/montera-tv-pa-vagg">Montera TV på vägg <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="tp-cta-area nt-dark-band pt-120 pb-120" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container"><div class="row"><div class="col-xl-8 col-lg-10">
      <span class="nt-eyebrow nt-eyebrow-light">Redo att börja?</span>
      <h2 class="mb-15 fs-xl-40 fs-sm-36 tp-text-common-white">Ett snickerijobb i Upplands Väsby?</h2>
      <p class="mb-40" style="color:rgba(255,255,255,0.78);font-size:1.05rem;max-width:620px;">Kontakta oss idag — fast pris, egna hantverkare, kostnadsfri offert.</p>
      <div class="d-flex flex-wrap align-items-center gap-4">
        <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500"><span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span></a>
        <a href="tel:+46852027977" class="d-inline-flex align-items-center gap-3" style="text-decoration:none;"><span style="width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;"><i class="fas fa-phone" style="color:#1FA968;"></i></span><span><span style="display:block;color:rgba(255,255,255,0.6);font-size:.8rem;">Ring oss direkt</span><span style="display:block;color:#fff;font-weight:700;font-size:1.05rem;">08-520 279 77</span></span></a>
      </div>
    </div></div></div>
  </div>
</BaseLayout>
