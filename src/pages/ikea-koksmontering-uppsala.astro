---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import SectionHeader from '../components/landing/SectionHeader.astro';
import ReviewStrip from '../components/ReviewStrip.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyOfferCard from '../components/StickyOfferCard.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "IKEA-köksmontering Uppsala — Fast pris | PRM Montage",
  "description": "IKEA-köksmontering i Uppsala till fast pris. Vi monterar ditt METOD-kök i villa eller lägenhet — enligt IKEA:s egna anvisningar. Kostnadsfri offert.",
  "canonical": "https://prmmontage.se/ikea-koksmontering-uppsala",
  "ogDescription": "IKEA-köksmontering i Uppsala till fast pris — montering av METOD-kök enligt IKEA:s anvisningar.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/hero-kok.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "IKEA-köksmontering Uppsala"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "IKEA-köksmontering",
        "name": "IKEA-köksmontering Uppsala",
        "description": "Montering av IKEA:s METOD-köksystem i Uppsala — stommar, luckor, MAXIMERA-lådor och bänkskiva, till fast pris.",
        "provider": organization,
        "areaServed": "Uppsala",
        "url": "https://prmmontage.se/ikea-koksmontering-uppsala"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Vad kostar IKEA-köksmontering i Uppsala?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Priset är fast och sätts efter att vi sett köksritningen, med hänsyn till skåp, lådor och bänkskiva. Offerten är gratis."
            }
          },
          {
            "@type": "Question",
            "name": "Är ni certifierade av IKEA?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Någon certifiering från IKEA har vi inte, men våra hantverkare har många METOD-monteringar bakom sig."
            }
          },
          {
            "@type": "Question",
            "name": "Hur bokar ni in monteringen i Uppsala?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Uppsala ligger drygt sju mil från Solna, så vi planerar besöket i förväg. Eftersom kök levereras med ledtid hinner vi hitta en tid som passar."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} defaultService="Köksrenovering">
  <!-- =============== BREADCRUMB =============== -->
    <section class="cv-pagehero">
    <div class="cv-container">
      <ul class="cv-crumbs"><li><a href="/">Hem</a></li></ul>
      <h1>IKEA-köksmontering i Uppsala</h1>
      <p class="cv-pagehero__lead">Montering av ditt IKEA METOD-kök — fast pris, Uppsala.</p>
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--outline-light"><i class="fas fa-phone"></i> Ring 08-520 279 77</a>
      </div>
      <div class="cv-rating cv-rating--light"><span class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span><span>4,9 på Google · 100+ omdömen</span></div>
    </div>
  </section>

  <div class="cv-pageshot-wrap"><div class="cv-container cv-pageshot"><img src="assets/img/projekt/hero-kok.webp" width="1400" height="560" alt="Kök monterat av PRM Montage i Stockholm" fetchpriority="high"></div></div>

  <ProofBar />


    <section class="cv-section">
    <div class="cv-container cv-layout">
      <article class="cv-prose">
          <span class="nt-eyebrow">Uppsala</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">IKEA-köksmontering i Uppsala — student­lägenheter och villor</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Som universitetsstad har Uppsala ovanligt många mindre lägenheter, där IKEA:s METOD-system är ett vanligt och kostnadseffektivt val vid nyinflytt eller renovering. Samtidigt möter vi också villaägare i områden som Sunnersta och Norby som väljer METOD för ett sekundärt kök eller som en del av en större renovering där pengarna i övrigt läggs på annat.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Uppsala ligger drygt sju mil från vårt kontor i Solna, så vi planerar monteringen i förväg i stället för att komma ut samma dag. Eftersom kök beställs med ledtid brukar det gå bra att hitta en tid som passar. Vi monterar efter IKEA:s anvisningar, med stommar, luckor, MAXIMERA-lådor, bänkskiva och sockellister, men är inte någon officiell IKEA-partner. Vår erfarenhet kommer från många genomförda METOD-monteringar.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">I äldre fastigheter i till exempel Fålhagen och Luthagen är väggar och golv sällan helt raka, vilket ställer högre krav på noggrannhet vid infästning och justering. Vi har god vana vid den typen av anpassningar, och lämnar alltid ett fast pris baserat på förutsättningarna i just din bostad.</p>
          <div class="cv-btn-row cv-midcta-row">
            <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
          </div>


          <div class="row g-4 mt-10 mb-45">
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-orange);">
                <h3><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Fast pris</h3>
                <p>Fast pris innan vi bokar monteringen, oavsett om det är en studentlägenhet eller ett villakök.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-navy);">
                <h3><i class="fas fa-route" style="color:#1FA968;margin-right:8px;"></i>Planerat i förväg</h3>
                <p>Vi lägger in resan i vår planering och hittar en tid som följer kökets leverans.</p>
              </div>
            </div>
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad ingår i IKEA-köksmonteringen i Uppsala?</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Köksstommar som monteras och fästs efter din planlösning</span></li>
            <li><i class="fas fa-check-circle"></i><span>Fronter och luckor som riktas in</span></li>
            <li><i class="fas fa-check-circle"></i><span>Lådor med MAXIMERA-system</span></li>
            <li><i class="fas fa-check-circle"></i><span>Bänkskivan kapas och sätts på plats</span></li>
            <li><i class="fas fa-check-circle"></i><span>Sockellister och passbitar</span></li>
            <li><i class="fas fa-check-circle"></i><span>Fast infästning i väggen och en sista kontroll</span></li>
          </ul>

          <div class="mb-45">
            <img src="assets/img/projekt/kok-05.webp" width="900" height="675" loading="lazy" alt="Monterat IKEA-kök i Uppsala" class="w-100" style="border-radius:12px;aspect-ratio:16/9;height:auto;object-fit:cover;">
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Så går det till</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span><strong>1. Skicka planlösningen</strong> — din ritning från IKEA, via kontaktformuläret.</span></li>
            <li><i class="fas fa-check-circle"></i><span><strong>2. Fast pris</strong> — kostnadsfri offert utifrån din bostad.</span></li>
            <li><i class="fas fa-check-circle"></i><span><strong>3. Boka monteringen</strong> — vi planerar den i förväg, i takt med leveransen.</span></li>
          </ul>

          <p class="mb-45" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Köpte du köket annorstädes? Se <a href="/koksmontering-uppsala">köksmontering i Uppsala</a>. För större renoveringar, läs <a href="/koksrenovering-stockholm">Köksrenovering Stockholm</a>. <a href="/rut-rot">ROT-avdraget</a> förklaras på en egen sida.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om IKEA-köksmontering i Uppsala</h4>
          <div class="accordion nt-accordion mb-45" id="faqIkeaUpp">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqIkeaUpp1">Vad kostar IKEA-köksmontering i Uppsala?</button></h2>
              <div id="faqIkeaUpp1" class="accordion-collapse collapse show" data-bs-parent="#faqIkeaUpp"><div class="accordion-body">Priset är fast och sätts efter att vi sett köksritningen, med hänsyn till skåp, lådor och bänkskiva. Offerten är gratis.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqIkeaUpp2">Är ni certifierade av IKEA?</button></h2>
              <div id="faqIkeaUpp2" class="accordion-collapse collapse" data-bs-parent="#faqIkeaUpp"><div class="accordion-body">Någon certifiering från IKEA har vi inte, men våra hantverkare har många METOD-monteringar bakom sig.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqIkeaUpp3">Hur bokar ni in monteringen i Uppsala?</button></h2>
              <div id="faqIkeaUpp3" class="accordion-collapse collapse" data-bs-parent="#faqIkeaUpp"><div class="accordion-body">Uppsala ligger drygt sju mil från Solna, så vi planerar besöket i förväg. Eftersom kök levereras med ledtid hinner vi hitta en tid som passar.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </article>
      <aside>
        <StickyOfferCard related={[]} relatedTitle="Fler jobb" />
      </aside>
    </div>
  </section>

  <section class="cv-section cv-section--tint">
    <div class="cv-container">
      <SectionHeader pill="Omdömen" title="Det säger våra kunder" />
      <ReviewStrip count={3} offset={12} job />
    </div>
  </section>


    <FinalCta heading="IKEA-köksmontering i Uppsala redo att bokas in" />

</BaseLayout>
