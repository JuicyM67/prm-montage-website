---
import BaseLayout from '../layouts/BaseLayout.astro';

const seo = {
  "title": "IKEA-köksmontering Uppsala — Fast pris | PRM Montage",
  "description": "IKEA-köksmontering i Uppsala till fast pris. Vi monterar ditt METOD-kök i villa eller lägenhet — enligt IKEA:s egna anvisningar. Kostnadsfri offert.",
  "canonical": "https://prmmontage.se/ikea-koksmontering-uppsala",
  "ogDescription": "IKEA-köksmontering i Uppsala till fast pris — montering av METOD-kök enligt IKEA:s anvisningar.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/hero-kok.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "IKEA-köksmontering Uppsala"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "IKEA-köksmontering",
        "name": "IKEA-köksmontering Uppsala",
        "description": "Montering av IKEA:s METOD-köksystem i Uppsala — stommar, luckor, MAXIMERA-lådor och bänkskiva, till fast pris.",
        "provider": {
          "@type": "HomeAndConstructionBusiness",
          "@id": "https://prmmontage.se/#organization",
          "name": "PRM Montage",
          "legalName": "PRM MONTAGE AB",
          "url": "https://prmmontage.se/",
          "telephone": "+46852027977",
          "email": "info@pro-montage.se",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Industrivägen 19",
            "postalCode": "171 48",
            "addressLocality": "Solna",
            "addressCountry": "SE"
          },
          "priceRange": "$$"
        },
        "areaServed": "Uppsala",
        "url": "https://prmmontage.se/ikea-koksmontering-uppsala"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Vad kostar IKEA-köksmontering i Uppsala?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Priset är fast och beror på kökets storlek — antal skåp, luckor och lådor samt om bänkskivan behöver kapas och anpassas. Du får alltid en kostnadsfri offert med fast pris innan vi bokar in monteringen."
            }
          },
          {
            "@type": "Question",
            "name": "Är ni certifierade av IKEA?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Vi är inte en officiell IKEA-partner, men våra hantverkare har gedigen erfarenhet av att montera IKEA:s METOD-kök enligt IKEA:s egna monteringsanvisningar."
            }
          },
          {
            "@type": "Question",
            "name": "Hur snabbt kan montering bokas i Uppsala?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Uppsala ligger drygt sju mil från vårt kontor i Solna, så vi planerar in monteringen i förväg. Hör av dig så ger vi en aktuell bild av läget."
            }
          },
          {
            "@type": "Question",
            "name": "Ger IKEA-köksmontering rätt till ROT-avdrag?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Arbetskostnaden för monteringen ger normalt rätt till ROT-avdrag, medan själva IKEA-köket och materialet inte gör det. Vi hjälper dig räkna på avdraget i offerten."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} defaultService="Köksrenovering">
  <!-- =============== BREADCRUMB =============== -->
  <div class="tp-breadcrumb-area tp-breadcrumb-spacing nt-dark-band pt-180 pb-90" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container">
      <div class="row"><div class="col-xl-8 col-lg-9">
        <div class="tp-breadcrumb-content">
          <h1 class="tp-breadcrumb-title fw-600 fs-60 fs-xs-40 ls-m-3 tp-text-common-white lh-1 mb-20">IKEA-köksmontering i Uppsala</h1>
          <p style="color:rgba(255,255,255,.78);font-size:1.02rem;max-width:620px;margin-bottom:18px;">Montering av ditt IKEA METOD-kök — fast pris, Uppsala.</p>
          <div class="tp-breadcrumb-dvdr"><ul><li><a href="/">Hem</a></li><li class="dvdr">/</li><li>IKEA-köksmontering Uppsala</li></ul></div>
        </div>
      </div></div>
    </div>
  </div>

  <div class="tp-service-details-area pt-100 pb-120" style="background:var(--nt-white);">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8">
          <span class="nt-eyebrow">Uppsala</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">IKEA-köksmontering i Uppsala — student­lägenheter och villor</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Som universitetsstad har Uppsala ovanligt många mindre lägenheter, där IKEA:s METOD-system är ett vanligt och kostnadseffektivt val vid nyinflytt eller renovering. Samtidigt möter vi också villaägare i områden som Sunnersta och Norby som väljer METOD för ett sekundärt kök eller som en del av en större renovering där pengarna i övrigt läggs på annat.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Uppsala ligger drygt sju mil från vårt kontor i Solna, vilket gör att vi planerar in monteringen i förväg snarare än att komma ut samma dag. I praktiken passar det bra ihop med hur köksmontering fungerar — kök beställs med ledtid oavsett, vilket ger oss tid att boka in ett besök som passar din tidsplan. Vi monterar enligt IKEA:s egna anvisningar — stommar, luckor, MAXIMERA-lådor, bänkskiva och sockellister — men vill vara tydliga med att vi inte är en officiell IKEA-partner eller certifierade av IKEA. Vår kompetens bygger på erfarenhet från många genomförda monteringar.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">I äldre fastigheter i till exempel Fålhagen och Luthagen är väggar och golv sällan helt raka, vilket ställer högre krav på noggrannhet vid infästning och justering. Vi har god vana vid den typen av anpassningar, och lämnar alltid ett fast pris baserat på förutsättningarna i just din bostad.</p>

          <div class="row g-4 mt-10 mb-45">
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-orange);">
                <h5><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Fast pris</h5>
                <p>Fast pris innan vi sätter igång — oavsett om det gäller en studentlägenhet eller ett villakök.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-navy);">
                <h5><i class="fas fa-route" style="color:#1FA968;margin-right:8px;"></i>Planerat besök</h5>
                <p>Vi bokar in monteringen i god tid, inplanerad specifikt för din resa till Uppsala.</p>
              </div>
            </div>
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad ingår i IKEA-köksmonteringen i Uppsala?</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Montering av köksstommar enligt IKEA:s ritning</span></li>
            <li><i class="fas fa-check-circle"></i><span>Montering av luckor och lådfronter</span></li>
            <li><i class="fas fa-check-circle"></i><span>Montering av MAXIMERA-lådor och innerlådor</span></li>
            <li><i class="fas fa-check-circle"></i><span>Kapning och montering av bänkskiva</span></li>
            <li><i class="fas fa-check-circle"></i><span>Sockellister och avslutande lister</span></li>
            <li><i class="fas fa-check-circle"></i><span>Säker infästning i vägg samt slutlig justering</span></li>
          </ul>

          <div class="mb-45">
            <img src="assets/img/projekt/kok-05.webp" width="900" height="675" loading="lazy" alt="Monterat IKEA-kök i Uppsala" class="w-100" style="border-radius:12px;aspect-ratio:16/9;height:auto;object-fit:cover;">
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Så går det till</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span><strong>1. Skicka in din ritning</strong> — din planlösning eller köksritning från IKEA.</span></li>
            <li><i class="fas fa-check-circle"></i><span><strong>2. Kostnadsfri offert</strong> — fast pris anpassat efter förutsättningarna i din bostad.</span></li>
            <li><i class="fas fa-check-circle"></i><span><strong>3. Montering bokas in</strong> — planerad i god tid, utförd av våra hantverkare.</span></li>
          </ul>

          <p class="mb-45" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Har du köpt kök från en annan leverantör? Se vår sida om <a href="/koksmontering-uppsala">köksmontering i Uppsala</a>. Behöver du en större renovering — med VVS, el eller rivning — se vår <a href="/koksrenovering-stockholm">Köksrenovering Stockholm</a>-sida.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om IKEA-köksmontering i Uppsala</h4>
          <div class="accordion nt-accordion mb-45" id="faqIkeaUpp">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqIkeaUpp1">Vad kostar IKEA-köksmontering i Uppsala?</button></h2>
              <div id="faqIkeaUpp1" class="accordion-collapse collapse show" data-bs-parent="#faqIkeaUpp"><div class="accordion-body">Priset är fast och beror på kökets storlek — antal skåp, luckor och lådor samt om bänkskivan behöver kapas och anpassas. Du får alltid en kostnadsfri offert med fast pris innan vi bokar in monteringen.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqIkeaUpp2">Är ni certifierade av IKEA?</button></h2>
              <div id="faqIkeaUpp2" class="accordion-collapse collapse" data-bs-parent="#faqIkeaUpp"><div class="accordion-body">Vi är inte en officiell IKEA-partner, men våra hantverkare har gedigen erfarenhet av att montera IKEA:s METOD-kök enligt IKEA:s egna monteringsanvisningar.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqIkeaUpp3">Hur snabbt kan montering bokas i Uppsala?</button></h2>
              <div id="faqIkeaUpp3" class="accordion-collapse collapse" data-bs-parent="#faqIkeaUpp"><div class="accordion-body">Uppsala ligger drygt sju mil från vårt kontor i Solna, så vi planerar in monteringen i förväg. Hör av dig så ger vi en aktuell bild av läget.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqIkeaUpp4">Ger IKEA-köksmontering rätt till ROT-avdrag?</button></h2>
              <div id="faqIkeaUpp4" class="accordion-collapse collapse" data-bs-parent="#faqIkeaUpp"><div class="accordion-body">Arbetskostnaden för monteringen ger normalt rätt till ROT-avdrag, medan själva IKEA-köket och materialet inte gör det. Läs mer på vår <a href="/rut-rot">sida om ROT-avdrag</a>.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="nt-side-card nt-side-card--navy" style="background:var(--nt-navy);">
            <h4 style="color:#fff;font-weight:700;margin-bottom:24px;">Kontakta oss direkt</h4>
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-phone" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">Ring oss</p><a href="tel:+46852027977" style="color:#fff;font-weight:700;font-size:1.05rem;text-decoration:none;">08-520 279 77</a></div>
            </div>
            <div style="display:flex;align-items:center;gap:14px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-envelope" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">E-post</p><a href="mailto:info@pro-montage.se" style="color:#fff;font-weight:700;text-decoration:none;">info@pro-montage.se</a></div>
            </div>
          </div>
          <div class="nt-side-card">
            <h5>Relaterat</h5>
            <ul class="nt-side-nav">
              <li><a href="/koksmontering-uppsala">Köksmontering Uppsala <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/koksrenovering-stockholm">Köksrenovering Stockholm <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
          <div class="nt-side-card">
            <h5>Fler områden</h5>
            <ul class="nt-side-nav">
              <li><a href="/ikea-koksmontering-solna">IKEA-köksmontering Solna <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/ikea-koksmontering-sundbyberg">IKEA-köksmontering Sundbyberg <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/ikea-koksmontering-upplands-vasby">IKEA-köksmontering Upplands Väsby <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/ikea-koksmontering-danderyd">IKEA-köksmontering Danderyd <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/ikea-koksmontering-bromma">IKEA-köksmontering Bromma <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/ikea-koksmontering-tacby">IKEA-köksmontering Täby <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/uppsala">Om Uppsala <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="tp-cta-area nt-dark-band pt-120 pb-120" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container"><div class="row"><div class="col-xl-8 col-lg-10">
      <span class="nt-eyebrow nt-eyebrow-light">Redo att börja?</span>
      <h2 class="mb-15 fs-xl-40 fs-sm-36 tp-text-common-white">IKEA-köksmontering i Uppsala redo att bokas in</h2>
      <p class="mb-40" style="color:rgba(255,255,255,0.78);font-size:1.05rem;max-width:620px;">Kontakta oss idag — fast pris, egna hantverkare, kostnadsfri offert.</p>
      <div class="d-flex flex-wrap align-items-center gap-4">
        <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500"><span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span></a>
        <a href="tel:+46852027977" class="d-inline-flex align-items-center gap-3" style="text-decoration:none;"><span style="width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;"><i class="fas fa-phone" style="color:#1FA968;"></i></span><span><span style="display:block;color:rgba(255,255,255,0.6);font-size:.8rem;">Ring oss direkt</span><span style="display:block;color:#fff;font-weight:700;font-size:1.05rem;">08-520 279 77</span></span></a>
      </div>
    </div></div></div>
  </div>
</BaseLayout>
