---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import FinalCta from '../components/FinalCta.astro';

const seo = {
  "title": "Våra projekt — Referensgalleri | PRM Montage",
  "description": "Se ett urval av PRM Montages genomförda projekt inom kök, VVS och badrum samt bygg och snickeri i Stockholmsområdet — utförda till fast pris.",
  "canonical": "https://prmmontage.se/projekt",
  "ogDescription": "Se ett urval av PRM Montages genomförda projekt inom kök, VVS & badrum samt bygg & snickeri.",
  "ogImage": "https://prmmontage.se/assets/img/brand/og-default.jpg",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Projekt"
          }
        ]
      },
      {
        "@type": "CollectionPage",
        "url": "https://prmmontage.se/projekt",
        "name": "Våra projekt",
        "about": {
          "@type": "HomeAndConstructionBusiness",
          "@id": "https://prmmontage.se/#organization",
          "name": "PRM Montage",
          "legalName": "PRM MONTAGE AB",
          "url": "https://prmmontage.se/",
          "telephone": "+46852027977",
          "email": "info@pro-montage.se",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Industrivägen 19",
            "postalCode": "171 48",
            "addressLocality": "Solna",
            "addressCountry": "SE"
          },
          "priceRange": "$$"
        }
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="projekt">
  <!-- =============== BREADCRUMB =============== -->
    <section class="cv-pagehero">
    <div class="cv-container">
      <ul class="cv-crumbs"><li><a href="/">Hem</a></li></ul>
      <h1>Våra projekt</h1>
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--outline-light"><i class="fas fa-phone"></i> Ring 08-520 279 77</a>
      </div>
    </div>
  </section>

  <ProofBar />

  <!-- =============== /BREADCRUMB =============== -->

  <!-- =============== GALLERI =============== -->
  <div class="pt-100 pb-120" style="background:var(--nt-white);">
    <div class="container">
      <div class="row justify-content-center mb-40">
        <div class="col-xl-8 text-center">
          <p style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Ett urval av jobb vi genomfört i Solna, Sundbyberg och övriga Stockholmsområdet — kök, badrum, VVS, bygg och snickeri. Filtrera galleriet nedan för att se exempel inom respektive område.</p>
        </div>
      </div>

      <div class="nt-gallery-filter">
        <button type="button" class="is-active" data-filter="all">Alla</button>
        <button type="button" data-filter="kok">Kök</button>
        <button type="button" data-filter="badrum">VVS &amp; Badrum</button>
        <button type="button" data-filter="bygg">Bygg &amp; snickeri</button>
      </div>

      <div class="nt-gallery-grid">
        <a class="nt-gallery-item" data-category="kok" href="#"><img src="assets/img/projekt/kok-02.webp" width="900" height="675" loading="lazy" alt="Köksrenovering med integrerade vitvaror, Solna"><span>Köksrenovering</span></a>
        <a class="nt-gallery-item" data-category="kok" href="#"><img src="assets/img/projekt/kok-03.webp" width="900" height="675" loading="lazy" alt="Nytt kök med bänkskiva i sten"><span>Köksrenovering</span></a>
        <a class="nt-gallery-item" data-category="kok" href="#"><img src="assets/img/projekt/kok-04.webp" width="900" height="675" loading="lazy" alt="Kök med köksfläkt och öppen planlösning"><span>Köksrenovering</span></a>
        <a class="nt-gallery-item" data-category="kok" href="#"><img src="assets/img/projekt/kok-05.webp" width="900" height="675" loading="lazy" alt="Kök med diskho och blandare i rostfritt"><span>Köksrenovering</span></a>

        <a class="nt-gallery-item" data-category="badrum" href="#"><img src="assets/img/projekt/badrum-01.webp" width="900" height="675" loading="lazy" alt="Badrumsrenovering med kakel från golv till tak"><span>VVS &amp; Badrum</span></a>
        <a class="nt-gallery-item" data-category="badrum" href="#"><img src="assets/img/projekt/badrum-02.webp" width="900" height="675" loading="lazy" alt="Nyrenoverat badrum med golvvärme"><span>VVS &amp; Badrum</span></a>
        <a class="nt-gallery-item" data-category="badrum" href="#"><img src="assets/img/projekt/badrum-03.webp" width="900" height="675" loading="lazy" alt="Duschvägg i glas, badrumsrenovering Stockholm"><span>VVS &amp; Badrum</span></a>
        <a class="nt-gallery-item" data-category="badrum" href="#"><img src="assets/img/projekt/badrum-04.webp" width="900" height="675" loading="lazy" alt="Dusch med regnmunstycke, badrumsrenovering"><span>VVS &amp; Badrum</span></a>
        <a class="nt-gallery-item" data-category="badrum" href="#"><img src="assets/img/projekt/badrum-05.webp" width="900" height="675" loading="lazy" alt="Badrum med fristående badkar"><span>VVS &amp; Badrum</span></a>
        <a class="nt-gallery-item" data-category="badrum" href="#"><img src="assets/img/projekt/badrum-06.webp" width="900" height="675" loading="lazy" alt="Handfat och blandare i modernt badrum"><span>VVS &amp; Badrum</span></a>
        <a class="nt-gallery-item" data-category="badrum" href="#"><img src="assets/img/projekt/badrum-07.webp" width="900" height="675" loading="lazy" alt="Våtrumsrenovering med klinker"><span>VVS &amp; Badrum</span></a>
        <a class="nt-gallery-item" data-category="badrum" href="#"><img src="assets/img/projekt/badrum-08.webp" width="900" height="675" loading="lazy" alt="Duschblandare i mässing, badrumsrenovering"><span>VVS &amp; Badrum</span></a>
        <a class="nt-gallery-item" data-category="badrum" href="#"><img src="assets/img/projekt/badrum-09.webp" width="900" height="675" loading="lazy" alt="Badrum med kakel i mörk kulör"><span>VVS &amp; Badrum</span></a>
        <a class="nt-gallery-item" data-category="badrum" href="#"><img src="assets/img/projekt/badrum-10.webp" width="900" height="675" loading="lazy" alt="Helrenoverat badrum, Solna"><span>VVS &amp; Badrum</span></a>
        <a class="nt-gallery-item" data-category="badrum" href="#"><img src="assets/img/projekt/badrum-11.webp" width="900" height="675" loading="lazy" alt="Toalett och handfat, ny VVS-installation"><span>VVS &amp; Badrum</span></a>
        <a class="nt-gallery-item" data-category="badrum" href="#"><img src="assets/img/projekt/badrum-12.webp" width="900" height="675" loading="lazy" alt="Badrum med förvaring och spegelskåp"><span>VVS &amp; Badrum</span></a>
        <a class="nt-gallery-item" data-category="badrum" href="#"><img src="assets/img/projekt/badrum-13.webp" width="900" height="675" loading="lazy" alt="Dusch och kakelvägg, badrumsrenovering"><span>VVS &amp; Badrum</span></a>
        <a class="nt-gallery-item" data-category="badrum" href="#"><img src="assets/img/projekt/badrum-14.webp" width="900" height="675" loading="lazy" alt="Färdigställt badrum efter totalrenovering"><span>VVS &amp; Badrum</span></a>

        <a class="nt-gallery-item" data-category="bygg" href="#"><img src="assets/img/projekt/bygg-01.webp" width="900" height="675" loading="lazy" alt="Ny ytterdörr monterad av PRM Montage"><span>Bygg &amp; snickeri</span></a>
        <a class="nt-gallery-item" data-category="bygg" href="#"><img src="assets/img/projekt/bygg-02.webp" width="900" height="675" loading="lazy" alt="Snickeriarbete i samband med renovering"><span>Bygg &amp; snickeri</span></a>
        <a class="nt-gallery-item" data-category="bygg" href="#"><img src="assets/img/projekt/bygg-03.webp" width="900" height="675" loading="lazy" alt="Nybyggd tvättstuga med bänkskiva och förvaring"><span>Bygg &amp; snickeri</span></a>
        <a class="nt-gallery-item" data-category="bygg" href="#"><img src="assets/img/projekt/bygg-04.webp" width="900" height="675" loading="lazy" alt="Renovering pågår i hallen"><span>Bygg &amp; snickeri</span></a>
        <a class="nt-gallery-item" data-category="bygg" href="#"><img src="assets/img/projekt/bygg-05.webp" width="900" height="675" loading="lazy" alt="Nybyggd garderob och förvaringslösning"><span>Bygg &amp; snickeri</span></a>
      </div>
    </div>
  </div>
  <!-- =============== /GALLERI =============== -->

  <!-- =============== CTA =============== -->
    <FinalCta heading="Kontakta oss för ditt projekt" />

  <!-- =============== /CTA =============== -->

  <!-- =============== FOOTER =============== -->

  <Fragment slot="before-modal">
    <div class="nt-lightbox-overlay" id="nt-lightbox">
        <button class="nt-lightbox-close" aria-label="Stäng"><i class="fas fa-xmark"></i></button>
        <button class="nt-lightbox-prev" aria-label="Föregående bild"><i class="fas fa-arrow-left"></i></button>
        <img src="" alt="">
        <button class="nt-lightbox-next" aria-label="Nästa bild"><i class="fas fa-arrow-right"></i></button>
        <div class="nt-lightbox-caption"></div>
      </div>
  </Fragment>

  <Fragment slot="scripts">
    <script is:inline src="assets/js/lightbox.js"></script>
    <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var filterButtons = document.querySelectorAll('.nt-gallery-filter button');
      var galleryItems = document.querySelectorAll('.nt-gallery-grid .nt-gallery-item');

      filterButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          filterButtons.forEach(function (b) { b.classList.remove('is-active'); });
          btn.classList.add('is-active');

          var filter = btn.getAttribute('data-filter');

          galleryItems.forEach(function (item) {
            if (filter === 'all' || item.getAttribute('data-category') === filter) {
              item.removeAttribute('hidden');
            } else {
              item.setAttribute('hidden', '');
            }
          });
        });
      });
    });
  </script>
  </Fragment>
</BaseLayout>
