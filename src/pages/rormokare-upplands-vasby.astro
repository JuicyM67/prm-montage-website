---
import BaseLayout from '../layouts/BaseLayout.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "Rörmokare Upplands Väsby — VVS & jour | PRM Montage",
  "description": "Rörmokare i Upplands Väsby till fast pris. Auktoriserade VVS-installatörer för blandare, avlopp och rörbyten — samt jour dygnet runt vid vattenläcka.",
  "canonical": "https://prmmontage.se/rormokare-upplands-vasby",
  "ogDescription": "Rörmokare i Upplands Väsby till fast pris — VVS-arbete, akut hjälp och jour dygnet runt.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/hero-badrum.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Hantverkare i Upplands Väsby",
            "item": "https://prmmontage.se/upplands-vasby"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Rörmokare Upplands Väsby"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "VVS",
        "name": "Rörmokare i Upplands Väsby",
        "description": "VVS-arbete i Upplands Väsby till fast pris — blandare, toalettstolar, avlopp, rördragning och installation av vitvaror, med jour dygnet runt.",
        "provider": organization,
        "areaServed": "Upplands Väsby",
        "url": "https://prmmontage.se/rormokare-upplands-vasby"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Vad kostar en rörmokare i Upplands Väsby?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Vi arbetar med fast pris i stället för löpande timdebitering. Priset beror på vad som ska göras — ett blandarbyte är ett kort besök, medan rördragning vid en badrumsrenovering är ett flerdagarsjobb. Du får en kostnadsfri offert med fast pris innan arbetet påbörjas."
            }
          },
          {
            "@type": "Question",
            "name": "Vad kostar det när ni rycker ut akut?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Jourpriser ligger högre än ordinarie priser eftersom vi omprioriterar dagen eller åker ut på kväll, natt eller helg. Du får en prisbild redan i telefon och ett fast pris på åtgärden när vi har sett skadan på plats. Kan jobbet vänta till nästa vardag säger vi det — då blir det billigare för dig."
            }
          },
          {
            "@type": "Question",
            "name": "Hur snabbt är ni på plats i Upplands Väsby?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Vi utgår från Solna, ungefär två mil söderut längs E4:an. Vid akuta ärenden får du besked direkt i telefon om hur snabbt vi kan vara framme, utifrån var i kommunen du bor och hur läget ser ut just då."
            }
          },
          {
            "@type": "Question",
            "name": "Vad gör jag medan jag väntar på en vattenläcka?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Stäng huvudkranen, bryt strömmen om vatten är nära eluttag eller elcentral, flytta undan det som kan ta skada och fotografera innan du torkar upp. Bor du i lägenhet — larma föreningen så att grannarna under kan kontrolleras."
            }
          },
          {
            "@type": "Question",
            "name": "Ger VVS-arbete rätt till ROT-avdrag?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Arbetskostnaden för VVS-arbete i bostaden ger normalt rätt till ROT-avdrag, medan material inte gör det. Det gäller även akuta åtgärder. Vi drar av avdraget direkt på fakturan."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="tjanster" defaultService="VVS & Badrum">
  <!-- =============== BREADCRUMB =============== -->
  <div class="tp-breadcrumb-area tp-breadcrumb-spacing nt-dark-band pt-180 pb-90" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container">
      <div class="row"><div class="col-xl-8 col-lg-9">
        <div class="tp-breadcrumb-content">
          <h1 class="tp-breadcrumb-title fw-600 fs-60 fs-xs-40 ls-m-3 tp-text-common-white lh-1 mb-20">Rörmokare i Upplands Väsby</h1>
          <p style="color:rgba(255,255,255,.78);font-size:1.02rem;max-width:620px;margin-bottom:18px;">Auktoriserade VVS-installatörer i hela kommunen — till fast pris, med jour dygnet runt vid vattenläcka och stopp i avloppet.</p>
          <div class="tp-breadcrumb-dvdr"><ul><li><a href="/">Hem</a></li><li class="dvdr">/</li><li><a href="/upplands-vasby">Upplands Väsby</a></li><li class="dvdr">/</li><li>Rörmokare Upplands Väsby</li></ul></div>
        </div>
      </div></div>
    </div>
  </div>

  <div class="tp-service-details-thumb pt-80" style="background:var(--nt-white);">
    <div class="container">
      <div class="nt-media wow img-custom-anim-top" data-wow-duration="1.5s" data-wow-delay="0.2s" style="height:360px;">
        <img src="assets/img/projekt/hero-badrum.webp" width="1400" height="560" alt="VVS-arbete utfört av PRM Montage i Upplands Väsby" style="width:100%;height:100%;object-fit:cover;">
      </div>
    </div>
  </div>

  <div class="tp-service-details-area pt-70 pb-120" style="background:var(--nt-white);">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8">
          <span class="nt-eyebrow">Upplands Väsby</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Rörmokare i Upplands Väsby — VVS och jour till fast pris</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">PRM Montage utför VVS-arbete i hela Upplands Väsby — Väsby centrum, Smedby, Runby, Bollstanäs, Vilunda, Odenslunda och Fresta. Våra auktoriserade VVS-installatörer tar både planerade jobb och akuta utryckningar, och vi har jour dygnet runt på <a href="tel:+46852027977">08-520 279 77</a>.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Bostadsbeståndet i kommunen sätter ofta agendan. I flerbostadshusen kring centrum och Smedby är det oftast badrum och stammar som börjat närma sig slutet av sin livslängd, medan villorna i Runby och Bollstanäs lika ofta behöver hjälp med enskilda installationer — en ny blandare, en diskmaskin som ska kopplas in eller en varmvattenberedare som slutat leverera.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Oavsett vilket får du ett fast pris innan vi börjar, baserat på en kostnadsfri offert. Vi utgår från Industrivägen 19 i Solna, drygt två mil söderut längs E4:an.</p>
          <div class="row g-4 mt-10 mb-45">
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-orange);">
                <h5><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Fast pris — ingen timdebitering</h5>
                <p>Kostnadsfri offert först, fast pris sedan. Även vid akuta åtgärder.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-navy);">
                <h5><i class="fas fa-clock" style="color:#1FA968;margin-right:8px;"></i>Jour dygnet runt</h5>
                <p>Vattenläcka, rörbrott eller stopp i avloppet? Ring 08-520 279 77 när som helst.</p>
              </div>
            </div>
          </div>
          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">VVS-jobb vi utför i Upplands Väsby</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Byte och montering av blandare i kök och badrum</span></li>
            <li><i class="fas fa-check-circle"></i><span>Läckande blandare, kranar, ventiler och vattenlås</span></li>
            <li><i class="fas fa-check-circle"></i><span>Byte av toalettstol, handfat och kommod</span></li>
            <li><i class="fas fa-check-circle"></i><span>Installation av disk- och tvättmaskin med vatten, avlopp och avstängning</span></li>
            <li><i class="fas fa-check-circle"></i><span>Montering av duschvägg, duschhörn och duschblandare</span></li>
            <li><i class="fas fa-check-circle"></i><span>Rördragning och rörbyten vid badrums- och köksrenovering</span></li>
            <li><i class="fas fa-check-circle"></i><span>Varmvattenberedare som slutat fungera</span></li>
            <li><i class="fas fa-check-circle"></i><span>Stopp i avlopp och golvbrunn</span></li>
          </ul>
          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Akut rörmokare och jour i Upplands Väsby</h4>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Vatten som rinner där det inte ska väntar inte på kontorstid. Vi rycker ut på akuta VVS-ärenden i Upplands Väsby dygnet runt — vattenläcka, rörbrott, stopp i avloppet eller en ventil som inte går att stänga. Ring så får du prata med en människa direkt, och ett besked om hur snabbt vi kan vara på plats.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Stäng huvudkranen medan du väntar, bryt strömmen om vatten är nära eluttag och fotografera skadan innan du städar — bilderna behövs vid försäkringsärendet. Vi dokumenterar skadan och lämnar ett skriftligt underlag på vad som var trasigt och vad vi åtgärdade.</p>
          <div class="mb-45">
            <img src="assets/img/projekt/badrum-08.webp" width="900" height="675" loading="lazy" alt="Badrumsinstallation utförd av PRM Montages VVS-montörer" class="w-100" style="border-radius:12px;aspect-ratio:16/9;height:auto;object-fit:cover;">
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">När VVS-jobbet växer</h4>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Ett läckage bakom kaklet slutar sällan med bara ett rörbyte. Eftersom vi har egna snickare och behöriga elektriker kan vi ta hela vägen från stoppad läcka till färdigt rum — <a href="/vvs-badrum">badrumsrenovering</a>, <a href="/snickeri-upplands-vasby">snickeri</a> och <a href="/elektriker-stockholm">el</a> i samma projekt, med ett fast pris och en kontaktperson.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Se även vad vi mer gör i kommunen på sidan <a href="/upplands-vasby">hantverkare i Upplands Väsby</a>.</p>
          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om rörmokare i Upplands Väsby</h4>
<div class="accordion nt-accordion mb-45" id="faqRorUV">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqRorUV1">Vad kostar en rörmokare i Upplands Väsby?</button></h2>
              <div id="faqRorUV1" class="accordion-collapse collapse show" data-bs-parent="#faqRorUV"><div class="accordion-body">Vi arbetar med fast pris i stället för löpande timdebitering. Priset beror på vad som ska göras — ett <a href="/byta-blandare">blandarbyte</a> är ett kort besök, medan rördragning vid en <a href="/vvs-badrum">badrumsrenovering</a> är ett flerdagarsjobb. Du får en kostnadsfri offert med fast pris innan arbetet påbörjas.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqRorUV2">Vad kostar det när ni rycker ut akut?</button></h2>
              <div id="faqRorUV2" class="accordion-collapse collapse" data-bs-parent="#faqRorUV"><div class="accordion-body">Jourpriser ligger högre än ordinarie priser eftersom vi omprioriterar dagen eller åker ut på kväll, natt eller helg. Du får en prisbild redan i telefon och ett fast pris på åtgärden när vi har sett skadan på plats. Kan jobbet vänta till nästa vardag säger vi det — då blir det billigare för dig.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqRorUV3">Hur snabbt är ni på plats i Upplands Väsby?</button></h2>
              <div id="faqRorUV3" class="accordion-collapse collapse" data-bs-parent="#faqRorUV"><div class="accordion-body">Vi utgår från Solna, ungefär två mil söderut längs E4:an. Vid akuta ärenden får du besked direkt i telefon om hur snabbt vi kan vara framme, utifrån var i kommunen du bor och hur läget ser ut just då.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqRorUV4">Vad gör jag medan jag väntar på en vattenläcka?</button></h2>
              <div id="faqRorUV4" class="accordion-collapse collapse" data-bs-parent="#faqRorUV"><div class="accordion-body">Stäng huvudkranen, bryt strömmen om vatten är nära eluttag eller elcentral, flytta undan det som kan ta skada och fotografera innan du torkar upp. Bor du i lägenhet — larma föreningen så att grannarna under kan kontrolleras. Mer råd finns på vår sida om <a href="/vattenlacka-stockholm">vattenläcka</a>.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqRorUV5">Ger VVS-arbete rätt till ROT-avdrag?</button></h2>
              <div id="faqRorUV5" class="accordion-collapse collapse" data-bs-parent="#faqRorUV"><div class="accordion-body">Arbetskostnaden för VVS-arbete i bostaden ger normalt rätt till ROT-avdrag, medan material inte gör det. Det gäller även akuta åtgärder. Vi drar av avdraget direkt på fakturan — läs mer på vår <a href="/rut-rot">sida om ROT-avdrag</a>.</div></div>
            </div>
          </div>
          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="nt-side-card nt-side-card--navy" style="background:var(--nt-navy);">
            <h4 style="color:#fff;font-weight:700;margin-bottom:24px;">Kontakta oss direkt</h4>
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-phone" style="color:#1FA968;"></i></span>
