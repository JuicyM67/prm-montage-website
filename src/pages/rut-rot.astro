---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import FinalCta from '../components/FinalCta.astro';

const seo = {
  "title": "ROT-avdrag — Så fungerar det | PRM Montage",
  "description": "Så fungerar ROT-avdraget när du anlitar PRM Montage AB. Vi hjälper dig räkna på och ansöka om avdraget enligt Skatteverkets regler.",
  "canonical": "https://prmmontage.se/rut-rot",
  "ogDescription": "Så fungerar ROT-avdraget när du anlitar PRM Montage AB. Vi hjälper dig räkna på och ansöka om avdraget.",
  "ogImage": "https://prmmontage.se/assets/img/brand/og-default.jpg",
  "twitterDescription": "Så fungerar ROT-avdraget när du anlitar PRM Montage AB.",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "ROT-avdrag"
          }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Gäller ROT-avdrag på material?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Nej. Enligt Skatteverkets regler ger endast arbetskostnaden rätt till ROT-avdrag. Material och övriga kostnader, såsom resekostnader, ger inte rätt till avdrag."
            }
          },
          {
            "@type": "Question",
            "name": "Vilka av PRM Montages tjänster ger ROT-avdrag?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "De flesta bygg-, VVS-, el- och snickeriarbeten vi utför ger rätt till ROT-avdrag på arbetskostnaden. Kontakta oss så stämmer vi av vad som gäller för just ditt projekt."
            }
          },
          {
            "@type": "Question",
            "name": "Hur mycket kan jag få i ROT-avdrag?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "ROT-avdraget och rutavdraget räknas ihop och är högst 75 000 kronor per person och år. Rotavdraget får dock högst vara 50 000 kronor per år."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo}>
  <!-- =============== BREADCRUMB =============== -->
    <section class="cv-pagehero">
    <div class="cv-container">
      <ul class="cv-crumbs"><li><a href="/">Hem</a></li></ul>
      <h1>ROT-avdrag</h1>
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--outline-light"><i class="fas fa-phone"></i> Ring 08-520 279 77</a>
      </div>
    </div>
  </section>

  <ProofBar />

  <!-- =============== /BREADCRUMB =============== -->

  <div class="pt-100 pb-120" style="background:var(--nt-white);">
    <div class="container">
      <div class="cv-layout">
        <article class="cv-prose">
          <span class="nt-eyebrow">Vad är ROT-avdrag?</span>
          <h2 class="mb-25 fs-xl-36 fs-sm-30">Så fungerar ROT-avdraget hos PRM Montage</h2>
          <p class="mb-45" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">När du anlitar ett företag för reparation, underhåll samt ombyggnad och tillbyggnad kan du få rotavdrag för delar av arbetskostnaden. Du kan också få rutavdrag för hushållsnära tjänster. Material och övriga kostnader, såsom resekostnader, ger däremot inte rätt till avdrag. Detta enligt Skatteverkets regler.</p>

          <h3 style="color:var(--nt-navy);font-weight:700;margin-bottom:14px;">Vilka arbeten omfattas?</h3>
          <p class="mb-40" style="color:var(--nt-gray);line-height:1.8;">PRM Montages egna arbetskostnader inom bygg, VVS, el och snickeri kvalificerar normalt för ROT-avdrag, eftersom de räknas som reparation, underhåll, ombyggnad eller tillbyggnad. Material — till exempel kakel, blandare, köksluckor eller virke — ger däremot inte rätt till avdrag, oavsett vilken tjänst det gäller.</p>

          <h3 style="color:var(--nt-navy);font-weight:700;margin-bottom:14px;">Hur mycket kan jag få i avdrag?</h3>
          <p class="mb-40" style="color:var(--nt-gray);line-height:1.8;">Rotavdraget och rutavdraget räknas ihop och är högst 75 000 kronor per person och år. Rotavdraget får dock högst vara 50 000 kronor per år. Hur mycket du kan få i just ditt projekt beror på arbetskostnadens storlek och hur mycket avdragsutrymme du har kvar för året.</p>

          <h3 style="color:var(--nt-navy);font-weight:700;margin-bottom:14px;">Hur går det till hos PRM Montage?</h3>
          <p class="mb-45" style="color:var(--nt-gray);line-height:1.8;">Vi hjälper dig räkna på och ansöka om ROT-avdraget i samband med offerten, så att du redan från start ser vad projektet kostar efter avdrag. I praktiken innebär det att du bara betalar nettobeloppet till oss — vi sköter sedan begäran om utbetalning från Skatteverket för din räkning, precis som lagen kräver.</p>

          <h3 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om ROT-avdrag</h3>
          <div class="accordion nt-accordion mb-20" id="faqRot">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqRot1">Gäller ROT-avdrag på material?</button></h2>
              <div id="faqRot1" class="accordion-collapse collapse show" data-bs-parent="#faqRot"><div class="accordion-body">Nej. Enligt Skatteverkets regler ger endast arbetskostnaden rätt till ROT-avdrag. Material och övriga kostnader, såsom resekostnader, ger inte rätt till avdrag.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqRot2">Vilka av PRM Montages tjänster ger ROT-avdrag?</button></h2>
              <div id="faqRot2" class="accordion-collapse collapse" data-bs-parent="#faqRot"><div class="accordion-body">De flesta bygg-, VVS-, el- och snickeriarbeten vi utför ger rätt till ROT-avdrag på arbetskostnaden. Kontakta oss så stämmer vi av vad som gäller för just ditt projekt.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqRot3">Hur mycket kan jag få i ROT-avdrag?</button></h2>
              <div id="faqRot3" class="accordion-collapse collapse" data-bs-parent="#faqRot"><div class="accordion-body">ROT-avdraget och rutavdraget räknas ihop och är högst 75 000 kronor per person och år. Rotavdraget får dock högst vara 50 000 kronor per år.</div></div>
            </div>
          </div>
        </article>

        <aside class="cv-aside"><nav class="cv-links" aria-label="Läs även"><h3>Läs även</h3><ul><li><a href="/garanti">Garanti, ansvar &amp; trygghet <i class="fas fa-arrow-right"></i></a></li><li><a href="/sa-har-gar-det-till">Så här går det till <i class="fas fa-arrow-right"></i></a></li><li><a href="/tjanster">Alla tjänster <i class="fas fa-arrow-right"></i></a></li></ul></nav></aside>
      </div>
    </div>
  </div>

  <!-- =============== CTA =============== -->
    <FinalCta heading="Vi hjälper dig räkna på ditt ROT-avdrag" />

  <!-- =============== /CTA =============== -->

  <!-- =============== FOOTER =============== -->
</BaseLayout>
