---
import BaseLayout from '../layouts/BaseLayout.astro';

const seo = {
  "title": "Laga läckande blandare Stockholm — Fast pris | PRM Montage",
  "description": "Läckande blandare eller duschblandare? Vi lagar eller byter droppande blandare i Stockholm till fast pris. Snabb hjälp — kostnadsfri offert.",
  "canonical": "https://prmmontage.se/laga-lackande-blandare",
  "ogDescription": "Vi lagar läckande och droppande blandare i kök, badrum och dusch i Stockholm — till fast pris.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/badrum-03.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Tjänster",
            "item": "https://prmmontage.se/tjanster"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Laga läckande blandare"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Reparation av läckande blandare",
        "name": "Laga läckande blandare Stockholm",
        "description": "Vi lagar läckande och droppande blandare i kök, badrum och dusch i Stockholm — till fast pris.",
        "provider": {
          "@type": "HomeAndConstructionBusiness",
          "@id": "https://prmmontage.se/#organization",
          "name": "PRM Montage",
          "legalName": "PRM MONTAGE AB",
          "url": "https://prmmontage.se/",
          "telephone": "+46852027977",
          "email": "info@pro-montage.se",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Industrivägen 19",
            "postalCode": "171 48",
            "addressLocality": "Solna",
            "addressCountry": "SE"
          },
          "priceRange": "$$"
        },
        "areaServed": "Stockholm",
        "url": "https://prmmontage.se/laga-lackande-blandare"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Varför droppar min blandare?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Den vanligaste orsaken är en sliten packning eller en trasig keramisk insats i blandarens ventil. I duschblandare är det ofta termostatpatronen som är kalkbelagd eller utsliten. Alla tre är åtgärder vi utför på plats."
            }
          },
          {
            "@type": "Question",
            "name": "Är det värt att laga blandaren eller ska jag byta den?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Är blandaren i övrigt hel och av god kvalitet är det oftast både billigare och mer hållbart att byta insats eller packning. Är den gammal, kalkskadad eller av enklare modell rekommenderar vi ett byte — du får vår bedömning innan vi börjar."
            }
          },
          {
            "@type": "Question",
            "name": "Hur mycket vatten läcker en droppande kran?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "En kran som droppar kontinuerligt kan läcka bort tusentals liter vatten per år. Gäller det varmvatten tillkommer kostnaden för uppvärmningen, vilket gör att åtgärden ofta betalar sig snabbt."
            }
          },
          {
            "@type": "Question",
            "name": "Ger reparation av blandare rätt till ROT-avdrag?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Arbetskostnaden vid reparation och byte av blandare ger normalt rätt till ROT-avdrag, medan material inte gör det. Läs mer på vår ROT-avdragssida."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="tjanster" defaultService="VVS & Badrum">
  <!-- =============== BREADCRUMB =============== -->
  <div class="tp-breadcrumb-area tp-breadcrumb-spacing nt-dark-band pt-180 pb-90" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container">
      <div class="row"><div class="col-xl-8 col-lg-9">
        <div class="tp-breadcrumb-content">
          <h1 class="tp-breadcrumb-title fw-600 fs-60 fs-xs-40 ls-m-3 tp-text-common-white lh-1 mb-20">Laga läckande blandare &amp; duschblandare</h1>
          <div class="tp-breadcrumb-dvdr"><ul><li><a href="/">Hem</a></li><li class="dvdr">/</li><li><a href="/tjanster">Tjänster</a></li><li class="dvdr">/</li><li>Laga läckande blandare</li></ul></div>
        </div>
      </div></div>
    </div>
  </div>

  <div class="tp-service-details-thumb pt-80" style="background:var(--nt-white);">
    <div class="container">
      <div class="nt-media wow img-custom-anim-top" data-wow-duration="1.5s" data-wow-delay="0.2s" style="height:360px;">
        <img src="assets/img/projekt/badrum-03.webp" width="1400" height="560" alt="Badrum med dusch renoverat av PRM Montage i Stockholm" style="width:100%;height:100%;object-fit:cover;">
      </div>
    </div>
  </div>

  <div class="tp-service-details-area pt-70 pb-120" style="background:var(--nt-white);">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8">
          <span class="nt-eyebrow">Tjänst</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Läckande blandare — vi lagar eller byter till fast pris</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">En droppande blandare är sällan bara irriterande. En blandare som läcker kontinuerligt kan kosta flera hundra kronor om året i onödig vattenförbrukning, och en läcka bakom kaklet eller under handfatet kan ge fuktskador. PRM Montage lagar läckande blandare i kök, badrum och dusch i hela Stockholm.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Vi börjar med att lokalisera var läckaget kommer ifrån. Ofta räcker det att byta en packning, en keramisk insats eller en termostatpatron — då fungerar blandaren som ny. Är blandaren gammal eller sliten är det ofta mer ekonomiskt att <a href="/byta-blandare">byta blandaren</a> helt, och då säger vi det.</p>

          <div class="row g-4 mt-10 mb-45">
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-orange);">
                <h5><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Fast pris</h5>
                <p>Du får en tydlig, fast prisbild innan vi sätter igång — inga överraskningar.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-navy);">
                <h5><i class="fas fa-shield-check" style="color:#1FA968;margin-right:8px;"></i>Auktoriserade installatörer</h5>
                <p>Behöriga VVS-installatörer, fullt försäkrade och med garanti på arbetet.</p>
              </div>
            </div>
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad ingår när vi lagar en läckande blandare?</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Felsökning och lokalisering av läckaget</span></li>
            <li><i class="fas fa-check-circle"></i><span>Byte av packningar och O-ringar</span></li>
            <li><i class="fas fa-check-circle"></i><span>Byte av keramisk insats eller patron</span></li>
            <li><i class="fas fa-check-circle"></i><span>Byte av termostatpatron i duschblandare</span></li>
            <li><i class="fas fa-check-circle"></i><span>Kontroll av anslutningar och kopplingar under handfatet</span></li>
            <li><i class="fas fa-check-circle"></i><span>Täthetsprovning efter åtgärd</span></li>
          </ul>

          <div class="row g-4 mb-45">
            <div class="col-md-6">
              <div class="nt-quote">
                <div class="nt-quote__stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
                <p>"Helped us with installation of faucet. Very professional! The job was very well done! Can strongly recommend!"</p>
                <div class="nt-quote__author">
                  <div class="nt-quote__avatar">TD</div>
                  <div><h6>Thomas Durrani</h6><span class="nt-quote__source"><i class="fab fa-google"></i> Google-recension</span></div>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-quote">
                <div class="nt-quote__stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
                <p>"Jag är mycket nöjd med installationen av blandaren i mitt badrum av en duktig och vänlig hantverkare."</p>
                <div class="nt-quote__author">
                  <div class="nt-quote__avatar">MC</div>
                  <div><h6>Marie Chenik</h6><span class="nt-quote__source"><i class="fab fa-google"></i> Google-recension</span></div>
                </div>
              </div>
            </div>
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om läckande blandare</h4>
          <div class="accordion nt-accordion mb-45" id="faqLacka">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqLacka1">Varför droppar min blandare?</button></h2>
              <div id="faqLacka1" class="accordion-collapse collapse show" data-bs-parent="#faqLacka"><div class="accordion-body">Den vanligaste orsaken är en sliten packning eller en trasig keramisk insats i blandarens ventil. I duschblandare är det ofta termostatpatronen som är kalkbelagd eller utsliten. Alla tre är åtgärder vi utför på plats.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqLacka2">Är det värt att laga blandaren eller ska jag byta den?</button></h2>
              <div id="faqLacka2" class="accordion-collapse collapse" data-bs-parent="#faqLacka"><div class="accordion-body">Är blandaren i övrigt hel och av god kvalitet är det oftast både billigare och mer hållbart att byta insats eller packning. Är den gammal, kalkskadad eller av enklare modell rekommenderar vi ett byte — du får vår bedömning innan vi börjar.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqLacka3">Hur mycket vatten läcker en droppande kran?</button></h2>
              <div id="faqLacka3" class="accordion-collapse collapse" data-bs-parent="#faqLacka"><div class="accordion-body">En kran som droppar kontinuerligt kan läcka bort tusentals liter vatten per år. Gäller det varmvatten tillkommer kostnaden för uppvärmningen, vilket gör att åtgärden ofta betalar sig snabbt.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqLacka4">Ger reparation av blandare rätt till ROT-avdrag?</button></h2>
              <div id="faqLacka4" class="accordion-collapse collapse" data-bs-parent="#faqLacka"><div class="accordion-body">Arbetskostnaden vid reparation och byte av blandare ger normalt rätt till ROT-avdrag, medan material inte gör det. Läs mer på vår <a href="/rut-rot">ROT-avdragssida</a>.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="nt-side-card nt-side-card--navy" style="background:var(--nt-navy);">
            <h4 style="color:#fff;font-weight:700;margin-bottom:24px;">Kontakta oss direkt</h4>
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-phone" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">Ring oss</p><a href="tel:+46852027977" style="color:#fff;font-weight:700;font-size:1.05rem;text-decoration:none;">08-520 279 77</a></div>
            </div>
            <div style="display:flex;align-items:center;gap:14px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-envelope" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">E-post</p><a href="mailto:info@pro-montage.se" style="color:#fff;font-weight:700;text-decoration:none;">info@pro-montage.se</a></div>
            </div>
          </div>
          <div class="nt-side-card">
            <h5>Varför PRM Montage?</h5>
            <ul class="nt-check" style="margin:0;"><li><i class="fas fa-check"></i><span>Fast pris, alltid</span></li><li><i class="fas fa-check"></i><span>F-skatt &amp; försäkrade</span></li><li><i class="fas fa-check"></i><span>Egna hantverkare</span></li><li><i class="fas fa-check"></i><span>Garanti på arbetet</span></li></ul>
          </div>
          <div class="nt-side-card">
            <h5>Alla tjänster</h5>
            <ul class="nt-side-nav">
              <li><a href="/koksrenovering-stockholm">Köksrenovering Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/bygg-renovering">Bygg &amp; renovering <i class="fas fa-arrow-right"></i></a></li>
              <li class="is-active"><a href="/vvs-badrum">VVS &amp; Badrum <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/elektriker-stockholm">Elektriker Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/altanbygge-i-stockholm">Altanbygge i Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/jour">Jour — akut hjälp <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
          <div class="nt-side-card">
            <h5>Fler jobb till fast pris</h5>
            <ul class="nt-side-nav">
              <li><a href="/byta-blandare">Byta blandare <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/installera-diskmaskin">Installera diskmaskin <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/byta-toalettstol">Byta toalettstol <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/installera-tvattmaskin">Installera tvättmaskin <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/eluttag-tvattmaskin-diskmaskin">Eluttag till tvätt- &amp; diskmaskin <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/eluttag-badrum">Eluttag i badrum <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/montera-duschvagg">Montera duschvägg <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/byta-handfat-kommod">Byta handfat &amp; kommod <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/montera-tv-pa-vagg">Montera TV på vägg <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="tp-cta-area nt-dark-band pt-120 pb-120" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container"><div class="row"><div class="col-xl-8 col-lg-10">
      <span class="nt-eyebrow nt-eyebrow-light">Redo att börja?</span>
      <h2 class="mb-15 fs-xl-40 fs-sm-36 tp-text-common-white">Droppar en blandare hemma?</h2>
      <p class="mb-40" style="color:rgba(255,255,255,0.78);font-size:1.05rem;max-width:620px;">Kontakta oss idag — fast pris, egna hantverkare, kostnadsfri offert.</p>
      <div class="d-flex flex-wrap align-items-center gap-4">
        <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500"><span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span></a>
        <a href="tel:+46852027977" class="d-inline-flex align-items-center gap-3" style="text-decoration:none;"><span style="width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;"><i class="fas fa-phone" style="color:#1FA968;"></i></span><span><span style="display:block;color:rgba(255,255,255,0.6);font-size:.8rem;">Ring oss direkt</span><span style="display:block;color:#fff;font-weight:700;font-size:1.05rem;">08-520 279 77</span></span></a>
      </div>
    </div></div></div>
  </div>
</BaseLayout>
