---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import SectionHeader from '../components/landing/SectionHeader.astro';
import ReviewStrip from '../components/ReviewStrip.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyOfferCard from '../components/StickyOfferCard.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "Vattenläcka Stockholm — Akut hjälp dygnet runt | PRM Montage",
  "description": "Vattenläcka i Stockholm? Ring 08-520 279 77 — vi rycker ut dygnet runt och stoppar läckan. Fast pris, 4,9 på Google (100+ omdömen), hjälp med försäkring.",
  "canonical": "https://prmmontage.se/vattenlacka-stockholm",
  "ogDescription": "Akut hjälp vid vattenläcka i Stockholm — dygnet runt. Vi stoppar läckan, spårar orsaken och återställer.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/hero-badrum.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Tjänster",
            "item": "https://prmmontage.se/tjanster"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Vattenläcka Stockholm"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Vattenskada och läcksökning",
        "name": "Vattenläcka i Stockholm",
        "description": "Akut utryckning vid vattenläcka i Stockholm — avstängning, läcksökning, fuktmätning och återställning av badrum och kök.",
        "provider": organization,
        "areaServed": "Stockholm",
        "url": "https://prmmontage.se/vattenlacka-stockholm"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Vad gör jag först vid en vattenläcka?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Stäng huvudkranen så att vattnet slutar rinna, bryt strömmen om vatten är i närheten av eluttag eller elcentral, och flytta undan det som kan ta skada. Fotografera innan du städar upp — bilderna behövs vid försäkringsärendet. Ring sedan oss på 08-520 279 77."
            }
          },
          {
            "@type": "Question",
            "name": "Hur hittar ni en läcka som inte syns?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Fuktfläckar på vägg eller i tak, en vattenmätare som fortsätter räkna när alla kranar är stängda, eller golv som buktar är vanliga tecken. Vi spårar läckan med fuktmätning och avläsning av mätaren, och öppnar bara upp där det faktiskt behövs."
            }
          },
          {
            "@type": "Question",
            "name": "Vem betalar — jag, föreningen eller försäkringsbolaget?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Det beror på var läckan sitter. I en bostadsrätt ansvarar föreningen normalt för stammarna medan du som medlem ansvarar för det som är innanför lägenhetens väggar, men fördelningen står i föreningens stadgar. Plötsliga och oförutsedda vattenskador täcks oftast av hemförsäkringen, medan skador som beror på eftersatt underhåll gör det sällan. Vi lämnar alltid ett skriftligt underlag på vad som var trasigt."
            }
          },
          {
            "@type": "Question",
            "name": "Kan ni återställa badrummet efteråt?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. Vi har egna hantverkare inom VVS, bygg och el, så vi kan ta hela kedjan — stoppa läckan, torka ut, riva bort det skadade och bygga upp badrum eller kök igen med tätskikt, kakel och installationer. Du får ett fast pris på återställningen innan den påbörjas."
            }
          },
          {
            "@type": "Question",
            "name": "Vem ringer man vid en vattenläcka?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ring en VVS-firma som kan stoppa läckan och anmäl skadan till ditt försäkringsbolag. Bor du i lägenhet ska du också larma föreningen eller fastighetsägaren. Vi rycker ut och stoppar läckan — ring 08-520 279 77."
            }
          },
          {
            "@type": "Question",
            "name": "Hur stoppar jag en vattenläcka själv i väntan på hjälp?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Stäng vattnet vid avstängningsventilen eller huvudkranen, bryt strömmen på berörd grupp om vatten är nära el, och fotografera skadan innan du torkar upp. Ring sedan oss."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="tjanster" defaultService="VVS & Badrum">
  <!-- =============== BREADCRUMB =============== -->
    <section class="cv-pagehero">
    <div class="cv-container">
      <ul class="cv-crumbs"><li><a href="/">Hem</a></li><li><a href="/tjanster">Tjänster</a></li></ul>
      <h1>Vattenläcka i Stockholm</h1>
      <p class="cv-pagehero__lead">Akut hjälp dygnet runt vid vattenläcka och rörbrott. Vi stoppar vattnet, spårar orsaken och återställer — med egna hantverkare.</p>
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--outline-light"><i class="fas fa-phone"></i> Ring 08-520 279 77</a>
      </div>
      <div class="cv-rating cv-rating--light"><span class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span><span>4,9 på Google · 100+ omdömen</span></div>
    </div>
  </section>

  <div class="cv-pageshot-wrap"><div class="cv-container cv-pageshot"><img src="assets/img/projekt/hero-badrum.webp" width="1400" height="560" alt="PRM Montage åtgärdar akut vattenläcka i Stockholm" fetchpriority="high"></div></div>

  <ProofBar />


  

    <section class="cv-section">
    <div class="cv-container cv-layout">
      <article class="cv-prose">
          <span class="nt-eyebrow">Akut</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Vattenläcka i Stockholm — akut hjälp dygnet runt</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">En vattenläcka blir dyrare för varje timme den får fortsätta. PRM Montage rycker ut på akuta vattenläckor i hela Stockholmsområdet, dygnet runt — ring <a href="tel:+46852027977">08-520 279 77</a> så får du tag på oss direkt.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Vi stoppar läckan först, spårar sedan orsaken och lämnar ett fast pris på åtgärden. Är skadan större kan vi ta hela vägen tillbaka till färdigt rum med egna VVS-montörer, snickare och elektriker — utan att du behöver samordna flera firmor mitt i en redan besvärlig situation.</p>
          <div class="cv-btn-row cv-midcta-row">
            <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
          </div>

          <div class="row g-4 mt-10 mb-45">
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-orange);">
                <h3><i class="fas fa-droplet" style="color:#1FA968;margin-right:8px;"></i>Akut utryckning dygnet runt</h3>
                <p>Kväll, natt och helg — vi stoppar vattnet först och åtgärdar sedan.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-navy);">
                <h3><i class="fas fa-clipboard-check" style="color:#1FA968;margin-right:8px;"></i>Underlag till försäkringen</h3>
                <p>Vi dokumenterar skadan med bilder och skriver ett tydligt åtgärdsunderlag.</p>
              </div>
            </div>
          </div>
          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Stäng av vattnet — så här</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Huvudkranen sitter oftast i badrummet, i köksskåpet under diskbänken eller i undercentralen.</span></li>
            <li><i class="fas fa-check-circle"></i><span>I villa hittar du avstängningen där servisledningen kommer in, ofta i tvättstuga eller pannrum.</span></li>
            <li><i class="fas fa-check-circle"></i><span>Bryt strömmen på berörd grupp om vatten är nära eluttag, elcentral eller vitvaror.</span></li>
            <li><i class="fas fa-check-circle"></i><span>Fotografera skadan innan du torkar upp — bilderna behövs i försäkringsärendet.</span></li>
            <li><i class="fas fa-check-circle"></i><span>Bor du i lägenhet: larma föreningen eller fastighetsägaren så att grannarna under kan kontrolleras.</span></li>
          </ul>
          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vanliga orsaker till vattenläckor</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Åldrade kopplingar och rör bakom kakel eller under bänkskiva</span></li>
            <li><i class="fas fa-check-circle"></i><span>Trasig eller felmonterad diskmaskins- och tvättmaskinsanslutning</span></li>
            <li><i class="fas fa-check-circle"></i><span>Läckande blandare, ventil eller vattenlås</span></li>
            <li><i class="fas fa-check-circle"></i><span>Otäta tätskikt och genomföringar i badrum</span></li>
            <li><i class="fas fa-check-circle"></i><span>Sprucken spolcistern eller läckande toalettstol</span></li>
            <li><i class="fas fa-check-circle"></i><span>Frusna och spruckna rör i ouppvärmda utrymmen</span></li>
          </ul>
          <div class="mb-45">
            <img src="assets/img/projekt/badrum-13.webp" width="900" height="675" loading="lazy" alt="Återställt badrum efter vattenskada, utfört av PRM Montage i Stockholm" class="w-100" style="border-radius:12px;aspect-ratio:16/9;height:auto;object-fit:cover;">
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Från stoppad läcka till färdigt rum</h4>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">När det akuta är under kontroll handlar det om att få bort fukten och bygga upp igen. Vi mäter fukt, river bort det som är skadat och återställer med tätskikt, ytskikt och installationer enligt gällande branschregler. Behöver <a href="/elektriker-stockholm">el</a> dras om i samma veva gör våra behöriga elektriker det i samma projekt.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Är läckan i stället en droppande kran eller en blandare som inte går att stänga hjälper vi dig snabbare och billigare via <a href="/laga-lackande-blandare">laga läckande blandare</a> eller <a href="/byta-blandare">byta blandare</a>. Är det stopp i avloppet snarare än en läcka, se <a href="/akut-rormokare-stockholm">akut rörmokare i Stockholm</a>.</p>
          <h3 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Hur vet jag att jag har en dold vattenläcka?</h3>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Typiska tecken är fläckar eller missfärgning på vägg och tak, en murrig lukt, bubblande färg eller tapet och en vattenmätare som rör sig fast ingen använder vatten. Misstänker du en dold läcka — ring oss så hjälper vi dig att spåra den.</p>

<p class="mb-45" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Vi kommer till Stockholm med omnejd — bland annat <a href="/solna">Solna</a>, <a href="/sundbyberg">Sundbyberg</a>, <a href="/bromma">Bromma</a>, <a href="/danderyd">Danderyd</a>, <a href="/tacby">Täby</a> och <a href="/lidingo">Lidingö</a>.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om vattenläcka</h4>
<div class="accordion nt-accordion mb-45" id="faqVattenlacka">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqVattenlacka1">Vad gör jag först vid en vattenläcka?</button></h2>
              <div id="faqVattenlacka1" class="accordion-collapse collapse show" data-bs-parent="#faqVattenlacka"><div class="accordion-body">Stäng huvudkranen så att vattnet slutar rinna, bryt strömmen om vatten är i närheten av eluttag eller elcentral, och flytta undan det som kan ta skada. Fotografera innan du städar upp — bilderna behövs vid försäkringsärendet. Ring sedan oss på <a href="tel:+46852027977">08-520 279 77</a>.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqVattenlacka2">Hur hittar ni en läcka som inte syns?</button></h2>
              <div id="faqVattenlacka2" class="accordion-collapse collapse" data-bs-parent="#faqVattenlacka"><div class="accordion-body">Fuktfläckar på vägg eller i tak, en vattenmätare som fortsätter räkna när alla kranar är stängda, eller golv som buktar är vanliga tecken. Vi spårar läckan med fuktmätning och avläsning av mätaren, och öppnar bara upp där det faktiskt behövs.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqVattenlacka3">Vem betalar — jag, föreningen eller försäkringsbolaget?</button></h2>
              <div id="faqVattenlacka3" class="accordion-collapse collapse" data-bs-parent="#faqVattenlacka"><div class="accordion-body">Det beror på var läckan sitter. I en bostadsrätt ansvarar föreningen normalt för stammarna medan du som medlem ansvarar för det som är innanför lägenhetens väggar, men fördelningen står i föreningens stadgar. Plötsliga och oförutsedda vattenskador täcks oftast av hemförsäkringen, medan skador som beror på eftersatt underhåll gör det sällan. Vi lämnar alltid ett skriftligt underlag på vad som var trasigt.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqVattenlacka4">Kan ni återställa badrummet efteråt?</button></h2>
              <div id="faqVattenlacka4" class="accordion-collapse collapse" data-bs-parent="#faqVattenlacka"><div class="accordion-body">Ja. Vi har egna hantverkare inom VVS, bygg och el, så vi kan ta hela kedjan — stoppa läckan, torka ut, riva bort det skadade och bygga upp <a href="/vvs-badrum">badrum</a> eller <a href="/koksrenovering-stockholm">kök</a> igen med tätskikt, kakel och installationer. Du får ett fast pris på återställningen innan den påbörjas.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqVattenlacka5">Vem ringer man vid en vattenläcka?</button></h2>
              <div id="faqVattenlacka5" class="accordion-collapse collapse" data-bs-parent="#faqVattenlacka"><div class="accordion-body">Ring en VVS-firma som kan stoppa läckan och anmäl skadan till ditt försäkringsbolag. Bor du i lägenhet ska du också larma föreningen eller fastighetsägaren. Vi rycker ut och stoppar läckan — ring 08-520 279 77.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqVattenlacka6">Hur stoppar jag en vattenläcka själv i väntan på hjälp?</button></h2>
              <div id="faqVattenlacka6" class="accordion-collapse collapse" data-bs-parent="#faqVattenlacka"><div class="accordion-body">Stäng vattnet vid avstängningsventilen eller huvudkranen, bryt strömmen på berörd grupp om vatten är nära el, och fotografera skadan innan du torkar upp. Ring sedan oss.</div></div>
            </div>
          </div>
          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </article>
      <aside>
        <StickyOfferCard related={[{href:'/koksrenovering-stockholm',label:'Köksrenovering Stockholm'},{href:'/bygg-renovering',label:'Bygg & renovering'},{href:'/vvs-badrum',label:'VVS & Badrum'},{href:'/elektriker-stockholm',label:'Elektriker Stockholm'},{href:'/altanbygge-i-stockholm',label:'Altanbygge i Stockholm'},{href:'/jour',label:'Jour — akut hjälp'}]} relatedTitle="Våra tjänster" />
      </aside>
    </div>
  </section>

  <section class="cv-section cv-section--tint">
    <div class="cv-container">
      <SectionHeader pill="Omdömen" title="Det säger våra kunder" />
      <ReviewStrip count={3} offset={7} job />
    </div>
  </section>


    <FinalCta heading="Vattenläcka just nu? Ring 08-520 279 77." />

</BaseLayout>
