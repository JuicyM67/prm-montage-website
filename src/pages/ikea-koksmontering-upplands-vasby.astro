          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "IKEA-köksmontering",
        "name": "IKEA-köksmontering Upplands Väsby",
        "description": "Montering av IKEA:s METOD-köksystem i Upplands Väsby — stommar, luckor, MAXIMERA-lådor och bänkskiva, till fast pris.",
        "provider": {
          "@type": "HomeAndConstructionBusiness",
          "@id": "https://prmmontage.se/#organization",
          "name": "PRM Montage",
          "legalName": "PRM MONTAGE AB",
          "url": "https://prmmontage.se/",
          "telephone": "+46852027977",
          "email": "info@pro-montage.se",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Industrivägen 19",
            "postalCode": "171 48",
            "addressLocality": "Solna",
            "addressCountry": "SE"
          },
          "priceRange": "$$"
        },
        "areaServed": "Upplands Väsby",
        "url": "https://prmmontage.se/ikea-koksmontering-upplands-vasby"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Vad kostar IKEA-köksmontering i Upplands Väsby?",
