---
import BaseLayout from '../layouts/BaseLayout.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "IKEA-köksmontering Upplands Väsby — Fast pris | PRM Montage",
  "description": "IKEA-köksmontering i Upplands Väsby till fast pris. Vi monterar ditt METOD-kök i villa, radhus eller lägenhet enligt IKEA:s anvisningar. Kostnadsfri offert.",
  "canonical": "https://prmmontage.se/ikea-koksmontering-upplands-vasby",
  "ogDescription": "IKEA-köksmontering i Upplands Väsby till fast pris — montering av METOD-kök enligt IKEA:s anvisningar.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/hero-kok.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Hantverkare i Upplands Väsby",
            "item": "https://prmmontage.se/upplands-vasby"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "IKEA-köksmontering Upplands Väsby"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "IKEA-köksmontering",
        "name": "IKEA-köksmontering Upplands Väsby",
        "description": "Montering av IKEA:s METOD-köksystem i Upplands Väsby — stommar, luckor, MAXIMERA-lådor och bänkskiva, till fast pris.",
        "provider": organization,
        "areaServed": "Upplands Väsby",
        "url": "https://prmmontage.se/ikea-koksmontering-upplands-vasby"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Vad kostar IKEA-köksmontering i Upplands Väsby?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Vi ger ett fast pris när vi fått köksritningen. Kökets storlek, antalet skåp och bänkskivan avgör, och offerten kostar ingenting."
            }
          },
          {
            "@type": "Question",
            "name": "Är ni certifierade av IKEA?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Nej, någon certifiering från IKEA har vi inte. Våra snickare har dock gedigen METOD-vana och följer anvisningarna."
            }
          },
          {
            "@type": "Question",
            "name": "Hur snabbt kommer ni till Upplands Väsby?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Upplands Väsby ligger drygt två mil norr om vårt kontor i Solna, längs E4. Hör av dig så får du ett besked om vilken tid vi kan komma."
            }
          },
          {
            "@type": "Question",
            "name": "Ger monteringen rätt till ROT-avdrag?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Arbetskostnaden ger normalt rätt till ROT-avdrag, men inte köket och materialet. Se sidan om ROT-avdrag."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="tjanster" defaultService="VVS & Badrum">
  <!-- =============== BREADCRUMB =============== -->
  <div class="tp-breadcrumb-area tp-breadcrumb-spacing nt-dark-band pt-180 pb-90" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container">
      <div class="row"><div class="col-xl-8 col-lg-9">
        <div class="tp-breadcrumb-content">
          <h1 class="tp-breadcrumb-title fw-600 fs-60 fs-xs-40 ls-m-3 tp-text-common-white lh-1 mb-20">IKEA-köksmontering i Upplands Väsby</h1>
          <p style="color:rgba(255,255,255,.78);font-size:1.02rem;max-width:620px;margin-bottom:18px;">Vi monterar ditt METOD-kök enligt IKEA:s egna anvisningar — till fast pris i hela kommunen.</p>
          <div class="tp-breadcrumb-dvdr"><ul><li><a href="/">Hem</a></li><li class="dvdr">/</li><li><a href="/upplands-vasby">Upplands Väsby</a></li><li class="dvdr">/</li><li>IKEA-köksmontering Upplands Väsby</li></ul></div>
        </div>
      </div></div>
    </div>
  </div>

  <div class="tp-service-details-thumb pt-80" style="background:var(--nt-white);">
    <div class="container">
      <div class="nt-media wow img-custom-anim-top" data-wow-duration="1.5s" data-wow-delay="0.2s" style="height:360px;">
        <img src="assets/img/projekt/hero-kok.webp" width="1400" height="560" alt="Monterat IKEA-kök av PRM Montage i Upplands Väsby" style="width:100%;height:100%;object-fit:cover;">
      </div>
    </div>
  </div>

  <div class="tp-service-details-area pt-70 pb-120" style="background:var(--nt-white);">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8">
          <span class="nt-eyebrow">Upplands Väsby</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">IKEA-köksmontering i Upplands Väsby — fast pris</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Ett IKEA-kök är ett kostnadseffektivt sätt att få ett nytt kök — men monteringen är sällan så snabb som kartongerna antyder. PRM Montage monterar METOD-kök i hela Upplands Väsby enligt IKEA:s egna anvisningar, till fast pris.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">METOD-systemet bygger på en upphängningsskena som måste sitta i våg och i en vägg som tål lasten. I flerbostadshusen kring Väsby centrum och Smedby innebär det oftast infästning i betong eller lättbetong, medan villorna i Runby, Bollstanäs och Odenslunda har regelväggar där skruvarna behöver träffa rätt. Vi kontrollerar väggen först och väljer infästning därefter.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Bänkskivan är det andra momentet som avgör hur köket ser ut när det är klart. Vi kapar, anpassar mot vägg och tätar kring diskho och häll, så att skarvarna inte glipar och fukt inte tar sig ned i stommen.</p>
          <div class="row g-4 mt-10 mb-45">
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-orange);">
                <h5><i class="fas fa-toolbox" style="color:#1FA968;margin-right:8px;"></i>Monterat efter din ritning</h5>
                <p>Stommar, luckor, lådor och bänkskiva sätts upp med en infästning som passar väggen i just din bostad.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-navy);">
                <h5><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Ett pris som ligger fast</h5>
                <p>Offerten kostar ingenting, och priset är bestämt när vi bokar in jobbet.</p>
              </div>
            </div>
          </div>
          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad som ingår</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Uppmätning på plats och genomgång av din köksritning</span></li>
            <li><i class="fas fa-check-circle"></i><span>Stommar som hängs upp och fästs i betong, lättbetong eller regelvägg</span></li>
            <li><i class="fas fa-check-circle"></i><span>Luckor, fronter och MAXIMERA-lådor som justeras</span></li>
            <li><i class="fas fa-check-circle"></i><span>Bänkskiva som kapas och tätas runt diskho och häll</span></li>
            <li><i class="fas fa-check-circle"></i><span>Täcksidor, sockel, lister och passbitar</span></li>
            <li><i class="fas fa-check-circle"></i><span>Vitvaror som byggs in och kopplas till el och vatten</span></li>
            <li><i class="fas fa-check-circle"></i><span>Emballage och gammalt kök forslas bort vid behov</span></li>
          </ul>
          <div class="mb-45">
            <img src="assets/img/projekt/kok-05.webp" width="900" height="675" loading="lazy" alt="Monterat IKEA METOD-kök av PRM Montage" class="w-100" style="border-radius:12px;aspect-ratio:16/9;height:auto;object-fit:cover;">
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">IKEA-kök — eller något annat?</h4>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Vi monterar förstås även kök från andra leverantörer — se <a href="/koksmontering-upplands-vasby">köksmontering i Upplands Väsby</a>. Ska hela köket göras om, med rivning, ny el och flyttat vatten, är det <a href="/koksrenovering-stockholm">köksrenovering</a> som gäller.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Läs mer om vad vi gör i kommunen på <a href="/upplands-vasby">hantverkare i Upplands Väsby</a>, eller om IKEA-montering i övriga länet på <a href="/ikea-koksmontering-stockholm">montera IKEA-kök i Stockholm</a>.</p>
          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om IKEA-köksmontering i Upplands Väsby</h4>
<div class="accordion nt-accordion mb-45" id="faqIkeaUV">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqIkeaUV1">Vad kostar IKEA-köksmontering i Upplands Väsby?</button></h2>
              <div id="faqIkeaUV1" class="accordion-collapse collapse show" data-bs-parent="#faqIkeaUV"><div class="accordion-body">Vi ger ett fast pris när vi fått köksritningen. Kökets storlek, antalet skåp och bänkskivan avgör, och offerten kostar ingenting.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqIkeaUV2">Är ni certifierade av IKEA?</button></h2>
              <div id="faqIkeaUV2" class="accordion-collapse collapse" data-bs-parent="#faqIkeaUV"><div class="accordion-body">Nej, någon certifiering från IKEA har vi inte. Våra snickare har dock gedigen METOD-vana och följer anvisningarna.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqIkeaUV3">Hur snabbt kommer ni till Upplands Väsby?</button></h2>
              <div id="faqIkeaUV3" class="accordion-collapse collapse" data-bs-parent="#faqIkeaUV"><div class="accordion-body">Upplands Väsby ligger drygt två mil norr om vårt kontor i Solna, längs E4. Hör av dig så får du ett besked om vilken tid vi kan komma.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqIkeaUV4">Ger monteringen rätt till ROT-avdrag?</button></h2>
              <div id="faqIkeaUV4" class="accordion-collapse collapse" data-bs-parent="#faqIkeaUV"><div class="accordion-body">Arbetskostnaden ger normalt rätt till ROT-avdrag, men inte köket och materialet. Se <a href="/rut-rot">sidan om ROT-avdrag</a>.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="nt-side-card nt-side-card--navy" style="background:var(--nt-navy);">
            <h4 style="color:#fff;font-weight:700;margin-bottom:24px;">Kontakta oss direkt</h4>
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-phone" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">Ring oss</p><a href="tel:+46852027977" style="color:#fff;font-weight:700;font-size:1.05rem;text-decoration:none;">08-520 279 77</a></div>
            </div>
            <div style="display:flex;align-items:center;gap:14px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-envelope" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">E-post</p><a href="mailto:info@pro-montage.se" style="color:#fff;font-weight:700;text-decoration:none;">info@pro-montage.se</a></div>
            </div>
          </div>
          <div class="nt-side-card">
            <h5>Varför PRM Montage?</h5>
            <ul class="nt-check" style="margin:0;"><li><i class="fas fa-check"></i><span>Fast pris, alltid</span></li><li><i class="fas fa-check"></i><span>F-skatt &amp; försäkrade</span></li><li><i class="fas fa-check"></i><span>Egna hantverkare</span></li><li><i class="fas fa-check"></i><span>Garanti på arbetet</span></li></ul>
          </div>
          <div class="nt-side-card">
            <h5>I Upplands Väsby</h5>
            <ul class="nt-side-nav">
              <li><a href="/upplands-vasby">Hantverkare i Upplands Väsby <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/rormokare-upplands-vasby">Rörmokare Upplands Väsby <i class="fas fa-arrow-right"></i></a></li>
