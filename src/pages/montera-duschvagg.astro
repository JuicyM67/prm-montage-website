---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import SectionHeader from '../components/landing/SectionHeader.astro';
import ReviewStrip from '../components/ReviewStrip.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyOfferCard from '../components/StickyOfferCard.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "Montera duschvägg Stockholm — Fast pris | PRM Montage",
  "description": "Montering av duschvägg och duschhörn i Stockholm till fast pris. Fackmannamässig installation av duschvägg i badrum. Kostnadsfri offert.",
  "canonical": "https://prmmontage.se/montera-duschvagg",
  "ogDescription": "Montering av duschvägg, duschhörn och duschkabin i Stockholm — till fast pris av egna hantverkare.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/badrum-06.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Tjänster",
            "item": "https://prmmontage.se/tjanster"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Montera duschvägg"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Montering av duschvägg och duschhörn",
        "name": "Montera duschvägg Stockholm",
        "description": "Montering av duschvägg, duschhörn och duschkabin i Stockholm — till fast pris av egna hantverkare.",
        "provider": organization,
        "areaServed": "Stockholm",
        "url": "https://prmmontage.se/montera-duschvagg"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Vad kostar det att montera en duschvägg?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Priset beror på typ av duschvägg och väggens material — en rak vägg går snabbare än en duschhörna med dörrar. Du får alltid ett fast pris innan arbetet påbörjas, baserat på en kostnadsfri offert."
            }
          },
          {
            "@type": "Question",
            "name": "Monterar ni även duschhörn och duschkabiner?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. Vi monterar raka duschväggar, duschhörnor med två väggar, vikdörrar, skjutdörrar och kompletta duschkabiner."
            }
          },
          {
            "@type": "Question",
            "name": "Kan man borra i kakel utan att det spricker?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja, med rätt borr, lågt varvtal och rätt teknik. Det är här de flesta gör-det-själv-monteringar går fel — en spricka i kaklet kan skada tätskiktet bakom."
            }
          },
          {
            "@type": "Question",
            "name": "Ger montering av duschvägg rätt till ROT-avdrag?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Arbetskostnaden vid montering av duschvägg ger normalt rätt till ROT-avdrag, medan material inte gör det. Läs mer på vår ROT-avdragssida."
            }
          },
          {
            "@type": "Question",
            "name": "Kan ni montera en duschvägg som jag har köpt själv?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. Vi monterar gärna en duschvägg eller duschkabin du redan har köpt."
            }
          },
          {
            "@type": "Question",
            "name": "Vad är skillnaden på duschvägg och duschhörn?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "En duschvägg är en enskild glasvägg. Ett duschhörn har två väggar och bildar ett hörn. Vi monterar båda."
            }
          },
          {
            "@type": "Question",
            "name": "Går det att montera duschvägg när blandaren sitter utanpå väggen?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ofta går det, men väggen behöver passas in kring rören. Beskriv hur det ser ut i badrummet i offertformuläret så bedömer vi vad som är möjligt."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="tjanster" defaultService="VVS & Badrum">
  <!-- =============== BREADCRUMB =============== -->
    <section class="cv-pagehero">
    <div class="cv-container">
      <ul class="cv-crumbs"><li><a href="/">Hem</a></li><li><a href="/tjanster">Tjänster</a></li></ul>
      <h1>Montering av duschvägg i Stockholm</h1>
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--outline-light"><i class="fas fa-phone"></i> Ring 08-520 279 77</a>
      </div>
      <div class="cv-rating cv-rating--light"><span class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span><span>4,9 på Google · 100+ omdömen</span></div>
    </div>
  </section>

  <div class="cv-pageshot-wrap"><div class="cv-container cv-pageshot"><img src="assets/img/projekt/badrum-06.webp" width="1400" height="560" alt="Badrum med monterad duschvägg, utfört av PRM Montage i Stockholm" fetchpriority="high"></div></div>

  <ProofBar />


  

    <section class="cv-section">
    <div class="cv-container cv-layout">
      <article class="cv-prose">
          <span class="nt-eyebrow">Tjänst</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Montera duschvägg och duschhörn — till fast pris</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">PRM Montage monterar duschväggar och duschhörn i hela Stockholm. Vi monterar alla vanliga typer — rak duschvägg mot badkar eller vägg, duschhörna med två väggar, vikbara och skjutbara dörrar samt kompletta duschkabiner.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">En duschvägg måste sitta i lod och vara ordentligt tätad mot vägg och golv för att vattnet ska stanna i duschen. Vi förborrar varsamt i kaklet, monterar med infästning anpassad efter väggens material och silikonfogar där det behövs. Du får alltid ett fast pris innan arbetet påbörjas.</p>
          <div class="cv-btn-row cv-midcta-row">
            <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
          </div>


          <div class="row g-4 mt-10 mb-45">
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-orange);">
                <h3><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Fast pris</h3>
                <p>Du får en tydlig, fast prisbild innan vi sätter igång — inga överraskningar.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-navy);">
                <h3><i class="fas fa-shield-check" style="color:#1FA968;margin-right:8px;"></i>Auktoriserade installatörer</h3>
                <p>Behöriga VVS-installatörer, fullt försäkrade och med garanti på arbetet.</p>
              </div>
            </div>
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad ingår vid montering av duschvägg?</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Demontering av befintlig duschvägg eller duschkabin</span></li>
            <li><i class="fas fa-check-circle"></i><span>Montering av rak duschvägg, duschhörna eller duschkabin</span></li>
            <li><i class="fas fa-check-circle"></i><span>Förborrning i kakel och klinker med rätt teknik</span></li>
            <li><i class="fas fa-check-circle"></i><span>Infästning anpassad efter väggens material</span></li>
            <li><i class="fas fa-check-circle"></i><span>Justering i lod och kontroll av dörrfunktion</span></li>
            <li><i class="fas fa-check-circle"></i><span>Silikonfogning och tätning mot vägg och golv</span></li>
          </ul>

          <div class="mb-45">
            <img src="assets/img/projekt/badrum-08.webp" width="900" height="675" loading="lazy" alt="Duschhörna monterad av PRM Montage i ett badrum i Stockholm" class="w-100" style="border-radius:12px;aspect-ratio:16/9;height:auto;object-fit:cover;">
          </div>

          <h3 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Duschvägg eller duschhörn?</h3>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">En duschvägg är en enskild glasvägg, ofta mot badkar eller i ena sidan av duschen. Ett duschhörn har två väggar och bildar ett hörn. Vi monterar båda, liksom vikbara och skjutbara dörrar.</p>

          <h3 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Duschvägg när rören sitter utanpå väggen</h3>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Sitter blandaren eller rören utanpå väggen kan duschväggen behöva anpassas efter dem. Vi tittar på hur väggen kan passas in kring rören innan vi borrar.</p>

<p class="mb-45" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Vi kommer till Stockholm med omnejd — bland annat <a href="/solna">Solna</a>, <a href="/sundbyberg">Sundbyberg</a>, <a href="/bromma">Bromma</a>, <a href="/danderyd">Danderyd</a>, <a href="/tacby">Täby</a> och <a href="/lidingo">Lidingö</a>.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om montering av duschvägg</h4>
          <div class="accordion nt-accordion mb-45" id="faqDusch">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqDusch1">Vad kostar det att montera en duschvägg?</button></h2>
              <div id="faqDusch1" class="accordion-collapse collapse show" data-bs-parent="#faqDusch"><div class="accordion-body">Priset beror på typ av duschvägg och väggens material — en rak vägg går snabbare än en duschhörna med dörrar. Du får alltid ett fast pris innan arbetet påbörjas, baserat på en kostnadsfri offert.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqDusch2">Monterar ni även duschhörn och duschkabiner?</button></h2>
              <div id="faqDusch2" class="accordion-collapse collapse" data-bs-parent="#faqDusch"><div class="accordion-body">Ja. Vi monterar raka duschväggar, duschhörnor med två väggar, vikdörrar, skjutdörrar och kompletta duschkabiner.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqDusch3">Kan man borra i kakel utan att det spricker?</button></h2>
              <div id="faqDusch3" class="accordion-collapse collapse" data-bs-parent="#faqDusch"><div class="accordion-body">Ja, med rätt borr, lågt varvtal och rätt teknik. Det är här de flesta gör-det-själv-monteringar går fel — en spricka i kaklet kan skada tätskiktet bakom.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqDusch4">Ger montering av duschvägg rätt till ROT-avdrag?</button></h2>
              <div id="faqDusch4" class="accordion-collapse collapse" data-bs-parent="#faqDusch"><div class="accordion-body">Arbetskostnaden vid montering av duschvägg ger normalt rätt till ROT-avdrag, medan material inte gör det. Läs mer på vår <a href="/rut-rot">ROT-avdragssida</a>.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqDusch5">Kan ni montera en duschvägg som jag har köpt själv?</button></h2>
              <div id="faqDusch5" class="accordion-collapse collapse" data-bs-parent="#faqDusch"><div class="accordion-body">Ja. Vi monterar gärna en duschvägg eller duschkabin du redan har köpt.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqDusch6">Vad är skillnaden på duschvägg och duschhörn?</button></h2>
              <div id="faqDusch6" class="accordion-collapse collapse" data-bs-parent="#faqDusch"><div class="accordion-body">En duschvägg är en enskild glasvägg. Ett duschhörn har två väggar och bildar ett hörn. Vi monterar båda.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqDusch7">Går det att montera duschvägg när blandaren sitter utanpå väggen?</button></h2>
              <div id="faqDusch7" class="accordion-collapse collapse" data-bs-parent="#faqDusch"><div class="accordion-body">Ofta går det, men väggen behöver passas in kring rören. Beskriv hur det ser ut i badrummet i offertformuläret så bedömer vi vad som är möjligt.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </article>
      <aside>
        <StickyOfferCard related={[{href:'/byta-blandare',label:'Byta blandare'},{href:'/installera-diskmaskin',label:'Installera diskmaskin'},{href:'/byta-toalettstol',label:'Byta toalettstol'},{href:'/installera-tvattmaskin',label:'Installera tvättmaskin'},{href:'/eluttag-tvattmaskin-diskmaskin',label:'Eluttag till tvätt- & diskmaskin'},{href:'/eluttag-badrum',label:'Eluttag i badrum'},{href:'/laga-lackande-blandare',label:'Laga läckande blandare'},{href:'/byta-handfat-kommod',label:'Byta handfat & kommod'},{href:'/montera-tv-pa-vagg',label:'Montera TV på vägg'},{href:'/handyman-stockholm',label:'Handyman Stockholm'},{href:'/mobelmontering-stockholm',label:'Möbelmontering'},{href:'/byta-las-cylinder',label:'Byta lås & låscylinder'}]} relatedTitle="Fler jobb" />
      </aside>
    </div>
  </section>

  <section class="cv-section cv-section--tint">
    <div class="cv-container">
      <SectionHeader pill="Omdömen" title="Det säger våra kunder" />
      <ReviewStrip count={3} offset={4} job />
    </div>
  </section>


    <FinalCta heading="Ska duschväggen monteras?" />

</BaseLayout>
