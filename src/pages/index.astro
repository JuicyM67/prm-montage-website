---

<BaseLayout seo={seo} activeNav="hem">
  <Fragment slot="head">
    <link rel="preload" as="image" href="assets/img/hero/hero-home.webp" media="(min-width: 768px)">
    <link rel="preload" as="image" href="assets/img/hero/hero-home-mobile.webp" media="(max-width: 767.98px)">
  </Fragment>

  <!-- =============== /NAVBAR =============== -->

  <!-- =============== HERO (statisk, formulär above the fold) =============== -->
  <section class="nt-hero-static">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-lg-7">
          <div class="nt-hero-social">
            <a href="https://www.instagram.com/prmmontageab/" target="_blank" rel="noopener" aria-label="PRM Montage på Instagram"><i class="fab fa-instagram"></i></a>
            <a href="https://www.facebook.com/prmmontageab/" target="_blank" rel="noopener" aria-label="PRM Montage på Facebook"><i class="fab fa-facebook-f"></i></a>
          </div>
          <div class="nt-rating-badge">
            <span class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span>
            <span class="txt">4,9 i betyg på Google &middot; Över 100 recensioner</span>
          </div>
          <h1>Bygg, renovering, VVS &amp; el i Stockholm — <span>till fast pris</span></h1>
          <p class="nt-hero-lead">PRM Montage AB är din lokala hantverksfirma i Solna. Vi hjälper dig med kök, badrum, bygg &amp; renovering, el och altan — med egna hantverkare, F-skatt, försäkring och alltid ett fast pris innan vi börjar.</p>
          <div class="nt-trust-row mb-10">
            <span><i class="fas fa-shield-check"></i> F-skatt &amp; försäkrat</span>
            <span><i class="fas fa-tags"></i> Alltid fast pris</span>
            <span><i class="fas fa-user-group"></i> Egna hantverkare</span>
            <span><i class="fas fa-clock"></i> Jour dygnet runt</span>
          </div>
        </div>
        <div class="col-lg-5">
          <div class="nt-hero-form-card">
            <h3>Kostnadsfri offert</h3>
            <p class="nt-form-sub">Fyll i formuläret så återkommer vi till dig — helt utan kostnad eller förpliktelser.</p>
            <div class="nt-form-message"></div>
            <form class="nt-ajax-form" data-form-type="offert">
              <div class="nt-form-field">
                <label>Namn *</label>
                <input type="text" name="name" required placeholder="Förnamn Efternamn">
              </div>
              <div class="nt-form-row2">
                <div class="nt-form-field">
                  <label>Telefon *</label>
                  <input type="tel" name="phone" required placeholder="070-123 45 67">
                </div>
                <div class="nt-form-field">
                  <label>E-post</label>
                  <input type="email" name="email" placeholder="valfritt">
                </div>
              </div>
              <div class="nt-form-row3">
                <div class="nt-form-field">
                  <label>Adress *</label>
                  <input type="text" name="address" required placeholder="Gatuadress">
                </div>
                <div class="nt-form-field">
                  <label>Postnummer *</label>
                  <input type="text" name="postalCode" required inputmode="numeric" placeholder="123 45">
                </div>
                <div class="nt-form-field">
                  <label>Stad *</label>
                  <input type="text" name="city" required placeholder="T.ex. Solna">
                </div>
              </div>
              <div class="nt-form-field">
                <label>Vad vill du ha hjälp med? *</label>
                <select name="service" required>
                  <option value="">— Välj tjänst —</option>
                  <option>Köksrenovering</option>
                  <option>Bygg &amp; renovering</option>
                  <option>VVS &amp; Badrum</option>
                  <option>Elektriker</option>
                  <option>Altanbygge</option>
                  <option>Jour / akut</option>
                  <option>Annat</option>
                </select>
              </div>
              <div class="nt-form-field">
                <label>Kort beskrivning</label>
                <textarea name="message" placeholder="Berätta gärna lite om projektet..."></textarea>
              </div>
              <div class="nt-form-field">
                <label>Bifoga bilder (valfritt)</label>
                <div class="nt-file-field"><input type="file" name="files" accept="image/*,.pdf" multiple>
                  <p class="nt-file-hint">Max 3 filer, totalt 10 MB.</p>
                </div>
              </div>
              <button type="submit" class="nt-form-submit">Skicka förfrågan &rarr;</button>
              <p class="nt-form-fineprint">Inget köptvång. Vi återkommer till dig personligen.</p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- =============== /HERO =============== -->

  <!-- =============== TRYGGHETSPUNKTER =============== -->
  <div class="tp-feature-area tp-feature-4-wrap pt-90 pb-60 fix" style="background:var(--nt-white);">
    <div class="container">
      <div class="tp-border-bottom pb-30">
        <div class="row gx-60">
          <div class="col-lg-4 col-md-6 tp-counter-3-border">
            <div class="tp-feature-3-wrap tpshake-wrap d-flex md-space wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
              <span class="mr-25 nt-icon-card__icon" style="margin-bottom:0;flex-shrink:0;"><i class="fas fa-file-invoice-dollar"></i></span>
              <div>
                <h3 class="fs-24 fw-600 mb-10" style="color:var(--nt-navy);">Alltid fast pris</h3>
                <p style="color:var(--nt-gray);margin:0;">Du får en tydlig prisbild innan vi sätter igång — inga överraskningar på fakturan.</p>
              </div>
            </div>
          </div>
          <div class="col-lg-4 col-md-6 tp-counter-3-border">
            <div class="tp-feature-3-wrap tpshake-wrap d-flex md-space wow fadeInUp" data-wow-delay=".3s" data-wow-duration=".9s">
              <span class="mr-25 nt-icon-card__icon" style="margin-bottom:0;flex-shrink:0;"><i class="fas fa-user-group"></i></span>
              <div>
                <h3 class="fs-24 fw-600 mb-10" style="color:var(--nt-navy);">Allt under ett tak</h3>
                <p style="color:var(--nt-gray);margin:0;">Egna hantverkare inom bygg, VVS, el och snickeri — du slipper samordna flera företag.</p>
              </div>
            </div>
          </div>
          <div class="col-lg-4 col-md-6">
            <div class="tp-feature-3-wrap tpshake-wrap d-flex md-space wow fadeInUp" data-wow-delay=".4s" data-wow-duration=".9s">
              <span class="mr-25 nt-icon-card__icon" style="margin-bottom:0;flex-shrink:0;"><i class="fas fa-shield-check"></i></span>
              <div>
                <h3 class="fs-24 fw-600 mb-10" style="color:var(--nt-navy);">Försäkrat &amp; F-skatt</h3>
                <p style="color:var(--nt-gray);margin:0;">PRM Montage AB innehar F-skatt och är fullt försäkrat under varje uppdrag.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- =============== /TRYGGHETSPUNKTER =============== -->

  <!-- =============== OM OSS =============== -->
  <div class="tp-about-area pt-130 pb-110">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6 mb-40">
          <div class="tp-benifits-4-thumb p-relative mr-50">
            <div class="nt-media wow img-custom-anim-left" data-wow-duration="1.5s" data-wow-delay="0.2s">
              <img src="assets/img/projekt/kok-03.webp" width="900" height="675" loading="lazy" alt="Köksrenovering utförd av PRM Montage i Stockholm">
            </div>
            <div class="p-absolute text-center" style="top:-26px;left:-18px;background:var(--nt-orange);color:#fff;border-radius:14px;padding:20px 24px;box-shadow:0 16px 34px rgba(31,169,104,.35);">
              <h4 style="color:#fff;font-size:2rem;font-weight:700;margin:0;line-height:1;">2022</h4>
              <span style="font-size:.82rem;opacity:.9;">Grundades i Solna</span>
            </div>
          </div>
        </div>
        <div class="col-lg-6 mb-40">
          <div class="tp-about-2-content tp-about-4-content ml-30">
            <span class="nt-eyebrow">Om PRM Montage</span>
            <h2 class="mb-25 fs-xl-40 fs-sm-36 wow img-custom-anim-top" data-wow-duration="1.5s" data-wow-delay="0.2s">Din moderna hantverkare i Stockholm</h2>
            <p class="mb-20" style="color:var(--nt-gray);line-height:1.8;">PRM Montage AB är ett väletablerat bygg- och hantverksföretag med säte på Industrivägen 19 i Solna. Vi gör det enklare att ta hand om både stora och små jobb — till fast pris, med certifierade hantverkare och korta väntetider.</p><p class="mb-20" style="color:var(--nt-gray);line-height:1.8;">Vi samlar kompetens inom bygg, snickeri, VVS och el under ett och samma tak, vilket gör att du som kund slipper anlita och samordna flera olika företag för ditt projekt.</p>
            <div class="tp-about-bottom-feature mb-40 mt-30"><ul><li><i class="fa-sharp fa-solid fa-check"></i> Egna hantverkare inom bygg, VVS, el och snickeri</li><li><i class="fa-sharp fa-solid fa-check"></i> F-skatt, försäkring och fasta priser på alla jobb</li><li><i class="fa-sharp fa-solid fa-check"></i> Baserade i Solna — arbetar i hela Stockholm, från norr till söder</li></ul></div>
            <a href="/om-oss" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center">
                <span class="btn-text">Läs mer om oss</span>
                <span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span>
                <span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span>
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- =============== /OM OSS =============== -->

  <!-- =============== TJÄNSTER =============== -->
  <div class="tp-service-area pt-130 pb-100" style="background:var(--nt-white);">
    <div class="container">
      <div class="row align-items-end mb-60">
        <div class="col-lg-8">
          <span class="nt-eyebrow">Våra tjänster</span>
          <h2 class="fs-xl-40 fs-sm-36 wow img-custom-anim-left" data-wow-duration="1.5s" data-wow-delay="0.2s">Hjälp med hela hemmet — från kök till altan</h2>
        </div>
        <div class="col-lg-4">
          <div class="text-lg-end mt-25">
            <a href="/tjanster" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center">
                <span class="btn-text">Se alla tjänster</span>
                <span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span>
                <span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span>
              </span>
            </a>
          </div>
        </div>
      </div>
      <div class="row g-4">
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <span class="nt-badge-popular">Populär</span>
            <div class="nt-icon-card__icon"><i class="fas fa-utensils"></i></div>
            <h4><a href="/koksrenovering-stockholm">Köksrenovering Stockholm</a></h4>
