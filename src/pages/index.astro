---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import ReviewStrip from '../components/ReviewStrip.astro';
import FaqSection from '../components/FaqSection.astro';
import FinalCta from '../components/FinalCta.astro';

const faqs = [
  {
    "q": "Vad kostar det?",
    "a": "Du får alltid ett fast pris innan vi startar, baserat på en kostnadsfri offert. Beskriv jobbet i formuläret så återkommer vi."
  },
  {
    "q": "Hur snabbt kan ni komma?",
    "a": "Hör av dig så ger vi en aktuell bild av när vi kan boka in jobbet. Vid akuta läckor eller elfel rycker vi ut dygnet runt — ring 08-520 279 77."
  },
  {
    "q": "Tar ni även små jobb?",
    "a": "Ja. Allt från att byta blandare eller lås till montering av möbler, hyllor och TV — se <a href=\"/handyman-stockholm\">Handyman Stockholm</a>. Samla gärna flera småjobb så tar vi dem vid samma besök."
  },
  {
    "q": "Vilka områden arbetar ni i?",
    "a": "Vi arbetar i hela Stockholm med omnejd, bland annat Solna, Sundbyberg, Bromma, Danderyd, Täby, Lidingö, Södermalm och Upplands Väsby — samt i Uppsala."
  },
  {
    "q": "Har ni F-skatt och försäkring?",
    "a": "Ja. PRM Montage AB (org.nr 559377-9621) innehar F-skatt och är försäkrat under varje uppdrag, och vi lämnar garanti på utfört arbete."
  },
  {
    "q": "Får jag ROT-avdrag?",
    "a": "Arbetskostnaden ger normalt rätt till ROT-avdrag, medan material inte gör det. Vi hjälper dig räkna på avdraget i offerten — läs mer på <a href=\"/rut-rot\">sidan om ROT-avdrag</a>."
  }
];

