---
import BaseLayout from '../layouts/BaseLayout.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "Köksrenovering & köksmontering Uppsala | PRM Montage",
  "description": "Köksrenovering och köksmontering i Uppsala till fast pris. Vi monterar kök i villor och lägenheter — stomme, luckor, bänkskiva. Planerade besök, kostnadsfri offert.",
  "canonical": "https://prmmontage.se/koksmontering-uppsala",
  "ogDescription": "Köksmontering i Uppsala till fast pris — professionell montering av kök, oavsett varumärke.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/hero-kok.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Köksmontering Uppsala"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Köksmontering",
        "name": "Köksmontering Uppsala",
        "description": "Montering av kök du redan köpt — stomme, luckor, bänkskiva och infästning, till fast pris i Uppsala.",
        "provider": organization,
        "areaServed": "Uppsala",
        "url": "https://prmmontage.se/koksmontering-uppsala"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Kommer ni till Uppsala för köksmontering?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. Uppsala ligger drygt sju mil från vårt kontor i Solna, så vi planerar monteringen i förväg i stället för att komma ut samma dag."
            }
          },
          {
            "@type": "Question",
            "name": "Monterar ni i både villor och lägenheter i Uppsala?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja, i villor i områden som Sunnersta och Norby och i lägenheter i centrala Uppsala."
            }
          },
          {
            "@type": "Question",
            "name": "Kan ni boka monteringen efter kökets leveransdatum?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. Kök levereras med några veckors ledtid, och vi lägger monteringen så att den följer leveransen."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} defaultService="Köksrenovering">
  <!-- =============== BREADCRUMB =============== -->
  <div class="tp-breadcrumb-area tp-breadcrumb-spacing nt-dark-band pt-180 pb-90" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container">
      <div class="row"><div class="col-xl-8 col-lg-9">
        <div class="tp-breadcrumb-content">
          <h1 class="tp-breadcrumb-title fw-600 fs-60 fs-xs-40 ls-m-3 tp-text-common-white lh-1 mb-20">Köksrenovering &amp; köksmontering i Uppsala</h1>
          <p style="color:rgba(255,255,255,.78);font-size:1.02rem;max-width:620px;margin-bottom:18px;">Fast pris och professionell montering av kök i Uppsala — oavsett varumärke.</p>
          <div class="tp-breadcrumb-dvdr"><ul><li><a href="/">Hem</a></li><li class="dvdr">/</li><li>Köksmontering Uppsala</li></ul></div>
        </div>
      </div></div>
    </div>
  </div>

  <div class="tp-service-details-area pt-100 pb-120" style="background:var(--nt-white);">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8">
          <span class="nt-eyebrow">Uppsala</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Professionell köksmontering, planerad i förväg</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Uppsala ligger drygt sju mil från vårt kontor i Solna, vilket gör att vi planerar in köksmontering i förväg snarare än att komma ut samma dag. Det passar bra ihop med hur köksmontering fungerar i praktiken — kök beställs och levereras med några veckors ledtid oavsett, vilket ger oss gott om tid att boka in ett besök som passar både dig och vår planering.</p>

          <div class="nt-highlight mb-45">
            <h5><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Planerad montering, fast pris</h5>
            <p>Eftersom vi planerar besöket i förväg kan vi lämna ett tydligt fast pris för hela monteringen.</p>
          </div>

          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Montering utgår från ett kök som redan är beställt. Behöver bostaden nya vattenledningar, nya eluttag eller rivning är det en köksrenovering. Vi monterar kök i villor i områden som Sunnersta och Norby och i lägenheter i centrala Uppsala, och anpassar arbetet efter förutsättningarna.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad ingår i köksmonteringen?</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Stommar och skåp som står i våg</span></li>
            <li><i class="fas fa-check-circle"></i><span>Luckor som riktas in med jämna springor</span></li>
            <li><i class="fas fa-check-circle"></i><span>Bänkskiva som monteras mot vägg</span></li>
            <li><i class="fas fa-check-circle"></i><span>Lister och sockel som avslutar köket</span></li>
            <li><i class="fas fa-check-circle"></i><span>Inkoppling av disk och blandare på önskemål</span></li>
          </ul>

          <div class="mb-45">
            <img src="assets/img/projekt/kok-02.webp" width="900" height="675" loading="lazy" alt="Monterat kök i Uppsala" class="w-100" style="border-radius:12px;aspect-ratio:16/9;height:auto;object-fit:cover;">
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Så går det till</h4>
          <div class="row g-4 gy-5 mb-45">
            <div class="col-md-4">
              <div class="nt-step h-100">
                <span class="nt-step__num">01</span>
                <h4>Kostnadsfri offert</h4>
                <p>Berätta om köket och bostaden, med mått och leverantör, så får du ett fast pris på monteringen.</p>
              </div>
            </div>
            <div class="col-md-4">
              <div class="nt-step h-100">
                <span class="nt-step__num">02</span>
                <h4>Montering bokas in</h4>
                <p>Vi bokar monteringen i förväg, i takt med kökets leverans, eftersom resan från Solna ska planeras.</p>
              </div>
            </div>
            <div class="col-md-4">
              <div class="nt-step h-100">
                <span class="nt-step__num">03</span>
                <h4>Färdigt kök</h4>
                <p>Köket monteras och justeras, och vi går igenom det med dig innan vi åker tillbaka.</p>
              </div>
            </div>
          </div>

          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">För större ombyggnad med rivning, VVS eller el, se <a href="/koksrenovering-stockholm">Köksrenovering Stockholm</a>. Kök från IKEA finns under <a href="/ikea-koksmontering-uppsala">IKEA-köksmontering i Uppsala</a>. Läs även om <a href="/rut-rot">ROT-avdraget</a>.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om köksmontering i Uppsala</h4>
          <div class="accordion nt-accordion mb-45" id="faqKoksmUpp">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqKoksmUpp1">Kommer ni till Uppsala för köksmontering?</button></h2>
              <div id="faqKoksmUpp1" class="accordion-collapse collapse show" data-bs-parent="#faqKoksmUpp"><div class="accordion-body">Ja. Uppsala ligger drygt sju mil från vårt kontor i Solna, så vi planerar monteringen i förväg i stället för att komma ut samma dag.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqKoksmUpp2">Monterar ni i både villor och lägenheter i Uppsala?</button></h2>
              <div id="faqKoksmUpp2" class="accordion-collapse collapse" data-bs-parent="#faqKoksmUpp"><div class="accordion-body">Ja, i villor i områden som Sunnersta och Norby och i lägenheter i centrala Uppsala.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqKoksmUpp3">Kan ni boka monteringen efter kökets leveransdatum?</button></h2>
              <div id="faqKoksmUpp3" class="accordion-collapse collapse" data-bs-parent="#faqKoksmUpp"><div class="accordion-body">Ja. Kök levereras med några veckors ledtid, och vi lägger monteringen så att den följer leveransen.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="nt-side-card nt-side-card--navy" style="background:var(--nt-navy);">
            <h4 style="color:#fff;font-weight:700;margin-bottom:24px;">Kontakta oss direkt</h4>
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-phone" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">Ring oss</p><a href="tel:+46852027977" style="color:#fff;font-weight:700;font-size:1.05rem;text-decoration:none;">08-520 279 77</a></div>
            </div>
            <div style="display:flex;align-items:center;gap:14px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-envelope" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">E-post</p><a href="mailto:info@pro-montage.se" style="color:#fff;font-weight:700;text-decoration:none;">info@pro-montage.se</a></div>
            </div>
          </div>
          <div class="nt-side-card">
            <h5>Relaterat</h5>
            <ul class="nt-side-nav">
              <li><a href="/ikea-koksmontering-uppsala">IKEA-köksmontering Uppsala <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/koksrenovering-stockholm">Köksrenovering Stockholm <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
          <div class="nt-side-card">
            <h5>Fler områden</h5>
            <ul class="nt-side-nav">
              <li><a href="/koksmontering-solna">Köksmontering Solna <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/koksmontering-sundbyberg">Köksmontering Sundbyberg <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/koksmontering-upplands-vasby">Köksmontering Upplands Väsby <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/koksmontering-danderyd">Köksmontering Danderyd <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/koksmontering-bromma">Köksmontering Bromma <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/koksmontering-tacby">Köksmontering Täby <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/uppsala">Alla tjänster i Uppsala <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="tp-cta-area nt-dark-band pt-120 pb-120" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container"><div class="row"><div class="col-xl-8 col-lg-10">
      <span class="nt-eyebrow nt-eyebrow-light">Redo att börja?</span>
      <h2 class="mb-15 fs-xl-40 fs-sm-36 tp-text-common-white">Dags att förverkliga ditt drömkök?</h2>
      <p class="mb-40" style="color:rgba(255,255,255,0.78);font-size:1.05rem;max-width:620px;">Kontakta oss idag — fast pris, egna hantverkare, kostnadsfri offert.</p>
      <div class="d-flex flex-wrap align-items-center gap-4">
        <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500"><span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span></a>
        <a href="tel:+46852027977" class="d-inline-flex align-items-center gap-3" style="text-decoration:none;"><span style="width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;"><i class="fas fa-phone" style="color:#1FA968;"></i></span><span><span style="display:block;color:rgba(255,255,255,0.6);font-size:.8rem;">Ring oss direkt</span><span style="display:block;color:#fff;font-weight:700;font-size:1.05rem;">08-520 279 77</span></span></a>
      </div>
    </div></div></div>
  </div>
</BaseLayout>
