---
import BaseLayout from '../layouts/BaseLayout.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "Altanbygge i Stockholm — Fast pris | PRM Montage",
  "description": "Altanbygge i Stockholm till fast pris. Skräddarsydda altaner och uteplatser — från planering och bygglovshantering till slutbesiktning. Kostnadsfri offert.",
  "canonical": "https://prmmontage.se/altanbygge-i-stockholm",
  "ogDescription": "Altanbygge i Stockholm till fast pris — skräddarsydda altaner och uteplatser från planering till slutbesiktning.",
  "ogImage": "https://prmmontage.se/assets/img/logo/logo-color.png",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Tjänster",
            "item": "https://prmmontage.se/tjanster"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Altanbygge i Stockholm"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Altanbygge",
        "name": "Altanbygge i Stockholm",
        "description": "Altanbygge i Stockholm till fast pris — skräddarsydda altaner och uteplatser från planering till slutbesiktning.",
        "provider": organization,
        "areaServed": "Stockholm",
        "url": "https://prmmontage.se/altanbygge-i-stockholm"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Vad kostar en altan?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Priset beror på altanens storlek, konstruktion och materialval. Vi lämnar alltid ett fast pris efter offert, innan arbetet påbörjas."
            }
          },
          {
            "@type": "Question",
            "name": "Behöver jag bygglov för min altan?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Om du behöver bygglov för din altan beror på höjd, placering och din kommuns regler. Vi hjälper dig reda ut vad som gäller och sköter bygglovsprocessen vid behov."
            }
          },
          {
            "@type": "Question",
            "name": "Hur lång tid tar ett altanbygge?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Tidsåtgången beror på altanens storlek och utformning. Du får en tydlig tidsplan i samband med offerten."
            }
          },
          {
            "@type": "Question",
            "name": "Ger altanbygge rätt till ROT-avdrag?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Arbetskostnaden för altanbygge ger normalt rätt till ROT-avdrag, medan material inte gör det. Läs mer på vår ROT-avdragssida."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="tjanster" defaultService="Altanbygge">
  <!-- =============== BREADCRUMB =============== -->
  <div class="tp-breadcrumb-area tp-breadcrumb-spacing nt-dark-band pt-180 pb-90" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container">
      <div class="row"><div class="col-xl-8 col-lg-9">
        <div class="tp-breadcrumb-content">
          <h1 class="tp-breadcrumb-title fw-600 fs-60 fs-xs-40 ls-m-3 tp-text-common-white lh-1 mb-20">Altanbygge i Stockholm</h1>
          <div class="tp-breadcrumb-dvdr"><ul><li><a href="/">Hem</a></li><li class="dvdr">/</li><li><a href="/tjanster">Tjänster</a></li><li class="dvdr">/</li><li>Altanbygge i Stockholm</li></ul></div>
        </div>
      </div></div>
    </div>
  </div>

  <div class="tp-service-details-area pt-70 pb-120" style="background:var(--nt-white);">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8">
          <span class="nt-eyebrow">Tjänst</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Altanbygge i Stockholm — till fast pris</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Drömmer du om en ny altan eller uteplats? PRM Montage bygger skräddarsydda altaner över hela Stockholmsområdet, oavsett om projektet är litet eller stort. Vi hjälper dig genom hela processen — från planering och eventuell bygglovshantering till materialval och slutbesiktning — så att du kan luta dig tillbaka och se altanen växa fram.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Vi har egna hantverkare inom bygg och snickeri, vilket gör att vi kan hantera altanbygget som ett samlat projekt med fast pris. Du vet alltid vad som gäller innan arbetet påbörjas.</p>

          <div class="row g-4 mt-10 mb-45">
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-orange);">
                <h5><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Fast pris</h5>
                <p>Du får en tydlig, fast prisbild innan vi sätter igång — inga överraskningar.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-navy);">
                <h5><i class="fas fa-user-group" style="color:#1FA968;margin-right:8px;"></i>Från idé till besiktning</h5>
                <p>Vi hjälper till med planering, bygglov vid behov och slutbesiktning.</p>
              </div>
            </div>
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad ingår i altanbygget?</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Planering och skräddarsydd design</span></li>
            <li><i class="fas fa-check-circle"></i><span>Hjälp med bygglovsfrågor vid behov</span></li>
            <li><i class="fas fa-check-circle"></i><span>Materialval anpassat efter budget och stil</span></li>
            <li><i class="fas fa-check-circle"></i><span>Grund-, stom- och trädäcksarbete</span></li>
            <li><i class="fas fa-check-circle"></i><span>Räcken, trappor och belysning</span></li>
            <li><i class="fas fa-check-circle"></i><span>Slutbesiktning</span></li>
          </ul>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om altanbygge</h4>
          <div class="accordion nt-accordion mb-45" id="faqAltan">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqAltan1">Vad kostar en altan?</button></h2>
              <div id="faqAltan1" class="accordion-collapse collapse show" data-bs-parent="#faqAltan"><div class="accordion-body">Priset beror på altanens storlek, konstruktion och materialval. Vi lämnar alltid ett fast pris efter offert, innan arbetet påbörjas.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqAltan2">Behöver jag bygglov för min altan?</button></h2>
              <div id="faqAltan2" class="accordion-collapse collapse" data-bs-parent="#faqAltan"><div class="accordion-body">Om du behöver bygglov för din altan beror på höjd, placering och din kommuns regler. Vi hjälper dig reda ut vad som gäller och sköter bygglovsprocessen vid behov.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqAltan3">Hur lång tid tar ett altanbygge?</button></h2>
              <div id="faqAltan3" class="accordion-collapse collapse" data-bs-parent="#faqAltan"><div class="accordion-body">Tidsåtgången beror på altanens storlek och utformning. Du får en tydlig tidsplan i samband med offerten.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqAltan4">Ger altanbygge rätt till ROT-avdrag?</button></h2>
              <div id="faqAltan4" class="accordion-collapse collapse" data-bs-parent="#faqAltan"><div class="accordion-body">Arbetskostnaden för altanbygge ger normalt rätt till ROT-avdrag, medan material inte gör det. Läs mer på vår <a href="/rut-rot">ROT-avdragssida</a>.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="nt-side-card nt-side-card--navy" style="background:var(--nt-navy);">
            <h4 style="color:#fff;font-weight:700;margin-bottom:24px;">Kontakta oss direkt</h4>
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-phone" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">Ring oss</p><a href="tel:+46852027977" style="color:#fff;font-weight:700;font-size:1.05rem;text-decoration:none;">08-520 279 77</a></div>
            </div>
            <div style="display:flex;align-items:center;gap:14px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-envelope" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">E-post</p><a href="mailto:info@pro-montage.se" style="color:#fff;font-weight:700;text-decoration:none;">info@pro-montage.se</a></div>
            </div>
          </div>
          <div class="nt-side-card">
            <h5>Varför PRM Montage?</h5>
            <ul class="nt-check" style="margin:0;"><li><i class="fas fa-check"></i><span>Fast pris, alltid</span></li><li><i class="fas fa-check"></i><span>F-skatt &amp; försäkrade</span></li><li><i class="fas fa-check"></i><span>Egna hantverkare</span></li><li><i class="fas fa-check"></i><span>Garanti på arbetet</span></li></ul>
          </div>
          <div class="nt-side-card">
            <h5>Alla tjänster</h5>
            <ul class="nt-side-nav">
              <li><a href="/koksrenovering-stockholm">Köksrenovering Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/bygg-renovering">Bygg &amp; renovering <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/vvs-badrum">VVS &amp; Badrum <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/elektriker-stockholm">Elektriker Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li class="is-active"><a href="/altanbygge-i-stockholm">Altanbygge i Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/jour">Jour — akut hjälp <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="tp-cta-area nt-dark-band pt-120 pb-120" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container"><div class="row"><div class="col-xl-8 col-lg-10">
      <span class="nt-eyebrow nt-eyebrow-light">Redo att börja?</span>
      <h2 class="mb-15 fs-xl-40 fs-sm-36 tp-text-common-white">Dags att bygga din drömaltan?</h2>
      <p class="mb-40" style="color:rgba(255,255,255,0.78);font-size:1.05rem;max-width:620px;">Kontakta oss idag — fast pris, egna hantverkare, kostnadsfri offert.</p>
      <div class="d-flex flex-wrap align-items-center gap-4">
        <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500"><span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span></a>
        <a href="tel:+46852027977" class="d-inline-flex align-items-center gap-3" style="text-decoration:none;"><span style="width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;"><i class="fas fa-phone" style="color:#1FA968;"></i></span><span><span style="display:block;color:rgba(255,255,255,0.6);font-size:.8rem;">Ring oss direkt</span><span style="display:block;color:#fff;font-weight:700;font-size:1.05rem;">08-520 279 77</span></span></a>
      </div>
    </div></div></div>
  </div>
</BaseLayout>
