---
import SmallJobPage from '../components/SmallJobPage.astro';

const page = {
  "slug": "handyman-stockholm",
  "highlights": [
    {
      "icon": "fa-file-invoice-dollar",
      "title": "Fast pris",
      "text": "Du får en tydlig, fast prisbild innan vi sätter igång — inga överraskningar."
    },
    {
      "icon": "fa-user-group",
      "title": "Egna hantverkare",
      "text": "Du möter samma hantverkare som utför jobbet, med garanti på arbetet."
    }
  ],
  "related": [
    {
      "href": "/mobelmontering-stockholm",
      "label": "Möbelmontering"
    },
    {
      "href": "/montera-hyllor-tavlor-gardinstanger",
      "label": "Hyllor, tavlor & gardinstänger"
    },
    {
      "href": "/montera-tv-pa-vagg",
      "label": "Montera TV på vägg"
    },
    {
      "href": "/byta-las-cylinder",
      "label": "Byta lås & låscylinder"
    },
    {
      "href": "/montera-dorr-dorrstangare",
      "label": "Dörr & dörrstängare"
    },
    {
      "href": "/byta-blandare",
      "label": "Byta blandare"
    },
    {
      "href": "/byta-toalettstol",
      "label": "Byta toalettstol"
    },
    {
      "href": "/byta-varmvattenberedare",
      "label": "Byta varmvattenberedare"
    },
    {
      "href": "/byta-termostat-element",
      "label": "Byta termostat på element"
    },
    {
      "href": "/byta-eluttag-stromstallare",
      "label": "Byta eluttag & strömbrytare"
    },
    {
      "href": "/montera-taklampa",
      "label": "Montera taklampa & spotlights"
    }
  ],
  "eyebrow": "Tjänst",
  "crumbs": [],
  "title": "Handyman Stockholm — Montering & småjobb | PRM Montage",
  "description": "Handyman i Stockholm för montering och småjobb: möbler, hyllor, TV, lås, blandare och mer. Egna hantverkare, fast pris och kostnadsfri offert.",
  "heroImage": "assets/img/projekt/bygg-02.webp",
  "heroAlt": "Arbete utfört av PRM Montage i Stockholm",
  "h1": "Handyman i Stockholm",
  "lead": "Montering, byten och småfix. Snabbt och snyggt utfört av våra egna hantverkare.",
  "h2": "Handyman för monterings- och småjobb i hela Stockholm",
  "intro": [
    "Behöver du hjälp med de jobb som aldrig blir av? PRM Montage är handyman i Stockholm för både monterings- och småjobb: vi sätter upp hyllor och gardinstänger, monterar möbler och TV, byter lås och blandare och fixar det som krånglar hemma. Du får hjälp av våra egna hantverkare.",
    "Jobben är små men ska ändå bli rätt. Vi tar med rätt verktyg och rätt infästning för just din vägg och lämnar rent efter oss. Beskriv vad du vill ha gjort i offertformuläret, gärna med foton, så återkommer vi med besked om hur vi kan hjälpa till."
  ],
  "sections": [
    {
      "h": "Det här hjälper vi till med",
      "list": [
        "<a href=\"/mobelmontering-stockholm\">Möbelmontering och IKEA-montering</a> — garderober, byråer, sängar och förvaring",
        "<a href=\"/montera-hyllor-tavlor-gardinstanger\">Hyllor, tavlor, speglar och gardinstänger</a>",
        "<a href=\"/montera-tv-pa-vagg\">TV på vägg</a> med rätt fäste och dolda kablar",
        "<a href=\"/byta-las-cylinder\">Byta lås och låscylinder</a> samt <a href=\"/montera-dorr-dorrstangare\">dörrar och dörrstängare</a>",
        "<a href=\"/byta-blandare\">Byta blandare</a>, <a href=\"/byta-toalettstol\">toalettstol</a> och <a href=\"/byta-handfat-kommod\">handfat</a>",
        "<a href=\"/byta-eluttag-stromstallare\">Byta eluttag och strömbrytare</a> samt <a href=\"/montera-taklampa\">montera lampor</a>"
      ]
    },
    {
      "h": "Så går det till",
      "paras": [
        "1. Du beskriver jobbet och skickar gärna foton. 2. Vi bekräftar vad vi kan hjälpa till med och bokar en tid. 3. Vi utför jobbet och går igenom resultatet med dig. Har du flera småjobb — samla dem, så tar vi dem vid samma besök."
      ]
    },
    {
      "h": "Handyman i ditt område",
      "paras": [
        "Vi kommer till Stockholm med omnejd — bland annat <a href=\"/handyman-solna\">Solna</a>, <a href=\"/handyman-sundbyberg\">Sundbyberg</a>, <a href=\"/handyman-bromma\">Bromma</a>, <a href=\"/handyman-danderyd\">Danderyd</a>, <a href=\"/handyman-taby\">Täby</a> och <a href=\"/handyman-lidingo\">Lidingö</a>."
      ]
    }
  ],
  "faqs": [
    {
      "q": "Vad kan en handyman hjälpa till med?",
      "a": "Allt från montering av möbler, hyllor och TV till byte av lås, blandare och toalettstol. Beskriv jobbet i offertformuläret så berättar vi om och hur vi kan hjälpa till."
    },
    {
      "q": "Kan ni ta flera småjobb vid samma besök?",
      "a": "Ja, och det är ofta smart. Samla gärna flera småjobb så ordnar vi dem vid samma tillfälle."
    },
    {
      "q": "Vilka områden kommer ni till?",
      "a": "Vi kommer till Stockholm med omnejd, bland annat Solna, Sundbyberg, Bromma, Danderyd, Täby och Lidingö."
    },
    {
      "q": "Hur får jag ett pris?",
      "a": "Du får ett fast pris innan vi startar, baserat på en kostnadsfri offert. Beskriv jobbet och skicka gärna foton."
    }
  ],
  "serviceType": "Handyman och montering",
  "serviceName": "Handyman Stockholm",
  "defaultService": "Montering & handyman",
  "ctaHeading": "Har du något som behöver fixas?"
};
---
<SmallJobPage {...page} />
