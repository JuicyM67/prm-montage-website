---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import SectionHeader from '../components/landing/SectionHeader.astro';
import ReviewStrip from '../components/ReviewStrip.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyOfferCard from '../components/StickyOfferCard.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "Köksrenovering & köksmontering Sundbyberg | PRM Montage",
  "description": "Köksrenovering och köksmontering i Sundbyberg till fast pris. Kort startsträcka från vårt kontor i Solna — vi monterar kök i både nyproduktion och äldre fastigheter.",
  "canonical": "https://prmmontage.se/koksmontering-sundbyberg",
  "ogDescription": "Köksmontering i Sundbyberg till fast pris — kort startsträcka från vårt kontor i Solna.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/hero-kok.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Köksmontering Sundbyberg"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Köksmontering",
        "name": "Köksmontering Sundbyberg",
        "description": "Montering av kök du redan köpt — stomme, luckor, bänkskiva och infästning, till fast pris i Sundbyberg.",
        "provider": organization,
        "areaServed": "Sundbyberg",
        "url": "https://prmmontage.se/koksmontering-sundbyberg"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Kan ni montera ett kök som följer med ett nyproduktionsprojekt i Sundbyberg?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. När köket är beställt via byggherren eller en kökshandlare men monteringen inte ingår, tar vi den delen."
            }
          },
          {
            "@type": "Question",
            "name": "Hur snabbt kommer ni till Sundbyberg?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Kommunen gränsar till Solna, där vårt kontor ligger, så vägen är kort och vi kan ofta boka med litet varsel."
            }
          },
          {
            "@type": "Question",
            "name": "Går det bra att montera i äldre lägenheter?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. Vi kontrollerar väggar och golv vid offerten och anpassar monteringen efter hur det ser ut."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} defaultService="Köksrenovering">
  <!-- =============== BREADCRUMB =============== -->
    <section class="cv-pagehero">
    <div class="cv-container">
      <ul class="cv-crumbs"><li><a href="/">Hem</a></li></ul>
      <h1>Köksrenovering &amp; köksmontering i Sundbyberg</h1>
      <p class="cv-pagehero__lead">Fast pris, kort startsträcka från Solna och montering av nya och befintliga kök i Sundbyberg.</p>
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--outline-light"><i class="fas fa-phone"></i> Ring 08-520 279 77</a>
      </div>
      <div class="cv-rating cv-rating--light"><span class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span><span>4,9 på Google · 100+ omdömen</span></div>
    </div>
  </section>

  <div class="cv-pageshot-wrap"><div class="cv-container cv-pageshot"><img src="assets/img/projekt/hero-kok.webp" width="1400" height="560" alt="Kök monterat av PRM Montage i Stockholm" fetchpriority="high"></div></div>

  <ProofBar />


    <section class="cv-section">
    <div class="cv-container cv-layout">
      <article class="cv-prose">
          <span class="nt-eyebrow">Sundbyberg</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Köksmontering nära till hands från Solna</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Sundbyberg gränsar direkt till Solna, där PRM Montage har sitt kontor på Industrivägen 19 — det ger oss ofta kort startsträcka till uppdrag i hela kommunen. Köksmontering är tjänsten du behöver när köket redan är köpt och bara ska på plats: stomme, luckor, bänkskiva, sockel och infästning — utan de ingrepp i vatten, avlopp och el som en full köksrenovering innebär.</p>
          <div class="cv-btn-row cv-midcta-row">
            <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
          </div>


          <div class="row g-4 mb-45">
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-building"></i></div>
                <h4>Nyproduktion</h4>
                <p>I Sundbybergs centrum, Rissne och Hallonbergen flyttar många in i nya bostadsrätter med kök som ska monteras innan man kan använda lägenheten.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-house"></i></div>
                <h4>Äldre fastighet</h4>
                <p>I andra delar av kommunen vill man byta ut ett slitet kök i en äldre lägenhet, utan att göra en hel renovering av VVS och el.</p>
              </div>
            </div>
          </div>

          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Många av de köksmonteringar vi utför i Sundbyberg handlar om att köket redan har beställts från en kökshandlare eller följer med ett nyproduktionsprojekt, och att kunden själv behöver ordna monteringen separat. Det är precis det gapet vi fyller: vi tar över där leveransen slutar och kökets snickeri, luckor och bänkskiva ska bli ett färdigt, användbart kök.</p>

          <div class="nt-highlight mb-45">
            <h5><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Fast pris på monteringen</h5>
            <p>Vi tar över där leveransen slutar och lämnar ett fast pris för monteringen innan vi startar.</p>
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad ingår i köksmonteringen?</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Stommar som sätts ihop och fästs rakt</span></li>
            <li><i class="fas fa-check-circle"></i><span>Luckor och lådor som justeras</span></li>
            <li><i class="fas fa-check-circle"></i><span>Bänkskiva som monteras och tätas mot vägg</span></li>
            <li><i class="fas fa-check-circle"></i><span>Sockel och avslutningslister</span></li>
            <li><i class="fas fa-check-circle"></i><span>Koppling av diskmaskin och blandare om det behövs</span></li>
          </ul>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Så går det till</h4>
          <div class="row g-4 gy-5 mb-45">
            <div class="col-md-4">
              <div class="nt-step h-100">
                <span class="nt-step__num">01</span>
                <h4>Kostnadsfri offert</h4>
                <p>Skicka uppgifter om köket, mått, leverantör och planlösning, så tar vi fram ett fast pris.</p>
              </div>
            </div>
            <div class="col-md-4">
              <div class="nt-step h-100">
                <span class="nt-step__num">02</span>
                <h4>Montering bokas in</h4>
                <p>Eftersom Sundbyberg ligger granne med Solna kan vi ofta lägga in en tid på kort varsel.</p>
              </div>
            </div>
            <div class="col-md-4">
              <div class="nt-step h-100">
                <span class="nt-step__num">03</span>
                <h4>Färdigt kök</h4>
                <p>Vi monterar köket, kontrollerar att allt sluter och går igenom resultatet tillsammans med dig.</p>
              </div>
            </div>
          </div>

          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Behövs mer än montering, som rivning, VVS eller el, hittar du det under <a href="/koksrenovering-stockholm">Köksrenovering Stockholm</a>. För kök från IKEA, läs <a href="/ikea-koksmontering-sundbyberg">IKEA-köksmontering i Sundbyberg</a>. Om <a href="/rut-rot">ROT-avdrag</a> finns en egen sida.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om köksmontering i Sundbyberg</h4>
          <div class="accordion nt-accordion mb-45" id="faqKoksmSbg">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqKoksmSbg1">Kan ni montera ett kök som följer med ett nyproduktionsprojekt i Sundbyberg?</button></h2>
              <div id="faqKoksmSbg1" class="accordion-collapse collapse show" data-bs-parent="#faqKoksmSbg"><div class="accordion-body">Ja. När köket är beställt via byggherren eller en kökshandlare men monteringen inte ingår, tar vi den delen.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqKoksmSbg2">Hur snabbt kommer ni till Sundbyberg?</button></h2>
              <div id="faqKoksmSbg2" class="accordion-collapse collapse" data-bs-parent="#faqKoksmSbg"><div class="accordion-body">Kommunen gränsar till Solna, där vårt kontor ligger, så vägen är kort och vi kan ofta boka med litet varsel.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqKoksmSbg3">Går det bra att montera i äldre lägenheter?</button></h2>
              <div id="faqKoksmSbg3" class="accordion-collapse collapse" data-bs-parent="#faqKoksmSbg"><div class="accordion-body">Ja. Vi kontrollerar väggar och golv vid offerten och anpassar monteringen efter hur det ser ut.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </article>
      <aside>
        <StickyOfferCard related={[]} relatedTitle="Fler jobb" />
      </aside>
    </div>
  </section>

  <section class="cv-section cv-section--tint">
    <div class="cv-container">
      <SectionHeader pill="Omdömen" title="Det säger våra kunder" />
      <ReviewStrip count={3} offset={6} job />
    </div>
  </section>


    <FinalCta heading="Dags att förverkliga ditt drömkök?" />

</BaseLayout>
