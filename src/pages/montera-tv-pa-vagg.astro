---
import BaseLayout from '../layouts/BaseLayout.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "Montera TV på vägg Stockholm — Fast pris | PRM Montage",
  "description": "Hänga upp TV:n på väggen? Vi monterar TV på vägg i Stockholm till fast pris — rätt fäste, rätt höjd, dolda kablar. Kostnadsfri offert.",
  "canonical": "https://prmmontage.se/montera-tv-pa-vagg",
  "ogDescription": "TV-montering på vägg i Stockholm till fast pris — rätt infästning, rätt höjd och dolda kablar.",
  "ogImage": "https://prmmontage.se/assets/img/logo/logo-color.png",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Tjänster",
            "item": "https://prmmontage.se/tjanster"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Montera TV på vägg"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Montering av TV på vägg",
        "name": "Montera TV på vägg Stockholm",
        "description": "TV-montering på vägg i Stockholm till fast pris — rätt infästning, rätt höjd och dolda kablar.",
        "provider": organization,
        "areaServed": "Stockholm",
        "url": "https://prmmontage.se/montera-tv-pa-vagg"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Hur högt ska en TV sitta på väggen?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "En bra tumregel är att skärmens mitt hamnar i ögonhöjd när du sitter i soffan, vilket för de flesta innebär cirka 100–120 cm från golvet till skärmens mitt. Sitter TV:n för högt belastas nacken. Vi mäter utifrån ditt soffavstånd och din sitthöjd vid monteringen."
            }
          },
          {
            "@type": "Question",
            "name": "Kan man hänga en TV på en gipsvägg?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja, men infästningen måste göras i reglarna bakom gipsen eller med rätt typ av infästning för tung last. Vi lokaliserar reglarna och väljer infästning efter TV:ns vikt."
            }
          },
          {
            "@type": "Question",
            "name": "Kan ni dölja kablarna?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. Vi kan antingen sätta upp en kabelkanal som målas i väggens kulör, eller dra kablarna dolt i väggen där konstruktionen tillåter det."
            }
          },
          {
            "@type": "Question",
            "name": "Ger TV-montering rätt till RUT-avdrag?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Montering av TV på vägg räknas normalt som ett mindre hemarbete som kan ge rätt till rutavdrag snarare än ROT-avdrag. Vi hjälper dig reda ut vilket avdrag som gäller för just ditt jobb — läs mer på vår sida om ROT- och rutavdrag."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="tjanster" defaultService="Annat">
  <!-- =============== BREADCRUMB =============== -->
  <div class="tp-breadcrumb-area tp-breadcrumb-spacing nt-dark-band pt-180 pb-90" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container">
      <div class="row"><div class="col-xl-8 col-lg-9">
        <div class="tp-breadcrumb-content">
          <h1 class="tp-breadcrumb-title fw-600 fs-60 fs-xs-40 ls-m-3 tp-text-common-white lh-1 mb-20">Montera TV på vägg i Stockholm</h1>
          <div class="tp-breadcrumb-dvdr"><ul><li><a href="/">Hem</a></li><li class="dvdr">/</li><li><a href="/tjanster">Tjänster</a></li><li class="dvdr">/</li><li>Montera TV på vägg</li></ul></div>
        </div>
      </div></div>
    </div>
  </div>

  <div class="tp-service-details-area pt-90 pb-120" style="background:var(--nt-white);">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8">
          <span class="nt-eyebrow">Tjänst</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Montera TV på vägg — rätt fäste, rätt höjd, dolda kablar</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Att hänga upp TV:n på väggen frigör plats och ger ett lugnare vardagsrum — men infästningen måste klara TV:ns vikt över tid. PRM Montage monterar TV på vägg i hela Stockholm. Vi bedömer väggens konstruktion, väljer rätt infästning och monterar fästet i lod på den höjd du vill ha.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Vi monterar på alla vanliga väggtyper: betong, tegel, lättbetong och gipsvägg med regel. I gipsväggar är det avgörande att fästet skruvas i regel eller med rätt typ av expander — det är den vanligaste orsaken till att en TV lossnar. Vi döljer också gärna kablarna i kabelkanal eller drar dem i vägg.</p>

          <div class="row g-4 mt-10 mb-45">
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-orange);">
                <h5><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Fast pris</h5>
                <p>Du får en tydlig, fast prisbild innan vi sätter igång — inga överraskningar.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-navy);">
                <h5><i class="fas fa-shield-check" style="color:#1FA968;margin-right:8px;"></i>Egna hantverkare</h5>
                <p>Erfarna montörer, fullt försäkrade och med garanti på arbetet.</p>
              </div>
            </div>
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad ingår vid TV-montering?</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Bedömning av väggens konstruktion och bärighet</span></li>
            <li><i class="fas fa-check-circle"></i><span>Montering av väggfäste — fast, tiltbart eller svängbart</span></li>
            <li><i class="fas fa-check-circle"></i><span>Uppsättning av TV i lod och på önskad höjd</span></li>
            <li><i class="fas fa-check-circle"></i><span>Dragning och dold förläggning av kablar</span></li>
            <li><i class="fas fa-check-circle"></i><span>Anslutning av TV, ljudanläggning och kringutrustning</span></li>
            <li><i class="fas fa-check-circle"></i><span>Uppstart och funktionskontroll</span></li>
          </ul>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om TV-montering</h4>
          <div class="accordion nt-accordion mb-45" id="faqTv">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqTv1">Hur högt ska en TV sitta på väggen?</button></h2>
              <div id="faqTv1" class="accordion-collapse collapse show" data-bs-parent="#faqTv"><div class="accordion-body">En bra tumregel är att skärmens mitt hamnar i ögonhöjd när du sitter i soffan, vilket för de flesta innebär cirka 100–120 cm från golvet till skärmens mitt. Sitter TV:n för högt belastas nacken. Vi mäter utifrån ditt soffavstånd och din sitthöjd vid monteringen.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqTv2">Kan man hänga en TV på en gipsvägg?</button></h2>
              <div id="faqTv2" class="accordion-collapse collapse" data-bs-parent="#faqTv"><div class="accordion-body">Ja, men infästningen måste göras i reglarna bakom gipsen eller med rätt typ av infästning för tung last. Vi lokaliserar reglarna och väljer infästning efter TV:ns vikt.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqTv3">Kan ni dölja kablarna?</button></h2>
              <div id="faqTv3" class="accordion-collapse collapse" data-bs-parent="#faqTv"><div class="accordion-body">Ja. Vi kan antingen sätta upp en kabelkanal som målas i väggens kulör, eller dra kablarna dolt i väggen där konstruktionen tillåter det.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqTv4">Ger TV-montering rätt till RUT-avdrag?</button></h2>
              <div id="faqTv4" class="accordion-collapse collapse" data-bs-parent="#faqTv"><div class="accordion-body">Montering av TV på vägg räknas normalt som ett mindre hemarbete som kan ge rätt till rutavdrag snarare än ROT-avdrag. Vi hjälper dig reda ut vilket avdrag som gäller för just ditt jobb — läs mer på vår <a href="/rut-rot">sida om ROT- och rutavdrag</a>.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="nt-side-card nt-side-card--navy" style="background:var(--nt-navy);">
            <h4 style="color:#fff;font-weight:700;margin-bottom:24px;">Kontakta oss direkt</h4>
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-phone" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">Ring oss</p><a href="tel:+46852027977" style="color:#fff;font-weight:700;font-size:1.05rem;text-decoration:none;">08-520 279 77</a></div>
            </div>
            <div style="display:flex;align-items:center;gap:14px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-envelope" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">E-post</p><a href="mailto:info@pro-montage.se" style="color:#fff;font-weight:700;text-decoration:none;">info@pro-montage.se</a></div>
            </div>
          </div>
          <div class="nt-side-card">
            <h5>Varför PRM Montage?</h5>
            <ul class="nt-check" style="margin:0;"><li><i class="fas fa-check"></i><span>Fast pris, alltid</span></li><li><i class="fas fa-check"></i><span>F-skatt &amp; försäkrade</span></li><li><i class="fas fa-check"></i><span>Egna hantverkare</span></li><li><i class="fas fa-check"></i><span>Garanti på arbetet</span></li></ul>
          </div>
          <div class="nt-side-card">
            <h5>Alla tjänster</h5>
            <ul class="nt-side-nav">
              <li><a href="/koksrenovering-stockholm">Köksrenovering Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/bygg-renovering">Bygg &amp; renovering <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/vvs-badrum">VVS &amp; Badrum <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/elektriker-stockholm">Elektriker Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/altanbygge-i-stockholm">Altanbygge i Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/jour">Jour — akut hjälp <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
          <div class="nt-side-card">
            <h5>Fler jobb till fast pris</h5>
            <ul class="nt-side-nav">
              <li><a href="/byta-blandare">Byta blandare <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/installera-diskmaskin">Installera diskmaskin <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/byta-toalettstol">Byta toalettstol <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/installera-tvattmaskin">Installera tvättmaskin <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/eluttag-tvattmaskin-diskmaskin">Eluttag till tvätt- &amp; diskmaskin <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/eluttag-badrum">Eluttag i badrum <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/laga-lackande-blandare">Laga läckande blandare <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/montera-duschvagg">Montera duschvägg <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/byta-handfat-kommod">Byta handfat &amp; kommod <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="tp-cta-area nt-dark-band pt-120 pb-120" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container"><div class="row"><div class="col-xl-8 col-lg-10">
      <span class="nt-eyebrow nt-eyebrow-light">Redo att börja?</span>
      <h2 class="mb-15 fs-xl-40 fs-sm-36 tp-text-common-white">Ska TV:n upp på väggen?</h2>
      <p class="mb-40" style="color:rgba(255,255,255,0.78);font-size:1.05rem;max-width:620px;">Kontakta oss idag — fast pris, egna hantverkare, kostnadsfri offert.</p>
      <div class="d-flex flex-wrap align-items-center gap-4">
        <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500"><span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span></a>
        <a href="tel:+46852027977" class="d-inline-flex align-items-center gap-3" style="text-decoration:none;"><span style="width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;"><i class="fas fa-phone" style="color:#1FA968;"></i></span><span><span style="display:block;color:rgba(255,255,255,0.6);font-size:.8rem;">Ring oss direkt</span><span style="display:block;color:#fff;font-weight:700;font-size:1.05rem;">08-520 279 77</span></span></a>
      </div>
    </div></div></div>
  </div>
</BaseLayout>
