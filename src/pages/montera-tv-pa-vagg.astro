---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import ReviewStrip from '../components/ReviewStrip.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyOfferCard from '../components/StickyOfferCard.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "Montera TV på vägg Stockholm — Fast pris | PRM Montage",
  "description": "Hänga upp TV:n på väggen? Vi monterar TV på vägg i Stockholm till fast pris — rätt fäste, rätt höjd, dolda kablar. Kostnadsfri offert.",
  "canonical": "https://prmmontage.se/montera-tv-pa-vagg",
  "ogDescription": "TV-montering på vägg i Stockholm till fast pris — rätt infästning, rätt höjd och dolda kablar.",
  "ogImage": "https://prmmontage.se/assets/img/logo/logo-color.png",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Tjänster",
            "item": "https://prmmontage.se/tjanster"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Montera TV på vägg"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Montering av TV på vägg",
        "name": "Montera TV på vägg Stockholm",
        "description": "TV-montering på vägg i Stockholm till fast pris — rätt infästning, rätt höjd och dolda kablar.",
        "provider": organization,
        "areaServed": "Stockholm",
        "url": "https://prmmontage.se/montera-tv-pa-vagg"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Hur högt ska en TV sitta på väggen?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "En bra tumregel är att skärmens mitt hamnar i ögonhöjd när du sitter i soffan, vilket för de flesta innebär cirka 100–120 cm från golvet till skärmens mitt. Sitter TV:n för högt belastas nacken. Vi mäter utifrån ditt soffavstånd och din sitthöjd vid monteringen."
            }
          },
          {
            "@type": "Question",
            "name": "Kan man hänga en TV på en gipsvägg?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja, men infästningen måste göras i reglarna bakom gipsen eller med rätt typ av infästning för tung last. Vi lokaliserar reglarna och väljer infästning efter TV:ns vikt."
            }
          },
          {
            "@type": "Question",
            "name": "Kan ni dölja kablarna?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. Vi kan antingen sätta upp en kabelkanal som målas i väggens kulör, eller dra kablarna dolt i väggen där konstruktionen tillåter det."
            }
          },
          {
            "@type": "Question",
            "name": "Ger TV-montering rätt till RUT-avdrag?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Montering av TV på vägg räknas normalt som ett mindre hemarbete som kan ge rätt till rutavdrag snarare än ROT-avdrag. Vi hjälper dig reda ut vilket avdrag som gäller för just ditt jobb — läs mer på vår sida om ROT- och rutavdrag."
            }
          },
          {
            "@type": "Question",
            "name": "Vilken höjd ska TV:n sitta på?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Som tumregel ska mitten av skärmen ligga ungefär i ögonhöjd när du sitter. Vi hjälper dig välja höjd på plats innan vi borrar."
            }
          },
          {
            "@type": "Question",
            "name": "Kan ni montera TV på gipsvägg?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. På gipsvägg är det avgörande att fästet skruvas i regel eller monteras med rätt typ av expander — det är den vanligaste orsaken till att en TV lossnar. Vi bedömer väggen innan vi börjar."
            }
          },
          {
            "@type": "Question",
            "name": "Kan ni dölja sladdarna?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja, vi drar och döljer kablar så att de inte hänger synliga under TV:n, i den mån väggen och rummet tillåter."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="tjanster" defaultService="Annat">
  <!-- =============== BREADCRUMB =============== -->
    <section class="cv-pagehero">
    <div class="cv-container">
      <ul class="cv-crumbs"><li><a href="/">Hem</a></li><li><a href="/tjanster">Tjänster</a></li></ul>
      <h1>Montera TV på vägg i Stockholm</h1>
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--outline-light"><i class="fas fa-phone"></i> Ring 08-520 279 77</a>
      </div>
      <div class="cv-rating cv-rating--light"><span class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span><span>4,9 på Google · 100+ omdömen</span></div>
    </div>
  </section>

  <ProofBar />


    <section class="cv-section">
    <div class="cv-container cv-layout">
      <article class="cv-prose">
          <span class="nt-eyebrow">Tjänst</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Montera TV på vägg — rätt fäste, rätt höjd, dolda kablar</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Att hänga upp TV:n på väggen frigör plats och ger ett lugnare vardagsrum — men infästningen måste klara TV:ns vikt över tid. PRM Montage monterar TV på vägg i hela Stockholm. Vi bedömer väggens konstruktion, väljer rätt infästning och monterar fästet i lod på den höjd du vill ha.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Vi monterar på alla vanliga väggtyper: betong, tegel, lättbetong och gipsvägg med regel. I gipsväggar är det avgörande att fästet skruvas i regel eller med rätt typ av expander — det är den vanligaste orsaken till att en TV lossnar. Vi döljer också gärna kablarna i kabelkanal eller drar dem i vägg.</p>
          <div class="cv-btn-row cv-midcta-row">
            <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
          </div>


          <div class="row g-4 mt-10 mb-45">
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-orange);">
                <h5><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Fast pris</h5>
                <p>Du får en tydlig, fast prisbild innan vi sätter igång — inga överraskningar.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-navy);">
                <h5><i class="fas fa-shield-check" style="color:#1FA968;margin-right:8px;"></i>Egna hantverkare</h5>
                <p>Erfarna montörer, fullt försäkrade och med garanti på arbetet.</p>
              </div>
            </div>
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad ingår vid TV-montering?</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Bedömning av väggens konstruktion och bärighet</span></li>
            <li><i class="fas fa-check-circle"></i><span>Montering av väggfäste — fast, tiltbart eller svängbart</span></li>
            <li><i class="fas fa-check-circle"></i><span>Uppsättning av TV i lod och på önskad höjd</span></li>
            <li><i class="fas fa-check-circle"></i><span>Dragning och dold förläggning av kablar</span></li>
            <li><i class="fas fa-check-circle"></i><span>Anslutning av TV, ljudanläggning och kringutrustning</span></li>
            <li><i class="fas fa-check-circle"></i><span>Uppstart och funktionskontroll</span></li>
          </ul>

          <h3 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Fast, tiltbart eller svängbart fäste?</h3>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Ett fast fäste ger en TV som sitter nära väggen. Ett tiltbart fäste låter dig vinkla skärmen nedåt, vilket passar när TV:n hänger högt, och ett svängbart fäste gör att du kan dra ut och vrida TV:n, till exempel i ett hörn eller en öppen planlösning. Vi hjälper dig välja efter rummet och TV:ns vikt.</p>

          <h3 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Montera TV på vägg i lägenhet</h3>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">I lägenheter är väggarna ofta gips med reglar, betong eller lättbetong, och valet av infästning beror på vilket det är. Vi bedömer väggen innan vi borrar så att fästet sitter där det håller.</p>

<p class="mb-45" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Vi kommer till Stockholm med omnejd — bland annat <a href="/solna">Solna</a>, <a href="/sundbyberg">Sundbyberg</a>, <a href="/bromma">Bromma</a>, <a href="/danderyd">Danderyd</a>, <a href="/tacby">Täby</a> och <a href="/lidingo">Lidingö</a>.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om TV-montering</h4>
          <div class="accordion nt-accordion mb-45" id="faqTv">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqTv1">Hur högt ska en TV sitta på väggen?</button></h2>
              <div id="faqTv1" class="accordion-collapse collapse show" data-bs-parent="#faqTv"><div class="accordion-body">En bra tumregel är att skärmens mitt hamnar i ögonhöjd när du sitter i soffan, vilket för de flesta innebär cirka 100–120 cm från golvet till skärmens mitt. Sitter TV:n för högt belastas nacken. Vi mäter utifrån ditt soffavstånd och din sitthöjd vid monteringen.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqTv2">Kan man hänga en TV på en gipsvägg?</button></h2>
              <div id="faqTv2" class="accordion-collapse collapse" data-bs-parent="#faqTv"><div class="accordion-body">Ja, men infästningen måste göras i reglarna bakom gipsen eller med rätt typ av infästning för tung last. Vi lokaliserar reglarna och väljer infästning efter TV:ns vikt.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqTv3">Kan ni dölja kablarna?</button></h2>
              <div id="faqTv3" class="accordion-collapse collapse" data-bs-parent="#faqTv"><div class="accordion-body">Ja. Vi kan antingen sätta upp en kabelkanal som målas i väggens kulör, eller dra kablarna dolt i väggen där konstruktionen tillåter det.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqTv4">Ger TV-montering rätt till RUT-avdrag?</button></h2>
              <div id="faqTv4" class="accordion-collapse collapse" data-bs-parent="#faqTv"><div class="accordion-body">Montering av TV på vägg räknas normalt som ett mindre hemarbete som kan ge rätt till rutavdrag snarare än ROT-avdrag. Vi hjälper dig reda ut vilket avdrag som gäller för just ditt jobb — läs mer på vår <a href="/rut-rot">sida om ROT- och rutavdrag</a>.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqTv5">Vilken höjd ska TV:n sitta på?</button></h2>
              <div id="faqTv5" class="accordion-collapse collapse" data-bs-parent="#faqTv"><div class="accordion-body">Som tumregel ska mitten av skärmen ligga ungefär i ögonhöjd när du sitter. Vi hjälper dig välja höjd på plats innan vi borrar.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqTv6">Kan ni montera TV på gipsvägg?</button></h2>
              <div id="faqTv6" class="accordion-collapse collapse" data-bs-parent="#faqTv"><div class="accordion-body">Ja. På gipsvägg är det avgörande att fästet skruvas i regel eller monteras med rätt typ av expander — det är den vanligaste orsaken till att en TV lossnar. Vi bedömer väggen innan vi börjar.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqTv7">Kan ni dölja sladdarna?</button></h2>
              <div id="faqTv7" class="accordion-collapse collapse" data-bs-parent="#faqTv"><div class="accordion-body">Ja, vi drar och döljer kablar så att de inte hänger synliga under TV:n, i den mån väggen och rummet tillåter.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </article>
      <aside>
        <StickyOfferCard related={[{href:'/byta-blandare',label:'Byta blandare'},{href:'/installera-diskmaskin',label:'Installera diskmaskin'},{href:'/byta-toalettstol',label:'Byta toalettstol'},{href:'/installera-tvattmaskin',label:'Installera tvättmaskin'},{href:'/eluttag-tvattmaskin-diskmaskin',label:'Eluttag till tvätt- & diskmaskin'},{href:'/eluttag-badrum',label:'Eluttag i badrum'},{href:'/laga-lackande-blandare',label:'Laga läckande blandare'},{href:'/montera-duschvagg',label:'Montera duschvägg'},{href:'/byta-handfat-kommod',label:'Byta handfat & kommod'},{href:'/handyman-stockholm',label:'Handyman Stockholm'},{href:'/mobelmontering-stockholm',label:'Möbelmontering'},{href:'/byta-las-cylinder',label:'Byta lås & låscylinder'}]} relatedTitle="Fler jobb" />
      </aside>
    </div>
  </section>

  <section class="cv-section cv-section--tint">
    <div class="cv-container">
      <h2 class="cv-h2">Det säger våra kunder</h2>
      <ReviewStrip count={3} offset={2} job />
    </div>
  </section>


    <FinalCta heading="Ska TV:n upp på väggen?" />

</BaseLayout>
