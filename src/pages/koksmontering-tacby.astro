---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import SectionHeader from '../components/landing/SectionHeader.astro';
import ReviewStrip from '../components/ReviewStrip.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyOfferCard from '../components/StickyOfferCard.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "Köksrenovering & köksmontering Täby — Fast pris | PRM Montage",
  "description": "Köksrenovering och köksmontering i Täby till fast pris. Snabb och störningsfri montering för barnfamiljer i bland annat Näsbypark och Täby Centrum. Kostnadsfri offert.",
  "canonical": "https://prmmontage.se/koksmontering-tacby",
  "ogDescription": "Köksmontering i Täby till fast pris — snabbt och störningsfritt för familjen.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/hero-kok.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Köksmontering Täby"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Köksmontering",
        "name": "Köksmontering Täby",
        "description": "Montering av kök du redan köpt — stomme, luckor, bänkskiva och infästning, till fast pris i Täby.",
        "provider": organization,
        "areaServed": "Täby",
        "url": "https://prmmontage.se/koksmontering-tacby"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Vad påverkar priset på köksmontering i Täby?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Kökets storlek och omfattning. Du får ett fast pris efter att vi fått mått och leverantör, innan vi bokar tid."
            }
          },
          {
            "@type": "Question",
            "name": "Kan monteringen ske medan familjen bor kvar?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. Vi planerar arbetet tillsammans med dig så att det passar vardagen, och håller dig uppdaterad medan vi arbetar."
            }
          },
          {
            "@type": "Question",
            "name": "Hur skiljer sig köksmontering från köksrenovering?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Montering gäller ett kök du redan har köpt. Behövs rivning, VVS eller el är det köksrenovering."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} defaultService="Köksrenovering">
  <!-- =============== BREADCRUMB =============== -->
    <section class="cv-pagehero">
    <div class="cv-container">
      <ul class="cv-crumbs"><li><a href="/">Hem</a></li></ul>
      <h1>Köksrenovering &amp; köksmontering i Täby</h1>
      <p class="cv-pagehero__lead">Fast pris, snabb och störningsfri köksmontering för barnfamiljer i Täby.</p>
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--outline-light"><i class="fas fa-phone"></i> Ring 08-520 279 77</a>
      </div>
      <div class="cv-rating cv-rating--light"><span class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span><span>4,9 på Google · 100+ omdömen</span></div>
    </div>
  </section>

  <div class="cv-pageshot-wrap"><div class="cv-container cv-pageshot"><img src="assets/img/projekt/hero-kok.webp" width="1400" height="560" alt="Kök monterat av PRM Montage i Stockholm" fetchpriority="high"></div></div>

  <ProofBar />


    <section class="cv-section">
    <div class="cv-container cv-layout">
      <article class="cv-prose">
          <span class="nt-eyebrow">Täby</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Snabb köksmontering för familjen</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Många familjer i Täby, till exempel kring Näsbypark och Täby Centrum, växer ur sitt kök i takt med att familjen blir större. Då räcker det sällan att bara köpa ett nytt kök — det ska också monteras, helst utan att hela hushållet sätts ur spel under en längre period.</p>
          <div class="cv-btn-row cv-midcta-row">
            <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
          </div>


          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Så går det till</h4>
          <div class="row g-4 gy-5 mb-45">
            <div class="col-md-4">
              <div class="nt-step h-100">
                <span class="nt-step__num">01</span>
                <h4>Kostnadsfri offert</h4>
                <p>Skicka mått, leverantör och planlösning, så får du ett fast pris på monteringen.</p>
              </div>
            </div>
            <div class="col-md-4">
              <div class="nt-step h-100">
                <span class="nt-step__num">02</span>
                <h4>Montering bokas in</h4>
                <p>Vi bokar en tid som passar familjens vardag, så att köket kommer på plats med så lite störning som möjligt.</p>
              </div>
            </div>
            <div class="col-md-4">
              <div class="nt-step h-100">
                <span class="nt-step__num">03</span>
                <h4>Färdigt kök</h4>
                <p>Vi monterar, justerar och går igenom resultatet med dig innan vi lämnar huset.</p>
              </div>
            </div>
          </div>

          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Köksmontering är den snabbare vägen dit: vi monterar det kök ni redan har köpt — stomme, luckor, bänkskiva och infästning — utan de ingrepp i VVS, el och rivning som en full köksrenovering innebär. Behövs det ändå, till exempel om vatten eller avlopp behöver flyttas, finns vår bredare tjänst som ett naturligt nästa steg.</p>

          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">I villor och radhus i Täby är det vanligt att köket har varit i samma skick sedan huset byggdes eller köptes, och att det nu ska bytas i samband med att barnen blir äldre och behöver mer plats i vardagsrummet och köket. Eftersom köket redan är valt och beställt kan vi ofta boka in monteringen med relativt kort varsel, utan att familjen behöver planera om vardagen under veckor i sträck.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad ingår i köksmonteringen?</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Stommar och skåp som monteras rakt</span></li>
            <li><i class="fas fa-check-circle"></i><span>Luckor och lådfronter som justeras för hand</span></li>
            <li><i class="fas fa-check-circle"></i><span>Bänkskiva som fästs och kapas där det behövs</span></li>
            <li><i class="fas fa-check-circle"></i><span>Sockel och lister som avslutar jobbet</span></li>
            <li><i class="fas fa-check-circle"></i><span>Inkoppling av spis, disk och blandare vid behov</span></li>
          </ul>

          <div class="nt-highlight mb-45">
            <h5><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Fast pris, lite störning</h5>
            <p>Du får ett fast pris innan vi bokar tid, och vi lägger upp arbetet så att familjens vardag rubbas så lite som möjligt.</p>
          </div>

          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Behövs större ingrepp med VVS, el eller rivning, titta på <a href="/koksrenovering-stockholm">Köksrenovering Stockholm</a>. IKEA-kök i Täby hittar du under <a href="/ikea-koksmontering-tacby">IKEA-köksmontering i Täby</a>. Om <a href="/rut-rot">ROT-avdraget</a> kan du läsa mer.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om köksmontering i Täby</h4>
          <div class="accordion nt-accordion mb-45" id="faqKoksmTaby">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqKoksmTaby1">Vad påverkar priset på köksmontering i Täby?</button></h2>
              <div id="faqKoksmTaby1" class="accordion-collapse collapse show" data-bs-parent="#faqKoksmTaby"><div class="accordion-body">Kökets storlek och omfattning. Du får ett fast pris efter att vi fått mått och leverantör, innan vi bokar tid.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqKoksmTaby2">Kan monteringen ske medan familjen bor kvar?</button></h2>
              <div id="faqKoksmTaby2" class="accordion-collapse collapse" data-bs-parent="#faqKoksmTaby"><div class="accordion-body">Ja. Vi planerar arbetet tillsammans med dig så att det passar vardagen, och håller dig uppdaterad medan vi arbetar.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqKoksmTaby3">Hur skiljer sig köksmontering från köksrenovering?</button></h2>
              <div id="faqKoksmTaby3" class="accordion-collapse collapse" data-bs-parent="#faqKoksmTaby"><div class="accordion-body">Montering gäller ett kök du redan har köpt. Behövs rivning, VVS eller el är det köksrenovering.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </article>
      <aside>
        <StickyOfferCard related={[]} relatedTitle="Fler jobb" />
      </aside>
    </div>
  </section>

  <section class="cv-section cv-section--tint">
    <div class="cv-container">
      <SectionHeader pill="Omdömen" title="Det säger våra kunder" />
      <ReviewStrip count={3} offset={6} job />
    </div>
  </section>


    <FinalCta heading="Dags att förverkliga ditt drömkök?" />

</BaseLayout>
