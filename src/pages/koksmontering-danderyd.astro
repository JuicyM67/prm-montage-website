---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import ReviewStrip from '../components/ReviewStrip.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyOfferCard from '../components/StickyOfferCard.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "Köksrenovering & köksmontering Danderyd | PRM Montage",
  "description": "Köksrenovering och köksmontering i Danderyd till fast pris. Vi monterar kök i villor i bland annat Djursholm och Stocksund — stomme, luckor, bänkskiva. Kostnadsfri offert.",
  "canonical": "https://prmmontage.se/koksmontering-danderyd",
  "ogDescription": "Köksmontering i Danderyd till fast pris — professionell montering av villakök, oavsett varumärke.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/hero-kok.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Köksmontering Danderyd"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Köksmontering",
        "name": "Köksmontering Danderyd",
        "description": "Montering av kök du redan köpt — stomme, luckor, bänkskiva och infästning, till fast pris i Danderyd.",
        "provider": organization,
        "areaServed": "Danderyd",
        "url": "https://prmmontage.se/koksmontering-danderyd"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Vilka kök monterar ni i Danderyds villor?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Kök från kökssnickerier och kedjor lika väl som från IKEA. Vi monterar det du redan har köpt, även när det är specialtillverkat."
            }
          },
          {
            "@type": "Question",
            "name": "Kan monteringen samordnas med andra arbeten i villan?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. Byts golv eller målas samtidigt lägger vi monteringen i en turordning som passar, så att ytorna inte skadas."
            }
          },
          {
            "@type": "Question",
            "name": "Hur skiljer sig köksmontering från köksrenovering?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Köksmontering utgår från ett kök som redan är köpt. Behöver du rivning, nya ledningar eller flyttat vatten tar vi det i en köksrenovering i stället."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} defaultService="Köksrenovering">
  <!-- =============== BREADCRUMB =============== -->
    <section class="cv-pagehero">
    <div class="cv-container">
      <ul class="cv-crumbs"><li><a href="/">Hem</a></li></ul>
      <h1>Köksrenovering &amp; köksmontering i Danderyd</h1>
      <p class="cv-pagehero__lead">Fast pris och professionell montering av kök i Danderyds villor — oavsett varumärke.</p>
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--outline-light"><i class="fas fa-phone"></i> Ring 08-520 279 77</a>
      </div>
      <div class="cv-rating cv-rating--light"><span class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span><span>4,9 på Google · 100+ omdömen</span></div>
    </div>
  </section>

  <ProofBar />


    <section class="cv-section">
    <div class="cv-container cv-layout">
      <article class="cv-prose">
          <span class="nt-eyebrow">Danderyd</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Professionell montering av villakök</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Danderyd, med områden som Djursholm och Stocksund, kännetecknas av stora villor och höga krav på hantverkets kvalitet. Köken här är ofta större och köps från kökssnickerier eller etablerade kedjor — och oavsett var köket kommer ifrån hjälper vi till med själva monteringen: stomme, luckor, bänkskiva och infästning, utfört med samma noggrannhet som villans övriga standard kräver.</p>
          <div class="cv-btn-row cv-midcta-row">
            <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
          </div>


          <div class="nt-highlight mb-45">
            <h5><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Fast pris för villaköket</h5>
            <p>Du får ett tydligt pris för monteringen innan vi bokar tid, oavsett om köket ska in i en gammal eller en nyare villa.</p>
          </div>

          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Köksmontering utgår alltså från ett kök som redan är beställt. Behöver villan även nya vattenledningar eller att en vägg rivs är det en bredare köksrenovering. Själva monteringsarbetet sker ofta i samband med en delrenovering, där kök och golv byts samtidigt utan att hela huset görs om.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad ingår i köksmonteringen?</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Stomme och skåp i våg, även när golv och väggar i äldre villor lutar</span></li>
            <li><i class="fas fa-check-circle"></i><span>Luckor och lådor som sluter jämnt</span></li>
            <li><i class="fas fa-check-circle"></i><span>Bänkskiva som anpassas och fästs</span></li>
            <li><i class="fas fa-check-circle"></i><span>Sockel och lister som följer väggens linjer</span></li>
            <li><i class="fas fa-check-circle"></i><span>Inkoppling av vitvaror om du vill ha hjälp med det</span></li>
          </ul>

          <div class="mb-45">
            <img src="assets/img/projekt/kok-03.webp" width="900" height="675" loading="lazy" alt="Monterat kök i villa i Danderyd" class="w-100" style="border-radius:12px;aspect-ratio:16/9;height:auto;object-fit:cover;">
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Så går det till</h4>
          <div class="row g-4 gy-5 mb-45">
            <div class="col-md-4">
              <div class="nt-step h-100">
                <span class="nt-step__num">01</span>
                <h4>Kostnadsfri offert</h4>
                <p>Berätta om villan och köket, med mått, leverantör och planlösning, så tar vi fram ett fast pris på monteringen.</p>
              </div>
            </div>
            <div class="col-md-4">
              <div class="nt-step h-100">
                <span class="nt-step__num">02</span>
                <h4>Montering bokas in</h4>
                <p>Vi lägger monteringen i en tidsplan som går ihop med övriga arbeten i huset, så att hantverkarna inte kommer i varandras väg.</p>
              </div>
            </div>
            <div class="col-md-4">
              <div class="nt-step h-100">
                <span class="nt-step__num">03</span>
                <h4>Färdigt kök</h4>
                <p>Köket monteras och finjusteras, och vi går igenom det färdiga resultatet med dig.</p>
              </div>
            </div>
          </div>

          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Behöver villan nya ledningar eller en rivd vägg i samband med köksbytet finns <a href="/koksrenovering-stockholm">Köksrenovering Stockholm</a>. Har du köpt ditt kök från IKEA hittar du <a href="/ikea-koksmontering-danderyd">IKEA-köksmontering i Danderyd</a>. Om ROT-avdrag på arbetskostnaden kan du läsa på <a href="/rut-rot">ROT-sidan</a>.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om köksmontering i Danderyd</h4>
          <div class="accordion nt-accordion mb-45" id="faqKoksmDan">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqKoksmDan1">Vilka kök monterar ni i Danderyds villor?</button></h2>
              <div id="faqKoksmDan1" class="accordion-collapse collapse show" data-bs-parent="#faqKoksmDan"><div class="accordion-body">Kök från kökssnickerier och kedjor lika väl som från IKEA. Vi monterar det du redan har köpt, även när det är specialtillverkat.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqKoksmDan2">Kan monteringen samordnas med andra arbeten i villan?</button></h2>
              <div id="faqKoksmDan2" class="accordion-collapse collapse" data-bs-parent="#faqKoksmDan"><div class="accordion-body">Ja. Byts golv eller målas samtidigt lägger vi monteringen i en turordning som passar, så att ytorna inte skadas.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqKoksmDan3">Hur skiljer sig köksmontering från köksrenovering?</button></h2>
              <div id="faqKoksmDan3" class="accordion-collapse collapse" data-bs-parent="#faqKoksmDan"><div class="accordion-body">Köksmontering utgår från ett kök som redan är köpt. Behöver du rivning, nya ledningar eller flyttat vatten tar vi det i en köksrenovering i stället.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </article>
      <aside>
        <StickyOfferCard related={[]} relatedTitle="Fler jobb" />
      </aside>
    </div>
  </section>

  <section class="cv-section cv-section--tint">
    <div class="cv-container">
      <h2 class="cv-h2">Det säger våra kunder</h2>
      <ReviewStrip count={3} offset={6} job />
    </div>
  </section>


    <FinalCta heading="Dags att förverkliga ditt drömkök?" />

</BaseLayout>
