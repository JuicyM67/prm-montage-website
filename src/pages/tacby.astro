---
import BaseLayout from '../layouts/BaseLayout.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "Hantverkare i Täby — Bygg, VVS & El | PRM Montage",
  "description": "Hantverkare i Täby – PRM Montage hjälper barnfamiljer i bland annat Näsbypark och kring Täby Centrum med köksrenovering, badrum, altanbygge och tillbyggnad.",
  "canonical": "https://prmmontage.se/tacby",
  "ogDescription": "PRM Montage hjälper familjer i Täby med köksrenovering, badrum, altanbygge och tillbyggnad till fast pris.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/hero-kok.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Hantverkare i Täby"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Köksrenovering",
        "name": "Köksrenovering i Täby",
        "description": "Köksrenovering anpassad för barnfamiljer i villor och radhus i Täby.",
        "provider": organization,
        "areaServed": "Täby",
        "url": "https://prmmontage.se/koksrenovering-stockholm"
      },
      {
        "@type": "Service",
        "serviceType": "Bygg och renovering",
        "name": "Bygg & renovering i Täby",
        "description": "Tillbyggnad och renovering som ger en växande familj mer yta i Täby.",
        "provider": organization,
        "areaServed": "Täby",
        "url": "https://prmmontage.se/bygg-renovering"
      },
      {
        "@type": "Service",
        "serviceType": "Altanbygge",
        "name": "Altanbygge i Täby",
        "description": "Altan eller uteplats till villa eller radhus i Täby.",
        "provider": organization,
        "areaServed": "Täby",
        "url": "https://prmmontage.se/altanbygge-i-stockholm"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Hur begär jag en offert i Täby?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ring oss på 08-520 279 77 eller fyll i formuläret på sidan och berätta om ditt projekt. Vi återkommer med en kostnadsfri offert och ett fast pris innan arbetet påbörjas."
            }
          },
          {
            "@type": "Question",
            "name": "Ger renoveringen rätt till ROT-avdrag?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Arbetskostnaden vid de flesta renoverings- och tillbyggnadsprojekt ger normalt rätt till ROT-avdrag, medan material och produkter inte gör det. Vi hjälper dig räkna på avdraget i offerten."
            }
          },
          {
            "@type": "Question",
            "name": "Hur snabbt kan ni komma ut till Täby?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Täby ligger en kort bilresa från vårt kontor i Solna, vilket normalt gör att vi kan boka in ett besök inom rimlig tid. Vid akuta ärenden erbjuder vi jour dygnet runt på samma telefonnummer."
            }
          },
          {
            "@type": "Question",
            "name": "Hjälper ni till med bygglov för tillbyggnad eller altan i Täby?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Om en tillbyggnad eller altan kräver bygglov beror bland annat på höjd, placering och Täby kommuns regler. Vi hjälper dig reda ut vad som gäller för just din fastighet och tar fram underlag inför en eventuell ansökan."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="omraden">
  <!-- =============== BREADCRUMB =============== -->
  <div class="tp-breadcrumb-area tp-breadcrumb-spacing nt-dark-band pt-180 pb-90" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container">
      <div class="row"><div class="col-xl-8 col-lg-9">
        <div class="tp-breadcrumb-content">
          <h1 class="tp-breadcrumb-title fw-600 fs-60 fs-xs-40 ls-m-3 tp-text-common-white lh-1 mb-20">Hantverkare i Täby</h1>
          <p style="color:rgba(255,255,255,.78);font-size:1.02rem;max-width:620px;margin-bottom:18px;">Bygg, renovering, VVS och el för familjebostäder i Täby — med fast pris och en kort bilresa från vårt kontor i Solna.</p>
          <div class="tp-breadcrumb-dvdr"><ul><li><a href="/">Hem</a></li><li class="dvdr">/</li><li>Hantverkare i Täby</li></ul></div>
        </div>
      </div></div>
    </div>
  </div>

  <div class="tp-service-details-area pt-100 pb-120" style="background:var(--nt-white);">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8">
          <span class="nt-eyebrow">Täby</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Hantverkare för växande familjer i Täby</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Täby är en kommun där många väljer att bo kvar och växa i sitt hus istället för att flytta när familjen blir större. I områden som Näsbypark och kring Täby Centrum dominerar villor och radhus, ofta med barnfamiljer som bott i samma hus i flera år och som nu vill anpassa boendet efter nya behov — ett större kök, ett andra badrum, eller en tillbyggnad för att få mer yta.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Det här mönstret märks tydligt i de uppdrag vi får i Täby. Köksrenoveringar handlar ofta om att skapa en mer praktisk vardag för en familj, med bättre förvaring och en planlösning som fungerar för fler personer samtidigt. Badrumsrenoveringar handlar lika ofta om att gå från ett enda badrum till att lösa morgonstressen i en barnfamilj, medan altanbygge och tillbyggnad handlar om att få ut mer av tomten och huset man redan bor i.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Vi planerar varje projekt i Täby utifrån hur familjen faktiskt använder sitt hem, med ett fast pris innan arbetet påbörjas och egna hantverkare inom bygg, VVS och el som kan samordna hela projektet — oavsett om det handlar om en köksrenovering eller en större tillbyggnad.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;margin-top:10px;">Våra tjänster i Täby</h4>
          <div class="row g-4 mb-50">
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-utensils"></i></div>
                <h4><a href="/koksrenovering-stockholm">Köksrenovering Stockholm</a></h4>
                <p>Köksrenovering anpassad för en växande familjs vardag.</p>
                <a class="nt-icon-card__link" href="/koksrenovering-stockholm">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-screwdriver-wrench"></i></div>
                <h4><a href="/koksmontering-tacby">Köksmontering Täby</a></h4>
                <p>Växer ni ur köket i Täby? Vi monterar ert nya kök snabbt och till fast pris.</p>
                <a class="nt-icon-card__link" href="/koksmontering-tacby">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-toolbox"></i></div>
                <h4><a href="/ikea-koksmontering-tacby">IKEA-köksmontering Täby</a></h4>
                <p>Ett prisvärt val för barnfamiljer i Täby — vi monterar ert IKEA METOD-kök enligt anvisningarna.</p>
                <a class="nt-icon-card__link" href="/ikea-koksmontering-tacby">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-hammer"></i></div>
                <h4><a href="/bygg-renovering">Bygg &amp; renovering</a></h4>
                <p>Tillbyggnad och renovering som ger mer yta i villan eller radhuset.</p>
                <a class="nt-icon-card__link" href="/bygg-renovering">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-shower"></i></div>
                <h4><a href="/vvs-badrum">VVS &amp; Badrum</a></h4>
                <p>Nytt badrum eller kompletterande duschrum för familjer med behov av fler badrum.</p>
                <a class="nt-icon-card__link" href="/vvs-badrum">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-bolt"></i></div>
                <h4><a href="/elektriker-stockholm">Elektriker Stockholm</a></h4>
                <p>Elinstallationer anpassade efter en växande familjs behov.</p>
                <a class="nt-icon-card__link" href="/elektriker-stockholm">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-sun"></i></div>
                <h4><a href="/altanbygge-i-stockholm">Altanbygge i Stockholm</a></h4>
                <p>Altan eller uteplats som blir en förlängning av vardagsrummet.</p>
                <a class="nt-icon-card__link" href="/altanbygge-i-stockholm">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-triangle-exclamation"></i></div>
                <h4><a href="/jour">Jour — akut hjälp</a></h4>
                <p>Akut hjälp vid läckage eller elfel i ditt hus i Täby.</p>
                <a class="nt-icon-card__link" href="/jour">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Varför anlita PRM Montage i Täby?</h4>
          <ul class="nt-check mb-50">
            <li><i class="fas fa-check-circle"></i><span>Fast pris innan vi sätter igång — inga överraskningar på fakturan.</span></li>
            <li><i class="fas fa-check-circle"></i><span>F-skatt och fullt försäkrade under varje uppdrag.</span></li>
            <li><i class="fas fa-check-circle"></i><span>Egna hantverkare som samordnar bygg, VVS och el i samma projekt.</span></li>
            <li><i class="fas fa-check-circle"></i><span>Kort bilresa från vårt kontor i Solna till Täby.</span></li>
            <li><i class="fas fa-check-circle"></i><span>Garanti på utfört arbete.</span></li>
          </ul>

          <div class="mb-50">
            <img src="assets/img/projekt/bygg-01.webp" width="900" height="675" loading="lazy" alt="Exempel på snickeri- och byggarbete" class="w-100" style="border-radius:12px;aspect-ratio:16/9;height:auto;object-fit:cover;">
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om hantverkare i Täby</h4>
          <div class="accordion nt-accordion mb-45" id="faqTaby">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqTaby1">Hur begär jag en offert i Täby?</button></h2>
              <div id="faqTaby1" class="accordion-collapse collapse show" data-bs-parent="#faqTaby"><div class="accordion-body">Ring oss på 08-520 279 77 eller fyll i formuläret på sidan och berätta om ditt projekt. Vi återkommer med en kostnadsfri offert och ett fast pris innan arbetet påbörjas.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqTaby2">Ger renoveringen rätt till ROT-avdrag?</button></h2>
              <div id="faqTaby2" class="accordion-collapse collapse" data-bs-parent="#faqTaby"><div class="accordion-body">Arbetskostnaden vid de flesta renoverings- och tillbyggnadsprojekt ger normalt rätt till ROT-avdrag, medan material och produkter inte gör det. Vi hjälper dig räkna på avdraget i offerten. Läs mer på vår <a href="/rut-rot">sida om ROT-avdrag</a>.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqTaby3">Hur snabbt kan ni komma ut till Täby?</button></h2>
              <div id="faqTaby3" class="accordion-collapse collapse" data-bs-parent="#faqTaby"><div class="accordion-body">Täby ligger en kort bilresa från vårt kontor i Solna, vilket normalt gör att vi kan boka in ett besök inom rimlig tid. Vid akuta ärenden erbjuder vi <a href="/jour">jour dygnet runt</a> på samma telefonnummer.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqTaby4">Hjälper ni till med bygglov för tillbyggnad eller altan i Täby?</button></h2>
              <div id="faqTaby4" class="accordion-collapse collapse" data-bs-parent="#faqTaby"><div class="accordion-body">Om en tillbyggnad eller altan kräver bygglov beror bland annat på höjd, placering och Täby kommuns regler. Vi hjälper dig reda ut vad som gäller för just din fastighet och tar fram underlag inför en eventuell ansökan.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="nt-side-card nt-side-card--navy" style="background:var(--nt-navy);">
            <h4 style="color:#fff;font-weight:700;margin-bottom:24px;">Kontakta oss direkt</h4>
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-phone" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">Ring oss</p><a href="tel:+46852027977" style="color:#fff;font-weight:700;font-size:1.05rem;text-decoration:none;">08-520 279 77</a></div>
            </div>
            <div style="display:flex;align-items:center;gap:14px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-envelope" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">E-post</p><a href="mailto:info@pro-montage.se" style="color:#fff;font-weight:700;text-decoration:none;">info@pro-montage.se</a></div>
            </div>
          </div>
          <div class="nt-side-card">
            <h5>Våra tjänster</h5>
            <ul class="nt-side-nav">
              <li><a href="/koksrenovering-stockholm">Köksrenovering Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/bygg-renovering">Bygg &amp; renovering <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/vvs-badrum">VVS &amp; Badrum <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/elektriker-stockholm">Elektriker Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/altanbygge-i-stockholm">Altanbygge i Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/jour">Jour — akut hjälp <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
          <div class="nt-side-card">
            <h5>Fler områden</h5>
            <ul class="nt-side-nav">
              <li><a href="/solna">Solna <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/sundbyberg">Sundbyberg <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/upplands-vasby">Upplands Väsby <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/danderyd">Danderyd <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/bromma">Bromma <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/uppsala">Uppsala <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/lidingo">Lidingö <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/sodermalm">Södermalm <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="tp-cta-area nt-dark-band pt-120 pb-120" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container"><div class="row"><div class="col-xl-8 col-lg-10">
      <span class="nt-eyebrow nt-eyebrow-light">Redo att börja?</span>
      <h2 class="mb-15 fs-xl-40 fs-sm-36 tp-text-common-white">Hantverkare i Täby redo att hjälpa dig</h2>
      <p class="mb-40" style="color:rgba(255,255,255,0.78);font-size:1.05rem;max-width:620px;">Kontakta oss idag — fast pris, egna hantverkare, kostnadsfri offert.</p>
      <div class="d-flex flex-wrap align-items-center gap-4">
        <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500"><span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span></a>
        <a href="tel:+46852027977" class="d-inline-flex align-items-center gap-3" style="text-decoration:none;"><span style="width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;"><i class="fas fa-phone" style="color:#1FA968;"></i></span><span><span style="display:block;color:rgba(255,255,255,0.6);font-size:.8rem;">Ring oss direkt</span><span style="display:block;color:#fff;font-weight:700;font-size:1.05rem;">08-520 279 77</span></span></a>
      </div>
    </div></div></div>
  </div>
</BaseLayout>
