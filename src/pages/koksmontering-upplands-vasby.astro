---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import SectionHeader from '../components/landing/SectionHeader.astro';
import ReviewStrip from '../components/ReviewStrip.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyOfferCard from '../components/StickyOfferCard.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "Köksrenovering & köksmontering Upplands Väsby | PRM Montage",
  "description": "Köksrenovering och köksmontering i Upplands Väsby till fast pris. Vi monterar kök i villa, radhus och lägenhet. Kostnadsfri offert.",
  "canonical": "https://prmmontage.se/koksmontering-upplands-vasby",
  "ogDescription": "Köksmontering i Upplands Väsby till fast pris — vi monterar kök i alla varumärken.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/hero-kok.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Hantverkare i Upplands Väsby",
            "item": "https://prmmontage.se/upplands-vasby"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Köksmontering Upplands Väsby"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Köksmontering",
        "name": "Köksmontering Upplands Väsby",
        "description": "Montering av kök du redan köpt — stomme, luckor, bänkskiva och infästning, till fast pris i Upplands Väsby.",
        "provider": organization,
        "areaServed": "Upplands Väsby",
        "url": "https://prmmontage.se/koksmontering-upplands-vasby"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Vad kostar köksmontering i Upplands Väsby?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Priset beror på kökets storlek och omfattning — om det är en enklare stomme eller ett helt kök med bänkskiva, sockel och vitvaror som ska kopplas in. Vi lämnar alltid ett fast pris innan monteringen bokas, baserat på en kostnadsfri offert."
            }
          },
          {
            "@type": "Question",
            "name": "Vad är skillnaden mot en köksrenovering?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Köksmontering handlar om att montera ett kök du redan köpt — stommar, luckor, bänkskiva och infästning. En köksrenovering är ett större projekt som också omfattar rivning, ny rördragning, el och ytskikt. Behöver du det senare hjälper vi dig med det också."
            }
          },
          {
            "@type": "Question",
            "name": "Monterar ni kök från alla leverantörer?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. Vi monterar kök från IKEA, Marbodal, Ballingslöv, Vedum, Kvik och andra leverantörer. Har du köpt ett IKEA-kök hittar du mer på vår sida om IKEA-köksmontering i Upplands Väsby."
            }
          },
          {
            "@type": "Question",
            "name": "Kopplar ni in diskmaskin, häll och fläkt?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. Vi har egna VVS-montörer och behöriga elektriker, så vatten, avlopp och el kan kopplas i samma besök som monteringen — utan att du behöver boka in separata firmor."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="tjanster" defaultService="VVS & Badrum">
  <!-- =============== BREADCRUMB =============== -->
    <section class="cv-pagehero">
    <div class="cv-container">
      <ul class="cv-crumbs"><li><a href="/">Hem</a></li><li><a href="/upplands-vasby">Upplands Väsby</a></li></ul>
      <h1>Köksrenovering &amp; köksmontering i Upplands Väsby</h1>
      <p class="cv-pagehero__lead">Vi monterar ditt nya kök — stommar, luckor och bänkskiva — till fast pris i hela kommunen.</p>
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--outline-light"><i class="fas fa-phone"></i> Ring 08-520 279 77</a>
      </div>
      <div class="cv-rating cv-rating--light"><span class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span><span>4,9 på Google · 100+ omdömen</span></div>
    </div>
  </section>

  <div class="cv-pageshot-wrap"><div class="cv-container cv-pageshot"><img src="assets/img/projekt/hero-kok.webp" width="1400" height="560" alt="Monterat kök av PRM Montage i Upplands Väsby" fetchpriority="high"></div></div>

  <ProofBar />


  

    <section class="cv-section">
    <div class="cv-container cv-layout">
      <article class="cv-prose">
          <span class="nt-eyebrow">Upplands Väsby</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Köksmontering i Upplands Väsby — fast pris</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Har du köpt ett nytt kök och vill ha det monterat fackmannamässigt? PRM Montage monterar kök i hela Upplands Väsby — stommar, luckor, lådor, bänkskiva, sockel och lister — till fast pris, med kostnadsfri offert innan vi bokar in jobbet.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Vi monterar kök från alla vanliga leverantörer. Förutsättningarna skiljer sig en del inom kommunen: i flerbostadshusen kring Väsby centrum och Smedby är väggarna ofta av betong eller lättbetong och kräver rätt infästning, medan villorna i Runby och Bollstanäs oftare har regelväggar där det gäller att träffa reglarna. Vi kontrollerar väggarna innan vi sätter första skenan.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Eftersom vi också har egna VVS-montörer och behöriga elektriker kan vi koppla in diskmaskin, häll, ugn och fläkt i samma vända — det är annars två extra firmor att boka.</p>
          <div class="cv-btn-row cv-midcta-row">
            <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
          </div>

          <div class="row g-4 mt-10 mb-45">
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-orange);">
                <h3><i class="fas fa-screwdriver-wrench" style="color:#009828;margin-right:8px;"></i>Alla köksleverantörer</h3>
                <p>IKEA, Marbodal, Ballingslöv, Vedum, Kvik — vi monterar oavsett varumärke.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-navy);">
                <h3><i class="fas fa-file-invoice-dollar" style="color:#009828;margin-right:8px;"></i>Fast pris på monteringen</h3>
                <p>Kostnadsfri offert först, fast pris sedan.</p>
              </div>
            </div>
          </div>
          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad som ingår i monteringen</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Uppmätning och kontroll mot din köksritning</span></li>
            <li><i class="fas fa-check-circle"></i><span>Montering av stommar med rätt infästning i betong-, lättbetong- eller regelvägg</span></li>
            <li><i class="fas fa-check-circle"></i><span>Luckor, lådfronter och justering av gångjärn</span></li>
            <li><i class="fas fa-check-circle"></i><span>Kapning, montering och tätning av bänkskiva</span></li>
            <li><i class="fas fa-check-circle"></i><span>Sockel, täcksidor, lister och passbitar</span></li>
            <li><i class="fas fa-check-circle"></i><span>Inbyggnad av vitvaror samt inkoppling av el och VVS</span></li>
            <li><i class="fas fa-check-circle"></i><span>Bortforsling av emballage och det gamla köket vid behov</span></li>
          </ul>
          <div class="mb-45">
            <img src="assets/img/projekt/kok-04.webp" width="900" height="675" loading="lazy" alt="Monterat kök utfört av PRM Montage" class="w-100" style="border-radius:12px;aspect-ratio:16/9;height:auto;object-fit:cover;">
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Montering eller hela köket?</h4>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Ska bara köket sättas upp är det den här tjänsten du vill ha. Ska det gamla köket rivas, väggar flyttas, el dras om och vatten flyttas är det en <a href="/koksrenovering-stockholm">köksrenovering</a> — då tar vi hela projektet i en samlad offert. Behöver du dessutom platsbyggda hyllor eller passbitar kring köket löser våra <a href="/snickeri-upplands-vasby">snickare</a> det i samma vända.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Se allt vi gör i kommunen på sidan <a href="/upplands-vasby">hantverkare i Upplands Väsby</a>.</p>
          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om köksmontering i Upplands Väsby</h4>
<div class="accordion nt-accordion mb-45" id="faqKokUV">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqKokUV1">Vad kostar köksmontering i Upplands Väsby?</button></h2>
              <div id="faqKokUV1" class="accordion-collapse collapse show" data-bs-parent="#faqKokUV"><div class="accordion-body">Priset beror på kökets storlek och omfattning — om det är en enklare stomme eller ett helt kök med bänkskiva, sockel och vitvaror som ska kopplas in. Vi lämnar alltid ett fast pris innan monteringen bokas, baserat på en kostnadsfri offert.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqKokUV2">Vad är skillnaden mot en köksrenovering?</button></h2>
              <div id="faqKokUV2" class="accordion-collapse collapse" data-bs-parent="#faqKokUV"><div class="accordion-body">Köksmontering handlar om att montera ett kök du redan köpt — stommar, luckor, bänkskiva och infästning. En <a href="/koksrenovering-stockholm">köksrenovering</a> är ett större projekt som också omfattar rivning, ny rördragning, el och ytskikt. Behöver du det senare hjälper vi dig med det också.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqKokUV3">Monterar ni kök från alla leverantörer?</button></h2>
              <div id="faqKokUV3" class="accordion-collapse collapse" data-bs-parent="#faqKokUV"><div class="accordion-body">Ja. Vi monterar kök från IKEA, Marbodal, Ballingslöv, Vedum, Kvik och andra leverantörer. Har du köpt ett IKEA-kök hittar du mer på vår sida om <a href="/ikea-koksmontering-upplands-vasby">IKEA-köksmontering i Upplands Väsby</a>.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqKokUV4">Kopplar ni in diskmaskin, häll och fläkt?</button></h2>
              <div id="faqKokUV4" class="accordion-collapse collapse" data-bs-parent="#faqKokUV"><div class="accordion-body">Ja. Vi har egna <a href="/rormokare-upplands-vasby">VVS-montörer</a> och behöriga <a href="/elektriker-stockholm">elektriker</a>, så vatten, avlopp och el kan kopplas i samma besök som monteringen — utan att du behöver boka in separata firmor.</div></div>
            </div>
          </div>
          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </article>
      <aside>
        <StickyOfferCard related={[{href:'/koksrenovering-stockholm',label:'Köksrenovering Stockholm'},{href:'/bygg-renovering',label:'Bygg & renovering'},{href:'/vvs-badrum',label:'VVS & Badrum'},{href:'/elektriker-stockholm',label:'Elektriker Stockholm'},{href:'/altanbygge-i-stockholm',label:'Altanbygge i Stockholm'},{href:'/jour',label:'Jour — akut hjälp'}]} relatedTitle="Våra tjänster" />
      </aside>
    </div>
  </section>

  <section class="cv-section cv-section--tint">
    <div class="cv-container">
      <SectionHeader pill="Omdömen" title="Det säger våra kunder" />
      <ReviewStrip count={3} offset={4} job />
    </div>
  </section>


    <FinalCta heading="Nytt kök som ska monteras?" />

</BaseLayout>
