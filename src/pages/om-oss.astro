---
import BaseLayout from '../layouts/BaseLayout.astro';

const seo = {
  "title": "Om oss — PRM Montage AB | Hantverksfirma i Solna",
  "description": "PRM Montage AB är en hantverksfirma i Solna, grundad 2022. Egna hantverkare inom bygg, VVS, el och snickeri — F-skatt, försäkring och alltid fast pris.",
  "canonical": "https://prmmontage.se/om-oss",
  "ogImage": "https://prmmontage.se/assets/img/brand/og-default.jpg",
  "twitterTitle": "Om oss — PRM Montage AB",
  "twitterDescription": "Hantverksfirma i Solna, grundad 2022. Egna hantverkare, F-skatt, försäkring och alltid fast pris.",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Om oss"
          }
        ]
      },
      {
        "@type": "AboutPage",
        "url": "https://prmmontage.se/om-oss",
        "name": "Om PRM Montage AB",
        "about": {
          "@type": "HomeAndConstructionBusiness",
          "@id": "https://prmmontage.se/#organization",
          "name": "PRM Montage",
          "legalName": "PRM MONTAGE AB",
          "url": "https://prmmontage.se/",
          "telephone": "+46852027977",
          "email": "info@pro-montage.se",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Industrivägen 19",
            "postalCode": "171 48",
            "addressLocality": "Solna",
            "addressCountry": "SE"
          },
          "priceRange": "$$"
        }
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="om-oss">
  <!-- =============== BREADCRUMB =============== -->
  <div class="tp-breadcrumb-area tp-breadcrumb-spacing nt-dark-band pt-180 pb-90" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container">
      <div class="row"><div class="col-xl-8 col-lg-9">
        <div class="tp-breadcrumb-content">
          <h1 class="tp-breadcrumb-title fw-600 fs-60 fs-xs-40 ls-m-3 tp-text-common-white lh-1 mb-20">Om oss</h1>
          <div class="tp-breadcrumb-dvdr"><ul><li><a href="/">Hem</a></li><li class="dvdr">/</li><li>Om oss</li></ul></div>
        </div>
      </div></div>
    </div>
  </div>
  <!-- =============== /BREADCRUMB =============== -->

  <!-- =============== VÅR HISTORIA =============== -->
  <div class="tp-about-area pt-130 pb-90">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6 mb-40">
          <div class="tp-benifits-4-thumb p-relative mr-50">
            <div class="nt-media wow img-custom-anim-left" data-wow-duration="1.5s" data-wow-delay="0.2s">
              <img src="assets/img/projekt/kok-03.webp" width="900" height="675" loading="lazy" alt="Köksrenovering utförd av PRM Montages egna hantverkare">
            </div>
            <div class="p-absolute text-center" style="top:-26px;left:-18px;background:var(--nt-orange);color:#fff;border-radius:14px;padding:20px 24px;box-shadow:0 16px 34px rgba(31,169,104,.35);">
              <h4 style="color:#fff;font-size:2rem;font-weight:700;margin:0;line-height:1;">2022</h4>
              <span style="font-size:.82rem;opacity:.9;">Grundades i Solna</span>
            </div>
          </div>
        </div>
        <div class="col-lg-6 mb-40">
          <div class="tp-about-2-content tp-about-4-content ml-30">
            <span class="nt-eyebrow">Vår historia</span>
            <h2 class="mb-25 fs-xl-40 fs-sm-36 wow img-custom-anim-top" data-wow-duration="1.5s" data-wow-delay="0.2s">En hantverksfirma byggd på fast pris och eget ansvar</h2>
            <p class="mb-20" style="color:var(--nt-gray);line-height:1.8;">PRM Montage AB (org.nr 559377-9621) grundades 2022 med säte på Industrivägen 19 i Solna. Vi är idag omkring sex hantverkare som tillsammans täcker bygg, snickeri, VVS och el — allt under ett och samma bolag.</p>
            <p class="mb-20" style="color:var(--nt-gray);line-height:1.8;">Idén från start var enkel: kunden ska aldrig behöva anlita och samordna flera olika hantverksfirmor för ett och samma projekt. Vi tar hand om hela jobbet, från första kontakt till besiktning, med samma fasta prisbild genom hela processen.</p>
            <div class="tp-about-bottom-feature mb-40 mt-30"><ul><li><i class="fa-sharp fa-solid fa-check"></i> Egna hantverkare inom bygg, VVS, el och snickeri — inga underentreprenörer</li><li><i class="fa-sharp fa-solid fa-check"></i> F-skatt, fullständig försäkring och fast pris på alla jobb</li><li><i class="fa-sharp fa-solid fa-check"></i> Baserade i Solna — arbetar i hela Stockholm och i Uppsala</li><li><i class="fa-sharp fa-solid fa-check"></i> 4,9 i betyg på Google</li></ul></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- =============== /VÅR HISTORIA =============== -->

  <!-- =============== VARFÖR VI FINNS =============== -->
  <div class="pt-40 pb-100" style="background:var(--nt-gray-light);">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-xl-8 text-center">
          <span class="nt-eyebrow">Varför vi finns</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Vi ville göra det enklare att anlita hantverkare</h2>
          <p style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Många hemprojekt kräver flera olika kompetenser — en snickare för stommen, en rörmokare för vattnet, en elektriker för uttagen. Det blir lätt krångligt att hitta, jämföra och samordna allt själv. PRM Montage startades för att samla den kompetensen på ett ställe, med hantverkare som är anställda av oss och som du kan lita på genom hela projektet.</p>
          <p style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Vi tar fullt ansvar för våra kunder — från första offerten till avslutad besiktning. Det innebär ett fast pris innan vi sätter igång, fullständig försäkring under varje uppdrag och ett bolag med F-skatt som du alltid kan nå.</p>
        </div>
      </div>
    </div>
  </div>
  <!-- =============== /VARFÖR VI FINNS =============== -->

  <!-- =============== TRYGGHETSPUNKTER =============== -->
  <div class="tp-feature-area tp-feature-4-wrap pt-100 pb-60 fix" style="background:var(--nt-white);">
    <div class="container">
      <div class="tp-border-bottom pb-30">
        <div class="row gx-60">
          <div class="col-lg-4 col-md-6 tp-counter-3-border">
            <div class="tp-feature-3-wrap tpshake-wrap d-flex md-space wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
              <span class="mr-25 nt-icon-card__icon" style="margin-bottom:0;flex-shrink:0;"><i class="fas fa-file-invoice-dollar"></i></span>
              <div>
                <h3 class="fs-24 fw-600 mb-10" style="color:var(--nt-navy);">Alltid fast pris</h3>
                <p style="color:var(--nt-gray);margin:0;">Priset bestäms tillsammans med dig innan arbetet påbörjas — inga överraskningar på fakturan.</p>
              </div>
            </div>
          </div>
          <div class="col-lg-4 col-md-6 tp-counter-3-border">
            <div class="tp-feature-3-wrap tpshake-wrap d-flex md-space wow fadeInUp" data-wow-delay=".3s" data-wow-duration=".9s">
              <span class="mr-25 nt-icon-card__icon" style="margin-bottom:0;flex-shrink:0;"><i class="fas fa-user-group"></i></span>
              <div>
                <h3 class="fs-24 fw-600 mb-10" style="color:var(--nt-navy);">Allt under ett tak</h3>
                <p style="color:var(--nt-gray);margin:0;">Egna hantverkare inom bygg, VVS, el och snickeri — du slipper samordna flera företag.</p>
              </div>
            </div>
          </div>
          <div class="col-lg-4 col-md-6">
            <div class="tp-feature-3-wrap tpshake-wrap d-flex md-space wow fadeInUp" data-wow-delay=".4s" data-wow-duration=".9s">
              <span class="mr-25 nt-icon-card__icon" style="margin-bottom:0;flex-shrink:0;"><i class="fas fa-shield-check"></i></span>
              <div>
                <h3 class="fs-24 fw-600 mb-10" style="color:var(--nt-navy);">Försäkrat &amp; F-skatt</h3>
                <p style="color:var(--nt-gray);margin:0;">PRM Montage AB innehar F-skatt och är fullt försäkrat under varje uppdrag.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- =============== /TRYGGHETSPUNKTER =============== -->

  <!-- =============== SIFFROR =============== -->
  <div class="tp-counter-area pt-90 pb-60" style="background:var(--nt-gray-light);">
    <div class="container">
      <div class="row">
        <div class="col-xl-3 col-lg-6 col-md-6">
          <div class="tp-counter-wrap d-flex align-items-center mb-30 wow fadeInUp" data-wow-delay=".1s" data-wow-duration=".9s">
            <span class="mr-25"><i class="fas fa-calendar" style="font-size:2.6rem;color:#1FA968;"></i></span>
            <div class="nt-stat-light"><h3>2022</h3><p>Grundades i Solna</p></div>
          </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-6">
          <div class="tp-counter-wrap d-flex align-items-center mb-30 wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <span class="mr-25"><i class="fas fa-star" style="font-size:2.6rem;color:#1FA968;"></i></span>
            <div class="nt-stat-light"><h3>4,9</h3><p>Betyg på Google</p></div>
          </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-6">
          <div class="tp-counter-wrap d-flex align-items-center mb-30 wow fadeInUp" data-wow-delay=".3s" data-wow-duration=".9s">
            <span class="mr-25"><i class="fas fa-user-group" style="font-size:2.6rem;color:#1FA968;"></i></span>
            <div class="nt-stat-light"><h3>6</h3><p>Hantverkare i teamet</p></div>
          </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-6">
          <div class="tp-counter-wrap d-flex align-items-center mb-30 wow fadeInUp" data-wow-delay=".4s" data-wow-duration=".9s">
            <span class="mr-25"><i class="fas fa-file-invoice-dollar" style="font-size:2.6rem;color:#1FA968;"></i></span>
            <div class="nt-stat-light"><h3>100%</h3><p>Fasta priser</p></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- =============== /SIFFROR =============== -->

  <!-- =============== CTA =============== -->
  <div class="tp-cta-area nt-dark-band pt-120 pb-120" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container"><div class="row"><div class="col-xl-8 col-lg-10">
      <span class="nt-eyebrow nt-eyebrow-light">Redo att börja?</span>
      <h2 class="mb-15 fs-xl-40 fs-sm-36 tp-text-common-white">Lär känna oss genom att låta oss visa vad vi går för</h2>
      <p class="mb-40" style="color:rgba(255,255,255,0.78);font-size:1.05rem;max-width:620px;">Kontakta oss idag för en kostnadsfri offert — snabbt svar, fast pris, inga överraskningar.</p>
      <div class="d-flex flex-wrap align-items-center gap-4">
        <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500"><span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span></a>
        <a href="tel:+46852027977" class="d-inline-flex align-items-center gap-3" style="text-decoration:none;"><span style="width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;"><i class="fas fa-phone" style="color:#1FA968;"></i></span><span><span style="display:block;color:rgba(255,255,255,0.6);font-size:.8rem;">Ring oss direkt</span><span style="display:block;color:#fff;font-weight:700;font-size:1.05rem;">08-520 279 77</span></span></a>
      </div>
    </div></div></div>
  </div>
  <!-- =============== /CTA =============== -->

  <!-- =============== FOOTER =============== -->
</BaseLayout>
