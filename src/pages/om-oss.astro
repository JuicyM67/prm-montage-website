---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import FinalCta from '../components/FinalCta.astro';

const seo = {
  "title": "Om oss — PRM Montage AB | Hantverksfirma i Solna",
  "description": "PRM Montage AB är en hantverksfirma i Solna, grundad 2022. Egna hantverkare inom bygg, VVS, el och snickeri — F-skatt, försäkring och alltid fast pris.",
  "canonical": "https://prmmontage.se/om-oss",
  "ogImage": "https://prmmontage.se/assets/img/brand/og-default.jpg",
  "twitterTitle": "Om oss — PRM Montage AB",
  "twitterDescription": "Hantverksfirma i Solna, grundad 2022. Egna hantverkare, F-skatt, försäkring och alltid fast pris.",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Om oss"
          }
        ]
      },
      {
        "@type": "AboutPage",
        "url": "https://prmmontage.se/om-oss",
        "name": "Om PRM Montage AB",
        "about": {
          "@type": "HomeAndConstructionBusiness",
          "@id": "https://prmmontage.se/#organization",
          "name": "PRM Montage",
          "legalName": "PRM MONTAGE AB",
          "url": "https://prmmontage.se/",
          "telephone": "+46852027977",
          "email": "info@pro-montage.se",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Industrivägen 19",
            "postalCode": "171 48",
            "addressLocality": "Solna",
            "addressCountry": "SE"
          },
          "priceRange": "$$"
        }
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="om-oss">
  <!-- =============== BREADCRUMB =============== -->
    <section class="cv-pagehero">
    <div class="cv-container">
      <ul class="cv-crumbs"><li><a href="/">Hem</a></li></ul>
      <h1>Om oss</h1>
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--outline-light"><i class="fas fa-phone"></i> Ring 08-520 279 77</a>
      </div>
    </div>
  </section>

  <ProofBar />

  <!-- =============== /BREADCRUMB =============== -->

  <!-- =============== VÅR HISTORIA =============== -->
  <section class="cv-section">
    <div class="cv-container cv-layout">
      <article class="cv-prose">
        <span class="nt-eyebrow">Vår historia</span>
        <h2>En hantverksfirma byggd på fast pris och eget ansvar</h2>
        <p>PRM Montage AB (org.nr 559377-9621) grundades 2022 med säte på Industrivägen 19 i Solna. Vi är idag omkring sex hantverkare som tillsammans täcker bygg, snickeri, VVS och el — allt under ett och samma bolag.</p>
        <p>Idén från start var enkel: kunden ska aldrig behöva anlita och samordna flera olika hantverksfirmor för ett och samma projekt. Vi tar hand om hela jobbet, från första kontakt till besiktning, med samma fasta prisbild genom hela processen.</p>
        <ul class="nt-check" style="margin-top:28px !important;"><li><i class="fas fa-check-circle"></i><span>Egna hantverkare inom bygg, VVS, el och snickeri — inga underentreprenörer</span></li><li><i class="fas fa-check-circle"></i><span>F-skatt, fullständig försäkring och fast pris på alla jobb</span></li><li><i class="fas fa-check-circle"></i><span>Baserade i Solna — arbetar i hela Stockholm och i Uppsala</span></li><li><i class="fas fa-check-circle"></i><span>4,9 i betyg på Google</span></li></ul>
        <img src="assets/img/projekt/kok-03.webp" width="900" height="675" loading="lazy" alt="Köksrenovering utförd av PRM Montages egna hantverkare" style="width:100%;margin-top:40px;aspect-ratio:16/9;object-fit:cover;">
      </article>
    </div>
  </section>

  <!-- =============== VARFÖR VI FINNS =============== -->
  <section class="cv-section cv-section--tint">
    <div class="cv-container cv-layout">
      <article class="cv-prose">
        <span class="nt-eyebrow">Varför vi finns</span>
        <h2>Vi ville göra det enklare att anlita hantverkare</h2>
        <p>Många hemprojekt kräver flera olika kompetenser — en snickare för stommen, en rörmokare för vattnet, en elektriker för uttagen. Det blir lätt krångligt att hitta, jämföra och samordna allt själv. PRM Montage startades för att samla den kompetensen på ett ställe, med hantverkare som är anställda av oss och som du kan lita på genom hela projektet.</p>
        <p>Vi tar fullt ansvar för våra kunder — från första offerten till avslutad besiktning. Det innebär ett fast pris innan vi sätter igång, fullständig försäkring under varje uppdrag och ett bolag med F-skatt som du alltid kan nå.</p>
      </article>
    </div>
  </section>

  <!-- =============== TRYGGHETSPUNKTER =============== -->
  <section class="cv-section">
    <div class="cv-container cv-layout">
      <article class="cv-prose">
        <div class="row g-4">
          <div class="col-md-4"><div class="nt-highlight h-100"><h3><i class="fas fa-file-invoice-dollar" style="color:#009828;"></i>Alltid fast pris</h3><p>Priset bestäms tillsammans med dig innan arbetet påbörjas — inga överraskningar på fakturan.</p></div></div>
          <div class="col-md-4"><div class="nt-highlight h-100"><h3><i class="fas fa-user-group" style="color:#009828;"></i>Allt under ett tak</h3><p>Egna hantverkare inom bygg, VVS, el och snickeri — du slipper samordna flera företag.</p></div></div>
          <div class="col-md-4"><div class="nt-highlight h-100"><h3><i class="fas fa-shield-check" style="color:#009828;"></i>Försäkrat &amp; F-skatt</h3><p>PRM Montage AB innehar F-skatt och är fullt försäkrat under varje uppdrag.</p></div></div>
        </div>
      </article>
    </div>
  </section>

  <!-- =============== CTA =============== -->
    <FinalCta heading="Lär känna oss genom att låta oss visa vad vi går för" />

  <!-- =============== /CTA =============== -->

  <!-- =============== FOOTER =============== -->
</BaseLayout>
