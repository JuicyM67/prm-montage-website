---
import BaseLayout from '../layouts/BaseLayout.astro';

const seo = {
  "title": "Elektriker Stockholm — Fast pris | PRM Montage",
  "description": "Behörig elektriker i Stockholm till fast pris. Elinstallationer, elcentraler, belysning och eluttag. PRM Montage i Solna — kostnadsfri offert.",
  "canonical": "https://prmmontage.se/elektriker-stockholm",
  "ogDescription": "Behörig elektriker i Stockholm till fast pris — elinstallationer, elcentraler, belysning och eluttag.",
  "ogImage": "https://prmmontage.se/assets/img/logo/logo-color.png",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Tjänster",
            "item": "https://prmmontage.se/tjanster"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Elektriker Stockholm"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Elinstallation",
        "name": "Elektriker Stockholm",
        "description": "Behörig elektriker i Stockholm till fast pris — elinstallationer, elcentraler, belysning och eluttag.",
        "provider": {
          "@type": "HomeAndConstructionBusiness",
          "@id": "https://prmmontage.se/#organization",
          "name": "PRM Montage",
          "legalName": "PRM MONTAGE AB",
          "url": "https://prmmontage.se/",
          "telephone": "+46852027977",
          "email": "info@pro-montage.se",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Industrivägen 19",
            "postalCode": "171 48",
            "addressLocality": "Solna",
            "addressCountry": "SE"
          },
          "priceRange": "$$"
        },
        "areaServed": "Stockholm",
        "url": "https://prmmontage.se/elektriker-stockholm"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Vad kostar en elektriker i Stockholm?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Priset varierar beroende på jobbets typ och omfattning — allt från byte av ett vägguttag till installation av en ny elcentral. Vanliga jobb har fasta priser (till exempel 1 600 kr för byte av vägguttag), medan vi för större eller mer omfattande elarbeten alltid lämnar en offert med fast pris innan arbetet påbörjas."
            }
          },
          {
            "@type": "Question",
            "name": "Är era elektriker behöriga?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja, våra elektriker är behöriga och utför alla elinstallationer enligt gällande regelverk."
            }
          },
          {
            "@type": "Question",
            "name": "Hur snabbt kan ni komma?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Vi planerar in de flesta uppdrag inom kort efter kontakt. Kontakta oss så återkommer vi med en tid som passar. Vid akuta elfel, se vår jour-sida."
            }
          },
          {
            "@type": "Question",
            "name": "Ger elarbete rätt till ROT-avdrag?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Arbetskostnaden vid elarbete ger normalt rätt till ROT-avdrag, medan material inte gör det. Läs mer på vår ROT-avdragssida."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="tjanster" defaultService="Elektriker">
  <!-- =============== BREADCRUMB =============== -->
  <div class="tp-breadcrumb-area tp-breadcrumb-spacing nt-dark-band pt-180 pb-90" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container">
      <div class="row"><div class="col-xl-8 col-lg-9">
        <div class="tp-breadcrumb-content">
          <h1 class="tp-breadcrumb-title fw-600 fs-60 fs-xs-40 ls-m-3 tp-text-common-white lh-1 mb-20">Elektriker Stockholm</h1>
          <div class="tp-breadcrumb-dvdr"><ul><li><a href="/">Hem</a></li><li class="dvdr">/</li><li><a href="/tjanster">Tjänster</a></li><li class="dvdr">/</li><li>Elektriker Stockholm</li></ul></div>
        </div>
      </div></div>
    </div>
  </div>

  <div class="tp-service-details-area pt-70 pb-120" style="background:var(--nt-white);">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8">
          <span class="nt-eyebrow">Tjänst</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Elektriker i Stockholm — till fast pris</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Behöver du en behörig elektriker i Stockholm? PRM Montage utför elinstallationer av alla slag — från nyinstallation vid renovering till byte av elcentraler, belysning och eluttag. Vi har egna behöriga elektriker, vilket gör att elarbetet ofta kan hanteras tillsammans med övrig bygg- eller badrumsrenovering i samma projekt.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Oavsett om det gäller ett enskilt vägguttag eller en helt ny elcentral lämnar vi ett fast pris innan arbetet påbörjas. För vanliga jobb hittar du exempel på fasta priser nedan — för större projekt tar vi fram en offert anpassad efter ditt behov.</p>

          <div class="row g-4 mt-10 mb-45">
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-orange);">
                <h5><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Fast pris</h5>
                <p>Du får en tydlig, fast prisbild innan vi sätter igång — inga överraskningar.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-navy);">
                <h5><i class="fas fa-shield-check" style="color:#1FA968;margin-right:8px;"></i>Behöriga elektriker</h5>
                <p>Egna behöriga elektriker, fullt försäkrade och med garanti på arbetet.</p>
              </div>
            </div>
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad ingår i elektrikertjänsten?</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Elinstallationer</span></li>
            <li><i class="fas fa-check-circle"></i><span>Nyinstallation vid renovering</span></li>
            <li><i class="fas fa-check-circle"></i><span>Byte och uppgradering av elcentraler</span></li>
            <li><i class="fas fa-check-circle"></i><span>Belysning, inom- och utomhus</span></li>
            <li><i class="fas fa-check-circle"></i><span>Nya och befintliga eluttag — även <a href="/eluttag-badrum">eluttag i badrum</a></span></li>
            <li><i class="fas fa-check-circle"></i><span>Felsökning och kontroll</span></li>
          </ul>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Prisexempel — vanliga elarbeten</h4>
          <table class="nt-price-table mb-10">
            <thead><tr><th>Tjänst</th><th>Pris</th></tr></thead>
            <tbody>
              <tr><td>Byte av vägguttag (inomhus)</td><td>1 600 kr</td></tr>
              <tr><td>Nytt vägguttag (inomhus)</td><td>1 600 kr</td></tr>
              <tr><td><a href="/eluttag-tvattmaskin-diskmaskin">Eluttag för tvättmaskin/diskmaskin</a></td><td>2 205 kr</td></tr>
            </tbody>
          </table>
          <p class="nt-price-note mb-45">Priserna är exempel på fasta priser för vanliga jobb. Kontakta oss för en offert anpassad efter ditt projekt.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga eljobb till fast pris</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span><a href="/eluttag-tvattmaskin-diskmaskin">Eluttag till tvättmaskin och diskmaskin</a></span></li>
            <li><i class="fas fa-check-circle"></i><span><a href="/eluttag-badrum">Eluttag i badrum, kommod och badrumsskåp</a></span></li>
            <li><i class="fas fa-check-circle"></i><span><a href="/montera-tv-pa-vagg">Montera TV på vägg</a> — infästning och dolda kablar</span></li>
          </ul>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om elektriker</h4>
          <div class="accordion nt-accordion mb-45" id="faqEl">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqEl1">Vad kostar en elektriker i Stockholm?</button></h2>
              <div id="faqEl1" class="accordion-collapse collapse show" data-bs-parent="#faqEl"><div class="accordion-body">Priset varierar beroende på jobbets typ och omfattning — allt från byte av ett vägguttag till installation av en ny elcentral. Vanliga jobb har fasta priser (till exempel 1 600 kr för byte av vägguttag), medan vi för större eller mer omfattande elarbeten alltid lämnar en offert med fast pris innan arbetet påbörjas.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqEl2">Är era elektriker behöriga?</button></h2>
              <div id="faqEl2" class="accordion-collapse collapse" data-bs-parent="#faqEl"><div class="accordion-body">Ja, våra elektriker är behöriga och utför alla elinstallationer enligt gällande regelverk.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqEl3">Hur snabbt kan ni komma?</button></h2>
              <div id="faqEl3" class="accordion-collapse collapse" data-bs-parent="#faqEl"><div class="accordion-body">Vi planerar in de flesta uppdrag inom kort efter kontakt. Kontakta oss så återkommer vi med en tid som passar. Vid akuta elfel, se vår <a href="/jour">jour-sida</a>.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqEl4">Ger elarbete rätt till ROT-avdrag?</button></h2>
              <div id="faqEl4" class="accordion-collapse collapse" data-bs-parent="#faqEl"><div class="accordion-body">Arbetskostnaden vid elarbete ger normalt rätt till ROT-avdrag, medan material inte gör det. Läs mer på vår <a href="/rut-rot">ROT-avdragssida</a>.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="nt-side-card nt-side-card--navy" style="background:var(--nt-navy);">
            <h4 style="color:#fff;font-weight:700;margin-bottom:24px;">Kontakta oss direkt</h4>
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-phone" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">Ring oss</p><a href="tel:+46852027977" style="color:#fff;font-weight:700;font-size:1.05rem;text-decoration:none;">08-520 279 77</a></div>
            </div>
            <div style="display:flex;align-items:center;gap:14px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-envelope" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">E-post</p><a href="mailto:info@pro-montage.se" style="color:#fff;font-weight:700;text-decoration:none;">info@pro-montage.se</a></div>
            </div>
          </div>
          <div class="nt-side-card">
            <h5>Varför PRM Montage?</h5>
            <ul class="nt-check" style="margin:0;"><li><i class="fas fa-check"></i><span>Fast pris, alltid</span></li><li><i class="fas fa-check"></i><span>F-skatt &amp; försäkrade</span></li><li><i class="fas fa-check"></i><span>Egna hantverkare</span></li><li><i class="fas fa-check"></i><span>Garanti på arbetet</span></li></ul>
          </div>
          <div class="nt-side-card">
            <h5>Alla tjänster</h5>
            <ul class="nt-side-nav">
              <li><a href="/koksrenovering-stockholm">Köksrenovering Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/bygg-renovering">Bygg &amp; renovering <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/vvs-badrum">VVS &amp; Badrum <i class="fas fa-arrow-right"></i></a></li>
              <li class="is-active"><a href="/elektriker-stockholm">Elektriker Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/altanbygge-i-stockholm">Altanbygge i Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/jour">Jour — akut hjälp <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="tp-cta-area nt-dark-band pt-120 pb-120" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container"><div class="row"><div class="col-xl-8 col-lg-10">
      <span class="nt-eyebrow nt-eyebrow-light">Redo att börja?</span>
      <h2 class="mb-15 fs-xl-40 fs-sm-36 tp-text-common-white">Behöver du en elektriker i Stockholm?</h2>
      <p class="mb-40" style="color:rgba(255,255,255,0.78);font-size:1.05rem;max-width:620px;">Kontakta oss idag — fast pris, egna hantverkare, kostnadsfri offert.</p>
      <div class="d-flex flex-wrap align-items-center gap-4">
        <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500"><span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span></a>
        <a href="tel:+46852027977" class="d-inline-flex align-items-center gap-3" style="text-decoration:none;"><span style="width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;"><i class="fas fa-phone" style="color:#1FA968;"></i></span><span><span style="display:block;color:rgba(255,255,255,0.6);font-size:.8rem;">Ring oss direkt</span><span style="display:block;color:#fff;font-weight:700;font-size:1.05rem;">08-520 279 77</span></span></a>
      </div>
    </div></div></div>
  </div>
</BaseLayout>
