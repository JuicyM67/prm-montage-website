---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import SectionHeader from '../components/landing/SectionHeader.astro';
import ReviewStrip from '../components/ReviewStrip.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyOfferCard from '../components/StickyOfferCard.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "Köksrenovering & köksmontering Solna — Fast pris | PRM Montage",
  "description": "Köksrenovering och köksmontering i Solna till fast pris. PRM Montage har kontor på Industrivägen 19 och monterar ditt nya kök — stomme, luckor och bänkskiva. Kostnadsfri offert.",
  "canonical": "https://prmmontage.se/koksmontering-solna",
  "ogDescription": "Köksmontering i Solna till fast pris — vi monterar kök i alla varumärken, med kort startsträcka från vårt kontor.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/hero-kok.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Köksmontering Solna"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Köksmontering",
        "name": "Köksmontering Solna",
        "description": "Montering av kök du redan köpt — stomme, luckor, bänkskiva och infästning, till fast pris i Solna.",
        "provider": organization,
        "areaServed": "Solna",
        "url": "https://prmmontage.se/koksmontering-solna"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Hur snabbt kan ni montera kök i Solna?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Med kontor på Industrivägen 19 har vi kort startsträcka. Hör av dig med mått och leverantör, så ger vi dig en tid och ett fast pris."
            }
          },
          {
            "@type": "Question",
            "name": "Kan ni montera kök som följer med en nyproducerad lägenhet?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. Många av våra kunder i Arenastaden, Hagalund och Råsunda har ett kök från byggherren eller en kökshandlare som ska upp före inflytt."
            }
          },
          {
            "@type": "Question",
            "name": "Vilka kök monterar ni?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Oavsett varumärke. Vi monterar det kök du har köpt, från stomme till bänkskiva."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} defaultService="Köksrenovering">
  <!-- =============== BREADCRUMB =============== -->
    <section class="cv-pagehero">
    <div class="cv-container">
      <ul class="cv-crumbs"><li><a href="/">Hem</a></li></ul>
      <h1>Köksrenovering &amp; köksmontering i Solna</h1>
      <p class="cv-pagehero__lead">Fast pris, kort startsträcka från vårt kontor i Solna och montering av kök i alla varumärken.</p>
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--outline-light"><i class="fas fa-phone"></i> Ring 08-520 279 77</a>
      </div>
      <div class="cv-rating cv-rating--light"><span class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span><span>4,9 på Google · 100+ omdömen</span></div>
    </div>
  </section>

  <div class="cv-pageshot-wrap"><div class="cv-container cv-pageshot"><img src="assets/img/projekt/hero-kok.webp" width="1400" height="560" alt="Kök monterat av PRM Montage i Stockholm" fetchpriority="high"></div></div>

  <ProofBar />


    <section class="cv-section">
    <div class="cv-container cv-layout">
      <article class="cv-prose">
          <span class="nt-eyebrow">Solna</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Köksmontering utförd av grannar på Industrivägen</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Vårt kontor ligger på Industrivägen 19, mitt i Solna — så när du anlitar oss för köksmontering handlar det inte om ett företag som bara skriver att man "jobbar i området", utan om hantverkare som redan är dina grannar. Köksmontering innebär att vi monterar ett kök du redan har köpt — oavsett varumärke: köksstomme, luckor, bänkskiva och infästning, utan att vi river ut befintlig VVS och el eller gör en total ombyggnad.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">I Solna märker vi tydligt av kommunens snabba utveckling. Många av våra uppdrag kommer från nyinflyttade i bostadsrätter i Arenastaden, Hagalund och Råsunda — kunder som köpt ett kök via mäklarens tillvalslista, ett byggherreavtal eller direkt från en kökshandlare, och som nu behöver få det monterat inför inflyttning. Andra vill helt enkelt byta ut en gammal köksstomme i en äldre lägenhet utan att göra en hel renovering. I båda fallen handlar köksmontering om att gå från kök i lådor och paket till ett färdigt, funktionellt kök — utan de kostnader och den tid som en total renovering med rivning, VVS och el annars kräver.</p>
          <div class="cv-btn-row cv-midcta-row">
            <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
          </div>


          <div class="nt-highlight mb-45">
            <h5><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Fast pris, kort startsträcka</h5>
            <p>Du får ett fast pris innan vi bokar tid, och som grannar kan vi ofta komma snabbt när köket ska vara klart.</p>
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad ingår i köksmonteringen?</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Köksstommar och skåp som står stadigt i våg</span></li>
            <li><i class="fas fa-check-circle"></i><span>Luckor och lådfronter som monteras och justeras</span></li>
            <li><i class="fas fa-check-circle"></i><span>Bänkskiva som kapas, passas in och fästs</span></li>
            <li><i class="fas fa-check-circle"></i><span>Lister, sockel och avslut</span></li>
            <li><i class="fas fa-check-circle"></i><span>Infästning enligt tillverkarens anvisningar</span></li>
          </ul>

          <div class="mb-45">
            <img src="assets/img/projekt/kok-04.webp" width="900" height="675" loading="lazy" alt="Monterat kök i lägenhet i Solna" class="w-100" style="border-radius:12px;aspect-ratio:16/9;height:auto;object-fit:cover;">
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Så går det till</h4>
          <div class="row g-4 gy-5 mb-45">
            <div class="col-md-4">
              <div class="nt-step h-100">
                <span class="nt-step__num">01</span>
                <h4>Kostnadsfri offert</h4>
                <p>Berätta om köket, med mått, leverantör och önskemål, så får du ett fast pris på monteringen.</p>
              </div>
            </div>
            <div class="col-md-4">
              <div class="nt-step h-100">
                <span class="nt-step__num">02</span>
                <h4>Montering bokas in</h4>
                <p>Vi bokar tid, ofta med kort varsel eftersom vårt kontor ligger på Industrivägen 19, mitt i Solna.</p>
              </div>
            </div>
            <div class="col-md-4">
              <div class="nt-step h-100">
                <span class="nt-step__num">03</span>
                <h4>Färdigt kök</h4>
                <p>Köket monteras, justeras och kopplas in vid behov, och vi går igenom det med dig innan vi lämnar.</p>
              </div>
            </div>
          </div>

          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Behövs även rivning, VVS eller el finns <a href="/koksrenovering-stockholm">Köksrenovering Stockholm</a>. Har du köpt ett IKEA-kök, se <a href="/ikea-koksmontering-solna">IKEA-köksmontering i Solna</a>. Mer om hur <a href="/rut-rot">ROT-avdraget</a> fungerar finns på en egen sida.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om köksmontering i Solna</h4>
          <div class="accordion nt-accordion mb-45" id="faqKoksmSolna">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqKoksmSolna1">Hur snabbt kan ni montera kök i Solna?</button></h2>
              <div id="faqKoksmSolna1" class="accordion-collapse collapse show" data-bs-parent="#faqKoksmSolna"><div class="accordion-body">Med kontor på Industrivägen 19 har vi kort startsträcka. Hör av dig med mått och leverantör, så ger vi dig en tid och ett fast pris.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqKoksmSolna2">Kan ni montera kök som följer med en nyproducerad lägenhet?</button></h2>
              <div id="faqKoksmSolna2" class="accordion-collapse collapse" data-bs-parent="#faqKoksmSolna"><div class="accordion-body">Ja. Många av våra kunder i Arenastaden, Hagalund och Råsunda har ett kök från byggherren eller en kökshandlare som ska upp före inflytt.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqKoksmSolna3">Vilka kök monterar ni?</button></h2>
              <div id="faqKoksmSolna3" class="accordion-collapse collapse" data-bs-parent="#faqKoksmSolna"><div class="accordion-body">Oavsett varumärke. Vi monterar det kök du har köpt, från stomme till bänkskiva.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </article>
      <aside>
        <StickyOfferCard related={[]} relatedTitle="Fler jobb" />
      </aside>
    </div>
  </section>

  <section class="cv-section cv-section--tint">
    <div class="cv-container">
      <SectionHeader pill="Omdömen" title="Det säger våra kunder" />
      <ReviewStrip count={3} offset={3} job />
    </div>
  </section>


    <FinalCta heading="Dags att förverkliga ditt drömkök?" />

</BaseLayout>
