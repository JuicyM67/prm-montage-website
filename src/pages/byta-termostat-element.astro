---
import SmallJobPage from '../components/SmallJobPage.astro';

const page = {
  "slug": "byta-termostat-element",
  "highlights": [
    {
      "icon": "fa-file-invoice-dollar",
      "title": "Fast pris",
      "text": "Du får en tydlig, fast prisbild innan vi sätter igång — inga överraskningar."
    },
    {
      "icon": "fa-user-group",
      "title": "Egna hantverkare",
      "text": "Du möter samma hantverkare som utför jobbet, med garanti på arbetet."
    }
  ],
  "related": [
    {
      "href": "/handyman-stockholm",
      "label": "Handyman Stockholm"
    },
    {
      "href": "/mobelmontering-stockholm",
      "label": "Möbelmontering"
    },
    {
      "href": "/montera-hyllor-tavlor-gardinstanger",
      "label": "Hyllor, tavlor & gardinstänger"
    },
    {
      "href": "/montera-tv-pa-vagg",
      "label": "Montera TV på vägg"
    },
    {
      "href": "/byta-las-cylinder",
      "label": "Byta lås & låscylinder"
    },
    {
      "href": "/montera-dorr-dorrstangare",
      "label": "Dörr & dörrstängare"
    },
    {
      "href": "/byta-blandare",
      "label": "Byta blandare"
    },
    {
      "href": "/byta-toalettstol",
      "label": "Byta toalettstol"
    },
    {
      "href": "/byta-varmvattenberedare",
      "label": "Byta varmvattenberedare"
    },
    {
      "href": "/byta-eluttag-stromstallare",
      "label": "Byta eluttag & strömbrytare"
    },
    {
      "href": "/montera-taklampa",
      "label": "Montera taklampa & spotlights"
    }
  ],
  "eyebrow": "Tjänst",
  "crumbs": [],
  "title": "Byta termostat på element Stockholm | PRM Montage",
  "description": "Byta termostat på element eller radiator i Stockholm? Vi byter termostatventil och termostathuvud så att värmen blir jämn. Kostnadsfri offert.",
  "heroImage": "assets/img/projekt/badrum-09.webp",
  "heroAlt": "Arbete utfört av PRM Montage i Stockholm",
  "h1": "Byta termostat på element i Stockholm",
  "lead": "Kallt element, för varmt rum eller en termostat som inte går att vrida? Vi byter.",
  "h2": "Byta radiatortermostat — jämn värme i hela hemmet",
  "intro": [
    "Blir elementet kallt fast värmen är på, blir det för varmt i rummet eller går termostaten inte att vrida? PRM Montage byter termostater på element och radiatorer i Stockholm. Vi bedömer först om det räcker att byta termostathuvudet eller om själva ventilen behöver bytas.",
    "En fungerande termostat håller rätt temperatur i rummet och hjälper till att undvika onödig energiförbrukning. Skicka ett foto på elementet och termostaten så ser vi vad som behövs."
  ],
  "sections": [
    {
      "h": "Termostathuvud eller termostatventil?",
      "paras": [
        "Termostathuvudet är den vridbara delen på elementet, och ofta räcker det att byta det. Sitter problemet i själva ventilen — om den är fastkärvad, läcker eller saknar funktion — byts ventilen, vilket kräver att vattnet i elementet tappas av."
      ]
    },
    {
      "h": "Kallt upptill eller ljud i elementet",
      "paras": [
        "Är elementet kallt upptill kan det behöva luftas, och ljud från elementet beror ofta på luft i systemet. Beskriv symptomen så tittar vi på det."
      ]
    },
    {
      "h": "Bostadsrätt och hyresrätt",
      "paras": [
        "I flerfamiljshus delar du ofta värmesystem med huset. Kontrollera med föreningen eller fastighetsägaren innan arbete på elementventiler, så stämmer vi gärna av hur det ska göras.",
        "Vi kommer till Stockholm med omnejd — bland annat <a href=\"/solna\">Solna</a>, <a href=\"/sundbyberg\">Sundbyberg</a>, <a href=\"/bromma\">Bromma</a>, <a href=\"/danderyd\">Danderyd</a>, <a href=\"/tacby\">Täby</a> och <a href=\"/lidingo\">Lidingö</a>."
      ]
    }
  ],
  "faqs": [
    {
      "q": "Hur vet jag om det är termostaten eller ventilen som är fel?",
      "a": "Är det bara termostathuvudet som sitter fast eller inte reagerar räcker det ofta att byta det. Fortsätter elementet vara kallt eller läcker det vid ventilen kan själva ventilen vara orsaken. Ett foto i offertformuläret räcker ofta för en första bedömning."
    },
    {
      "q": "Kan jag byta termostathuvud själv?",
      "a": "Det går ofta bra eftersom huvudet skruvas på ventilen, men passar inte huvudet eller sitter ventilen fast bör en VVS-montör titta på det."
    },
    {
      "q": "Kan ni avlufta mina element?",
      "a": "Ja, vi kan titta på element som är kalla upptill eller låter när vi ändå är på plats."
    },
    {
      "q": "Behöver jag köpa termostaten själv?",
      "a": "Du kan köpa den själv eller få hjälp att välja en modell som passar din ventil."
    }
  ],
  "serviceType": "Byte av radiatortermostat",
  "serviceName": "Byta termostat på element Stockholm",
  "defaultService": "VVS & Badrum",
  "ctaHeading": "Dags att byta termostat?"
};
---
<SmallJobPage {...page} />
