---
import BaseLayout from '../layouts/BaseLayout.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "IKEA-köksmontering Lidingö — Fast pris | PRM Montage",
  "description": "IKEA-köksmontering i Lidingö till fast pris. Vi monterar ditt METOD-kök i villa eller lägenhet — enligt IKEA:s egna anvisningar. Kostnadsfri offert.",
  "canonical": "https://prmmontage.se/ikea-koksmontering-lidingo",
  "ogDescription": "IKEA-köksmontering i Lidingö till fast pris — montering av METOD-kök enligt IKEA:s anvisningar.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/hero-kok.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "IKEA-köksmontering Lidingö"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "IKEA-köksmontering",
        "name": "IKEA-köksmontering Lidingö",
        "description": "Montering av IKEA:s METOD-köksystem i Lidingö — stommar, luckor, MAXIMERA-lådor och bänkskiva, till fast pris.",
        "provider": organization,
        "areaServed": "Lidingö",
        "url": "https://prmmontage.se/ikea-koksmontering-lidingo"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Vad kostar IKEA-köksmontering på Lidingö?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ett fast pris sätts när vi sett kökets mått och uppbyggnad. Villa eller lägenhet, huvudkök eller källarkök: offerten är gratis."
            }
          },
          {
            "@type": "Question",
            "name": "Är ni certifierade av IKEA?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Certifiering från IKEA har vi inte. Däremot har vi monterat många METOD-kök, och vi följer monteringsanvisningarna steg för steg."
            }
          },
          {
            "@type": "Question",
            "name": "Kommer ni över bron för en köksmontering?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. Lidingö nås med en kort bilresa från Solna och vi kan normalt boka in monteringen inom rimlig tid."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} defaultService="Köksrenovering">
  <!-- =============== BREADCRUMB =============== -->
  <div class="tp-breadcrumb-area tp-breadcrumb-spacing nt-dark-band pt-180 pb-90" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container">
      <div class="row"><div class="col-xl-8 col-lg-9">
        <div class="tp-breadcrumb-content">
          <h1 class="tp-breadcrumb-title fw-600 fs-60 fs-xs-40 ls-m-3 tp-text-common-white lh-1 mb-20">IKEA-köksmontering i Lidingö</h1>
          <p style="color:rgba(255,255,255,.78);font-size:1.02rem;max-width:620px;margin-bottom:18px;">Montering av ditt IKEA METOD-kök — fast pris, Lidingö.</p>
          <div class="tp-breadcrumb-dvdr"><ul><li><a href="/">Hem</a></li><li class="dvdr">/</li><li>IKEA-köksmontering Lidingö</li></ul></div>
        </div>
      </div></div>
    </div>
  </div>

  <div class="tp-service-details-area pt-100 pb-120" style="background:var(--nt-white);">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8">
          <span class="nt-eyebrow">Lidingö</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">IKEA-köksmontering i Lidingö — även i villor och premiumboenden</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">På Lidingö, i områden som Bodal, Käppala och Larsberg, finns många välskötta villor, och här väljer inte alla ett skräddarsytt kök. METOD-systemet passar bra när köket ska bli praktiskt och prisvärt, och när pengarna i huset ska läggas på annat.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Äldre villor på Lidingö har ofta golv och väggar som sjunkit eller lutar något. Det spelar roll för ett kök av METOD-typ, eftersom stommarna ska hänga på en skena som sitter i våg. Vi mäter och justerar efter huset, så att luckorna står jämnt trots att rummet inte gör det. Vi är inte någon officiell IKEA-partner och är inte certifierade av dem, men våra hantverkare har monterat många METOD-kök och arbetar efter IKEA:s monteringsanvisningar.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Ibland gäller jobbet inte huvudköket utan ett extra kök i en källare eller en gäståndelse. Då är det kostnaden som avgör valet av IKEA, men monteringen ska hålla samma kvalitet som i huvudköket.</p>

          <div class="row g-4 mt-10 mb-45">
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-orange);">
                <h5><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Fast pris</h5>
                <p>Priset är bestämt innan jobbet startar, även för ett kök i ett äldre hus.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-navy);">
                <h5><i class="fas fa-house" style="color:#1FA968;margin-right:8px;"></i>Köket sitter rakt</h5>
                <p>Vi justerar noga mot väggar och golv som inte är helt raka.</p>
              </div>
            </div>
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad ingår i IKEA-köksmonteringen i Lidingö?</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Stommar monterade efter ritning</span></li>
            <li><i class="fas fa-check-circle"></i><span>Luckor och lådfronter som sluter fint</span></li>
            <li><i class="fas fa-check-circle"></i><span>Lådor med MAXIMERA-system</span></li>
            <li><i class="fas fa-check-circle"></i><span>Bänkskiva som kapas efter kökets mått</span></li>
            <li><i class="fas fa-check-circle"></i><span>Lister och sockel runt hela köket</span></li>
            <li><i class="fas fa-check-circle"></i><span>Fast infästning och slutkontroll</span></li>
          </ul>

          <div class="mb-45">
            <img src="assets/img/projekt/kok-04.webp" width="900" height="675" loading="lazy" alt="Monterat IKEA-kök på Lidingö" class="w-100" style="border-radius:12px;aspect-ratio:16/9;height:auto;object-fit:cover;">
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Så går det till</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span><strong>1. Skicka ritningen</strong> — planlösningen från IKEA via kontaktformuläret.</span></li>
            <li><i class="fas fa-check-circle"></i><span><strong>2. Få offert</strong> — ett fast pris efter kökets storlek.</span></li>
            <li><i class="fas fa-check-circle"></i><span><strong>3. Bokning</strong> — vi planerar resan över bron och hittar en tid som passar dig.</span></li>
          </ul>

          <p class="mb-45" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Har du köpt köket från någon annan än IKEA, se <a href="/koksmontering-lidingo">köksmontering på Lidingö</a>. För rivning och nya ledningar, läs <a href="/koksrenovering-stockholm">Köksrenovering Stockholm</a>. <a href="/rut-rot">Så fungerar ROT-avdraget</a>.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om IKEA-köksmontering i Lidingö</h4>
          <div class="accordion nt-accordion mb-45" id="faqIkeaLid">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqIkeaLid1">Vad kostar IKEA-köksmontering på Lidingö?</button></h2>
              <div id="faqIkeaLid1" class="accordion-collapse collapse show" data-bs-parent="#faqIkeaLid"><div class="accordion-body">Ett fast pris sätts när vi sett kökets mått och uppbyggnad. Villa eller lägenhet, huvudkök eller källarkök: offerten är gratis.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqIkeaLid2">Är ni certifierade av IKEA?</button></h2>
              <div id="faqIkeaLid2" class="accordion-collapse collapse" data-bs-parent="#faqIkeaLid"><div class="accordion-body">Certifiering från IKEA har vi inte. Däremot har vi monterat många METOD-kök, och vi följer monteringsanvisningarna steg för steg.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqIkeaLid3">Kommer ni över bron för en köksmontering?</button></h2>
              <div id="faqIkeaLid3" class="accordion-collapse collapse" data-bs-parent="#faqIkeaLid"><div class="accordion-body">Ja. Lidingö nås med en kort bilresa från Solna och vi kan normalt boka in monteringen inom rimlig tid.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="nt-side-card nt-side-card--navy" style="background:var(--nt-navy);">
            <h4 style="color:#fff;font-weight:700;margin-bottom:24px;">Kontakta oss direkt</h4>
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-phone" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">Ring oss</p><a href="tel:+46852027977" style="color:#fff;font-weight:700;font-size:1.05rem;text-decoration:none;">08-520 279 77</a></div>
            </div>
            <div style="display:flex;align-items:center;gap:14px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-envelope" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">E-post</p><a href="mailto:info@pro-montage.se" style="color:#fff;font-weight:700;text-decoration:none;">info@pro-montage.se</a></div>
            </div>
          </div>
          <div class="nt-side-card">
            <h5>Relaterat</h5>
            <ul class="nt-side-nav">
              <li><a href="/koksmontering-lidingo">Köksmontering Lidingö <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/koksrenovering-stockholm">Köksrenovering Stockholm <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
          <div class="nt-side-card">
            <h5>Fler områden</h5>
            <ul class="nt-side-nav">
              <li><a href="/ikea-koksmontering-solna">IKEA-köksmontering Solna <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/ikea-koksmontering-sundbyberg">IKEA-köksmontering Sundbyberg <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/ikea-koksmontering-upplands-vasby">IKEA-köksmontering Upplands Väsby <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/ikea-koksmontering-danderyd">IKEA-köksmontering Danderyd <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/ikea-koksmontering-bromma">IKEA-köksmontering Bromma <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/ikea-koksmontering-tacby">IKEA-köksmontering Täby <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/lidingo">Om Lidingö <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="tp-cta-area nt-dark-band pt-120 pb-120" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container"><div class="row"><div class="col-xl-8 col-lg-10">
      <span class="nt-eyebrow nt-eyebrow-light">Redo att börja?</span>
      <h2 class="mb-15 fs-xl-40 fs-sm-36 tp-text-common-white">IKEA-köksmontering i Lidingö redo att bokas in</h2>
      <p class="mb-40" style="color:rgba(255,255,255,0.78);font-size:1.05rem;max-width:620px;">Kontakta oss idag — fast pris, egna hantverkare, kostnadsfri offert.</p>
      <div class="d-flex flex-wrap align-items-center gap-4">
        <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500"><span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span></a>
        <a href="tel:+46852027977" class="d-inline-flex align-items-center gap-3" style="text-decoration:none;"><span style="width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;"><i class="fas fa-phone" style="color:#1FA968;"></i></span><span><span style="display:block;color:rgba(255,255,255,0.6);font-size:.8rem;">Ring oss direkt</span><span style="display:block;color:#fff;font-weight:700;font-size:1.05rem;">08-520 279 77</span></span></a>
      </div>
    </div></div></div>
  </div>
</BaseLayout>
