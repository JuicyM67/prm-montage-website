---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import SectionHeader from '../components/landing/SectionHeader.astro';
import ReviewStrip from '../components/ReviewStrip.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyOfferCard from '../components/StickyOfferCard.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "Byta kommod & handfat Stockholm — Fast pris | PRM Montage",
  "description": "Vill du byta kommod eller handfat i badrummet? Vi byter och monterar tvättställ och kommod i Stockholm till fast pris, inklusive demontering och bortforsling.",
  "canonical": "https://prmmontage.se/byta-handfat-kommod",
  "ogDescription": "Montering och byte av handfat, tvättställ och kommod i Stockholm — till fast pris.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/badrum-10.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Tjänster",
            "item": "https://prmmontage.se/tjanster"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Byta handfat & kommod"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Montering av handfat och kommod",
        "name": "Byta handfat och kommod Stockholm",
        "description": "Montering och byte av handfat, tvättställ och kommod i Stockholm — till fast pris.",
        "provider": organization,
        "areaServed": "Stockholm",
        "url": "https://prmmontage.se/byta-handfat-kommod"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Vad kostar det att montera ett handfat?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Priset beror på om det är ett rakt byte mot befintliga anslutningar eller om vatten och avlopp behöver justeras för den nya kommodens höjd. Du får alltid ett fast pris innan arbetet påbörjas, baserat på en kostnadsfri offert."
            }
          },
          {
            "@type": "Question",
            "name": "Klarar väggen en vägghängd kommod?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Det beror på väggens konstruktion. I gipsvägg krävs oftast förstärkning eller genomgående infästning för att bära kommodens vikt. Vi bedömer det på plats och löser infästningen på rätt sätt."
            }
          },
          {
            "@type": "Question",
            "name": "Kan ni byta blandare samtidigt?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja, det är vanligast att göra båda samtidigt. Det sparar tid och blir billigare än två separata besök."
            }
          },
          {
            "@type": "Question",
            "name": "Ger byte av handfat rätt till ROT-avdrag?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Arbetskostnaden vid byte av handfat och kommod ger normalt rätt till ROT-avdrag, medan material inte gör det. Läs mer på vår ROT-avdragssida."
            }
          },
          {
            "@type": "Question",
            "name": "Kan jag byta handfat eller kommod i badrummet själv?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Att skruva fast en kommod kan många göra själva, men anslutningen av vatten och avlopp bör göras fackmannamässigt — en felkoppling kan ge fuktskador som syns först långt senare. Vi demonterar det gamla, monterar nytt och kontrollerar att allt är tätt, så du slipper risken."
            }
          },
          {
            "@type": "Question",
            "name": "Vad ingår när ni byter kommod i badrum?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Vi demonterar den gamla kommoden och handfatet, bortforslar dem, monterar den nya kommoden eller tvättstället med blandare och ansluter vatten och avlopp. Behöver du ett eluttag i kommoden hjälper vår behöriga elektriker till."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="tjanster" defaultService="VVS & Badrum">
  <!-- =============== BREADCRUMB =============== -->
    <section class="cv-pagehero">
    <div class="cv-container">
      <ul class="cv-crumbs"><li><a href="/">Hem</a></li><li><a href="/tjanster">Tjänster</a></li></ul>
      <h1>Byta handfat &amp; montera kommod</h1>
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--outline-light"><i class="fas fa-phone"></i> Ring 08-520 279 77</a>
      </div>
      <div class="cv-rating cv-rating--light"><span class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span><span>4,9 på Google · 100+ omdömen</span></div>
    </div>
  </section>

  <div class="cv-pageshot-wrap"><div class="cv-container cv-pageshot"><img src="assets/img/projekt/badrum-10.webp" width="1400" height="560" alt="Badrum med nytt handfat och kommod, utfört av PRM Montage i Stockholm" fetchpriority="high"></div></div>

  <ProofBar />


  

    <section class="cv-section">
    <div class="cv-container cv-layout">
      <article class="cv-prose">
          <span class="nt-eyebrow">Tjänst</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Montering av handfat och kommod — till fast pris</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Ett nytt handfat med kommod förändrar hela badrummet, och är ett av de snabbaste sätten att fräscha upp rummet utan en full renovering. PRM Montage monterar handfat, tvättställ och kommoder i hela Stockholm — vi demonterar det gamla, monterar det nya och ansluter vatten och avlopp.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Vi monterar både vägghängda kommoder och golvstående modeller, med tvättställ i porslin eller komposit. Ofta byts blandaren samtidigt — det gör vi i samma besök, se <a href="/byta-blandare">byta blandare</a>. Du får alltid ett fast pris innan arbetet påbörjas.</p>
          <div class="cv-btn-row cv-midcta-row">
            <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
          </div>


          <div class="row g-4 mt-10 mb-45">
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-orange);">
                <h5><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Fast pris</h5>
                <p>Du får en tydlig, fast prisbild innan vi sätter igång — inga överraskningar.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-navy);">
                <h5><i class="fas fa-shield-check" style="color:#1FA968;margin-right:8px;"></i>Auktoriserade installatörer</h5>
                <p>Behöriga VVS-installatörer, fullt försäkrade och med garanti på arbetet.</p>
              </div>
            </div>
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad ingår när vi byter handfat och kommod?</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Demontering av gammalt handfat och kommod</span></li>
            <li><i class="fas fa-check-circle"></i><span>Montering av vägghängd eller golvstående kommod</span></li>
            <li><i class="fas fa-check-circle"></i><span>Infästning anpassad efter väggens konstruktion</span></li>
            <li><i class="fas fa-check-circle"></i><span>Montering av tvättställ och blandare</span></li>
            <li><i class="fas fa-check-circle"></i><span>Anslutning av vatten och vattenlås</span></li>
            <li><i class="fas fa-check-circle"></i><span>Silikonfogning, täthetsprovning och bortforsling</span></li>
          </ul>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om handfat och kommod</h4>
          <div class="accordion nt-accordion mb-45" id="faqHandfat">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqHandfat1">Vad kostar det att montera ett handfat?</button></h2>
              <div id="faqHandfat1" class="accordion-collapse collapse show" data-bs-parent="#faqHandfat"><div class="accordion-body">Priset beror på om det är ett rakt byte mot befintliga anslutningar eller om vatten och avlopp behöver justeras för den nya kommodens höjd. Du får alltid ett fast pris innan arbetet påbörjas, baserat på en kostnadsfri offert.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqHandfat2">Klarar väggen en vägghängd kommod?</button></h2>
              <div id="faqHandfat2" class="accordion-collapse collapse" data-bs-parent="#faqHandfat"><div class="accordion-body">Det beror på väggens konstruktion. I gipsvägg krävs oftast förstärkning eller genomgående infästning för att bära kommodens vikt. Vi bedömer det på plats och löser infästningen på rätt sätt.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqHandfat3">Kan ni byta blandare samtidigt?</button></h2>
              <div id="faqHandfat3" class="accordion-collapse collapse" data-bs-parent="#faqHandfat"><div class="accordion-body">Ja, det är vanligast att göra båda samtidigt. Det sparar tid och blir billigare än två separata besök.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqHandfat4">Ger byte av handfat rätt till ROT-avdrag?</button></h2>
              <div id="faqHandfat4" class="accordion-collapse collapse" data-bs-parent="#faqHandfat"><div class="accordion-body">Arbetskostnaden vid byte av handfat och kommod ger normalt rätt till ROT-avdrag, medan material inte gör det. Läs mer på vår <a href="/rut-rot">ROT-avdragssida</a>.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqHandfat5">Kan jag byta handfat eller kommod i badrummet själv?</button></h2>
              <div id="faqHandfat5" class="accordion-collapse collapse" data-bs-parent="#faqHandfat"><div class="accordion-body">Att skruva fast en kommod kan många göra själva, men anslutningen av vatten och avlopp bör göras fackmannamässigt — en felkoppling kan ge fuktskador som syns först långt senare. Vi demonterar det gamla, monterar nytt och kontrollerar att allt är tätt, så du slipper risken.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqHandfat6">Vad ingår när ni byter kommod i badrum?</button></h2>
              <div id="faqHandfat6" class="accordion-collapse collapse" data-bs-parent="#faqHandfat"><div class="accordion-body">Vi demonterar den gamla kommoden och handfatet, bortforslar dem, monterar den nya kommoden eller tvättstället med blandare och ansluter vatten och avlopp. Behöver du ett eluttag i kommoden hjälper vår behöriga elektriker till — se <a href="/eluttag-badrum">eluttag i badrum</a>.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </article>
      <aside>
        <StickyOfferCard related={[{href:'/byta-blandare',label:'Byta blandare'},{href:'/installera-diskmaskin',label:'Installera diskmaskin'},{href:'/byta-toalettstol',label:'Byta toalettstol'},{href:'/installera-tvattmaskin',label:'Installera tvättmaskin'},{href:'/eluttag-tvattmaskin-diskmaskin',label:'Eluttag till tvätt- & diskmaskin'},{href:'/eluttag-badrum',label:'Eluttag i badrum'},{href:'/laga-lackande-blandare',label:'Laga läckande blandare'},{href:'/montera-duschvagg',label:'Montera duschvägg'},{href:'/montera-tv-pa-vagg',label:'Montera TV på vägg'},{href:'/handyman-stockholm',label:'Handyman Stockholm'},{href:'/mobelmontering-stockholm',label:'Möbelmontering'},{href:'/byta-las-cylinder',label:'Byta lås & låscylinder'}]} relatedTitle="Fler jobb" />
      </aside>
    </div>
  </section>

  <section class="cv-section cv-section--tint">
    <div class="cv-container">
      <SectionHeader pill="Omdömen" title="Det säger våra kunder" />
      <ReviewStrip count={3} offset={10} job />
    </div>
  </section>


    <FinalCta heading="Dags för ett nytt handfat?" />

</BaseLayout>
