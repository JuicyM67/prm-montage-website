---
import BaseLayout from '../layouts/BaseLayout.astro';

const seo = {
  "title": "Garanti, ansvar och trygghet | PRM Montage",
  "description": "PRM Montage AB tar fullt ansvar för sina kunder — fast pris, full försäkring under varje uppdrag, F-skatt och garanti på utfört arbete.",
  "canonical": "https://prmmontage.se/garanti",
  "ogDescription": "Fast pris, full försäkring, F-skatt och garanti på utfört arbete — vi tar fullt ansvar för våra kunder.",
  "ogImage": "https://prmmontage.se/assets/img/brand/og-default.jpg",
  "twitterDescription": "Fast pris, full försäkring, F-skatt och garanti på utfört arbete.",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Garanti"
          }
        ]
      },
      {
        "@type": "WebPage",
        "url": "https://prmmontage.se/garanti",
        "name": "Garanti, Ansvar och Trygghet",
        "about": {
          "@type": "HomeAndConstructionBusiness",
          "@id": "https://prmmontage.se/#organization",
          "name": "PRM Montage",
          "legalName": "PRM MONTAGE AB",
          "url": "https://prmmontage.se/",
          "telephone": "+46852027977",
          "email": "info@pro-montage.se",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Industrivägen 19",
            "postalCode": "171 48",
            "addressLocality": "Solna",
            "addressCountry": "SE"
          },
          "priceRange": "$$"
        }
      }
    ]
  }
};
---

<BaseLayout seo={seo}>
  <!-- =============== BREADCRUMB =============== -->
  <div class="tp-breadcrumb-area tp-breadcrumb-spacing nt-dark-band pt-180 pb-90" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container">
      <div class="row"><div class="col-xl-8 col-lg-9">
        <div class="tp-breadcrumb-content">
          <h1 class="tp-breadcrumb-title fw-600 fs-60 fs-xs-40 ls-m-3 tp-text-common-white lh-1 mb-20">Garanti, ansvar och trygghet</h1>
          <div class="tp-breadcrumb-dvdr"><ul><li><a href="/">Hem</a></li><li class="dvdr">/</li><li>Garanti</li></ul></div>
        </div>
      </div></div>
    </div>
  </div>
  <!-- =============== /BREADCRUMB =============== -->

  <div class="pt-100 pb-120" style="background:var(--nt-white);">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8">
          <span class="nt-eyebrow">Vi tar fullt ansvar för våra kunder</span>
          <h2 class="mb-25 fs-xl-36 fs-sm-30">Så tänker vi kring garanti, ansvar och trygghet</h2>
          <p class="mb-45" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Att anlita en hantverkare handlar om förtroende. Därför är vi tydliga med vad du kan förvänta dig av oss — innan, under och efter att arbetet är utfört.</p>

          <div class="mb-45">
            <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:14px;"><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:10px;"></i>Fast pris</h4>
            <p style="color:var(--nt-gray);line-height:1.8;">Vi lämnar alltid ett fast, skriftligt pris innan arbetet påbörjas. Det innebär att du vet exakt vad projektet kostar redan innan du bestämmer dig — inga dolda avgifter eller överraskningar på fakturan.</p>
          </div>

          <div class="mb-45">
            <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:14px;"><i class="fas fa-shield-check" style="color:#1FA968;margin-right:10px;"></i>Försäkring</h4>
            <p style="color:var(--nt-gray);line-height:1.8;">PRM Montage AB är fullt försäkrat under varje uppdrag vi tar oss an. Det ger dig som kund trygghet genom hela projektet, oavsett om det handlar om en mindre installation eller en större renovering.</p>
          </div>

          <div class="mb-45">
            <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:14px;"><i class="fas fa-award" style="color:#1FA968;margin-right:10px;"></i>Garanti på utfört arbete</h4>
            <p style="color:var(--nt-gray);line-height:1.8;">Vi står bakom det arbete vi utför och rättar till eventuella brister som uppstår på grund av vårt arbete. För dig som privatperson gäller dessutom det konsumentskydd som följer av konsumenttjänstlagen, vilket bland annat reglerar fackmässighet, reklamationsrätt och företagets ansvar för fel i utfört arbete. Vi går alltid igenom resultatet tillsammans med dig vid besiktning.</p>
          </div>

          <div class="mb-10">
            <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:14px;"><i class="fas fa-stamp" style="color:#1FA968;margin-right:10px;"></i>F-skatt</h4>
            <p style="color:var(--nt-gray);line-height:1.8;">PRM Montage AB innehar F-skatt, vilket innebär att bolaget själv ansvarar för att betala in skatter och sociala avgifter för sitt arbete. Som kund blir du därför inte betalningsskyldig för dessa avgifter, till skillnad från om du hade anlitat en hantverkare utan F-skatt.</p>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="nt-side-card nt-side-card--navy" style="background:var(--nt-navy);">
            <h4 style="color:#fff;font-weight:700;margin-bottom:24px;">Kontakta oss direkt</h4>
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-phone" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">Ring oss</p><a href="tel:+46852027977" style="color:#fff;font-weight:700;font-size:1.05rem;text-decoration:none;">08-520 279 77</a></div>
            </div>
            <div style="display:flex;align-items:center;gap:14px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-envelope" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">E-post</p><a href="mailto:info@pro-montage.se" style="color:#fff;font-weight:700;text-decoration:none;">info@pro-montage.se</a></div>
            </div>
          </div>
          <div class="nt-side-card">
            <h5>Trygghet hos PRM Montage</h5>
            <ul class="nt-check" style="margin:0;"><li><i class="fas fa-check"></i><span>Fast pris, alltid</span></li><li><i class="fas fa-check"></i><span>F-skatt &amp; försäkrade</span></li><li><i class="fas fa-check"></i><span>Egna hantverkare</span></li><li><i class="fas fa-check"></i><span>Garanti på arbetet</span></li></ul>
          </div>
          <div class="nt-side-card">
            <h5>Läs även</h5>
            <ul class="nt-side-nav">
              <li><a href="/rut-rot">ROT-avdrag <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/sa-har-gar-det-till">Så här går det till <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/om-oss">Om oss <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- =============== CTA =============== -->
  <div class="tp-cta-area nt-dark-band pt-120 pb-120" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container"><div class="row"><div class="col-xl-8 col-lg-10">
      <span class="nt-eyebrow nt-eyebrow-light">Redo att börja?</span>
      <h2 class="mb-15 fs-xl-40 fs-sm-36 tp-text-common-white">Trygg hantverksfirma, samlad på ett ställe</h2>
      <p class="mb-40" style="color:rgba(255,255,255,0.78);font-size:1.05rem;max-width:620px;">Kontakta oss idag för en kostnadsfri offert — fast pris, försäkrat och med garanti på arbetet.</p>
      <div class="d-flex flex-wrap align-items-center gap-4">
        <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500"><span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span></a>
        <a href="tel:+46852027977" class="d-inline-flex align-items-center gap-3" style="text-decoration:none;"><span style="width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;"><i class="fas fa-phone" style="color:#1FA968;"></i></span><span><span style="display:block;color:rgba(255,255,255,0.6);font-size:.8rem;">Ring oss direkt</span><span style="display:block;color:#fff;font-weight:700;font-size:1.05rem;">08-520 279 77</span></span></a>
      </div>
    </div></div></div>
  </div>
  <!-- =============== /CTA =============== -->

  <!-- =============== FOOTER =============== -->
</BaseLayout>
