---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import FinalCta from '../components/FinalCta.astro';

const seo = {
  "title": "Garanti, ansvar och trygghet | PRM Montage",
  "description": "PRM Montage AB tar fullt ansvar för sina kunder — fast pris, full försäkring under varje uppdrag, F-skatt och garanti på utfört arbete.",
  "canonical": "https://prmmontage.se/garanti",
  "ogDescription": "Fast pris, full försäkring, F-skatt och garanti på utfört arbete — vi tar fullt ansvar för våra kunder.",
  "ogImage": "https://prmmontage.se/assets/img/brand/og-default.jpg",
  "twitterDescription": "Fast pris, full försäkring, F-skatt och garanti på utfört arbete.",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Garanti"
          }
        ]
      },
      {
        "@type": "WebPage",
        "url": "https://prmmontage.se/garanti",
        "name": "Garanti, Ansvar och Trygghet",
        "about": {
          "@type": "HomeAndConstructionBusiness",
          "@id": "https://prmmontage.se/#organization",
          "name": "PRM Montage",
          "legalName": "PRM MONTAGE AB",
          "url": "https://prmmontage.se/",
          "telephone": "+46852027977",
          "email": "info@pro-montage.se",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Industrivägen 19",
            "postalCode": "171 48",
            "addressLocality": "Solna",
            "addressCountry": "SE"
          },
          "priceRange": "$$"
        }
      }
    ]
  }
};
---

<BaseLayout seo={seo}>
  <!-- =============== BREADCRUMB =============== -->
    <section class="cv-pagehero">
    <div class="cv-container">
      <ul class="cv-crumbs"><li><a href="/">Hem</a></li></ul>
      <h1>Garanti, ansvar och trygghet</h1>
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--outline-light"><i class="fas fa-phone"></i> Ring 08-520 279 77</a>
      </div>
    </div>
  </section>

  <ProofBar />

  <!-- =============== /BREADCRUMB =============== -->

  <div class="pt-100 pb-120" style="background:var(--nt-white);">
    <div class="container">
      <div class="cv-layout">
        <article class="cv-prose">
          <span class="nt-eyebrow">Vi tar fullt ansvar för våra kunder</span>
          <h2 class="mb-25 fs-xl-36 fs-sm-30">Så tänker vi kring garanti, ansvar och trygghet</h2>
          <p class="mb-45" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Att anlita en hantverkare handlar om förtroende. Därför är vi tydliga med vad du kan förvänta dig av oss — innan, under och efter att arbetet är utfört.</p>

          <div class="mb-45">
            <h3 style="color:var(--nt-navy);font-weight:700;margin-bottom:14px;"><i class="fas fa-file-invoice-dollar" style="color:#009828;margin-right:10px;"></i>Fast pris</h3>
            <p style="color:var(--nt-gray);line-height:1.8;">Vi lämnar alltid ett fast, skriftligt pris innan arbetet påbörjas. Det innebär att du vet exakt vad projektet kostar redan innan du bestämmer dig — inga dolda avgifter eller överraskningar på fakturan.</p>
          </div>

          <div class="mb-45">
            <h3 style="color:var(--nt-navy);font-weight:700;margin-bottom:14px;"><i class="fas fa-shield-check" style="color:#009828;margin-right:10px;"></i>Försäkring</h3>
            <p style="color:var(--nt-gray);line-height:1.8;">PRM Montage AB är fullt försäkrat under varje uppdrag vi tar oss an. Det ger dig som kund trygghet genom hela projektet, oavsett om det handlar om en mindre installation eller en större renovering.</p>
          </div>

          <div class="mb-45">
            <h3 style="color:var(--nt-navy);font-weight:700;margin-bottom:14px;"><i class="fas fa-award" style="color:#009828;margin-right:10px;"></i>Garanti på utfört arbete</h3>
            <p style="color:var(--nt-gray);line-height:1.8;">Vi står bakom det arbete vi utför och rättar till eventuella brister som uppstår på grund av vårt arbete. För dig som privatperson gäller dessutom det konsumentskydd som följer av konsumenttjänstlagen, vilket bland annat reglerar fackmässighet, reklamationsrätt och företagets ansvar för fel i utfört arbete. Vi går alltid igenom resultatet tillsammans med dig vid besiktning.</p>
          </div>

          <div class="mb-10">
            <h3 style="color:var(--nt-navy);font-weight:700;margin-bottom:14px;"><i class="fas fa-stamp" style="color:#009828;margin-right:10px;"></i>F-skatt</h3>
            <p style="color:var(--nt-gray);line-height:1.8;">PRM Montage AB innehar F-skatt, vilket innebär att bolaget själv ansvarar för att betala in skatter och sociala avgifter för sitt arbete. Som kund blir du därför inte betalningsskyldig för dessa avgifter, till skillnad från om du hade anlitat en hantverkare utan F-skatt.</p>
          </div>
        </article>

        <aside class="cv-aside"><nav class="cv-links" aria-label="Läs även"><h3>Läs även</h3><ul><li><a href="/rut-rot">ROT-avdrag <i class="fas fa-arrow-right"></i></a></li><li><a href="/sa-har-gar-det-till">Så här går det till <i class="fas fa-arrow-right"></i></a></li><li><a href="/om-oss">Om oss <i class="fas fa-arrow-right"></i></a></li></ul></nav></aside>
      </div>
    </div>
  </div>

  <!-- =============== CTA =============== -->
    <FinalCta heading="Trygg hantverksfirma, samlad på ett ställe" />

  <!-- =============== /CTA =============== -->

  <!-- =============== FOOTER =============== -->
</BaseLayout>
