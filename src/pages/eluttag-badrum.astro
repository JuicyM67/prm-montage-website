---
import BaseLayout from '../layouts/BaseLayout.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "Eluttag i badrum Stockholm — Fast pris | PRM Montage",
  "description": "Installera eluttag i badrum eller kommod? Behörig elektriker i Stockholm monterar eluttag enligt gällande regler för våtrum. Fast pris.",
  "canonical": "https://prmmontage.se/eluttag-badrum",
  "ogDescription": "Eluttag i badrum, badrumsskåp och kommod — installerat av behörig elektriker i Stockholm.",
  "ogImage": "https://prmmontage.se/assets/img/logo/logo-color.png",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Tjänster",
            "item": "https://prmmontage.se/tjanster"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Eluttag i badrum"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Installation av eluttag i badrum",
        "name": "Eluttag i badrum Stockholm",
        "description": "Eluttag i badrum, badrumsskåp och kommod — installerat av behörig elektriker i Stockholm.",
        "provider": organization,
        "areaServed": "Stockholm",
        "url": "https://prmmontage.se/eluttag-badrum"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Får man ha eluttag i badrum?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja, men bara på tillåtna placeringar. Badrum delas in i zoner utifrån avståndet till dusch och badkar, och uttaget måste ha rätt kapsling och skyddas av jordfelsbrytare. En behörig elektriker bedömer var uttaget får sitta i just ditt badrum."
            }
          },
          {
            "@type": "Question",
            "name": "Kan ni installera eluttag i badrumsskåp eller kommod?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja, det är ett av de vanligaste jobben vi gör i badrum. Ett uttag inne i kommoden eller badrumsskåpet ger ström till eltandborste och rakapparat utan synliga sladdar."
            }
          },
          {
            "@type": "Question",
            "name": "Vad kostar det att installera eluttag i badrum?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Priset beror på var uttaget ska sitta och hur långt kabeln behöver dras. Du får alltid ett fast pris innan arbetet påbörjas, baserat på en kostnadsfri offert. Se fler prisexempel på vår sida om elektriker i Stockholm."
            }
          },
          {
            "@type": "Question",
            "name": "Ger installation av eluttag i badrum rätt till ROT-avdrag?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Arbetskostnaden vid installation av eluttag i badrum ger normalt rätt till ROT-avdrag, medan material inte gör det. Läs mer på vår ROT-avdragssida."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="tjanster" defaultService="Elektriker">
  <!-- =============== BREADCRUMB =============== -->
  <div class="tp-breadcrumb-area tp-breadcrumb-spacing nt-dark-band pt-180 pb-90" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container">
      <div class="row"><div class="col-xl-8 col-lg-9">
        <div class="tp-breadcrumb-content">
          <h1 class="tp-breadcrumb-title fw-600 fs-60 fs-xs-40 ls-m-3 tp-text-common-white lh-1 mb-20">Installera eluttag i badrum</h1>
          <div class="tp-breadcrumb-dvdr"><ul><li><a href="/">Hem</a></li><li class="dvdr">/</li><li><a href="/tjanster">Tjänster</a></li><li class="dvdr">/</li><li>Eluttag i badrum</li></ul></div>
        </div>
      </div></div>
    </div>
  </div>

  <div class="tp-service-details-area pt-90 pb-120" style="background:var(--nt-white);">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8">
          <span class="nt-eyebrow">Tjänst</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Eluttag i badrum och kommod — installerat enligt reglerna för våtrum</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Vill du ha ett eluttag vid spegeln, inne i badrumsskåpet eller i kommoden? I badrum gäller särskilda regler för var eluttag får placeras, eftersom närheten till vatten ställer högre krav på både kapsling och skydd. PRM Montage installerar eluttag i badrum i hela Stockholm med behöriga elektriker.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Badrummet delas in i zoner utifrån avståndet till dusch och badkar, och uttag får inte placeras var som helst. Vi bedömer placeringen på plats, drar fram uttaget och ansluter det med rätt kapslingsklass och jordfelsbrytare. Vanligast är ett uttag i eller vid kommoden eller badrumsskåpet, där ström till eltandborste, rakapparat och belysning behövs.</p>

          <div class="row g-4 mt-10 mb-45">
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-orange);">
                <h5><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Fast pris</h5>
                <p>Du får en tydlig, fast prisbild innan vi sätter igång — inga överraskningar.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-navy);">
                <h5><i class="fas fa-shield-check" style="color:#1FA968;margin-right:8px;"></i>Behöriga elektriker</h5>
                <p>Elinstallationer utförda av behöriga elektriker enligt gällande regelverk.</p>
              </div>
            </div>
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad ingår vid installation av eluttag i badrum?</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Bedömning av tillåten placering utifrån badrummets zoner</span></li>
            <li><i class="fas fa-check-circle"></i><span>Framdragning av kabel till kommod, badrumsskåp eller vägg</span></li>
            <li><i class="fas fa-check-circle"></i><span>Montering av uttag med rätt kapslingsklass</span></li>
            <li><i class="fas fa-check-circle"></i><span>Anslutning och avsäkring i elcentralen</span></li>
            <li><i class="fas fa-check-circle"></i><span>Kontroll av jordfelsbrytare</span></li>
            <li><i class="fas fa-check-circle"></i><span>Mätning, funktionskontroll och dokumentation</span></li>
          </ul>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om eluttag i badrum</h4>
          <div class="accordion nt-accordion mb-45" id="faqEluttagBad">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqEluttagBad1">Får man ha eluttag i badrum?</button></h2>
              <div id="faqEluttagBad1" class="accordion-collapse collapse show" data-bs-parent="#faqEluttagBad"><div class="accordion-body">Ja, men bara på tillåtna placeringar. Badrum delas in i zoner utifrån avståndet till dusch och badkar, och uttaget måste ha rätt kapsling och skyddas av jordfelsbrytare. En behörig elektriker bedömer var uttaget får sitta i just ditt badrum.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqEluttagBad2">Kan ni installera eluttag i badrumsskåp eller kommod?</button></h2>
              <div id="faqEluttagBad2" class="accordion-collapse collapse" data-bs-parent="#faqEluttagBad"><div class="accordion-body">Ja, det är ett av de vanligaste jobben vi gör i badrum. Ett uttag inne i kommoden eller badrumsskåpet ger ström till eltandborste och rakapparat utan synliga sladdar.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqEluttagBad3">Vad kostar det att installera eluttag i badrum?</button></h2>
              <div id="faqEluttagBad3" class="accordion-collapse collapse" data-bs-parent="#faqEluttagBad"><div class="accordion-body">Priset beror på var uttaget ska sitta och hur långt kabeln behöver dras. Du får alltid ett fast pris innan arbetet påbörjas, baserat på en kostnadsfri offert. Se fler prisexempel på vår sida om <a href="/elektriker-stockholm">elektriker i Stockholm</a>.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqEluttagBad4">Ger installation av eluttag i badrum rätt till ROT-avdrag?</button></h2>
              <div id="faqEluttagBad4" class="accordion-collapse collapse" data-bs-parent="#faqEluttagBad"><div class="accordion-body">Arbetskostnaden vid installation av eluttag i badrum ger normalt rätt till ROT-avdrag, medan material inte gör det. Läs mer på vår <a href="/rut-rot">ROT-avdragssida</a>.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="nt-side-card nt-side-card--navy" style="background:var(--nt-navy);">
            <h4 style="color:#fff;font-weight:700;margin-bottom:24px;">Kontakta oss direkt</h4>
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-phone" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">Ring oss</p><a href="tel:+46852027977" style="color:#fff;font-weight:700;font-size:1.05rem;text-decoration:none;">08-520 279 77</a></div>
            </div>
            <div style="display:flex;align-items:center;gap:14px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-envelope" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">E-post</p><a href="mailto:info@pro-montage.se" style="color:#fff;font-weight:700;text-decoration:none;">info@pro-montage.se</a></div>
            </div>
          </div>
          <div class="nt-side-card">
            <h5>Varför PRM Montage?</h5>
            <ul class="nt-check" style="margin:0;"><li><i class="fas fa-check"></i><span>Fast pris, alltid</span></li><li><i class="fas fa-check"></i><span>F-skatt &amp; försäkrade</span></li><li><i class="fas fa-check"></i><span>Egna hantverkare</span></li><li><i class="fas fa-check"></i><span>Garanti på arbetet</span></li></ul>
          </div>
          <div class="nt-side-card">
            <h5>Alla tjänster</h5>
            <ul class="nt-side-nav">
              <li><a href="/koksrenovering-stockholm">Köksrenovering Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/bygg-renovering">Bygg &amp; renovering <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/vvs-badrum">VVS &amp; Badrum <i class="fas fa-arrow-right"></i></a></li>
              <li class="is-active"><a href="/elektriker-stockholm">Elektriker Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/altanbygge-i-stockholm">Altanbygge i Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/jour">Jour — akut hjälp <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
          <div class="nt-side-card">
            <h5>Fler jobb till fast pris</h5>
            <ul class="nt-side-nav">
              <li><a href="/byta-blandare">Byta blandare <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/installera-diskmaskin">Installera diskmaskin <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/byta-toalettstol">Byta toalettstol <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/installera-tvattmaskin">Installera tvättmaskin <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/eluttag-tvattmaskin-diskmaskin">Eluttag till tvätt- &amp; diskmaskin <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/laga-lackande-blandare">Laga läckande blandare <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/montera-duschvagg">Montera duschvägg <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/byta-handfat-kommod">Byta handfat &amp; kommod <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/montera-tv-pa-vagg">Montera TV på vägg <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="tp-cta-area nt-dark-band pt-120 pb-120" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container"><div class="row"><div class="col-xl-8 col-lg-10">
      <span class="nt-eyebrow nt-eyebrow-light">Redo att börja?</span>
      <h2 class="mb-15 fs-xl-40 fs-sm-36 tp-text-common-white">Vill du ha eluttag i badrummet?</h2>
      <p class="mb-40" style="color:rgba(255,255,255,0.78);font-size:1.05rem;max-width:620px;">Kontakta oss idag — fast pris, egna hantverkare, kostnadsfri offert.</p>
      <div class="d-flex flex-wrap align-items-center gap-4">
        <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500"><span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span></a>
        <a href="tel:+46852027977" class="d-inline-flex align-items-center gap-3" style="text-decoration:none;"><span style="width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;"><i class="fas fa-phone" style="color:#1FA968;"></i></span><span><span style="display:block;color:rgba(255,255,255,0.6);font-size:.8rem;">Ring oss direkt</span><span style="display:block;color:#fff;font-weight:700;font-size:1.05rem;">08-520 279 77</span></span></a>
      </div>
    </div></div></div>
  </div>
</BaseLayout>
