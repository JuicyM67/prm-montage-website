---
import BaseLayout from '../layouts/BaseLayout.astro';

const seo = {
  "title": "Köksrenovering Stockholm — Fast pris | PRM Montage",
  "description": "Köksrenovering i Stockholm till fast pris. PRM Montage samlar snickeri, VVS och el i samma projekt — från idé till färdigt kök. Kostnadsfri offert.",
  "canonical": "https://prmmontage.se/koksrenovering-stockholm",
  "ogDescription": "Köksrenovering i Stockholm till fast pris — snickeri, VVS och el i samma projekt.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/hero-kok.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Tjänster",
            "item": "https://prmmontage.se/tjanster"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Köksrenovering Stockholm"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Köksrenovering",
        "name": "Köksrenovering Stockholm",
        "description": "Köksrenovering i Stockholm till fast pris — snickeri, VVS och el i samma projekt.",
        "provider": {
          "@type": "HomeAndConstructionBusiness",
          "@id": "https://prmmontage.se/#organization",
          "name": "PRM Montage",
          "legalName": "PRM MONTAGE AB",
          "url": "https://prmmontage.se/",
          "telephone": "+46852027977",
          "email": "info@pro-montage.se",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Industrivägen 19",
            "postalCode": "171 48",
            "addressLocality": "Solna",
            "addressCountry": "SE"
          },
          "priceRange": "$$"
        },
        "areaServed": "Stockholm",
        "url": "https://prmmontage.se/koksrenovering-stockholm"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Vad kostar en köksrenovering i Stockholm?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Priset beror på köksstorlek, materialval och omfattning (t.ex. om vatten och el behöver flyttas). Vi lämnar alltid ett fast pris innan arbetet påbörjas, baserat på en kostnadsfri offert."
            }
          },
          {
            "@type": "Question",
            "name": "Hur lång tid tar en köksrenovering?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "En genomsnittlig köksrenovering tar allt från några dagar (mindre uppdateringar) till ett par veckor för en total renovering med nya stommar, bänkskiva, VVS och el. Du får en tidsplan i samband med offerten."
            }
          },
          {
            "@type": "Question",
            "name": "Ingår VVS och el i köksrenoveringen?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. Vi har egna behöriga hantverkare inom VVS och el, vilket gör att vi kan hantera hela köksrenoveringen — inklusive flytt av vatten, avlopp och eluttag — inom samma projekt."
            }
          },
          {
            "@type": "Question",
            "name": "Ger köksrenovering rätt till ROT-avdrag?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Arbetskostnaden vid en köksrenovering ger normalt rätt till ROT-avdrag, medan material och produkter inte gör det. Vi hjälper dig räkna på avdraget i offerten."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="tjanster" defaultService="Köksrenovering">
  <!-- =============== BREADCRUMB =============== -->
  <div class="tp-breadcrumb-area tp-breadcrumb-spacing nt-dark-band pt-180 pb-90" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container">
      <div class="row"><div class="col-xl-8 col-lg-9">
        <div class="tp-breadcrumb-content">
          <h1 class="tp-breadcrumb-title fw-600 fs-60 fs-xs-40 ls-m-3 tp-text-common-white lh-1 mb-20">Köksrenovering Stockholm</h1>
          <div class="tp-breadcrumb-dvdr"><ul><li><a href="/">Hem</a></li><li class="dvdr">/</li><li><a href="/tjanster">Tjänster</a></li><li class="dvdr">/</li><li>Köksrenovering Stockholm</li></ul></div>
        </div>
      </div></div>
    </div>
  </div>

  <div class="tp-service-details-thumb pt-80" style="background:var(--nt-white);">
    <div class="container">
      <div class="nt-media wow img-custom-anim-top" data-wow-duration="1.5s" data-wow-delay="0.2s" style="height:360px;">
        <img src="assets/img/projekt/hero-kok.webp" width="1400" height="560" alt="Köksrenovering utförd av PRM Montage i Stockholm" style="width:100%;height:100%;object-fit:cover;">
      </div>
    </div>
  </div>

  <div class="tp-service-details-area pt-70 pb-120" style="background:var(--nt-white);">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8">
          <span class="nt-eyebrow">Tjänst</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Köksrenovering i Stockholm — till fast pris</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Drömmer du om ett nytt kök? PRM Montage hjälper dig förverkliga idén — från första ritningen till ett färdigt kök du trivs i. Vi har egna hantverkare inom snickeri, VVS och el, vilket gör att hela köksrenoveringen kan hanteras inom samma projekt utan att du behöver anlita flera olika företag.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Oavsett om det handlar om att byta stommar och bänkskiva, flytta vatten och avlopp, eller göra en total köksrenovering i en bostadsrätt eller villa — vi lämnar alltid ett fast pris innan arbetet påbörjas, så att du vet exakt vad som gäller.</p>

          <div class="row g-4 mt-10 mb-45">
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-orange);">
                <h5><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Fast pris</h5>
                <p>Du får en tydlig, fast prisbild innan vi sätter igång — inga överraskningar.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-navy);">
                <h5><i class="fas fa-user-group" style="color:#1FA968;margin-right:8px;"></i>Allt under ett tak</h5>
                <p>Snickeri, VVS och el i samma projekt — med egna hantverkare.</p>
              </div>
            </div>
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad ingår i köksrenoveringen?</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Rivning av befintligt kök</span></li>
            <li><i class="fas fa-check-circle"></i><span>Nya köksstommar, bänkskiva och luckor</span></li>
            <li><i class="fas fa-check-circle"></i><span>Flytt eller installation av vatten och avlopp</span></li>
            <li><i class="fas fa-check-circle"></i><span>Elinstallation för vitvaror och belysning</span></li>
            <li><i class="fas fa-check-circle"></i><span>Kakel, klinker och golv i köket</span></li>
            <li><i class="fas fa-check-circle"></i><span>Slutstädning och besiktning</span></li>
          </ul>

          <div class="mb-45">
            <img src="assets/img/projekt/kok-04.webp" width="900" height="675" loading="lazy" alt="Nytt kök med köksfläkt, utfört av PRM Montage" class="w-100" style="border-radius:12px;aspect-ratio:16/9;height:auto;object-fit:cover;">
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om köksrenovering</h4>
          <div class="accordion nt-accordion mb-45" id="faqKok">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqKok1">Vad kostar en köksrenovering i Stockholm?</button></h2>
              <div id="faqKok1" class="accordion-collapse collapse show" data-bs-parent="#faqKok"><div class="accordion-body">Priset beror på köksstorlek, materialval och omfattning — till exempel om vatten och el behöver flyttas. Vi lämnar alltid ett fast pris innan arbetet påbörjas, baserat på en kostnadsfri offert.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqKok2">Hur lång tid tar en köksrenovering?</button></h2>
              <div id="faqKok2" class="accordion-collapse collapse" data-bs-parent="#faqKok"><div class="accordion-body">En genomsnittlig köksrenovering tar allt från några dagar vid mindre uppdateringar till ett par veckor för en total renovering med nya stommar, bänkskiva, VVS och el. Du får en tidsplan i samband med offerten.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqKok3">Ingår VVS och el i köksrenoveringen?</button></h2>
              <div id="faqKok3" class="accordion-collapse collapse" data-bs-parent="#faqKok"><div class="accordion-body">Ja. Vi har egna behöriga hantverkare inom VVS och el, vilket gör att vi kan hantera hela köksrenoveringen — inklusive flytt av vatten, avlopp och eluttag — inom samma projekt.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqKok4">Ger köksrenovering rätt till ROT-avdrag?</button></h2>
              <div id="faqKok4" class="accordion-collapse collapse" data-bs-parent="#faqKok"><div class="accordion-body">Arbetskostnaden vid en köksrenovering ger normalt rätt till ROT-avdrag, medan material och produkter inte gör det. Vi hjälper dig räkna på avdraget i offerten. Läs mer på vår <a href="/rut-rot">ROT-avdragssida</a>.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="nt-side-card nt-side-card--navy" style="background:var(--nt-navy);">
            <h4 style="color:#fff;font-weight:700;margin-bottom:24px;">Kontakta oss direkt</h4>
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-phone" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">Ring oss</p><a href="tel:+46852027977" style="color:#fff;font-weight:700;font-size:1.05rem;text-decoration:none;">08-520 279 77</a></div>
            </div>
            <div style="display:flex;align-items:center;gap:14px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-envelope" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">E-post</p><a href="mailto:info@pro-montage.se" style="color:#fff;font-weight:700;text-decoration:none;">info@pro-montage.se</a></div>
            </div>
          </div>
          <div class="nt-side-card">
            <h5>Varför PRM Montage?</h5>
            <ul class="nt-check" style="margin:0;"><li><i class="fas fa-check"></i><span>Fast pris, alltid</span></li><li><i class="fas fa-check"></i><span>F-skatt &amp; försäkrade</span></li><li><i class="fas fa-check"></i><span>Egna hantverkare</span></li><li><i class="fas fa-check"></i><span>Garanti på arbetet</span></li></ul>
          </div>
          <div class="nt-side-card">
            <h5>Alla tjänster</h5>
            <ul class="nt-side-nav">
              <li class="is-active"><a href="/koksrenovering-stockholm">Köksrenovering Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/bygg-renovering">Bygg &amp; renovering <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/vvs-badrum">VVS &amp; Badrum <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/elektriker-stockholm">Elektriker Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/altanbygge-i-stockholm">Altanbygge i Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/jour">Jour — akut hjälp <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
          <div class="nt-side-card">
            <h5>Bara montering av nytt kök?</h5>
            <p style="color:var(--nt-gray);font-size:.9rem;margin-bottom:14px;">Har du redan köpt ditt kök och behöver bara hjälp med monteringen? Se våra sidor för köksmontering i ditt område.</p>
            <ul class="nt-side-nav">
              <li><a href="/koksmontering-solna">Köksmontering Solna <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/koksmontering-sundbyberg">Köksmontering Sundbyberg <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/koksmontering-danderyd">Köksmontering Danderyd <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/koksmontering-bromma">Köksmontering Bromma <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/koksmontering-tacby">Köksmontering Täby <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/koksmontering-upplands-vasby">Köksmontering Upplands Väsby <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/ikea-koksmontering-solna">IKEA-köksmontering Solna <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/ikea-koksmontering-sundbyberg">IKEA-köksmontering Sundbyberg <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/ikea-koksmontering-danderyd">IKEA-köksmontering Danderyd <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/ikea-koksmontering-bromma">IKEA-köksmontering Bromma <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/ikea-koksmontering-tacby">IKEA-köksmontering Täby <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/ikea-koksmontering-upplands-vasby">IKEA-köksmontering Upplands Väsby <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/ikea-koksmontering-stockholm">Montera IKEA-kök i Stockholm <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="tp-cta-area nt-dark-band pt-120 pb-120" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container"><div class="row"><div class="col-xl-8 col-lg-10">
      <span class="nt-eyebrow nt-eyebrow-light">Redo att börja?</span>
      <h2 class="mb-15 fs-xl-40 fs-sm-36 tp-text-common-white">Dags att förverkliga ditt drömkök?</h2>
      <p class="mb-40" style="color:rgba(255,255,255,0.78);font-size:1.05rem;max-width:620px;">Kontakta oss idag — fast pris, egna hantverkare, kostnadsfri offert.</p>
      <div class="d-flex flex-wrap align-items-center gap-4">
        <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500"><span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span></a>
        <a href="tel:+46852027977" class="d-inline-flex align-items-center gap-3" style="text-decoration:none;"><span style="width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;"><i class="fas fa-phone" style="color:#1FA968;"></i></span><span><span style="display:block;color:rgba(255,255,255,0.6);font-size:.8rem;">Ring oss direkt</span><span style="display:block;color:#fff;font-weight:700;font-size:1.05rem;">08-520 279 77</span></span></a>
      </div>
    </div></div></div>
  </div>
</BaseLayout>
