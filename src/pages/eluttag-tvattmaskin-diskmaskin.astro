---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import SectionHeader from '../components/landing/SectionHeader.astro';
import ReviewStrip from '../components/ReviewStrip.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyOfferCard from '../components/StickyOfferCard.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "Eluttag till tvätt- & diskmaskin — Fast pris | PRM Montage",
  "description": "Installera eluttag till tvättmaskin eller diskmaskin i Stockholm. Behörig elektriker, fast pris 2 205 kr. Kostnadsfri offert.",
  "canonical": "https://prmmontage.se/eluttag-tvattmaskin-diskmaskin",
  "ogDescription": "Eluttag till tvättmaskin och diskmaskin i Stockholm — installerat av behörig elektriker till fast pris.",
  "ogImage": "https://prmmontage.se/assets/img/logo/logo-color.png",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Tjänster",
            "item": "https://prmmontage.se/tjanster"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Eluttag till tvätt- & diskmaskin"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Installation av eluttag för vitvaror",
        "name": "Eluttag till tvättmaskin och diskmaskin",
        "description": "Eluttag till tvättmaskin och diskmaskin i Stockholm — installerat av behörig elektriker till fast pris.",
        "provider": organization,
        "areaServed": "Stockholm",
        "url": "https://prmmontage.se/eluttag-tvattmaskin-diskmaskin"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Vad kostar ett eluttag till tvättmaskin eller diskmaskin?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Fast pris för ett nytt eluttag till tvätt- eller diskmaskin är 2 205 kr. Priset gäller normal installation — behöver längre kabeldragning eller arbete i elcentralen göras lämnar vi en offert med fast pris innan vi börjar."
            }
          },
          {
            "@type": "Question",
            "name": "Får jag installera eluttaget själv?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Nej. Att dra fram och ansluta ett fast eluttag är elinstallationsarbete som ska utföras av behörig elektriker. Våra elektriker är behöriga och utför installationen enligt gällande regelverk."
            }
          },
          {
            "@type": "Question",
            "name": "Kan tvättmaskinen kopplas in med förlängningssladd?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Det bör undvikas. Vitvaror drar hög effekt och en förlängningssladd eller grenkontakt kan bli överhettad. Ett eget jordat vägguttag är den säkra lösningen."
            }
          },
          {
            "@type": "Question",
            "name": "Ger installation av eluttag rätt till ROT-avdrag?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Arbetskostnaden vid installation av eluttag ger normalt rätt till ROT-avdrag, medan material inte gör det. Läs mer på vår ROT-avdragssida."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="tjanster" defaultService="Elektriker">
  <!-- =============== BREADCRUMB =============== -->
    <section class="cv-pagehero">
    <div class="cv-container">
      <ul class="cv-crumbs"><li><a href="/">Hem</a></li><li><a href="/tjanster">Tjänster</a></li></ul>
      <h1>Installera eluttag till tvättmaskin &amp; diskmaskin</h1>
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--outline-light"><i class="fas fa-phone"></i> Ring 08-520 279 77</a>
      </div>
      <div class="cv-rating cv-rating--light"><span class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span><span>4,9 på Google · 100+ omdömen</span></div>
    </div>
  </section>

  <div class="cv-pageshot-wrap"><div class="cv-container cv-pageshot"><img src="assets/img/projekt/hero-badrum.webp" width="1400" height="560" alt="Badrum utfört av PRM Montage i Stockholm" fetchpriority="high"></div></div>

  <ProofBar />


    <section class="cv-section">
    <div class="cv-container cv-layout">
      <article class="cv-prose">
          <span class="nt-eyebrow">Tjänst</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Eluttag till tvättmaskin och diskmaskin — installerat av behörig elektriker</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Saknas det ett eluttag där tvättmaskinen eller diskmaskinen ska stå? PRM Montage installerar nya eluttag för vitvaror i hela Stockholm. Arbetet utförs av behöriga elektriker och dimensioneras efter maskinens effekt, med rätt jordning och avsäkring.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Vitvaror drar mycket ström och bör ha ett eget jordat uttag — att koppla in dem via förlängningssladd eller grenuttag är en brandrisk. Vi drar fram uttaget, ansluter i elcentralen och kontrollerar installationen. Fast pris för ett nytt eluttag till tvätt- eller diskmaskin är 2 205 kr.</p>
          <div class="cv-btn-row cv-midcta-row">
            <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
          </div>


          <div class="row g-4 mt-10 mb-45">
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-orange);">
                <h3><i class="fas fa-file-invoice-dollar" style="color:#009828;margin-right:8px;"></i>Fast pris</h3>
                <p>Du får en tydlig, fast prisbild innan vi sätter igång — inga överraskningar.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-navy);">
                <h3><i class="fas fa-shield-check" style="color:#009828;margin-right:8px;"></i>Behöriga elektriker</h3>
                <p>Elinstallationer utförda av behöriga elektriker enligt gällande regelverk.</p>
              </div>
            </div>
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad ingår vid installation av eluttag för vitvaror?</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Framdragning av ny kabel till uttagets placering</span></li>
            <li><i class="fas fa-check-circle"></i><span>Montering av jordat vägguttag</span></li>
            <li><i class="fas fa-check-circle"></i><span>Anslutning och avsäkring i elcentralen</span></li>
            <li><i class="fas fa-check-circle"></i><span>Kontroll av jordfelsbrytare</span></li>
            <li><i class="fas fa-check-circle"></i><span>Mätning och funktionskontroll av installationen</span></li>
            <li><i class="fas fa-check-circle"></i><span>Dokumentation av utfört elarbete</span></li>
          </ul>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Prisexempel</h4>
          <table class="nt-price-table mb-10">
            <thead><tr><th>Tjänst</th><th>Pris</th></tr></thead>
            <tbody>
              <tr><td>Eluttag för tvättmaskin/diskmaskin</td><td>2 205 kr</td></tr>
              <tr><td>Byte av vägguttag (inomhus)</td><td>1 600 kr</td></tr>
              <tr><td>Nytt vägguttag (inomhus)</td><td>1 600 kr</td></tr>
            </tbody>
          </table>
          <p class="nt-price-note mb-45">Priserna är exempel på fasta priser för vanliga jobb. Kontakta oss för en offert anpassad efter ditt projekt.</p>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om eluttag till vitvaror</h4>
          <div class="accordion nt-accordion mb-45" id="faqEluttagTD">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqEluttagTD1">Vad kostar ett eluttag till tvättmaskin eller diskmaskin?</button></h2>
              <div id="faqEluttagTD1" class="accordion-collapse collapse show" data-bs-parent="#faqEluttagTD"><div class="accordion-body">Fast pris för ett nytt eluttag till tvätt- eller diskmaskin är 2 205 kr. Priset gäller normal installation — behöver längre kabeldragning eller arbete i elcentralen göras lämnar vi en offert med fast pris innan vi börjar.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqEluttagTD2">Får jag installera eluttaget själv?</button></h2>
              <div id="faqEluttagTD2" class="accordion-collapse collapse" data-bs-parent="#faqEluttagTD"><div class="accordion-body">Nej. Att dra fram och ansluta ett fast eluttag är elinstallationsarbete som ska utföras av behörig elektriker. Våra elektriker är behöriga och utför installationen enligt gällande regelverk.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqEluttagTD3">Kan tvättmaskinen kopplas in med förlängningssladd?</button></h2>
              <div id="faqEluttagTD3" class="accordion-collapse collapse" data-bs-parent="#faqEluttagTD"><div class="accordion-body">Det bör undvikas. Vitvaror drar hög effekt och en förlängningssladd eller grenkontakt kan bli överhettad. Ett eget jordat vägguttag är den säkra lösningen.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqEluttagTD4">Ger installation av eluttag rätt till ROT-avdrag?</button></h2>
              <div id="faqEluttagTD4" class="accordion-collapse collapse" data-bs-parent="#faqEluttagTD"><div class="accordion-body">Arbetskostnaden vid installation av eluttag ger normalt rätt till ROT-avdrag, medan material inte gör det. Läs mer på vår <a href="/rut-rot">ROT-avdragssida</a>.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </article>
      <aside>
        <StickyOfferCard related={[{href:'/byta-blandare',label:'Byta blandare'},{href:'/installera-diskmaskin',label:'Installera diskmaskin'},{href:'/byta-toalettstol',label:'Byta toalettstol'},{href:'/installera-tvattmaskin',label:'Installera tvättmaskin'},{href:'/eluttag-badrum',label:'Eluttag i badrum'},{href:'/laga-lackande-blandare',label:'Laga läckande blandare'},{href:'/montera-duschvagg',label:'Montera duschvägg'},{href:'/byta-handfat-kommod',label:'Byta handfat & kommod'},{href:'/montera-tv-pa-vagg',label:'Montera TV på vägg'},{href:'/handyman-stockholm',label:'Handyman Stockholm'},{href:'/mobelmontering-stockholm',label:'Möbelmontering'},{href:'/byta-las-cylinder',label:'Byta lås & låscylinder'}]} relatedTitle="Fler jobb" />
      </aside>
    </div>
  </section>

  <section class="cv-section cv-section--tint">
    <div class="cv-container">
      <SectionHeader pill="Omdömen" title="Det säger våra kunder" />
      <ReviewStrip count={3} offset={4} job />
    </div>
  </section>


    <FinalCta heading="Behöver du ett nytt eluttag till vitvaran?" />

</BaseLayout>
