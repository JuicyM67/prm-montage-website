---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import FinalCta from '../components/FinalCta.astro';

const seo = {
  "title": "Våra tjänster — Bygg, VVS, El & Kök | PRM Montage",
  "description": "PRM Montage AB erbjuder köksrenovering, bygg & renovering, VVS, el, altanbygge och jour i Stockholm — till fast pris med egna hantverkare.",
  "canonical": "https://prmmontage.se/tjanster",
  "ogDescription": "Köksrenovering, bygg & renovering, VVS, el, altanbygge och jour i Stockholm — till fast pris.",
  "ogImage": "https://prmmontage.se/assets/img/brand/og-default.jpg",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Tjänster"
          }
        ]
      },
      {
        "@type": "ItemList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "url": "https://prmmontage.se/koksrenovering-stockholm",
            "name": "Köksrenovering Stockholm"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "url": "https://prmmontage.se/bygg-renovering",
            "name": "Bygg & renovering"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "url": "https://prmmontage.se/vvs-badrum",
            "name": "VVS & Badrum"
          },
          {
            "@type": "ListItem",
            "position": 4,
            "url": "https://prmmontage.se/elektriker-stockholm",
            "name": "Elektriker Stockholm"
          },
          {
            "@type": "ListItem",
            "position": 5,
            "url": "https://prmmontage.se/altanbygge-i-stockholm",
            "name": "Altanbygge i Stockholm"
          },
          {
            "@type": "ListItem",
            "position": 6,
            "url": "https://prmmontage.se/jour",
            "name": "Jour"
          },
          {
            "@type": "ListItem",
            "position": 7,
            "url": "https://prmmontage.se/handyman-stockholm",
            "name": "Handyman Stockholm"
          },
          {
            "@type": "ListItem",
            "position": 8,
            "url": "https://prmmontage.se/mobelmontering-stockholm",
            "name": "Möbelmontering"
          },
          {
            "@type": "ListItem",
            "position": 9,
            "url": "https://prmmontage.se/byta-las-cylinder",
            "name": "Byta lås & låscylinder"
          },
          {
            "@type": "ListItem",
            "position": 10,
            "url": "https://prmmontage.se/byta-blandare",
            "name": "Byta blandare"
          },
          {
            "@type": "ListItem",
            "position": 11,
            "url": "https://prmmontage.se/byta-varmvattenberedare",
            "name": "Byta varmvattenberedare"
          },
          {
            "@type": "ListItem",
            "position": 12,
            "url": "https://prmmontage.se/montera-dorr-dorrstangare",
            "name": "Dörr & dörrstängare"
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="tjanster">
  <!-- =============== BREADCRUMB =============== -->
    <section class="cv-pagehero">
    <div class="cv-container">
      <ul class="cv-crumbs"><li><a href="/">Hem</a></li></ul>
      <h1>Våra tjänster</h1>
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--outline-light"><i class="fas fa-phone"></i> Ring 08-520 279 77</a>
      </div>
    </div>
  </section>

  <ProofBar />

  <!-- =============== /BREADCRUMB =============== -->

  <!-- =============== INTRO + TJÄNSTER =============== -->
  <div class="tp-service-area pt-100 pb-100" style="background:var(--nt-white);">
    <div class="container">
      <div class="row justify-content-center mb-60">
        <div class="col-xl-8 text-center">
          <p style="color:var(--nt-gray);line-height:1.85;font-size:1.05rem;">PRM Montage AB samlar bygg, snickeri, VVS och el under ett och samma bolag. Det innebär att vi kan hantera hela ditt projekt — stort som litet — utan att du behöver anlita flera olika hantverksfirmor. Alla tjänster nedan utförs av våra egna hantverkare, till fast pris.</p>
        </div>
      </div>
      <div class="row g-4">
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <span class="nt-badge-popular">Populär</span>
            <div class="nt-icon-card__icon"><i class="fas fa-utensils"></i></div>
            <h4><a href="/koksrenovering-stockholm">Köksrenovering Stockholm</a></h4>
            <p>Nytt kök från idé till färdig helhet — snickeri, VVS och el i samma projekt.</p>
            <a class="nt-icon-card__link" href="/koksrenovering-stockholm">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <span class="nt-badge-popular">Populär</span>
            <div class="nt-icon-card__icon"><i class="fas fa-shower"></i></div>
            <h4><a href="/vvs-badrum">VVS &amp; Badrum</a></h4>
            <p>Badrumsrenovering, duschväggar, blandare och behöriga VVS-installationer.</p>
            <a class="nt-icon-card__link" href="/vvs-badrum">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-hammer"></i></div>
            <h4><a href="/bygg-renovering">Bygg &amp; renovering</a></h4>
            <p>Helrenoveringar, tvättstugor, snickeri och ombyggnationer i hela bostaden.</p>
            <a class="nt-icon-card__link" href="/bygg-renovering">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-bolt"></i></div>
            <h4><a href="/elektriker-stockholm">Elektriker Stockholm</a></h4>
            <p>Behörig elinstallation — vägguttag, belysning och elcentraler till fast pris.</p>
            <a class="nt-icon-card__link" href="/elektriker-stockholm">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-sun"></i></div>
            <h4><a href="/altanbygge-i-stockholm">Altanbygge i Stockholm</a></h4>
            <p>Skräddarsydda altaner och uteplatser — från ritning till färdig altan.</p>
            <a class="nt-icon-card__link" href="/altanbygge-i-stockholm">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-triangle-exclamation"></i></div>
            <h4><a href="/jour">Jour — akut hjälp</a></h4>
            <p>Akut läckage eller elfel? Vi rycker ut när det verkligen behövs.</p>
            <a class="nt-icon-card__link" href="/jour">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-shower"></i></div>
            <h4><a href="/rormokare-stockholm">Rörmokare Stockholm</a></h4>
            <p>VVS-arbete i hela Stockholm — blandare, avlopp, rörbyten och installationer.</p>
            <a class="nt-icon-card__link" href="/rormokare-stockholm">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-screwdriver"></i></div>
            <h4><a href="/snickeri-stockholm">Snickeri Stockholm</a></h4>
            <p>Platsbyggd förvaring, lister, innerdörrar och altaner av egna snickare.</p>
            <a class="nt-icon-card__link" href="/snickeri-stockholm">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-toolbox"></i></div>
            <h4><a href="/ikea-koksmontering-stockholm">Montera IKEA-kök</a></h4>
            <p>Vi monterar ditt METOD-kök enligt IKEA:s egna anvisningar, till fast pris.</p>
            <a class="nt-icon-card__link" href="/ikea-koksmontering-stockholm">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- =============== /INTRO + TJÄNSTER =============== -->
  <div class="tp-service-area pb-100" style="background:var(--nt-white);">
    <div class="container">
      <div class="row"><div class="col-xl-8 col-lg-10 mb-40">
        <span class="nt-eyebrow">Snabba småjobb</span>
        <h2 class="mb-15 fs-xl-40 fs-sm-36">Småjobb och service till fast pris</h2>
        <p style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Ett lås som ska bytas, en blandare som droppar eller en TV som ska upp på väggen? Våra snabba småjobb tar vi vid ett enda besök.</p>
      </div></div>
      <div class="row g-4">
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-screwdriver-wrench"></i></div>
            <h4><a href="/handyman-stockholm">Handyman Stockholm</a></h4>
            <p>Montering och småjobb — hyllor, TV, möbler och mer.</p>
            <a class="nt-icon-card__link" href="/handyman-stockholm">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-toolbox"></i></div>
            <h4><a href="/mobelmontering-stockholm">Möbelmontering</a></h4>
            <p>IKEA-möbler, PAX-garderober och förvaring monterat och förankrat.</p>
            <a class="nt-icon-card__link" href="/mobelmontering-stockholm">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-shield-check"></i></div>
            <h4><a href="/byta-las-cylinder">Byta lås &amp; cylinder</a></h4>
            <p>Planerat byte av lås och låscylinder, justerat så att dörren går lätt.</p>
            <a class="nt-icon-card__link" href="/byta-las-cylinder">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-shower"></i></div>
            <h4><a href="/byta-blandare">Byta blandare</a></h4>
            <p>Kök, dusch och handfat — byte och montering av blandare.</p>
            <a class="nt-icon-card__link" href="/byta-blandare">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-shower"></i></div>
            <h4><a href="/byta-varmvattenberedare">Byta varmvattenberedare</a></h4>
            <p>Demontering, montering och täthetskontroll.</p>
            <a class="nt-icon-card__link" href="/byta-varmvattenberedare">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-house"></i></div>
            <h4><a href="/montera-dorr-dorrstangare">Dörr &amp; dörrstängare</a></h4>
            <p>Byta, justera och montera dörrar och dörrstängare.</p>
            <a class="nt-icon-card__link" href="/montera-dorr-dorrstangare">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- =============== MINDRE JOBB TILL FAST PRIS =============== -->
  <div class="tp-service-area pt-110 pb-120" style="background:var(--nt-white);">
    <div class="container">
      <div class="row justify-content-center mb-60">
        <div class="col-xl-8 text-center">
          <span class="nt-eyebrow">Fast pris</span>
          <h2 class="fs-xl-40 fs-sm-36 mb-20 wow img-custom-anim-top" data-wow-duration="1.5s" data-wow-delay="0.2s">Mindre jobb till fast pris</h2>
          <p style="color:var(--nt-gray);line-height:1.85;font-size:1.05rem;">Alla uppdrag är inte hela renoveringar. Vi tar oss lika gärna an de mindre jobben — en blandare som ska bytas, en diskmaskin som ska kopplas in eller ett eluttag som saknas. Samma hantverkare, samma fasta pris.</p>
        </div>
      </div>
      <div class="row g-4">
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-shower"></i></div>
            <h4><a href="/byta-blandare">Byta blandare</a></h4>
            <p>Byte och montering av blandare i kök och badrum.</p>
            <a class="nt-icon-card__link" href="/byta-blandare">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-screwdriver-wrench"></i></div>
            <h4><a href="/laga-lackande-blandare">Laga läckande blandare</a></h4>
            <p>Droppande kran eller duschblandare — vi lagar eller byter.</p>
            <a class="nt-icon-card__link" href="/laga-lackande-blandare">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-shower"></i></div>
            <h4><a href="/byta-toalettstol">Byta toalettstol</a></h4>
            <p>Golvstående och vägghängda toaletter, inkl. bortforsling.</p>
            <a class="nt-icon-card__link" href="/byta-toalettstol">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-hammer"></i></div>
            <h4><a href="/byta-handfat-kommod">Byta handfat &amp; kommod</a></h4>
            <p>Nytt tvättställ och kommod monterat och anslutet.</p>
            <a class="nt-icon-card__link" href="/byta-handfat-kommod">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-shower"></i></div>
            <h4><a href="/montera-duschvagg">Montera duschvägg</a></h4>
            <p>Duschväggar, duschhörn och duschkabiner monterade i lod.</p>
            <a class="nt-icon-card__link" href="/montera-duschvagg">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-utensils"></i></div>
            <h4><a href="/installera-diskmaskin">Installera diskmaskin</a></h4>
            <p>Anslutning av vatten, avlopp och tätt underlägg.</p>
            <a class="nt-icon-card__link" href="/installera-diskmaskin">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-toolbox"></i></div>
            <h4><a href="/installera-tvattmaskin">Installera tvättmaskin</a></h4>
            <p>Vatten, avlopp och el — provkörd och injusterad.</p>
            <a class="nt-icon-card__link" href="/installera-tvattmaskin">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-bolt"></i></div>
            <h4><a href="/eluttag-tvattmaskin-diskmaskin">Eluttag till vitvaror</a></h4>
            <p>Eget jordat uttag till tvätt- och diskmaskin. Fast pris.</p>
            <a class="nt-icon-card__link" href="/eluttag-tvattmaskin-diskmaskin">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-bolt"></i></div>
            <h4><a href="/eluttag-badrum">Eluttag i badrum</a></h4>
            <p>Uttag i kommod och badrumsskåp enligt reglerna för våtrum.</p>
            <a class="nt-icon-card__link" href="/eluttag-badrum">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-screwdriver-wrench"></i></div>
            <h4><a href="/montera-tv-pa-vagg">Montera TV på vägg</a></h4>
            <p>Rätt fäste, rätt höjd och dolda kablar.</p>
            <a class="nt-icon-card__link" href="/montera-tv-pa-vagg">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-triangle-exclamation"></i></div>
            <h4><a href="/akut-rormokare-stockholm">Akut rörmokare Stockholm</a></h4>
            <p>Jour dygnet runt vid rörbrott, stopp i avlopp och ventiler som inte går att stänga.</p>
            <a class="nt-icon-card__link" href="/akut-rormokare-stockholm">Läs mer <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-xl-4 col-md-6">
          <div class="nt-icon-card position-relative wow fadeInUp" data-wow-delay=".2s" data-wow-duration=".9s">
            <div class="nt-icon-card__icon"><i class="fas fa-droplet"></i></div>
