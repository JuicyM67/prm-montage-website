---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import SectionHeader from '../components/landing/SectionHeader.astro';
import ReviewStrip from '../components/ReviewStrip.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyOfferCard from '../components/StickyOfferCard.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "Hantverkare i Upplands Väsby — Bygg, VVS & El | PRM Montage",
  "description": "Hantverkare i Upplands Väsby — kök, badrum, bygg, VVS, el och snickeri till fast pris i Väsby centrum, Smedby, Runby och Bollstanäs. Kostnadsfri offert.",
  "canonical": "https://prmmontage.se/upplands-vasby",
  "ogDescription": "PRM Montage hjälper dig i Upplands Väsby med kök, badrum, bygg, VVS, el och snickeri — till fast pris.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/hero-bygg.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Hantverkare i Upplands Väsby"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "Bygg och renovering",
        "name": "Bygg & renovering i Upplands Väsby",
        "description": "Renovering, tillbyggnad och ombyggnation av villor, radhus och lägenheter i Upplands Väsby.",
        "provider": organization,
        "areaServed": "Upplands Väsby",
        "url": "https://prmmontage.se/bygg-renovering"
      },
      {
        "@type": "Service",
        "serviceType": "VVS och badrumsrenovering",
        "name": "VVS & Badrum i Upplands Väsby",
        "description": "Rörbyten och badrumsrenovering i villor och lägenheter i Upplands Väsby.",
        "provider": organization,
        "areaServed": "Upplands Väsby",
        "url": "https://prmmontage.se/vvs-badrum"
      },
      {
        "@type": "Service",
        "serviceType": "El",
        "name": "Elektriker i Upplands Väsby",
        "description": "Behörig elektriker för elcentraler, belysning och eluttag i Upplands Väsby.",
        "provider": organization,
        "areaServed": "Upplands Väsby",
        "url": "https://prmmontage.se/elektriker-stockholm"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Hur snabbt kan ni komma ut till Upplands Väsby?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Upplands Väsby ligger ungefär två mil norr om vårt kontor i Solna, rakt upp längs E4:an. För planerade jobb bokar vi normalt in ett besök inom några dagar. Vid akuta ärenden har vi jour dygnet runt på samma nummer."
            }
          },
          {
            "@type": "Question",
            "name": "Vilka delar av kommunen arbetar ni i?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Hela kommunen — Väsby centrum, Smedby, Runby, Bollstanäs, Vilunda, Odenslunda, Sanda, Ekebo, Brunnby och Fresta. Vi tar både lägenheter i de centrala delarna och villor och radhus i ytterområdena."
            }
          },
          {
            "@type": "Question",
            "name": "Hur begär jag en offert?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ring 08-520 279 77 eller fyll i formuläret på sidan och beskriv vad som ska göras. Vi kommer ut, tittar på förutsättningarna och lämnar en kostnadsfri offert med ett fast pris innan arbetet påbörjas."
            }
          },
          {
            "@type": "Question",
            "name": "Ger renoveringen rätt till ROT-avdrag?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Arbetskostnaden vid de flesta renoverings- och installationsprojekt i bostaden ger normalt rätt till ROT-avdrag, medan material och produkter inte gör det. Vi räknar av avdraget direkt på fakturan och visar det i offerten."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="omraden" defaultService="VVS & Badrum">
  <!-- =============== BREADCRUMB =============== -->
    <section class="cv-pagehero">
    <div class="cv-container">
      <ul class="cv-crumbs"><li><a href="/">Hem</a></li></ul>
      <h1>Hantverkare i Upplands Väsby</h1>
      <p class="cv-pagehero__lead">Bygg, renovering, VVS, el och snickeri för villor, radhus och lägenheter i Upplands Väsby — till fast pris.</p>
      <div class="cv-btn-row">
        <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
        <a href="tel:+46852027977" class="cv-btn cv-btn--outline-light"><i class="fas fa-phone"></i> Ring 08-520 279 77</a>
      </div>
      <div class="cv-rating cv-rating--light"><span class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span><span>4,9 på Google · 100+ omdömen</span></div>
    </div>
  </section>

  <div class="cv-pageshot-wrap"><div class="cv-container cv-pageshot"><img src="assets/img/projekt/hero-bygg.webp" width="1400" height="560" alt="Bygg och snickeri utfört av PRM Montage i Stockholm" fetchpriority="high"></div></div>

  <ProofBar />



    <section class="cv-section">
    <div class="cv-container cv-layout">
      <article class="cv-prose">
          <span class="nt-eyebrow">Upplands Väsby</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">Hantverkare för Upplands Väsbys villor och lägenheter</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Upplands Väsby är en kommun med stor spännvidd i bostadsbeståndet. Runt Väsby centrum och i Smedby finns flerbostadshus från miljonprogrammets år, i Runby, Bollstanäs och Odenslunda ligger villor och radhus från olika decennier, och i de nyare områdena kring stationen har det byggts tätt de senaste åren. Det gör att renoveringsbehoven ser väldigt olika ut beroende på var i kommunen du bor.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">PRM Montage arbetar i hela Upplands Väsby från vårt kontor på Industrivägen 19 i Solna — ungefär två mil söderut längs E4:an. Vi har egna hantverkare inom bygg, VVS, el och snickeri, vilket betyder att du inte behöver samordna flera firmor när ett projekt spänner över flera yrken. Du får ett fast pris innan arbetet påbörjas, baserat på en kostnadsfri offert.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">I de äldre flerfamiljshusen är det oftast badrum, kök och stammar som står näst på tur. I villaområdena handlar det lika ofta om tillbyggnad, altan, uppgradering av elcentral eller ett kök som ska bytas ut. Vi tar båda typerna av uppdrag, och samordnar mot bostadsrättsföreningen när det behövs.</p>
          <div class="cv-btn-row cv-midcta-row">
            <a href="/kontakt" class="cv-btn cv-btn--primary hire-btn">Begär kostnadsfri offert</a>
          </div>

          <h3 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Våra tjänster i Upplands Väsby</h3>
          <div class="row g-4 mb-50">
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-utensils"></i></div>
                <h3><a href="/koksrenovering-stockholm">Köksrenovering</a></h3>
                <p>Helt nytt kök i villa eller lägenhet. Snickeri, VVS och el i samma projekt.</p>
                <a class="nt-icon-card__link" href="/koksrenovering-stockholm">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-screwdriver-wrench"></i></div>
                <h3><a href="/koksmontering-upplands-vasby">Köksmontering Upplands Väsby</a></h3>
                <p>Köpt nytt kök? Vi monterar stommar, luckor och bänkskiva till fast pris.</p>
                <a class="nt-icon-card__link" href="/koksmontering-upplands-vasby">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-toolbox"></i></div>
                <h3><a href="/ikea-koksmontering-upplands-vasby">IKEA-köksmontering Upplands Väsby</a></h3>
                <p>METOD-kök monterat enligt IKEA:s egna anvisningar.</p>
                <a class="nt-icon-card__link" href="/ikea-koksmontering-upplands-vasby">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-shower"></i></div>
                <h3><a href="/rormokare-upplands-vasby">Rörmokare Upplands Väsby</a></h3>
                <p>VVS-arbete och jour dygnet runt. Blandare, avlopp, rörbyten och vattenläckor.</p>
                <a class="nt-icon-card__link" href="/rormokare-upplands-vasby">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-hammer"></i></div>
                <h3><a href="/snickeri-upplands-vasby">Snickeri Upplands Väsby</a></h3>
                <p>Platsbyggd förvaring, lister, innerdörrar och altaner av egna snickare.</p>
                <a class="nt-icon-card__link" href="/snickeri-upplands-vasby">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-shower"></i></div>
                <h3><a href="/vvs-badrum">VVS &amp; Badrum</a></h3>
                <p>Badrumsrenovering och rörbyten i både lägenhet och villa.</p>
                <a class="nt-icon-card__link" href="/vvs-badrum">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-bolt"></i></div>
                <h3><a href="/elektriker-stockholm">Elektriker</a></h3>
                <p>Behörig elektriker för elcentraler, belysning och nya uttag.</p>
                <a class="nt-icon-card__link" href="/elektriker-stockholm">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-icon-card h-100 position-relative">
                <div class="nt-icon-card__icon"><i class="fas fa-sun"></i></div>
                <h3><a href="/altanbygge-i-stockholm">Altanbygge</a></h3>
                <p>Altan och uteplats anpassad efter tomtens läge och husets stil.</p>
                <a class="nt-icon-card__link" href="/altanbygge-i-stockholm">Läs mer <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
          </div>
          <h3 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Varför anlita PRM Montage i Upplands Väsby?</h3>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Fast pris innan vi sätter igång — även för större villaprojekt.</span></li>
            <li><i class="fas fa-check-circle"></i><span>F-skatt och fullt försäkrade under varje uppdrag.</span></li>
            <li><i class="fas fa-check-circle"></i><span>Egna hantverkare inom bygg, VVS, el och snickeri — en kontaktperson.</span></li>
            <li><i class="fas fa-check-circle"></i><span>Kort körsträcka längs E4:an från vårt kontor i Solna.</span></li>
            <li><i class="fas fa-check-circle"></i><span>Jour dygnet runt vid vattenläcka och akuta elfel.</span></li>
            <li><i class="fas fa-check-circle"></i><span>Garanti på utfört arbete.</span></li>
          </ul>
          <div class="mb-45">
            <img src="assets/img/projekt/bygg-02.webp" width="900" height="675" loading="lazy" alt="Byggprojekt utfört av PRM Montage i Stockholmsområdet" class="w-100" style="border-radius:12px;aspect-ratio:16/9;height:auto;object-fit:cover;">
          </div>

          <h3 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om hantverkare i Upplands Väsby</h3>
<div class="accordion nt-accordion mb-45" id="faqUpplandsVasby">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqUpplandsVasby1">Hur snabbt kan ni komma ut till Upplands Väsby?</button></h2>
              <div id="faqUpplandsVasby1" class="accordion-collapse collapse show" data-bs-parent="#faqUpplandsVasby"><div class="accordion-body">Upplands Väsby ligger ungefär två mil norr om vårt kontor i Solna, rakt upp längs E4:an. För planerade jobb bokar vi normalt in ett besök inom några dagar. Vid akuta ärenden har vi <a href="/jour">jour dygnet runt</a> på samma nummer.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqUpplandsVasby2">Vilka delar av kommunen arbetar ni i?</button></h2>
              <div id="faqUpplandsVasby2" class="accordion-collapse collapse" data-bs-parent="#faqUpplandsVasby"><div class="accordion-body">Hela kommunen — Väsby centrum, Smedby, Runby, Bollstanäs, Vilunda, Odenslunda, Sanda, Ekebo, Brunnby och Fresta. Vi tar både lägenheter i de centrala delarna och villor och radhus i ytterområdena.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqUpplandsVasby3">Hur begär jag en offert?</button></h2>
              <div id="faqUpplandsVasby3" class="accordion-collapse collapse" data-bs-parent="#faqUpplandsVasby"><div class="accordion-body">Ring <a href="tel:+46852027977">08-520 279 77</a> eller fyll i formuläret på sidan och beskriv vad som ska göras. Vi kommer ut, tittar på förutsättningarna och lämnar en kostnadsfri offert med ett fast pris innan arbetet påbörjas.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqUpplandsVasby4">Ger renoveringen rätt till ROT-avdrag?</button></h2>
              <div id="faqUpplandsVasby4" class="accordion-collapse collapse" data-bs-parent="#faqUpplandsVasby"><div class="accordion-body">Arbetskostnaden vid de flesta renoverings- och installationsprojekt i bostaden ger normalt rätt till ROT-avdrag, medan material och produkter inte gör det. Vi räknar av avdraget direkt på fakturan och visar det i offerten. Läs mer på vår <a href="/rut-rot">sida om ROT-avdrag</a>.</div></div>
            </div>
          </div>
          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </article>
      <aside>
        <StickyOfferCard related={[]} relatedTitle="Fler jobb" />
      </aside>
    </div>
  </section>

  <section class="cv-section cv-section--tint">
    <div class="cv-container">
      <SectionHeader pill="Omdömen" title="Det säger våra kunder" />
      <ReviewStrip count={3} offset={9} job />
    </div>
  </section>


    <FinalCta heading="Hantverkare i Upplands Väsby redo att hjälpa dig" />

</BaseLayout>
