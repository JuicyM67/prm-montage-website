---
import BaseLayout from '../layouts/BaseLayout.astro';
import { organization } from '../data/organization';

const seo = {
  "title": "VVS & Badrumsrenovering Stockholm — Fast pris | PRM Montage",
  "description": "VVS och badrumsrenovering i Stockholm till fast pris. Duschväggsmontage, blandarbyte och rörinstallationer av auktoriserade VVS-installatörer.",
  "canonical": "https://prmmontage.se/vvs-badrum",
  "ogDescription": "VVS och badrumsrenovering i Stockholm till fast pris — utfört av auktoriserade VVS-installatörer.",
  "ogImage": "https://prmmontage.se/assets/img/projekt/hero-badrum.webp",
  "jsonLd": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Hem",
            "item": "https://prmmontage.se/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Tjänster",
            "item": "https://prmmontage.se/tjanster"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "VVS & Badrum"
          }
        ]
      },
      {
        "@type": "Service",
        "serviceType": "VVS och badrumsrenovering",
        "name": "VVS & Badrum Stockholm",
        "description": "VVS och badrumsrenovering i Stockholm till fast pris — utfört av auktoriserade VVS-installatörer.",
        "provider": organization,
        "areaServed": "Stockholm",
        "url": "https://prmmontage.se/vvs-badrum"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Vad kostar en badrumsrenovering?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Priset beror på badrummets storlek och omfattningen av arbetet. Vi lämnar alltid ett fast pris innan arbetet påbörjas, baserat på en kostnadsfri offert."
            }
          },
          {
            "@type": "Question",
            "name": "Är era VVS-installatörer auktoriserade?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja, våra VVS-installatörer är behöriga och utför arbetet enligt gällande branschregler."
            }
          },
          {
            "@type": "Question",
            "name": "Är ni försäkrade och lämnar ni garanti på arbetet?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. PRM Montage är fullt försäkrat och lämnar garanti på utfört arbete. Läs mer på vår garantisida."
            }
          },
          {
            "@type": "Question",
            "name": "Ger VVS-arbete rätt till ROT-avdrag?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Arbetskostnaden vid VVS-arbete och badrumsrenovering ger normalt rätt till ROT-avdrag, medan material inte gör det. Vi hjälper dig räkna på avdraget i offerten."
            }
          }
        ]
      }
    ]
  }
};
---

<BaseLayout seo={seo} activeNav="tjanster" defaultService="VVS & Badrum">
  <!-- =============== BREADCRUMB =============== -->
  <div class="tp-breadcrumb-area tp-breadcrumb-spacing nt-dark-band pt-180 pb-90" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container">
      <div class="row"><div class="col-xl-8 col-lg-9">
        <div class="tp-breadcrumb-content">
          <h1 class="tp-breadcrumb-title fw-600 fs-60 fs-xs-40 ls-m-3 tp-text-common-white lh-1 mb-20">VVS &amp; Badrum Stockholm</h1>
          <div class="tp-breadcrumb-dvdr"><ul><li><a href="/">Hem</a></li><li class="dvdr">/</li><li><a href="/tjanster">Tjänster</a></li><li class="dvdr">/</li><li>VVS &amp; Badrum</li></ul></div>
        </div>
      </div></div>
    </div>
  </div>

  <div class="tp-service-details-thumb pt-80" style="background:var(--nt-white);">
    <div class="container">
      <div class="nt-media wow img-custom-anim-top" data-wow-duration="1.5s" data-wow-delay="0.2s" style="height:360px;">
        <img src="assets/img/projekt/hero-badrum.webp" width="1400" height="560" alt="Badrumsrenovering utförd av PRM Montage i Stockholm" style="width:100%;height:100%;object-fit:cover;">
      </div>
    </div>
  </div>

  <div class="tp-service-details-area pt-70 pb-120" style="background:var(--nt-white);">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8">
          <span class="nt-eyebrow">Tjänst</span>
          <h2 class="mb-25 fs-xl-40 fs-sm-36">VVS &amp; badrumsrenovering i Stockholm — till fast pris</h2>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Ska badrummet renoveras eller behöver du hjälp med ett VVS-arbete? PRM Montage utför badrumsrenoveringar, duschväggsmontage, blandarbyten och rörinstallationer med egna auktoriserade VVS-installatörer. Det gör att du kan lita på att arbetet utförs fackmannamässigt och enligt gällande regler, från första besiktning till färdigt badrum.</p>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Vi hjälper både privatpersoner och bostadsrättsföreningar — allt från att byta en enskild blandare till att genomföra en total badrumsrenovering med nytt tätskikt, kakel och sanitetsporslin. Du får alltid ett fast pris innan arbetet påbörjas, baserat på en kostnadsfri offert.</p>

          <div class="row g-4 mt-10 mb-45">
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-orange);">
                <h5><i class="fas fa-file-invoice-dollar" style="color:#1FA968;margin-right:8px;"></i>Fast pris</h5>
                <p>Du får en tydlig, fast prisbild innan vi sätter igång — inga överraskningar.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-highlight h-100" style="background:var(--nt-gray-light);border-left-color:var(--nt-navy);">
                <h5><i class="fas fa-shield-check" style="color:#1FA968;margin-right:8px;"></i>Auktoriserade installatörer</h5>
                <p>Behöriga VVS-installatörer, fullt försäkrade och med garanti på arbetet.</p>
              </div>
            </div>
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:22px;">Vad ingår i VVS &amp; badrumsrenovering?</h4>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span>Total badrumsrenovering</span></li>
            <li><i class="fas fa-check-circle"></i><span><a href="/montera-duschvagg">Duschväggsmontage</a></span></li>
            <li><i class="fas fa-check-circle"></i><span><a href="/byta-blandare">Blandarbyte</a></span></li>
            <li><i class="fas fa-check-circle"></i><span>Rörinstallationer</span></li>
            <li><i class="fas fa-check-circle"></i><span>Tätskikt, kakel och klinker</span></li>
            <li><i class="fas fa-check-circle"></i><span>Slutstädning och besiktning</span></li>
          </ul>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Mindre VVS-jobb till fast pris</h4>
          <p class="mb-25" style="color:var(--nt-gray);line-height:1.85;font-size:1.02rem;">Alla uppdrag är inte hela renoveringar. Vi tar oss lika gärna an de mindre jobben i badrum, kök och tvättstuga — med samma hantverkare och samma fasta pris.</p>
          <ul class="nt-check mb-45">
            <li><i class="fas fa-check-circle"></i><span><a href="/byta-blandare">Byta blandare</a> i kök och badrum</span></li>
            <li><i class="fas fa-check-circle"></i><span><a href="/laga-lackande-blandare">Laga läckande blandare</a> och duschblandare</span></li>
            <li><i class="fas fa-check-circle"></i><span><a href="/byta-toalettstol">Byta toalettstol</a> — golvstående och vägghängd</span></li>
            <li><i class="fas fa-check-circle"></i><span><a href="/byta-handfat-kommod">Byta handfat och kommod</a></span></li>
            <li><i class="fas fa-check-circle"></i><span><a href="/montera-duschvagg">Montera duschvägg</a> och duschhörn</span></li>
            <li><i class="fas fa-check-circle"></i><span><a href="/installera-diskmaskin">Installera diskmaskin</a></span></li>
            <li><i class="fas fa-check-circle"></i><span><a href="/installera-tvattmaskin">Installera tvättmaskin</a></span></li>
          </ul>

          <div class="mb-45">
            <img src="assets/img/projekt/badrum-04.webp" width="900" height="675" loading="lazy" alt="Nytt badrum med kakel och dusch, utfört av PRM Montage" class="w-100" style="border-radius:12px;aspect-ratio:16/9;height:auto;object-fit:cover;">
          </div>

          <div class="row g-4 mb-45">
            <div class="col-md-6">
              <div class="nt-quote">
                <div class="nt-quote__stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
                <p>"Helped us with installation of faucet. Very professional! The job was very well done! Can strongly recommend!"</p>
                <div class="nt-quote__author">
                  <div class="nt-quote__avatar">TD</div>
                  <div><h6>Thomas Durrani</h6><span class="nt-quote__source"><i class="fab fa-google"></i> Google-recension</span></div>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="nt-quote">
                <div class="nt-quote__stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
                <p>"Jag är mycket nöjd med installationen av blandaren i mitt badrum av en duktig och vänlig hantverkare."</p>
                <div class="nt-quote__author">
                  <div class="nt-quote__avatar">MC</div>
                  <div><h6>Marie Chenik</h6><span class="nt-quote__source"><i class="fab fa-google"></i> Google-recension</span></div>
                </div>
              </div>
            </div>
          </div>

          <h4 style="color:var(--nt-navy);font-weight:700;margin-bottom:18px;">Vanliga frågor om VVS &amp; badrum</h4>
          <div class="accordion nt-accordion mb-45" id="faqVvs">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqVvs1">Vad kostar en badrumsrenovering?</button></h2>
              <div id="faqVvs1" class="accordion-collapse collapse show" data-bs-parent="#faqVvs"><div class="accordion-body">Priset beror på badrummets storlek och omfattningen av arbetet. Vi lämnar alltid ett fast pris innan arbetet påbörjas, baserat på en kostnadsfri offert.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqVvs2">Är era VVS-installatörer auktoriserade?</button></h2>
              <div id="faqVvs2" class="accordion-collapse collapse" data-bs-parent="#faqVvs"><div class="accordion-body">Ja, våra VVS-installatörer är behöriga och utför arbetet enligt gällande branschregler.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqVvs3">Är ni försäkrade och lämnar ni garanti på arbetet?</button></h2>
              <div id="faqVvs3" class="accordion-collapse collapse" data-bs-parent="#faqVvs"><div class="accordion-body">Ja. PRM Montage är fullt försäkrat och lämnar garanti på utfört arbete. Läs mer på vår <a href="/garanti">garantisida</a>.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqVvs4">Ger VVS-arbete rätt till ROT-avdrag?</button></h2>
              <div id="faqVvs4" class="accordion-collapse collapse" data-bs-parent="#faqVvs"><div class="accordion-body">Arbetskostnaden vid VVS-arbete och badrumsrenovering ger normalt rätt till ROT-avdrag, medan material inte gör det. Läs mer på vår <a href="/rut-rot">ROT-avdragssida</a>.</div></div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär kostnadsfri offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
            <a href="tel:+46852027977" class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 border-full-1 ls-0 tp-btn-switch-animation fw-500">
              <span class="d-flex align-items-center justify-content-center"><span class="btn-text">Ring 08-520 279 77</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span>
            </a>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="nt-side-card nt-side-card--navy" style="background:var(--nt-navy);">
            <h4 style="color:#fff;font-weight:700;margin-bottom:24px;">Kontakta oss direkt</h4>
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-phone" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">Ring oss</p><a href="tel:+46852027977" style="color:#fff;font-weight:700;font-size:1.05rem;text-decoration:none;">08-520 279 77</a></div>
            </div>
            <div style="display:flex;align-items:center;gap:14px;">
              <span style="width:44px;height:44px;border-radius:12px;background:rgba(31,169,104,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-envelope" style="color:#1FA968;"></i></span>
              <div><p style="color:rgba(255,255,255,.6);font-size:.8rem;margin:0;">E-post</p><a href="mailto:info@pro-montage.se" style="color:#fff;font-weight:700;text-decoration:none;">info@pro-montage.se</a></div>
            </div>
          </div>
          <div class="nt-side-card">
            <h5>Varför PRM Montage?</h5>
            <ul class="nt-check" style="margin:0;"><li><i class="fas fa-check"></i><span>Fast pris, alltid</span></li><li><i class="fas fa-check"></i><span>F-skatt &amp; försäkrade</span></li><li><i class="fas fa-check"></i><span>Egna hantverkare</span></li><li><i class="fas fa-check"></i><span>Garanti på arbetet</span></li></ul>
          </div>
          <div class="nt-side-card">
            <h5>Alla tjänster</h5>
            <ul class="nt-side-nav">
              <li><a href="/koksrenovering-stockholm">Köksrenovering Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/bygg-renovering">Bygg &amp; renovering <i class="fas fa-arrow-right"></i></a></li>
              <li class="is-active"><a href="/vvs-badrum">VVS &amp; Badrum <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/elektriker-stockholm">Elektriker Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/altanbygge-i-stockholm">Altanbygge i Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/jour">Jour — akut hjälp <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
          <div class="nt-side-card">
            <h5>Mer VVS</h5>
            <ul class="nt-side-nav">
              <li><a href="/rormokare-stockholm">Rörmokare Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/akut-rormokare-stockholm">Akut rörmokare Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/vattenlacka-stockholm">Vattenläcka Stockholm <i class="fas fa-arrow-right"></i></a></li>
              <li><a href="/rormokare-upplands-vasby">Rörmokare Upplands Väsby <i class="fas fa-arrow-right"></i></a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="tp-cta-area nt-dark-band pt-120 pb-120" style="background:linear-gradient(120deg,var(--nt-navy-dark) 0%,var(--nt-navy) 100%);">
    <div class="container"><div class="row"><div class="col-xl-8 col-lg-10">
      <span class="nt-eyebrow nt-eyebrow-light">Redo att börja?</span>
      <h2 class="mb-15 fs-xl-40 fs-sm-36 tp-text-common-white">Dags att förnya badrummet eller lösa ett VVS-problem?</h2>
      <p class="mb-40" style="color:rgba(255,255,255,0.78);font-size:1.05rem;max-width:620px;">Kontakta oss idag — fast pris, egna hantverkare, kostnadsfri offert.</p>
      <div class="d-flex flex-wrap align-items-center gap-4">
        <a href="/kontakt" class="tp-btn-xl hire-btn d-inline-block lh-0 tp-round-26 fs-16 tp-bg-theme-primary ls-0 tp-btn-switch-animation tp-text-common-white fw-500"><span class="d-flex align-items-center justify-content-center"><span class="btn-text">Begär offert</span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></span></a>
        <a href="tel:+46852027977" class="d-inline-flex align-items-center gap-3" style="text-decoration:none;"><span style="width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;"><i class="fas fa-phone" style="color:#1FA968;"></i></span><span><span style="display:block;color:rgba(255,255,255,0.6);font-size:.8rem;">Ring oss direkt</span><span style="display:block;color:#fff;font-weight:700;font-size:1.05rem;">08-520 279 77</span></span></a>
      </div>
    </div></div></div>
  </div>
</BaseLayout>
